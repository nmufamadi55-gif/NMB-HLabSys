@{
    Layout = null;
    ViewData["Title"] = "Forgot Password";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NMBHDL - Forgot Password</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: 'Inter', sans-serif;
                background: linear-gradient(135deg, #0F172A, #1E293B);
                min-height: 100vh;
                display: flex;
                justify-content: center;
                align-items: center;
                padding: 20px;
            }

            .container {
                background: white;
                border-radius: 24px;
                padding: 40px;
                max-width: 440px;
                width: 100%;
                box-shadow: 0 20px 60px rgba(0,0,0,0.3);
            }

            .logo {
                text-align: center;
                margin-bottom: 24px;
            }

                .logo h1 {
                    font-size: 24px;
                    color: #0F172A;
                    font-weight: 700;
                }

                .logo p {
                    color: #64748B;
                    font-size: 14px;
                    margin-top: 4px;
                }

            .info-box {
                background: #EFF6FF;
                color: #1E40AF;
                padding: 12px;
                border-radius: 12px;
                font-size: 13px;
                margin-bottom: 20px;
            }

            .form-group {
                margin-bottom: 20px;
            }

                .form-group label {
                    display: block;
                    font-weight: 500;
                    font-size: 14px;
                    color: #334155;
                    margin-bottom: 6px;
                }

                .form-group input {
                    width: 100%;
                    padding: 12px 16px;
                    border: 1px solid #E2E8F0;
                    border-radius: 12px;
                    font-size: 15px;
                }

                    .form-group input:focus {
                        outline: none;
                        border-color: #4F46E5;
                        box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.1);
                    }

            .btn-submit {
                width: 100%;
                padding: 14px;
                background: #4F46E5;
                color: white;
                border: none;
                border-radius: 12px;
                font-size: 16px;
                font-weight: 600;
                cursor: pointer;
            }

                .btn-submit:hover {
                    background: #4338CA;
                }

            .alert-success {
                background: #DCFCE7;
                color: #166534;
                padding: 12px;
                border-radius: 12px;
                font-size: 14px;
                margin-bottom: 16px;
            }

            .alert-error {
                background: #FEE2E2;
                color: #991B1B;
                padding: 12px;
                border-radius: 12px;
                font-size: 14px;
                margin-bottom: 16px;
            }

            .temp-password {
                background: #FEF3C7;
                color: #92400E;
                padding: 12px;
                border-radius: 12px;
                font-size: 14px;
                margin-top: 16px;
                border-left: 4px solid #F59E0B;
            }

                .temp-password code {
                    background: white;
                    padding: 4px 8px;
                    border-radius: 6px;
                    font-size: 15px;
                    font-weight: 600;
                }

            .back-link {
                text-align: center;
                margin-top: 20px;
                font-size: 14px;
            }

                .back-link a {
                    color: #4F46E5;
                    text-decoration: none;
                }

                    .back-link a:hover {
                        text-decoration: underline;
                    }
    </style>
</head>
<body>
    <div class="container">
        <div class="logo">
            <h1>🔑 Forgot Password</h1>
            <p>NMBHDL Password Reset</p>
        </div>

        <div class="info-box">
            Enter your email address and we'll generate a temporary password for you.
        </div>

        @if (ViewBag.Success != null)
        {
            <div class="alert-success">✅ @ViewBag.Success</div>
        }

        @if (ViewBag.Error != null)
        {
            <div class="alert-error">❌ @ViewBag.Error</div>
        }

        @if (ViewBag.TempPassword != null)
        {
            <div class="temp-password">
                <strong>⚠️ Temporary Password:</strong><br />
                <code>@ViewBag.TempPassword</code><br /><br />
                <small>Please log in with this password and change it immediately.</small>
            </div>
        }

        <form method="post" asp-action="ForgotPassword">
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label>Email Address</label>
                <input type="email" name="email" placeholder="you@email.com" required />
            </div>

            <button type="submit" class="btn-submit">Reset Password</button>
        </form>

        <div class="back-link">
            <a href="@Url.Action("Login", "Account")">← Back to Login</a>
        </div>
    </div>
</body>
</html>
