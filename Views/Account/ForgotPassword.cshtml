@{
    Layout = null;
    ViewData["Title"] = "Forgot Password";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NMBHDL - Forgot Password</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }

        :root {
            --accent-grad: linear-gradient(135deg, #2563EB 0%, #06B6D4 100%);
            --text-primary: #0F172A;
            --text-secondary: #475569;
            --border: #E2E8F0;
        }

        body {
            font-family: 'Inter', sans-serif;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
            position: relative;
            overflow: hidden;
            background: #F5F7FC;
        }

        body::before {
            content: '';
            position: fixed;
            inset: 0;
            background:
                radial-gradient(circle at 15% 20%, rgba(37, 99, 235, 0.20), transparent 45%),
                radial-gradient(circle at 85% 15%, rgba(6, 182, 212, 0.18), transparent 45%),
                radial-gradient(circle at 80% 85%, rgba(124, 58, 237, 0.14), transparent 45%),
                radial-gradient(circle at 20% 90%, rgba(5, 150, 105, 0.12), transparent 45%);
            z-index: 0;
        }

        .card {
            position: relative;
            z-index: 1;
            background: rgba(255, 255, 255, 0.88);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.9);
            border-radius: 24px;
            max-width: 460px;
            width: 100%;
            box-shadow: 0 25px 60px rgba(15, 23, 42, 0.15);
            overflow: hidden;
        }

        .card-header {
            padding: 2.4rem 2.4rem 1.2rem;
            text-align: center;
            border-bottom: 1px solid rgba(226, 232, 240, 0.7);
            position: relative;
        }

        .card-header::before {
            content: '';
            position: absolute;
            top: 0; left: 0; width: 100%; height: 4px;
            background: var(--accent-grad);
        }

        .logo-icon {
            width: 56px; height: 56px;
            margin: 0 auto 1rem;
            border-radius: 16px;
            display: flex; align-items: center; justify-content: center;
            background: var(--accent-grad);
            color: white;
            font-size: 1.4rem;
            box-shadow: 0 10px 24px rgba(37, 99, 235, 0.35);
        }

        .card-header h1 {
            font-size: 1.5rem;
            color: var(--text-primary);
            font-weight: 800;
            letter-spacing: -0.02em;
        }

        .card-header p {
            color: var(--text-secondary);
            font-size: 0.82rem;
            margin-top: 0.3rem;
            line-height: 1.5;
        }

        .card-body { padding: 1.8rem 2.4rem 2.4rem; }

        .info-box {
            background: #EFF6FF;
            color: #1E40AF;
            padding: 0.9rem 1rem;
            border-radius: 10px;
            font-size: 0.82rem;
            margin-bottom: 1.4rem;
            display: flex;
            gap: 0.6rem;
            align-items: flex-start;
            line-height: 1.5;
            border-left: 3px solid #2563EB;
        }

        .form-group { margin-bottom: 1.2rem; }

        .form-group label {
            display: block;
            font-weight: 600;
            font-size: 0.82rem;
            color: #334155;
            margin-bottom: 0.4rem;
        }

        .form-group input {
            width: 100%;
            padding: 0.8rem 1rem;
            border: 1px solid var(--border);
            border-radius: 10px;
            font-size: 0.92rem;
            font-family: inherit;
            background: white;
        }

        .form-group input:focus {
            outline: none;
            border-color: #2563EB;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
        }

        .btn-submit {
            width: 100%;
            padding: 0.9rem;
            background: var(--accent-grad);
            color: white;
            border: none;
            border-radius: 10px;
            font-size: 0.95rem;
            font-weight: 600;
            cursor: pointer;
            transition: 0.2s;
            font-family: inherit;
            box-shadow: 0 8px 22px rgba(37, 99, 235, 0.32);
        }

        .btn-submit:hover {
            transform: translateY(-1px);
            box-shadow: 0 12px 28px rgba(37, 99, 235, 0.42);
        }

        .alert {
            padding: 0.8rem 1rem;
            border-radius: 10px;
            font-size: 0.85rem;
            margin-bottom: 1rem;
            display: flex;
            align-items: flex-start;
            gap: 0.5rem;
        }

        .alert-success { background: #DCFCE7; color: #166534; border-left: 4px solid #059669; }
        .alert-error { background: #FEE2E2; color: #991B1B; border-left: 4px solid #DC2626; }

        .back-link {
            text-align: center;
            margin-top: 1.4rem;
            padding-top: 1.2rem;
            border-top: 1px solid rgba(226, 232, 240, 0.7);
            font-size: 0.85rem;
        }

        .back-link a {
            color: #2563EB;
            text-decoration: none;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
        }

        .back-link a:hover { text-decoration: underline; }

        @@media (max-width: 480px) {
            .card-header, .card-body { padding-left: 1.5rem; padding-right: 1.5rem; }
        }
    </style>
</head>
<body>
    <div class="card">
        <div class="card-header">
            <div class="logo-icon"><i class="fas fa-key"></i></div>
            <h1>Forgot Password?</h1>
            <p>Enter your email and we'll send you a secure reset link</p>
        </div>

        <div class="card-body">
            <div class="info-box">
                <i class="fas fa-envelope" style="margin-top:2px;"></i>
                <span>We'll email you a password reset link. The link is valid for <strong>30 minutes</strong> and can only be used once.</span>
            </div>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success">
                    <i class="fas fa-check-circle" style="margin-top:2px;"></i>
                    <span>@TempData["SuccessMessage"]</span>
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-error">
                    <i class="fas fa-exclamation-circle" style="margin-top:2px;"></i>
                    <span>@TempData["ErrorMessage"]</span>
                </div>
            }

            <form method="post" asp-action="ForgotPassword">
                @Html.AntiForgeryToken()

                <div class="form-group">
                    <label>Email Address</label>
                    <input type="email" name="email" placeholder="you@email.com" required autocomplete="email" />
                </div>

                <button type="submit" class="btn-submit">
                    <i class="fas fa-paper-plane"></i> Send Reset Link
                </button>
            </form>

            <div class="back-link">
                <a href="@Url.Action("Login", "Account")">
                    <i class="fas fa-arrow-left"></i> Back to Login
                </a>
            </div>
        </div>
    </div>
</body>
</html>
