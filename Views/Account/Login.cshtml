@using NMB_HLabSys.ViewModels.SharedViewModels
@model LoginViewModel

@{
    Layout = null;
    ViewData["Title"] = "Login";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NMBHDL - Login</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }

        :root {
            --accent-grad: linear-gradient(135deg, #2563EB 0%, #06B6D4 100%);
            --text-primary: #0F172A;
            --text-secondary: #475569;
            --border: #E2E8F0;
        }

        body {
            font-family: 'Inter', sans-serif;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
            position: relative;
            overflow: hidden;
            background: #F5F7FC;
        }

        body::before {
            content: '';
            position: fixed;
            inset: 0;
            background:
                radial-gradient(circle at 15% 20%, rgba(37, 99, 235, 0.20), transparent 45%),
                radial-gradient(circle at 85% 15%, rgba(6, 182, 212, 0.18), transparent 45%),
                radial-gradient(circle at 80% 85%, rgba(124, 58, 237, 0.14), transparent 45%),
                radial-gradient(circle at 20% 90%, rgba(5, 150, 105, 0.12), transparent 45%);
            z-index: 0;
        }

        .login-card {
            position: relative;
            z-index: 1;
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.9);
            border-radius: 24px;
            max-width: 440px;
            width: 100%;
            box-shadow: 0 25px 60px rgba(15, 23, 42, 0.15);
            overflow: hidden;
        }

        .login-header {
            padding: 2.4rem 2.4rem 1.2rem;
            text-align: center;
            border-bottom: 1px solid rgba(226, 232, 240, 0.7);
            position: relative;
        }

        .login-header::before {
            content: '';
            position: absolute;
            top: 0; left: 0; width: 100%; height: 4px;
            background: var(--accent-grad);
        }

        .logo-icon {
            width: 56px; height: 56px;
            margin: 0 auto 1rem;
            border-radius: 16px;
            display: flex; align-items: center; justify-content: center;
            background: var(--accent-grad);
            color: white;
            font-size: 1.5rem;
            box-shadow: 0 10px 24px rgba(37, 99, 235, 0.35);
        }

        .login-header h1 {
            font-size: 1.5rem;
            color: var(--text-primary);
            font-weight: 800;
            letter-spacing: -0.02em;
        }

        .login-header p {
            color: var(--text-secondary);
            font-size: 0.82rem;
            margin-top: 0.3rem;
            line-height: 1.5;
        }

        .login-body { padding: 1.8rem 2.4rem 2.4rem; }

        .form-group { margin-bottom: 1.1rem; }

        .form-group label {
            display: block;
            font-weight: 600;
            font-size: 0.82rem;
            color: #334155;
            margin-bottom: 0.4rem;
        }

        .form-group input[type="email"],
        .form-group input[type="password"],
        .form-group input[type="text"] {
            width: 100%;
            padding: 0.8rem 1rem;
            border: 1px solid var(--border);
            border-radius: 10px;
            font-size: 0.92rem;
            font-family: inherit;
            transition: 0.2s;
            background: white;
        }

        .form-group input:focus {
            outline: none;
            border-color: #2563EB;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
        }

        .field-error {
            color: #DC2626;
            font-size: 0.78rem;
            margin-top: 0.3rem;
            display: block;
        }

        .forgot-link {
            text-align: right;
            margin-bottom: 1rem;
            font-size: 0.8rem;
        }

        .forgot-link a {
            color: #2563EB;
            text-decoration: none;
            font-weight: 500;
        }

        .forgot-link a:hover { text-decoration: underline; }

        .remember-row {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 1.2rem;
        }

        .remember-row input[type="checkbox"] {
            width: 16px; height: 16px;
            accent-color: #2563EB;
            cursor: pointer;
        }

        .remember-row label {
            font-size: 0.85rem;
            color: var(--text-secondary);
            font-weight: 500;
            cursor: pointer;
            margin: 0;
        }

        .btn-login {
            width: 100%;
            padding: 0.9rem;
            background: var(--accent-grad);
            color: white;
            border: none;
            border-radius: 10px;
            font-size: 0.95rem;
            font-weight: 600;
            cursor: pointer;
            transition: 0.2s;
            font-family: inherit;
            box-shadow: 0 8px 22px rgba(37, 99, 235, 0.32);
        }

        .btn-login:hover {
            transform: translateY(-1px);
            box-shadow: 0 12px 28px rgba(37, 99, 235, 0.42);
        }

        .alert {
            padding: 0.8rem 1rem;
            border-radius: 10px;
            font-size: 0.85rem;
            margin-bottom: 1rem;
            display: flex;
            align-items: flex-start;
            gap: 0.5rem;
        }

        .alert-success { background: #DCFCE7; color: #166534; border-left: 4px solid #059669; }
        .alert-error { background: #FEE2E2; color: #991B1B; border-left: 4px solid #DC2626; }

        .login-footer {
            margin-top: 1.4rem;
            padding-top: 1.2rem;
            border-top: 1px solid rgba(226, 232, 240, 0.7);
            text-align: center;
            font-size: 0.85rem;
            color: var(--text-secondary);
        }

        .login-footer a { color: #2563EB; text-decoration: none; font-weight: 600; }
        .login-footer a:hover { text-decoration: underline; }

        .back-home {
            position: absolute;
            top: 1.5rem;
            left: 1.5rem;
            z-index: 2;
            color: var(--text-secondary);
            text-decoration: none;
            font-size: 0.85rem;
            font-weight: 500;
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            padding: 0.5rem 1rem;
            background: rgba(255, 255, 255, 0.8);
            border-radius: 20px;
            backdrop-filter: blur(10px);
            border: 1px solid rgba(226, 232, 240, 0.8);
            transition: 0.2s;
        }

        .back-home:hover { color: #2563EB; border-color: #2563EB; }

        @@media (max-width: 480px) {
            .login-header, .login-body { padding-left: 1.5rem; padding-right: 1.5rem; }
        }
    </style>
</head>
<body>
    <a href="@Url.Action("Index", "Home")" class="back-home">
        <i class="fas fa-arrow-left"></i> Back to Home
    </a>

    <div class="login-card">
        <div class="login-header">
            <div class="logo-icon"><i class="fas fa-microscope"></i></div>
            <h1>NMBHDL</h1>
            <p>Nelson Mandela Bay Haematology Diagnostic Laboratories</p>
        </div>

        <div class="login-body">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success">
                    <i class="fas fa-check-circle" style="margin-top:2px;"></i>
                    <span>@TempData["SuccessMessage"]</span>
                </div>
            }

            @if (!ViewData.ModelState.IsValid && ViewData.ModelState.Values.Any(v => v.Errors.Any()))
            {
                <div class="alert alert-error">
                    <i class="fas fa-exclamation-circle" style="margin-top:2px;"></i>
                    <div>
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <div>@error.ErrorMessage</div>
                        }
                    </div>
                </div>
            }

            <form method="post" asp-action="Login">
                @Html.AntiForgeryToken()

                <div class="form-group">
                    <label asp-for="Email">Email Address</label>
                    <input asp-for="Email" type="email" placeholder="you@email.com" required autocomplete="email" />
                    <span asp-validation-for="Email" class="field-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Password">Password</label>
                    <input asp-for="Password" type="password" placeholder="Enter your password" required autocomplete="current-password" />
                    <span asp-validation-for="Password" class="field-error"></span>
                </div>

                <div class="forgot-link">
                    <a href="@Url.Action("ForgotPassword", "Account")">Forgot password?</a>
                </div>

                <div class="remember-row">
                    <input asp-for="RememberMe" type="checkbox" id="rememberMe" />
                    <label asp-for="RememberMe" for="rememberMe">Remember me</label>
                </div>

                <button type="submit" class="btn-login">Sign In</button>
            </form>

            <div class="login-footer">
                Don't have an account? <a href="@Url.Action("Register", "Patient")">Register as Patient</a>
            </div>
        </div>
    </div>
</body>
</html>