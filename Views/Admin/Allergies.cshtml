@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Allergies Management";
    ViewData["RoleSubtitle"] = "Admin Portal";
    ViewData["UserGreeting"] = "⚙️ System Administrator";
    ViewData["UserInitials"] = "AD";
}

@section SidebarMenu {
    <li><a href="@Url.Action("Dashboard", "Admin")">📋 Dashboard</a></li>
    <li><a href="@Url.Action("Conditions", "Admin")">🩺 Medical Conditions</a></li>
    <li><a href="@Url.Action("Allergies", "Admin")" class="active">⚠️ Allergies</a></li>
    <li><a href="@Url.Action("Medications", "Admin")">💊 Medications</a></li>
    <li><a href="@Url.Action("Index", "Profile")"><i class="fas fa-user-circle"></i> <span>My Profile</span></a></li>
}

<style>
    .admin-toolbar {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: wrap;
        margin-bottom: 1rem;
    }

    .search-box {
        padding: 10px 14px;
        border-radius: 20px;
        border: 1px solid #CBD5E1;
        width: 280px;
    }

    .allergy-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: white;
        padding: 10px 12px;
        border-radius: 14px;
        margin-bottom: 8px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.04);
    }

    .allergy-actions {
        display: flex;
        gap: 6px;
    }

    .category-card {
        transition: 0.25s;
    }

        .category-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(0,0,0,0.08);
        }

    .remove-btn {
        color: red;
        border-color: red;
    }
</style>

<div class="card-modern">
    <div class="card-header-flex">
        <h3>⚠️ Allergies Reference List</h3>

        <button class="btn-sm-lab" onclick="showDemoAlert('New allergy added successfully')">
            + Add Allergy
        </button>
    </div>

    <div class="admin-toolbar">
        <input type="text"
               id="searchInput"
               class="search-box"
               placeholder="Search allergies..."
               onkeyup="searchAllergies()" />

        <button class="btn-outline-lab" onclick="showDemoAlert('Allergy list exported successfully')">
            Export List
        </button>
    </div>

    <div class="grid-2col">

        <div class="card-modern category-card" style="background:#F8FAFE;">
            <h4>💊 Medication Allergies</h4>
            <ul class="sortable-list" style="margin-top:0.5rem;">
                <li>Penicillin</li>
                <li>Sulfa Drugs</li>
                <li>Aspirin (NSAID)</li>
                <li>Cephalosporins</li>
                <li>Codeine</li>
            </ul>
        </div>

        <div class="card-modern category-card" style="background:#F8FAFE;">
            <h4>🍽️ Food Allergies</h4>
            <ul class="sortable-list" style="margin-top:0.5rem;">
                <li>Peanuts</li>
                <li>Tree Nuts</li>
                <li>Shellfish</li>
                <li>Eggs</li>
                <li>Soy</li>
            </ul>
        </div>

    </div>

    <div class="grid-2col" style="margin-top:1rem;">

        <div class="card-modern category-card" style="background:#F8FAFE;">
            <h4>🐝 Environmental Allergies</h4>
            <ul class="sortable-list" style="margin-top:0.5rem;">
                <li>Dust Mites</li>
                <li>Pollen</li>
                <li>Latex</li>
                <li>Mould</li>
                <li>Animal Dander</li>
            </ul>
        </div>

        <div class="card-modern category-card" style="background:#F8FAFE;">
            <h4>🦟 Insect Allergies</h4>
            <ul class="sortable-list" style="margin-top:0.5rem;">
                <li>Bee Venom</li>
                <li>Wasp Venom</li>
                <li>Fire Ants</li>
            </ul>

            <button class="btn-outline-lab"
                    style="margin-top:0.5rem;"
                    onclick="showDemoAlert('New allergy category added successfully')">
                + Add Category
            </button>
        </div>

    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const lists = document.querySelectorAll(".sortable-list");

        lists.forEach(function (list) {
            let items = Array.from(list.querySelectorAll("li"));

            items.sort(function (a, b) {
                return a.textContent.trim().localeCompare(b.textContent.trim());
            });

            list.innerHTML = "";

            items.forEach(function (item) {
                let itemName = item.textContent.trim();

                let li = document.createElement("li");
                li.className = "allergy-item";

                li.innerHTML = `
                        <span class="allergy-name">${itemName}</span>

                        <div class="allergy-actions">
                            <button class="btn-outline-lab"
                                    onclick="showDemoAlert('${itemName} updated successfully')">
                                Edit
                            </button>

                            <button class="btn-outline-lab remove-btn"
                                    onclick="removeItem(this)">
                                Remove
                            </button>
                        </div>
                    `;

                list.appendChild(li);
            });
        });
    });

    function removeItem(button) {
        let itemName = button.closest("li").querySelector(".allergy-name").textContent;

        if (confirm("Are you sure you want to remove " + itemName + "?")) {
            button.closest("li").remove();
            alert("✅ " + itemName + " removed successfully.");
        }
    }

    function searchAllergies() {
        let searchText = document.getElementById("searchInput").value.toLowerCase();
        let items = document.querySelectorAll(".allergy-item");

        items.forEach(function (item) {
            let allergyName = item.querySelector(".allergy-name").textContent.toLowerCase();

            if (allergyName.includes(searchText)) {
                item.style.display = "flex";
            } else {
                item.style.display = "none";
            }
        });
    }

    function showDemoAlert(msg) {
        alert("✅ " + msg);
    }
</script>