@using NMB_HLabSys.ViewModels.AdminViewModels
@model AdminLookupViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Allergies";
    ViewData["RoleSubtitle"] = "Admin Portal";
    ViewData["UserGreeting"] = "⚙️ System Administrator";
    ViewData["UserInitials"] = "AD";
}

@section SidebarMenu {
    <li><a href="@Url.Action("Dashboard", "Admin")">📋 Dashboard</a></li>
    <li><a href="@Url.Action("Conditions", "Admin")">🩺 Medical Conditions</a></li>
    <li><a href="@Url.Action("Allergies", "Admin")" class="active">⚠️ Allergies</a></li>
    <li><a href="@Url.Action("Medications", "Admin")">💊 Medications</a></li>
    <li><a href="@Url.Action("Categories", "Admin")">📁 Categories</a></li>
    <li><a href="@Url.Action("Index", "Profile")"><i class="fas fa-user-circle"></i> <span>My Profile</span></a></li>
}

<style>
    .admin-toolbar {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: wrap;
        margin-bottom: 1rem;
    }

    .search-box {
        padding: 10px 14px;
        border-radius: 20px;
        border: 1px solid #CBD5E1;
        width: 280px;
    }

    .allergy-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: white;
        padding: 10px 12px;
        border-radius: 14px;
        margin-bottom: 8px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.04);
    }

    .allergy-actions {
        display: flex;
        gap: 6px;
    }

    .category-card {
        transition: 0.25s;
    }

        .category-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(0,0,0,0.08);
        }

    .remove-btn {
        color: red;
        border-color: red;
    }

    .modal-overlay {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.5);
        z-index: 1000;
        justify-content: center;
        align-items: center;
    }

        .modal-overlay.active {
            display: flex;
        }

    .modal-box {
        background: white;
        padding: 2rem;
        border-radius: 20px;
        max-width: 500px;
        width: 90%;
    }

    .modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
    }

    .modal-close {
        background: none;
        border: none;
        font-size: 1.5rem;
        cursor: pointer;
    }

    .form-group {
        margin-bottom: 1rem;
    }

        .form-group label {
            display: block;
            font-weight: 500;
            margin-bottom: 0.25rem;
        }

        .form-group input, .form-group select, .form-group textarea {
            width: 100%;
            padding: 10px;
            border-radius: 12px;
            border: 1px solid #D1D5DB;
        }

    .alert-success {
        background: #DCFCE7;
        color: #166534;
        padding: 12px;
        border-radius: 12px;
        margin-bottom: 1rem;
    }

    .alert-error {
        background: #FEE2E2;
        color: #991B1B;
        padding: 12px;
        border-radius: 12px;
        margin-bottom: 1rem;
    }
</style>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert-success">✅ @TempData["SuccessMessage"]</div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert-error">❌ @TempData["ErrorMessage"]</div>
}

<div class="card-modern">
    <div class="card-header-flex">
        <h3>⚠️ Allergies</h3>
        <button class="btn-sm-lab" onclick="openAddModal()">+ Add Allergy</button>
    </div>

    <div class="admin-toolbar">
        <input type="text" id="searchInput" class="search-box" placeholder="Search allergies..." onkeyup="searchAllergies()" />
    </div>

    @if (Model.Allergies != null && Model.Allergies.Any())
    {
        foreach (var category in Model.Categories)
        {
            var allergiesInCategory = Model.Allergies.Where(a => a.CategoryID == category.CategoryID).ToList();

            if (allergiesInCategory.Any())
            {
                <div class="card-modern category-card" style="background:#F8FAFE; margin-bottom: 1rem;">
                    <h4>@category.CategoryName</h4>
                    <div style="margin-top: 0.5rem;">
                        @foreach (var allergy in allergiesInCategory)
                        {
                            <div class="allergy-item" data-name="@allergy.AllergyName.ToLower()">
                                <span class="allergy-name">
                                    <strong>@allergy.AllergyName</strong>
                                    @if (!string.IsNullOrEmpty(allergy.Description))
                                    {
                                        <span style="color: #6B7280; font-size: 0.85rem; margin-left: 0.5rem;">
                                            @allergy.Description
                                        </span>
                                    }
                                </span>
                                <div class="allergy-actions">
                                    <a href="@Url.Action("EditAllergy", "Admin", new { id = allergy.AllergyID })" class="btn-outline-lab">Edit</a>                                    <button class="btn-outline-lab remove-btn" onclick="deleteAllergy(@allergy.AllergyID)">Delete</button>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        }
    }
    else
    {
        <p style="text-align: center; color: #9CA3AF; padding: 2rem;">
            No allergies found. Click "+ Add Allergy" to create one.
        </p>
    }
</div>

<!-- Add Allergy Modal -->
<div id="addModal" class="modal-overlay">
    <div class="modal-box">
        <div class="modal-header">
            <h3>Add Allergy</h3>
            <button class="modal-close" onclick="closeAddModal()">✕</button>
        </div>
        <form method="post" action="@Url.Action("AddAllergy", "Admin")">
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label>Allergy Name *</label>
                <input type="text" name="allergyName" required />
            </div>

            <div class="form-group">
                <label>Category *</label>
                <select name="categoryId" required>
                    <option value="">-- Select Category --</option>
                    @foreach (var cat in Model.Categories)
                    {
                        <option value="@cat.CategoryID">@cat.CategoryName</option>
                    }
                </select>
            </div>

            <div class="form-group">
                <label>Description</label>
                <textarea name="description" rows="3"></textarea>
            </div>

            <button type="submit" class="btn-sm-lab" style="width:100%;">Add Allergy</button>
        </form>
    </div>
</div>

<script>
    function openAddModal() {
        document.getElementById('addModal').classList.add('active');
    }

    function closeAddModal() {
        document.getElementById('addModal').classList.remove('active');
    }

    function searchAllergies() {
        var searchText = document.getElementById('searchInput').value.toLowerCase();
        var items = document.querySelectorAll('.allergy-item');
        items.forEach(function (item) {
            var name = item.getAttribute('data-name');
            if (name && name.includes(searchText)) {
                item.style.display = 'flex';
            } else {
                item.style.display = 'none';
            }
        });
    }

    function deleteAllergy(id) {
        if (confirm('Are you sure you want to delete this allergy?')) {
            fetch('@Url.Action("DeleteAllergy", "Admin")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                },
                body: 'id=' + id
            })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        alert('✅ ' + data.message);
                        location.reload();
                    } else {
                        alert('❌ Error: ' + data.message);
                    }
                });
        }
    }

    function editAllergy(id) {
        alert('Edit functionality coming soon for ID: ' + id);
    }

    document.getElementById('addModal').addEventListener('click', function (e) {
        if (e.target === this) closeAddModal();
    });
</script>