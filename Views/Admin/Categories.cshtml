@model List<NMB_HLabSys.Models.LookupCategory>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Manage Categories";
    ViewData["RoleSubtitle"] = "Admin Portal";
    ViewData["UserGreeting"] = "⚙️ System Administrator";
    ViewData["UserInitials"] = "AD";
}

@section SidebarMenu {
    <li><a href="@Url.Action("Dashboard", "Admin")">📋 Dashboard</a></li>
    <li><a href="@Url.Action("Conditions", "Admin")">🩺 Medical Conditions</a></li>
    <li><a href="@Url.Action("Allergies", "Admin")">⚠️ Allergies</a></li>
    <li><a href="@Url.Action("Medications", "Admin")">💊 Medications</a></li>
    <li><a href="@Url.Action("Categories", "Admin")" class="active">📁 Categories</a></li>
    <li><a href="@Url.Action("Index", "Profile")"><i class="fas fa-user-circle"></i> <span>My Profile</span></a></li>
}

<style>
    .category-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: white;
        padding: 10px 12px;
        border-radius: 14px;
        margin-bottom: 8px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.04);
    }

    .category-actions {
        display: flex;
        gap: 6px;
    }

    .remove-btn {
        color: red;
        border-color: red;
    }

    .type-badge {
        padding: 3px 10px;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 600;
        margin-left: 0.5rem;
    }

    .type-condition {
        background: #EDE9FE;
        color: #6D28D9;
    }

    .type-allergy {
        background: #FEF3C7;
        color: #92400E;
    }

    .type-medication {
        background: #FCE7F3;
        color: #9D174D;
    }

    .modal-overlay {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.5);
        z-index: 1000;
        justify-content: center;
        align-items: center;
    }

        .modal-overlay.active {
            display: flex;
        }

    .modal-box {
        background: white;
        padding: 2rem;
        border-radius: 20px;
        max-width: 500px;
        width: 90%;
    }

    .modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
    }

    .modal-close {
        background: none;
        border: none;
        font-size: 1.5rem;
        cursor: pointer;
    }

    .form-group {
        margin-bottom: 1rem;
    }

        .form-group label {
            display: block;
            font-weight: 500;
            margin-bottom: 0.25rem;
        }

        .form-group input, .form-group select, .form-group textarea {
            width: 100%;
            padding: 10px;
            border-radius: 12px;
            border: 1px solid #D1D5DB;
        }

    .alert-success {
        background: #DCFCE7;
        color: #166534;
        padding: 12px;
        border-radius: 12px;
        margin-bottom: 1rem;
    }

    .alert-error {
        background: #FEE2E2;
        color: #991B1B;
        padding: 12px;
        border-radius: 12px;
        margin-bottom: 1rem;
    }
</style>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert-success">✅ @TempData["SuccessMessage"]</div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert-error">❌ @TempData["ErrorMessage"]</div>
}

<div class="card-modern">
    <div class="card-header-flex">
        <h3>📁 Categories</h3>
        <button class="btn-sm-lab" onclick="openAddModal()">+ Add Category</button>
    </div>

    @if (Model != null && Model.Any())
    {
        var conditionCategories = Model.Where(c => c.CategoryType == "Condition").ToList();
        var allergyCategories = Model.Where(c => c.CategoryType == "Allergy").ToList();
        var medicationCategories = Model.Where(c => c.CategoryType == "Medication").ToList();

        <!-- Condition Categories -->
        @if (conditionCategories.Any())
        {
            <h4 style="margin-top: 1rem; margin-bottom: 0.5rem;">🩺 Condition Categories</h4>
            @foreach (var cat in conditionCategories)
            {
                <div class="category-item">
                    <span>
                        <strong>@cat.CategoryName</strong>
                        <span class="type-badge type-condition">Condition</span>
                    </span>
                    <div class="category-actions">
                        <button class="btn-outline-lab remove-btn" onclick="deleteCategory(@cat.CategoryID)">Delete</button>
                    </div>
                </div>
            }
        }

        <!-- Allergy Categories -->
        @if (allergyCategories.Any())
        {
            <h4 style="margin-top: 1.5rem; margin-bottom: 0.5rem;">⚠️ Allergy Categories</h4>
            @foreach (var cat in allergyCategories)
            {
                <div class="category-item">
                    <span>
                        <strong>@cat.CategoryName</strong>
                        <span class="type-badge type-allergy">Allergy</span>
                    </span>
                    <div class="category-actions">
                        <button class="btn-outline-lab remove-btn" onclick="deleteCategory(@cat.CategoryID)">Delete</button>
                    </div>
                </div>
            }
        }

        <!-- Medication Categories -->
        @if (medicationCategories.Any())
        {
            <h4 style="margin-top: 1.5rem; margin-bottom: 0.5rem;">💊 Medication Categories</h4>
            @foreach (var cat in medicationCategories)
            {
                <div class="category-item">
                    <span>
                        <strong>@cat.CategoryName</strong>
                        <span class="type-badge type-medication">Medication</span>
                    </span>
                    <div class="category-actions">
                        <button class="btn-outline-lab remove-btn" onclick="deleteCategory(@cat.CategoryID)">Delete</button>
                    </div>
                </div>
            }
        }
    }
    else
    {
        <p style="text-align: center; color: #9CA3AF; padding: 2rem;">
            No categories found. Click "+ Add Category" to create one.
        </p>
    }
</div>

<!-- Add Category Modal -->
<div id="addModal" class="modal-overlay">
    <div class="modal-box">
        <div class="modal-header">
            <h3>Add Category</h3>
            <button class="modal-close" onclick="closeAddModal()">✕</button>
        </div>
        <form method="post" action="@Url.Action("AddCategory", "Admin")">
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label>Category Name *</label>
                <input type="text" name="categoryName" required />
            </div>

            <div class="form-group">
                <label>Category Type *</label>
                <select name="categoryType" required>
                    <option value="">-- Select Type --</option>
                    <option value="Condition">Condition</option>
                    <option value="Allergy">Allergy</option>
                    <option value="Medication">Medication</option>
                </select>
            </div>

            <div class="form-group">
                <label>Description</label>
                <textarea name="description" rows="3"></textarea>
            </div>

            <button type="submit" class="btn-sm-lab" style="width:100%;">Add Category</button>
        </form>
    </div>
</div>

<script>
    function openAddModal() {
        document.getElementById('addModal').classList.add('active');
    }

    function closeAddModal() {
        document.getElementById('addModal').classList.remove('active');
    }

    function deleteCategory(id) {
        if (confirm('Are you sure you want to delete this category?')) {
            fetch('@Url.Action("DeleteCategory", "Admin")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                },
                body: 'id=' + id
            })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        alert('✅ ' + data.message);
                        location.reload();
                    } else {
                        alert('❌ Error: ' + data.message);
                    }
                });
        }
    }

    document.getElementById('addModal').addEventListener('click', function (e) {
        if (e.target === this) closeAddModal();
    });
</script>