@model List<NMB_HLabSys.Models.LookupCategory>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Manage Categories";
    ViewData["RoleSubtitle"] = "Admin Portal";
    ViewData["UserGreeting"] = "System Administrator";
    ViewData["UserInitials"] = "AD";
    var showDeleted = (bool)(ViewBag.ShowDeleted ?? false);
}

@section SidebarMenu {
    <li><a href="@Url.Action("Dashboard", "Admin")"><i class="fas fa-chart-pie"></i> <span>Dashboard</span></a></li>
    <li><a href="@Url.Action("Categories", "Admin")" class="active"><i class="fas fa-folder"></i> <span>Categories</span></a></li>
    <li><a href="@Url.Action("Conditions", "Admin")"><i class="fas fa-database"></i> <span>Conditions</span></a></li>
    <li><a href="@Url.Action("Allergies", "Admin")"><i class="fas fa-allergies"></i> <span>Allergies</span></a></li>
    <li><a href="@Url.Action("Medications", "Admin")"><i class="fas fa-capsules"></i> <span>Medications</span></a></li>
    <li><a href="@Url.Action("Profile", "Admin")"><i class="fas fa-user-circle"></i> <span>My Profile</span></a></li>
}

<style>
    :root {
        --p-teal: #0891B2;
        --p-teal-grad: linear-gradient(135deg, #0891B2 0%, #06B6D4 100%);
        --p-navy: #0F172A;
        --p-text: #1E293B;
        --p-text-soft: #64748B;
        --p-text-muted: #94A3B8;
        --p-border: #E2E8F0;
        --p-bg-soft: #F8FAFC;
        --p-danger: #DC2626;
        --shadow-sm: 0 1px 3px rgba(15, 23, 42, 0.06), 0 1px 2px rgba(15, 23, 42, 0.04);
        --shadow-md: 0 4px 12px rgba(15, 23, 42, 0.06), 0 2px 6px rgba(15, 23, 42, 0.04);
        --shadow-lg: 0 12px 32px rgba(15, 23, 42, 0.10), 0 4px 12px rgba(15, 23, 42, 0.05);
        --radius: 16px;
    }

    /* ═══ HERO ═══ */
    .page-hero {
        position: relative;
        margin: -1.2rem -1.2rem 2rem -1.2rem;
        height: 300px;
        border-radius: 0 0 24px 24px;
        overflow: hidden;
        display: flex;
        align-items: flex-end;
        padding: 2rem;
        box-shadow: var(--shadow-lg);
    }

        .page-hero::before {
            content: '';
            position: absolute;
            inset: 0;
            background-image: url('https://images.unsplash.com/photo-1516321318423-f06f85e504b3?w=1600&q=85');
            background-size: cover;
            background-position: center;
            z-index: 0;
            transition: transform 12s ease-out;
        }

        .page-hero:hover::before {
            transform: scale(1.04);
        }

        .page-hero::after {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(to bottom, rgba(15, 23, 42, 0) 0%, rgba(15, 23, 42, 0) 40%, rgba(15, 23, 42, 0.25) 70%, rgba(15, 23, 42, 0.65) 100%);
            z-index: 1;
        }

    .hero-pill {
        position: relative;
        z-index: 2;
        background: rgba(15, 23, 42, 0.55);
        backdrop-filter: blur(20px) saturate(180%);
        border: 1px solid rgba(255, 255, 255, 0.15);
        border-radius: 20px;
        padding: 1.4rem 1.8rem;
        color: white;
        max-width: 700px;
        width: 100%;
        animation: heroFadeIn 0.8s ease-out;
    }

    @@keyframes heroFadeIn {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .hero-kicker {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(6, 182, 212, 0.25);
        border: 1px solid rgba(6, 182, 212, 0.4);
        padding: 0.35rem 0.9rem;
        border-radius: 20px;
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        margin-bottom: 0.7rem;
        color: #67E8F9;
    }

    .hero-pill h1 {
        font-size: 1.7rem;
        font-weight: 800;
        letter-spacing: -0.02em;
        margin: 0 0 0.3rem;
        line-height: 1.15;
    }

    .hero-pill p {
        font-size: 0.88rem;
        color: rgba(255, 255, 255, 0.8);
        margin: 0;
        line-height: 1.5;
    }

    .hero-actions {
        margin-top: 1rem;
        display: flex;
        gap: 0.6rem;
        flex-wrap: wrap;
    }

    .hero-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.55rem 1.1rem;
        border-radius: 10px;
        font-size: 0.8rem;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.2s;
        font-family: inherit;
        cursor: pointer;
        border: none;
        white-space: nowrap;
    }

    .hero-btn-primary {
        background: var(--p-teal-grad);
        color: white;
        box-shadow: 0 4px 14px rgba(6, 182, 212, 0.4);
    }

        .hero-btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 22px rgba(6, 182, 212, 0.5);
            color: white;
        }

    .hero-btn-secondary {
        background: rgba(255, 255, 255, 0.15);
        border: 1px solid rgba(255, 255, 255, 0.25);
        color: white;
        backdrop-filter: blur(10px);
    }

        .hero-btn-secondary:hover {
            background: rgba(255, 255, 255, 0.25);
            transform: translateY(-2px);
            color: white;
        }

    /* ═══ CARDS ═══ */
    .clean-card {
        background: white;
        border-radius: var(--radius);
        border: 1px solid var(--p-border);
        box-shadow: var(--shadow-sm);
        overflow: hidden;
        margin-bottom: 1.5rem;
    }

    .clean-card-header {
        padding: 1.1rem 1.5rem;
        border-bottom: 1px solid var(--p-border);
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        flex-wrap: wrap;
    }

        .clean-card-header h3 {
            margin: 0;
            color: var(--p-navy);
            font-size: 1rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 0.55rem;
        }

            .clean-card-header h3 i {
                color: var(--p-teal);
                font-size: 0.95rem;
            }

    .clean-card-header-actions {
        display: flex;
        gap: 0.6rem;
        align-items: center;
        flex-wrap: wrap;
    }

    .clean-card-body {
        padding: 1.5rem;
    }

    /* ═══ SEARCH BAR (PROFESSIONAL) ═══ */
    .search-wrapper {
        position: relative;
        display: flex;
        align-items: center;
        width: 320px;
        max-width: 100%;
    }

        .search-wrapper .search-icon {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--p-text-muted);
            font-size: 0.85rem;
            pointer-events: none;
            transition: color 0.2s;
            z-index: 1;
        }

        .search-wrapper:focus-within .search-icon {
            color: var(--p-teal);
        }

    .search-input {
        width: 100%;
        padding: 0.65rem 2.6rem 0.65rem 2.6rem;
        border-radius: 10px;
        border: 1px solid var(--p-border);
        font-size: 0.85rem;
        font-family: inherit;
        background: var(--p-bg-soft);
        transition: all 0.2s;
        color: var(--p-text);
    }

        .search-input::placeholder {
            color: var(--p-text-muted);
            font-size: 0.83rem;
        }

        .search-input:hover {
            background: white;
            border-color: #CBD5E1;
        }

        .search-input:focus {
            outline: none;
            border-color: var(--p-teal);
            box-shadow: 0 0 0 3px rgba(6, 182, 212, 0.12);
            background: white;
        }

    .search-clear {
        position: absolute;
        right: 8px;
        top: 50%;
        transform: translateY(-50%);
        background: var(--p-bg-soft);
        border: none;
        color: var(--p-text-muted);
        cursor: pointer;
        padding: 0.3rem;
        border-radius: 6px;
        font-size: 0.7rem;
        width: 22px;
        height: 22px;
        display: none;
        align-items: center;
        justify-content: center;
        transition: 0.2s;
        z-index: 1;
    }

        .search-clear.visible {
            display: flex;
        }

        .search-clear:hover {
            background: var(--p-teal);
            color: white;
        }

    /* ═══ TOGGLE BUTTON ═══ */
    .toggle-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.6rem 1rem;
        border-radius: 10px;
        font-size: 0.78rem;
        font-weight: 600;
        border: 1px solid var(--p-border);
        background: white;
        color: var(--p-text-soft);
        cursor: pointer;
        text-decoration: none;
        transition: all 0.2s;
        font-family: inherit;
        white-space: nowrap;
    }

        .toggle-btn:hover {
            border-color: var(--p-teal);
            color: var(--p-teal);
        }

        .toggle-btn.active {
            background: var(--p-teal-grad);
            color: white;
            border-color: transparent;
            box-shadow: 0 4px 12px rgba(6, 182, 212, 0.3);
        }

            .toggle-btn.active:hover {
                color: white;
            }

    /* ═══ SECTIONS ═══ */
    .category-section {
        background: var(--p-bg-soft);
        border-radius: 14px;
        padding: 1.2rem;
        margin-bottom: 1rem;
        border: 1px solid var(--p-border);
        animation: sectionFadeIn 0.4s ease-out;
    }

    @@keyframes sectionFadeIn {
        from {
            opacity: 0;
            transform: translateY(8px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .category-section:last-child {
        margin-bottom: 0;
    }

    .category-section h4 {
        color: var(--p-navy);
        font-size: 0.9rem;
        margin: 0 0 0.8rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

        .category-section h4 i {
            color: var(--p-teal);
            font-size: 0.85rem;
        }

    .category-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: white;
        padding: 0.8rem 1rem;
        border-radius: 10px;
        margin-bottom: 0.6rem;
        border: 1px solid var(--p-border);
        transition: 0.2s;
        gap: 0.8rem;
    }

        .category-item:last-child {
            margin-bottom: 0;
        }

        .category-item:hover {
            border-color: rgba(6, 182, 212, 0.3);
            transform: translateX(3px);
            box-shadow: var(--shadow-sm);
        }

        .category-item strong {
            color: var(--p-navy);
            font-size: 0.9rem;
        }

        /* Deleted item styling */
        .category-item.deleted-item {
            background: rgba(254, 242, 242, 0.5);
            border-color: #FECACA;
            opacity: 0.75;
        }

            .category-item.deleted-item:hover {
                border-color: var(--p-danger);
                opacity: 1;
                transform: none;
            }

            .category-item.deleted-item strong {
                color: #991B1B;
                text-decoration: line-through;
            }

    .deleted-badge {
        display: inline-block;
        padding: 0.2rem 0.6rem;
        border-radius: 20px;
        background: #FEE2E2;
        color: #991B1B;
        font-size: 0.65rem;
        font-weight: 700;
        margin-left: 0.4rem;
    }

    .type-badge {
        padding: 0.22rem 0.65rem;
        border-radius: 20px;
        font-size: 0.68rem;
        font-weight: 700;
        margin-left: 0.5rem;
        letter-spacing: 0.02em;
    }

    .type-condition {
        background: #E0E7FF;
        color: #3730A3;
    }

    .type-allergy {
        background: #FEF3C7;
        color: #92400E;
    }

    .type-medication {
        background: #FCE7F3;
        color: #9D174D;
    }

    /* ═══ BUTTONS ═══ */
    .btn {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.45rem 0.9rem;
        border-radius: 8px;
        font-size: 0.75rem;
        font-weight: 600;
        border: 1px solid var(--p-border);
        background: white;
        color: var(--p-navy);
        cursor: pointer;
        text-decoration: none;
        transition: all 0.2s;
        font-family: inherit;
        white-space: nowrap;
    }

        .btn:hover {
            border-color: var(--p-teal);
            color: var(--p-teal);
            box-shadow: var(--shadow-sm);
        }

    .btn-primary {
        background: var(--p-teal-grad);
        color: white;
        border: none;
        padding: 0.6rem 1.1rem;
        font-size: 0.8rem;
        box-shadow: 0 4px 12px rgba(6, 182, 212, 0.3);
    }

        .btn-primary:hover {
            color: white;
            transform: translateY(-1px);
            box-shadow: 0 6px 18px rgba(6, 182, 212, 0.4);
        }

    .btn-danger {
        color: var(--p-danger);
        border-color: #FECACA;
    }

        .btn-danger:hover {
            background: #FEE2E2;
            border-color: var(--p-danger);
            color: var(--p-danger);
        }

    .btn-success {
        background: #059669;
        color: white;
        border-color: #059669;
    }

        .btn-success:hover {
            background: #047857;
            border-color: #047857;
            color: white;
        }

    /* ═══ ALERTS ═══ */
    .alert {
        padding: 0.85rem 1.2rem;
        border-radius: 12px;
        margin-bottom: 1.2rem;
        display: flex;
        align-items: flex-start;
        gap: 0.6rem;
        font-size: 0.85rem;
    }

    .alert-success {
        background: #DCFCE7;
        color: #166534;
        border-left: 3px solid #059669;
    }

    .alert-error {
        background: #FEE2E2;
        color: #991B1B;
        border-left: 3px solid #DC2626;
    }

    /* ═══ EMPTY STATE ═══ */
    .empty-state {
        text-align: center;
        padding: 3rem 2rem;
        color: var(--p-text-muted);
    }

        .empty-state i {
            font-size: 2.5rem;
            opacity: 0.4;
            margin-bottom: 0.8rem;
            display: block;
        }

        .empty-state h3 {
            color: var(--p-navy);
            font-size: 1rem;
            font-weight: 700;
            margin: 0 0 0.3rem;
        }

        .empty-state p {
            margin: 0;
            font-size: 0.85rem;
        }

    /* ═══ MODAL ═══ */
    .modal-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(15, 23, 42, 0.5);
        backdrop-filter: blur(4px);
        z-index: 1000;
        justify-content: center;
        align-items: center;
        padding: 1rem;
    }

        .modal-overlay.active {
            display: flex;
        }

    .modal-box {
        background: white;
        padding: 2rem;
        border-radius: 20px;
        max-width: 500px;
        width: 100%;
        max-height: 90vh;
        overflow-y: auto;
        box-shadow: var(--shadow-lg);
        animation: modalIn 0.3s ease-out;
    }

    @@keyframes modalIn {
        from {
            opacity: 0;
            transform: scale(0.95);
        }

        to {
            opacity: 1;
            transform: scale(1);
        }
    }

    .modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
    }

        .modal-header h3 {
            color: var(--p-navy);
            font-size: 1.1rem;
            margin: 0;
            font-weight: 700;
        }

    .modal-close {
        background: none;
        border: none;
        font-size: 1.3rem;
        cursor: pointer;
        color: var(--p-text-soft);
        padding: 0.3rem;
        border-radius: 8px;
    }

        .modal-close:hover {
            background: var(--p-bg-soft);
            color: var(--p-navy);
        }

    .form-group {
        margin-bottom: 1rem;
    }

        .form-group label {
            display: block;
            font-weight: 600;
            font-size: 0.8rem;
            color: var(--p-navy);
            margin-bottom: 0.4rem;
        }

        .form-group input, .form-group select, .form-group textarea {
            width: 100%;
            padding: 0.7rem 1rem;
            border-radius: 10px;
            border: 1px solid var(--p-border);
            font-size: 0.85rem;
            font-family: inherit;
            background: white;
        }

            .form-group input:focus, .form-group select:focus, .form-group textarea:focus {
                outline: none;
                border-color: var(--p-teal);
                box-shadow: 0 0 0 3px rgba(6, 182, 212, 0.12);
            }

    .btn-submit {
        width: 100%;
        background: var(--p-teal-grad);
        color: white;
        border: none;
        padding: 0.75rem;
        border-radius: 10px;
        font-weight: 600;
        cursor: pointer;
        font-family: inherit;
        font-size: 0.9rem;
        box-shadow: 0 4px 14px rgba(6, 182, 212, 0.3);
        transition: 0.2s;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.4rem;
    }

        .btn-submit:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 20px rgba(6, 182, 212, 0.4);
        }

    /* ═══ RESPONSIVE ═══ */
    @@media (max-width: 768px) {
        .page-hero {
            margin: -0.8rem -0.8rem 1.5rem -0.8rem;
            height: 240px;
            padding: 1.2rem;
        }

        .hero-pill {
            padding: 1.1rem 1.3rem;
        }

            .hero-pill h1 {
                font-size: 1.4rem;
            }

        .clean-card-body {
            padding: 1.2rem;
        }

        .clean-card-header {
            padding: 1rem 1.2rem;
        }

        .clean-card-header-actions {
            width: 100%;
        }

        .search-wrapper {
            width: 100%;
        }
    }
</style>

<!-- ═══ HERO ═══ -->
<div class="page-hero">
    <div class="hero-pill">
        <span class="hero-kicker"><i class="fas fa-folder"></i> Admin</span>
        <h1>Manage Categories</h1>
        <p>Categories are the foundation — create them first before adding conditions, allergies, or medications.</p>
        <div class="hero-actions">
            <a href="@Url.Action("Dashboard", "Admin")" class="hero-btn hero-btn-secondary"><i class="fas fa-arrow-left"></i> Back to Dashboard</a>
            <button class="hero-btn hero-btn-primary" onclick="openAddModal()"><i class="fas fa-plus"></i> Add Category</button>
        </div>
    </div>
</div>

<!-- ═══ ALERTS ═══ -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success"><i class="fas fa-check-circle" style="margin-top:2px;"></i><span>@TempData["SuccessMessage"]</span></div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-error"><i class="fas fa-exclamation-circle" style="margin-top:2px;"></i><span>@TempData["ErrorMessage"]</span></div>
}

<!-- ═══ MAIN CARD ═══ -->
<div class="clean-card">
    <div class="clean-card-header">
        <h3><i class="fas fa-folder"></i> All Categories</h3>
        <div class="clean-card-header-actions">
            <div class="search-wrapper">
                <i class="fas fa-search search-icon"></i>
                <input type="text" id="searchInput" class="search-input" placeholder="Search categories..." oninput="searchCategories()" />
                <button type="button" class="search-clear" id="searchClear" onclick="clearSearch()" title="Clear search">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <a href="@Url.Action("Categories", "Admin", new { showDeleted = !showDeleted })" class="toggle-btn @(showDeleted ? "active" : "")">
                <i class="fas fa-@(showDeleted ? "eye-slash" : "eye")"></i> @(showDeleted ? "Hide Deleted" : "Show Deleted")
            </a>
            <button class="btn btn-primary" onclick="openAddModal()"><i class="fas fa-plus"></i> Add Category</button>
        </div>
    </div>
    <div class="clean-card-body" id="categoryContainer">
        @if (Model != null && Model.Any())
        {
            var conditionCategories = Model.Where(c => c.CategoryType == "Condition").ToList();
            var allergyCategories = Model.Where(c => c.CategoryType == "Allergy").ToList();
            var medicationCategories = Model.Where(c => c.CategoryType == "Medication").ToList();

            @if (conditionCategories.Any())
            {
                <div class="category-section" data-section="condition">
                    <h4><i class="fas fa-database"></i> Condition Categories</h4>
                    @foreach (var cat in conditionCategories)
                    {
                        <div class="category-item @(!cat.IsActive ? "deleted-item" : "")" data-name="@cat.CategoryName.ToLower()">
                            <span>
                                <strong>@cat.CategoryName</strong>
                                <span class="type-badge type-condition">Condition</span>
                                @if (!cat.IsActive)
                                {
                                    <span class="deleted-badge">Deleted</span>
                                }
                            </span>
                            <div style="display: flex; gap: 0.4rem;">
                                @if (cat.IsActive)
                                {
                                    <a href="@Url.Action("EditCategory", "Admin", new { id = cat.CategoryID })" class="btn"><i class="fas fa-edit"></i> Edit</a>
                                    <button class="btn btn-danger" onclick="deleteCategory(@cat.CategoryID)"><i class="fas fa-trash"></i> Delete</button>
                                }
                                else
                                {
                                    <button class="btn btn-success" onclick="reactivateCategory(@cat.CategoryID)"><i class="fas fa-undo"></i> Reactivate</button>
                                }
                            </div>
                        </div>
                    }
                </div>
            }

            @if (allergyCategories.Any())
            {
                <div class="category-section" data-section="allergy">
                    <h4><i class="fas fa-allergies"></i> Allergy Categories</h4>
                    @foreach (var cat in allergyCategories)
                    {
                        <div class="category-item @(!cat.IsActive ? "deleted-item" : "")" data-name="@cat.CategoryName.ToLower()">
                            <span>
                                <strong>@cat.CategoryName</strong>
                                <span class="type-badge type-allergy">Allergy</span>
                                @if (!cat.IsActive)
                                {
                                    <span class="deleted-badge">Deleted</span>
                                }
                            </span>
                            <div style="display: flex; gap: 0.4rem;">
                                @if (cat.IsActive)
                                {
                                    <a href="@Url.Action("EditCategory", "Admin", new { id = cat.CategoryID })" class="btn"><i class="fas fa-edit"></i> Edit</a>
                                    <button class="btn btn-danger" onclick="deleteCategory(@cat.CategoryID)"><i class="fas fa-trash"></i> Delete</button>
                                }
                                else
                                {
                                    <button class="btn btn-success" onclick="reactivateCategory(@cat.CategoryID)"><i class="fas fa-undo"></i> Reactivate</button>
                                }
                            </div>
                        </div>
                    }
                </div>
            }

            @if (medicationCategories.Any())
            {
                <div class="category-section" data-section="medication">
                    <h4><i class="fas fa-capsules"></i> Medication Categories</h4>
                    @foreach (var cat in medicationCategories)
                    {
                        <div class="category-item @(!cat.IsActive ? "deleted-item" : "")" data-name="@cat.CategoryName.ToLower()">
                            <span>
                                <strong>@cat.CategoryName</strong>
                                <span class="type-badge type-medication">Medication</span>
                                @if (!cat.IsActive)
                                {
                                    <span class="deleted-badge">Deleted</span>
                                }
                            </span>
                            <div style="display: flex; gap: 0.4rem;">
                                @if (cat.IsActive)
                                {
                                    <a href="@Url.Action("EditCategory", "Admin", new { id = cat.CategoryID })" class="btn"><i class="fas fa-edit"></i> Edit</a>
                                    <button class="btn btn-danger" onclick="deleteCategory(@cat.CategoryID)"><i class="fas fa-trash"></i> Delete</button>
                                }
                                else
                                {
                                    <button class="btn btn-success" onclick="reactivateCategory(@cat.CategoryID)"><i class="fas fa-undo"></i> Reactivate</button>
                                }
                            </div>
                        </div>
                    }
                </div>
            }

            <!-- Empty search result message (hidden by default) -->
            <div class="empty-state" id="noResultsState" style="display: none;">
                <i class="fas fa-search"></i>
                <h3>No matching categories</h3>
                <p>Try a different search term or <button type="button" onclick="clearSearch()" style="background: none; border: none; color: var(--p-teal); cursor: pointer; text-decoration: underline; font-weight: 600; font-size: inherit; padding: 0;">clear the search</button></p>
            </div>
        }
        else
        {
            <div class="empty-state">
                <i class="fas fa-folder-open"></i>
                <h3>No categories found</h3>
                <p>Click "Add Category" to create your first one.</p>
            </div>
        }
    </div>
</div>

<!-- ═══ ADD MODAL ═══ -->
<div id="addModal" class="modal-overlay">
    <div class="modal-box">
        <div class="modal-header">
            <h3><i class="fas fa-plus-circle"></i> Add Category</h3>
            <button class="modal-close" onclick="closeAddModal()">&times;</button>
        </div>
        <form method="post" action="@Url.Action("AddCategory", "Admin")">
            @Html.AntiForgeryToken()
            <div class="form-group"><label>Category Name</label><input type="text" name="categoryName" required /></div>
            <div class="form-group">
                <label>Category Type</label>
                <select name="categoryType" required>
                    <option value="">-- Select Type --</option>
                    <option value="Condition">Condition</option>
                    <option value="Allergy">Allergy</option>
                    <option value="Medication">Medication</option>
                </select>
            </div>
            <div class="form-group"><label>Description</label><textarea name="description" rows="3"></textarea></div>
            <button type="submit" class="btn-submit"><i class="fas fa-save"></i> Add Category</button>
        </form>
    </div>
</div>

<script>
    function openAddModal() { document.getElementById('addModal').classList.add('active'); }
    function closeAddModal() { document.getElementById('addModal').classList.remove('active'); }

    // ═══ SEARCH FUNCTIONALITY ═══
    function searchCategories() {
        var input = document.getElementById('searchInput');
        var clearBtn = document.getElementById('searchClear');
        var searchText = input.value.toLowerCase().trim();

        // Show/hide clear button
        if (searchText.length > 0) {
            clearBtn.classList.add('visible');
        } else {
            clearBtn.classList.remove('visible');
        }

        var totalVisible = 0;

        // Filter items within each section
        document.querySelectorAll('.category-section').forEach(function (section) {
            var visibleInSection = 0;

            section.querySelectorAll('.category-item').forEach(function (item) {
                var name = item.getAttribute('data-name') || '';
                if (name.includes(searchText)) {
                    item.style.display = 'flex';
                    visibleInSection++;
                    totalVisible++;
                } else {
                    item.style.display = 'none';
                }
            });

            // Hide whole section if no visible items
            if (visibleInSection === 0) {
                section.style.display = 'none';
            } else {
                section.style.display = 'block';
            }
        });

        // Show/hide "no results" message
        var noResults = document.getElementById('noResultsState');
        if (noResults) {
            noResults.style.display = (totalVisible === 0 && searchText.length > 0) ? 'block' : 'none';
        }
    }

    function clearSearch() {
        document.getElementById('searchInput').value = '';
        document.getElementById('searchClear').classList.remove('visible');

        // Show all sections and items again
        document.querySelectorAll('.category-section').forEach(function (section) {
            section.style.display = 'block';
            section.querySelectorAll('.category-item').forEach(function (item) {
                item.style.display = 'flex';
            });
        });

        var noResults = document.getElementById('noResultsState');
        if (noResults) noResults.style.display = 'none';

        document.getElementById('searchInput').focus();
    }

    // ═══ DELETE / REACTIVATE ═══
    function deleteCategory(id) {
        if (confirm('Delete this category? It will be soft-deleted and can be reactivated later.')) {
            fetch('@Url.Action("DeleteCategory", "Admin")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: 'id=' + id
            })
            .then(r => r.json())
            .then(data => {
                if (data.success) { alert(data.message); location.reload(); }
                else { alert('Error: ' + data.message); }
            });
        }
    }

    function reactivateCategory(id) {
        if (confirm('Reactivate this category? It will become active again.')) {
            fetch('@Url.Action("ReactivateCategory", "Admin")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: 'id=' + id
            })
            .then(r => r.json())
            .then(data => {
                if (data.success) { alert(data.message); location.reload(); }
                else { alert('Error: ' + data.message); }
            });
        }
    }

    // ═══ ESC KEY CLEARS SEARCH ═══
    document.getElementById('searchInput').addEventListener('keydown', function (e) {
        if (e.key === 'Escape') {
            clearSearch();
        }
    });

    // ═══ MODAL OUTSIDE CLICK ═══
    document.getElementById('addModal').addEventListener('click', function (e) {
        if (e.target === this) closeAddModal();
    });
</script>