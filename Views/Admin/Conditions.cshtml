@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Medical Conditions";
    ViewData["RoleSubtitle"] = "Admin Portal";
    ViewData["UserGreeting"] = "⚙️ System Administrator";
    ViewData["UserInitials"] = "AD";
}

@section SidebarMenu {
    <li><a href="@Url.Action("Dashboard", "Admin")">📋 Dashboard</a></li>
    <li><a href="@Url.Action("Conditions", "Admin")" class="active">🩺 Medical Conditions</a></li>
    <li><a href="@Url.Action("Allergies", "Admin")">⚠️ Allergies</a></li>
    <li><a href="@Url.Action("Medications", "Admin")">💊 Medications</a></li>
    <li>
        <a href="@Url.Action("Index", "Profile")">
            <i class="fas fa-user-circle"></i>
            <span>My Profile</span>
        </a>
    </li>
}

<div class="card-modern">

    <div class="card-header-flex">
        <h3>🩺 Medical Conditions by Category</h3>

        <button class="btn-sm-lab"
                onclick="showDemoAlert('Add new condition category')">
            + Add Category
        </button>
    </div>

    <div class="grid-2col">

        <!-- Haematological -->
        <div class="card-modern" style="background:#F8FAFE;">

            <h4>🔴 Haematological Conditions</h4>

            <ul class="sortable-list" style="margin-top:0.5rem;">
                <li>Anaemia</li>
                <li>Leukaemia</li>
                <li>Lymphoma</li>
                <li>Haemophilia</li>
                <li>Thrombocytopenia</li>
            </ul>

        </div>

        <!-- Metabolic -->
        <div class="card-modern" style="background:#F8FAFE;">

            <h4>💚 Metabolic & Endocrine</h4>

            <ul class="sortable-list" style="margin-top:0.5rem;">
                <li>Diabetes Type 1</li>
                <li>Diabetes Type 2</li>
                <li>Hypertension</li>
                <li>Hyperlipidaemia</li>
            </ul>

        </div>

    </div>

    <div class="grid-2col" style="margin-top:1rem;">

        <!-- Autoimmune -->
        <div class="card-modern" style="background:#F8FAFE;">

            <h4>🧬 Autoimmune & Inflammatory</h4>

            <ul class="sortable-list" style="margin-top:0.5rem;">
                <li>Rheumatoid Arthritis</li>
                <li>Lupus (SLE)</li>
                <li>Crohn's Disease</li>
            </ul>

        </div>

        <!-- Neurological -->
        <div class="card-modern" style="background:#F8FAFE;">

            <h4>🧠 Neurological</h4>

            <ul class="sortable-list" style="margin-top:0.5rem;">
                <li>Epilepsy</li>
                <li>Migraine</li>
                <li>Parkinson's Disease</li>
            </ul>

        </div>

    </div>

</div>

<script>

    document.addEventListener("DOMContentLoaded", function () {

        const lists = document.querySelectorAll(".sortable-list");

        lists.forEach(function (list) {

            let items = Array.from(list.querySelectorAll("li"));

            items.sort(function (a, b) {
                return a.textContent.trim().localeCompare(b.textContent.trim());
            });

            list.innerHTML = "";

            items.forEach(function (item) {

                let itemName = item.textContent.trim();

                let li = document.createElement("li");

                li.style.marginBottom = "0.5rem";

                li.innerHTML = `
                        <span>${itemName}</span>

                        <button class="btn-outline-lab"
                                style="margin-left:0.5rem;"
                                onclick="showDemoAlert('Edit ${itemName}')">
                            Edit
                        </button>

                        <button class="btn-outline-lab"
                                style="margin-left:0.5rem; color:red; border-color:red;"
                                onclick="removeItem(this)">
                            Remove
                        </button>
                    `;

                list.appendChild(li);

            });

        });

    });

    function removeItem(button) {

        let itemName = button.parentElement.querySelector("span").textContent;

        if (confirm("Are you sure you want to remove " + itemName + "?")) {

            button.parentElement.remove();

            alert(itemName + " has been removed.");

        }

    }

    function showDemoAlert(msg) {

        alert('🔔 ' + msg);

    }

</script>