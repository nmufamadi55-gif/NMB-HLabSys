@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Admin Dashboard";
    ViewData["RoleSubtitle"] = "Admin Portal";
    ViewData["UserGreeting"] = "⚙️ System Administrator";
    ViewData["UserInitials"] = "AD";
}

@section SidebarMenu {
    <li><a href="@Url.Action("Dashboard", "Admin")" class="active">📋 Dashboard</a></li>
    <li><a href="@Url.Action("Conditions", "Admin")">🩺 Medical Conditions</a></li>
    <li><a href="@Url.Action("Allergies", "Admin")">⚠️ Allergies</a></li>
    <li><a href="@Url.Action("Medications", "Admin")">💊 Medications</a></li>
    <li><a href="@Url.Action("Index", "Profile")"><i class="fas fa-user-circle"></i> <span>My Profile</span></a></li>
}

<style>
    .dashboard-card {
        transition: 0.25s;
    }

        .dashboard-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.08);
        }

    .quick-action-list {
        list-style: none;
        padding-left: 0;
        margin-top: 1rem;
    }

        .quick-action-list li {
            margin-bottom: 10px;
        }

        .quick-action-list a {
            display: block;
            background: #F8FAFE;
            padding: 12px;
            border-radius: 14px;
            text-decoration: none;
            color: #1F2937;
            font-weight: 600;
            transition: 0.2s;
        }

            .quick-action-list a:hover {
                background: #EAF2FF;
                transform: translateX(4px);
            }

    .chart-box {
        background: #F8FAFE;
        border-radius: 20px;
        padding: 20px;
        height: 300px;
        margin-top: 1rem;
    }

    .audit-badge {
        padding: 5px 12px;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 600;
    }

    .badge-added {
        background: #DCFCE7;
        color: #166534;
    }

    .badge-modified {
        background: #FEF3C7;
        color: #92400E;
    }

    .overview-item {
        background: #F8FAFE;
        padding: 12px;
        border-radius: 14px;
        margin-bottom: 10px;
        font-weight: 600;
    }
</style>

<div class="stat-cards">
    <div class="stat-item dashboard-card">
        <div class="stat-icon-lg">🩺</div>
        <div>
            <h3>24</h3>
            <p>Conditions</p>
        </div>
    </div>

    <div class="stat-item dashboard-card">
        <div class="stat-icon-lg">⚠️</div>
        <div>
            <h3>12</h3>
            <p>Allergies</p>
        </div>
    </div>

    <div class="stat-item dashboard-card">
        <div class="stat-icon-lg">💊</div>
        <div>
            <h3>38</h3>
            <p>Medications</p>
        </div>
    </div>
</div>

<div class="grid-2col">
    <div class="card-modern dashboard-card">
        <h3>📋 Quick Actions</h3>

        <ul class="quick-action-list">
            <li><a href="@Url.Action("Conditions", "Admin")">➕ Add / Manage Medical Conditions</a></li>
            <li><a href="@Url.Action("Allergies", "Admin")">⚠️ Add / Manage Allergies</a></li>
            <li><a href="@Url.Action("Medications", "Admin")">💊 Add / Manage Medications</a></li>
            <li><a href="#" onclick="showDemoAlert('Category management opened successfully')">📁 Manage Categories</a></li>
        </ul>
    </div>

    <div class="card-modern dashboard-card">
        <h3>📊 System Overview</h3>

        <div class="overview-item">👥 Active Users: 45</div>
        <div class="overview-item">👨‍⚕️ Doctors Registered: 12</div>
        <div class="overview-item">🔬 Lab Technicians: 8</div>
        <div class="overview-item">🩺 Patients: 124</div>
    </div>
</div>

<div class="grid-2col">
    <div class="card-modern dashboard-card">
        <h3>📈 Reference Data Overview</h3>

        <div class="chart-box">
            <canvas id="referenceChart"></canvas>
        </div>
    </div>

    <div class="card-modern dashboard-card">
        <h3>👥 User Distribution</h3>

        <div class="chart-box">
            <canvas id="userChart"></canvas>
        </div>
    </div>
</div>

<div class="card-modern">
    <div class="card-header-flex">
        <h3>🔄 Recent Lookup Table Changes</h3>

        <button class="btn-outline-lab" onclick="showDemoAlert('Audit log opened successfully')">
            Audit Log
        </button>
    </div>

    <div class="table-container">
        <table>
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Type</th>
                    <th>Item</th>
                    <th>Action</th>
                    <th>User</th>
                </tr>
            </thead>

            <tbody>
                <tr>
                    <td>2025-04-08</td>
                    <td>Condition</td>
                    <td>Haemochromatosis</td>
                    <td><span class="audit-badge badge-added">Added</span></td>
                    <td>Admin</td>
                </tr>

                <tr>
                    <td>2025-04-07</td>
                    <td>Allergy</td>
                    <td>Latex</td>
                    <td><span class="audit-badge badge-modified">Modified</span></td>
                    <td>Admin</td>
                </tr>

                <tr>
                    <td>2025-04-05</td>
                    <td>Medication</td>
                    <td>Apixaban</td>
                    <td><span class="audit-badge badge-added">Added</span></td>
                    <td>Admin</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    new Chart(document.getElementById('referenceChart'), {
        type: 'bar',
        data: {
            labels: ['Conditions', 'Allergies', 'Medications'],
            datasets: [{
                label: 'Total Records',
                data: [24, 12, 38],
                backgroundColor: ['#8B5CF6', '#F97316', '#EC4899'],
                borderRadius: 8
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false
        }
    });

    new Chart(document.getElementById('userChart'), {
        type: 'doughnut',
        data: {
            labels: ['Patients', 'Doctors', 'Technicians', 'Admins'],
            datasets: [{
                data: [124, 12, 8, 3],
                backgroundColor: ['#06B6D4', '#4F46E5', '#10B981', '#F59E0B']
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false
        }
    });

    function showDemoAlert(msg) {
        alert('✅ ' + msg);
    }
</script>