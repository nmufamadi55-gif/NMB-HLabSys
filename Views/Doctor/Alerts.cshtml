@model NMB_HLabSys.Models.ViewModels.AlertsIndexViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Alerts";
    ViewData["RoleSubtitle"] = "Doctor Portal";
    ViewData["UserGreeting"] = "Abnormal results requiring attention";
    ViewData["UserInitials"] = "SJ";
    ViewData["UserName"] = "Sarah Johnson";
}

@section SidebarMenu {
    <li><a href="@Url.Action("Dashboard", "Doctor")"><i class="fas fa-chart-pie"></i> <span>Dashboard</span></a></li>
    <li><a href="@Url.Action("TestRequests", "Doctor")"><i class="fas fa-notes-medical"></i> <span>Test Requests</span></a></li>
    <li><a href="@Url.Action("Patients", "Doctor")"><i class="fas fa-users"></i> <span>My Patients</span></a></li>
    <li><a href="@Url.Action("Alerts", "Doctor")" class="active"><i class="fas fa-bell"></i> <span>Alerts</span></a></li>
    <li><a href="@Url.Action("Results", "Doctor")"><i class="fas fa-chart-line"></i> <span>Results</span></a></li>
    <li><a href="@Url.Action("Reports", "Doctor")"><i class="fas fa-file-alt"></i> <span>Reports</span></a></li>
    <li><a href="@Url.Action("Index", "Profile")"><i class="fas fa-user-circle"></i> <span>My Profile</span></a></li>
}

@section Styles {
    <style>
        .stats-row {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 1rem;
            margin-bottom: 1.2rem;
        }

        .stat-box {
            background: white;
            border-radius: 16px;
            padding: 1rem 1.2rem;
            border: 1px solid #E2E8F0;
            display: flex;
            align-items: center;
            gap: 0.9rem;
            transition: all 0.2s;
        }

            .stat-box:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 24px rgba(220,38,38,0.06);
            }

        .stat-icon {
            width: 42px;
            height: 42px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 1.05rem;
            flex-shrink: 0;
        }

            .stat-icon.red {
                background: linear-gradient(135deg, #DC2626, #EF4444);
            }

            .stat-icon.amber {
                background: linear-gradient(135deg, #F59E0B, #D97706);
            }

            .stat-icon.blue {
                background: linear-gradient(135deg, #0841C9, #1D97F1);
            }

        .stat-text h3 {
            font-size: 1.4rem;
            color: #032C7D;
            margin: 0;
            font-weight: 700;
            letter-spacing: -0.02em;
        }

        .stat-text p {
            margin: 0;
            font-size: 0.7rem;
            color: #5A6E7A;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            font-weight: 600;
        }

        .panel {
            background: white;
            border-radius: 20px;
            padding: 1.5rem;
            margin-bottom: 1.2rem;
            border: 1px solid #E2E8F0;
        }

        .filter-bar {
            display: flex;
            gap: 0.6rem;
            flex-wrap: wrap;
            align-items: center;
        }

        .filter-input, .filter-select {
            padding: 0.6rem 1rem;
            border-radius: 30px;
            border: 1px solid #E2E8F0;
            font-size: 0.85rem;
            font-family: inherit;
        }

        .filter-input {
            flex: 1;
            min-width: 200px;
        }

            .filter-input:focus, .filter-select:focus {
                outline: none;
                border-color: #0841C9;
                box-shadow: 0 0 0 3px rgba(8,65,201,0.1);
            }

        .btn {
            padding: 0.6rem 1.3rem;
            border-radius: 30px;
            font-size: 0.82rem;
            font-weight: 600;
            cursor: pointer;
            border: none;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            transition: all 0.2s;
            font-family: inherit;
            white-space: nowrap;
        }

        .btn-primary {
            background: #0841C9;
            color: white;
        }

            .btn-primary:hover {
                background: #032C7D;
                color: white;
            }

        .btn-outline {
            background: transparent;
            border: 1px solid #E2E8F0;
            color: #1A2C3A;
        }

            .btn-outline:hover {
                background: #F1F5F9;
                color: #1A2C3A;
            }

        .btn-sm {
            padding: 0.35rem 0.8rem;
            font-size: 0.72rem;
        }

        /* ─── TOAST ─── */
        #toastContainer {
            position: fixed;
            top: 1.5rem;
            right: 1.5rem;
            z-index: 9999;
            display: flex;
            flex-direction: column;
            gap: 0.6rem;
            max-width: 380px;
            width: 100%;
            pointer-events: none;
        }

        .toast {
            background: white;
            border-radius: 12px;
            padding: 1rem 1.1rem;
            box-shadow: 0 12px 40px rgba(0, 0, 0, 0.15);
            display: flex;
            align-items: flex-start;
            gap: 0.8rem;
            border-left: 4px solid #10B981;
            pointer-events: auto;
            animation: toastSlideIn 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94);
            transition: opacity 0.3s, transform 0.3s;
        }

        keyframes toastSlideIn {
            from

        {
            opacity: 0;
            transform: translateX(40px);
        }

        to {
            opacity: 1;
            transform: translateX(0);
        }

        }

        .toast-icon {
            font-size: 1.3rem;
            color: #10B981;
            flex-shrink: 0;
            margin-top: 0.1rem;
        }

        .toast-content {
            flex: 1;
            display: flex;
            flex-direction: column;
            gap: 0.15rem;
        }

            .toast-content strong {
                font-size: 0.88rem;
                color: #032C7D;
                font-weight: 700;
            }

            .toast-content span {
                font-size: 0.78rem;
                color: #5A6E7A;
                line-height: 1.4;
            }

        .toast-close {
            background: none;
            border: none;
            font-size: 1.1rem;
            color: #94A3B8;
            cursor: pointer;
            line-height: 1;
            padding: 0 0.2rem;
            flex-shrink: 0;
        }

            .toast-close:hover {
                color: #1A2C3A;
            }

        media (max-width: 480px) {
            #toastContainer

        {
            top: 1rem;
            right: 1rem;
            left: 1rem;
            max-width: none;
        }

        }

        /* ─── ALERT CARD ─── */
        .alert-card {
            background: white;
            border-radius: 16px;
            border: 1px solid #FECACA;
            border-left: 5px solid #DC2626;
            margin-bottom: 1rem;
            overflow: hidden;
            transition: all 0.2s;
        }

            .alert-card.urgent {
                border-left-color: #F59E0B;
                border-color: #FDE68A;
            }

            .alert-card:hover {
                box-shadow: 0 8px 24px rgba(220,38,38,0.1);
                transform: translateY(-1px);
            }

        .alert-header {
            padding: 1rem 1.3rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            cursor: pointer;
            gap: 1rem;
            flex-wrap: wrap;
            user-select: none;
            background: #FEF2F2;
        }

        .alert-card.urgent .alert-header {
            background: #FFFBEB;
        }

        .alert-header:hover {
            filter: brightness(0.98);
        }

        .alert-header h4 {
            color: #7F1D1D;
            font-size: 0.95rem;
            margin: 0;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 0.6rem;
            flex-wrap: wrap;
        }

        .alert-card.urgent .alert-header h4 {
            color: #78350F;
        }

        .alert-header .meta {
            font-size: 0.75rem;
            color: #5A6E7A;
            margin-top: 0.2rem;
        }

        .alert-header .badges {
            display: flex;
            gap: 0.4rem;
            align-items: center;
        }

        .arrow {
            transition: transform 0.25s;
            color: #5A6E7A;
            font-size: 0.8rem;
        }

        .alert-card.open .arrow {
            transform: rotate(180deg);
        }

        .alert-body {
            display: none;
            padding: 0.5rem 1.3rem 1rem;
        }

        .alert-card.open .alert-body {
            display: block;
        }

        .badge {
            display: inline-block;
            padding: 0.2rem 0.65rem;
            border-radius: 30px;
            font-size: 0.65rem;
            font-weight: 700;
            letter-spacing: 0.04em;
            text-transform: uppercase;
        }

        .badge-critical {
            background: #DC2626;
            color: white;
        }

        .badge-elevated {
            background: #F59E0B;
            color: white;
        }

        .badge-abnormal {
            background: #FEE2E2;
            color: #991B1B;
        }

        .badge-stat {
            background: #DC2626;
            color: white;
        }

        .badge-urgent {
            background: #F59E0B;
            color: white;
        }

        .badge-routine {
            background: #F1F5F9;
            color: #5A6E7A;
        }

        .abnormal-item {
            background: #FEF2F2;
            border-radius: 12px;
            padding: 0.9rem 1rem;
            margin-top: 0.6rem;
            border-left: 4px solid #DC2626;
        }

            .abnormal-item.elevated {
                background: #FFFBEB;
                border-left-color: #F59E0B;
            }

        .abnormal-row-1 {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            gap: 1rem;
            flex-wrap: wrap;
        }

        .abnormal-test-name {
            font-weight: 700;
            color: #7F1D1D;
            font-size: 0.95rem;
        }

        .abnormal-item.elevated .abnormal-test-name {
            color: #78350F;
        }

        .abnormal-result {
            font-family: 'Courier New', monospace;
            font-size: 1.2rem;
            font-weight: 800;
            color: #DC2626;
            letter-spacing: -0.02em;
        }

        .abnormal-item.elevated .abnormal-result {
            color: #D97706;
        }

        .abnormal-range {
            font-size: 0.72rem;
            color: #5A6E7A;
        }

        .abnormal-sig {
            margin-top: 0.5rem;
            font-size: 0.78rem;
            color: #1A2C3A;
            font-style: italic;
        }

        .abnormal-actions {
            margin-top: 0.6rem;
            display: flex;
            gap: 0.5rem;
        }

        .alert {
            padding: 0.8rem 1rem;
            border-radius: 10px;
            margin-bottom: 1rem;
            font-size: 0.85rem;
        }

        .alert-success {
            background: #D1FAE5;
            color: #065F46;
            border-left: 4px solid #10B981;
        }

        .alert-danger {
            background: #FEE2E2;
            color: #991B1B;
            border-left: 4px solid #DC2626;
        }

        .empty-state {
            text-align: center;
            padding: 3rem 1rem;
            color: #94A3B8;
        }

            .empty-state i {
                font-size: 3rem;
                color: #86EFAC;
                margin-bottom: 0.8rem;
                display: block;
            }

            .empty-state h3 {
                color: #5A6E7A;
                font-size: 1.1rem;
                margin: 0 0 0.3rem;
            }

            .empty-state p {
                font-size: 0.85rem;
                margin: 0;
            }

        @@media (max-width: 900px) {
            .stats-row {
                grid-template-columns: 1fr;
            }
        }
    </style>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<!-- ─── STATS ─── -->
<div class="stats-row">
    <div class="stat-box">
        <div class="stat-icon red"><i class="fas fa-exclamation-circle"></i></div>
        <div class="stat-text">
            <h3>@Model.Statistics.CriticalCount</h3>
            <p>Critical (STAT)</p>
        </div>
    </div>
    <div class="stat-box">
        <div class="stat-icon amber"><i class="fas fa-exclamation-triangle"></i></div>
        <div class="stat-text">
            <h3>@Model.Statistics.UrgentCount</h3>
            <p>Urgent</p>
        </div>
    </div>
    <div class="stat-box">
        <div class="stat-icon blue"><i class="fas fa-bell"></i></div>
        <div class="stat-text">
            <h3>@Model.Statistics.TotalAlerts</h3>
            <p>Total Alerts</p>
        </div>
    </div>
</div>

<!-- ─── FILTERS ─── -->
<div class="panel">
    <form method="get" asp-action="Alerts" class="filter-bar">
        <input type="text" name="SearchTerm" class="filter-input"
               placeholder="Search by patient or request #"
               value="@Model.Filter.SearchTerm" />

        <select name="Urgency" class="filter-select">
            <option value="all">All Urgency</option>
            <option value="stat" selected="@(Model.Filter.Urgency == "stat")">STAT</option>
            <option value="urgent" selected="@(Model.Filter.Urgency == "urgent")">Urgent</option>
            <option value="routine" selected="@(Model.Filter.Urgency == "routine")">Routine</option>
        </select>

        <input type="date" name="StartDate" class="filter-select"
               value="@(Model.Filter.StartDate?.ToString("yyyy-MM-dd"))" />

        <input type="date" name="EndDate" class="filter-select"
               value="@(Model.Filter.EndDate?.ToString("yyyy-MM-dd"))" />

        <button type="submit" class="btn btn-primary">
            <i class="fas fa-filter"></i> Apply
        </button>
        <a asp-action="Alerts" class="btn btn-outline">
            <i class="fas fa-times"></i> Reset
        </a>
    </form>
</div>

<!-- ─── ALERTS ─── -->
@if (Model.Alerts == null || !Model.Alerts.Any())
{
    <div class="panel">
        <div class="empty-state">
            <i class="fas fa-check-circle"></i>
            <h3>No alerts</h3>
            <p>No abnormal results in this date range. Great news!</p>
        </div>
    </div>
}
else
{
    foreach (var alert in Model.Alerts)
    {
        var isUrgent = alert.Urgency == "urgent";
        var urgencyClass = isUrgent ? "urgent" : "";

        <div class="alert-card @urgencyClass open">
            <div class="alert-header" onclick="toggleAlert(this)">
                <div>
                    <h4>
                        <i class="fas fa-exclamation-triangle" style="color:@(isUrgent ? "#D97706" : "#DC2626");"></i>
                        @alert.RequestNumber — @alert.PatientName
                    </h4>
                    <div class="meta">
                        <i class="fas fa-calendar"></i> @alert.AlertDate.ToString("yyyy-MM-dd HH:mm")
                        &nbsp;·&nbsp;
                        <span class="badge badge-@alert.Urgency">@alert.Urgency.ToUpper()</span>
                    </div>
                </div>
                <div class="badges">
                    <span class="badge badge-abnormal">@alert.AbnormalTests.Count Abnormal</span>
                    <i class="fas fa-chevron-down arrow"></i>
                </div>
            </div>
            <div class="alert-body">
                @foreach (var test in alert.AbnormalTests)
                {
                    var itemClass = test.Severity == "Elevated" ? "elevated" : "";

                    <div class="abnormal-item @itemClass">
                        <div class="abnormal-row-1">
                            <div>
                                <div class="abnormal-test-name">@test.TestName</div>
                                <div class="abnormal-range">Normal: @test.NormalRange</div>
                            </div>
                            <div style="text-align:right;">
                                <div class="abnormal-result">@test.Result</div>
                                <span class="badge badge-@test.Severity.ToLower()">@test.Severity</span>
                            </div>
                        </div>
                        <div class="abnormal-sig">@test.ClinicalSignificance</div>
                        <div class="abnormal-actions">
                            <a asp-action="TestRequestDetails" asp-route-id="@alert.RequestID"
                               class="btn btn-outline btn-sm">
                                <i class="fas fa-notes-medical"></i> View Request
                            </a>
                            <button type="button" class="btn btn-primary btn-sm"
                                    onclick="acknowledge(@alert.RequestID, event)">
                                <i class="fas fa-check"></i> Acknowledge
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
}

@section Scripts {
    <script>
        function toggleAlert(header) {
            header.closest('.alert-card').classList.toggle('open');
        }

        function acknowledge(requestId, event) {
            event.stopPropagation();

            var card = event.target.closest('.alert-card');

            // Fire the (no-op) server call just to keep the endpoint alive
            fetch('@Url.Action("AcknowledgeAlert", "Doctor")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: 'id=' + requestId
            }).catch(function () { /* ignore errors for the toast-only flow */ });

            // Fade out the card
            card.style.transition = 'opacity 0.3s, transform 0.3s';
            card.style.opacity = '0';
            card.style.transform = 'translateX(20px)';

            setTimeout(function () {
                card.remove();

                // If no cards left, show the empty state
                if (document.querySelectorAll('.alert-card').length === 0) {
                    showEmptyState();
                }
            }, 300);

            // Toast
            showToast('Alert acknowledged', 'Request #' + requestId + ' has been marked as reviewed.');
        }

        // ─── TOAST SYSTEM ───
        function showToast(title, message) {
            var container = document.getElementById('toastContainer');
            if (!container) return;

            var toast = document.createElement('div');
            toast.className = 'toast';
            toast.innerHTML =
                '<div class="toast-icon"><i class="fas fa-check-circle"></i></div>' +
                '<div class="toast-content">' +
                    '<strong>' + title + '</strong>' +
                    '<span>' + message + '</span>' +
                '</div>' +
                '<button type="button" class="toast-close" onclick="this.parentElement.remove()">&times;</button>';

            container.appendChild(toast);

            // Auto-dismiss after 4 seconds
            setTimeout(function () {
                if (toast.parentNode) {
                    toast.style.opacity = '0';
                    toast.style.transform = 'translateX(40px)';
                    setTimeout(function () {
                        if (toast.parentNode) toast.remove();
                    }, 300);
                }
            }, 4000);
        }

        function showEmptyState() {
            var main = document.querySelector('.main-panel') || document.body;
            // Find the panel containing alerts (the one after the filters)
            var lastPanel = document.querySelectorAll('.panel');
            if (lastPanel.length > 0) {
                // Remove all alert cards (already done above) and show empty state
                var container = lastPanel[lastPanel.length - 1];

                // If there's already an empty state, don't add another
                if (container.querySelector('.empty-state')) return;

                // Remove any remaining alert card wrappers
                container.querySelectorAll('.alert-card').forEach(function (c) { c.remove(); });

                // Prepend empty state
                var empty = document.createElement('div');
                empty.className = 'empty-state';
                empty.innerHTML =
                    '<i class="fas fa-check-circle"></i>' +
                    '<h3>No alerts</h3>' +
                    '<p>No abnormal results in this date range. Great news!</p>';
                container.appendChild(empty);
            }
        }
    </script>
}