@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Alerts & Abnormal Results";
    ViewData["RoleSubtitle"] = "Doctor Portal";
    ViewData["UserGreeting"] = "Review abnormal results that need your attention";
    ViewData["UserInitials"] = "DJ";
    ViewData["UserName"] = "Dr. Sarah Johnson";
}

@section SidebarMenu {
    <li><a href="@Url.Action("Dashboard", "Doctor")"><i class="fas fa-chart-pie"></i> <span>Dashboard</span></a></li>
    <li><a href="@Url.Action("TestRequests", "Doctor")"><i class="fas fa-notes-medical"></i> <span>Test Requests</span></a></li>
    <li><a href="@Url.Action("Patients", "Doctor")"><i class="fas fa-users"></i> <span>My Patients</span></a></li>
    <li><a href="@Url.Action("Alerts", "Doctor")" class="active"><i class="fas fa-bell"></i> <span>Alerts</span></a></li>
    <li><a href="@Url.Action("Results", "Doctor")"><i class="fas fa-chart-line"></i> <span>Results</span></a></li>
    <li><a href="@Url.Action("Reports", "Doctor")"><i class="fas fa-file-alt"></i> <span>Reports</span></a></li>
}

<div class="stats" style="display: flex; gap: 1rem; margin-bottom: 1rem;">
    <div class="stat-box" style="background:#FEF2F2;"><h4 id="criticalCount">0</h4><p>Critical (STAT)</p></div>
    <div class="stat-box" style="background:#FFFBEB;"><h4 id="urgentCount">0</h4><p>Urgent</p></div>
    <div class="stat-box"><h4 id="totalCount">0</h4><p>Total Alerts</p></div>
</div>

<div class="card">
    <div class="filter-bar">
        <input type="text" id="alertSearch" placeholder="🔍 Search" style="padding:0.3rem; border-radius:30px;">
        <select id="alertUrgency" style="padding:0.3rem; border-radius:30px;">
            <option value="all">All Urgency</option>
            <option value="stat">STAT</option>
            <option value="urgent">Urgent</option>
        </select>
        <button class="btn-sm" onclick="applyFilters()">Apply</button>
        <button class="btn-sm" onclick="resetFilters()">Reset</button>
    </div>
    <div class="table-container">
        <table id="alertsTable">
            <thead><tr><th>Date</th><th>Patient</th><th>Test</th><th>Result</th><th>Normal</th><th>Urgency</th><th>Action</th></tr></thead>
            <tbody id="alertsBody"></tbody>
        </table>
    </div>
</div>

<script>
    let alerts = [
        { date:"2025-04-09", patient:"Thabo Mbeki", test:"Haemoglobin", result:"7.2", normal:"12-16", urgency:"stat" },
        { date:"2025-04-08", patient:"John Smith", test:"Platelets", result:"45", normal:"150-450", urgency:"urgent" }
    ];
    function renderAlerts() {
        const tbody = document.getElementById('alertsBody');
        tbody.innerHTML = alerts.map(a => `<tr style="background:#FEF2F2;"><td>${a.date}</td><td>${a.patient}</td><td>${a.test}</td><td style="color:#DC2626; font-weight:bold;">${a.result}</td><td>${a.normal}</td><td><span class="status-badge">${a.urgency.toUpperCase()}</span></td><td><button class="btn-sm" onclick="alert('Review ${a.patient}')">Review</button></td></tr>`).join('');
        document.getElementById('criticalCount').innerText = alerts.filter(a=>a.urgency==='stat').length;
        document.getElementById('urgentCount').innerText = alerts.filter(a=>a.urgency==='urgent').length;
        document.getElementById('totalCount').innerText = alerts.length;
    }
    function applyFilters() { renderAlerts(); }
    function resetFilters() { renderAlerts(); }
    renderAlerts();
</script>

<style>
    .card {
        background: white;
        border-radius: 16px;
        padding: 1rem;
        border: 1px solid #E2E8F0;
    }

    .stat-box {
        background: white;
        border-radius: 12px;
        padding: 0.5rem;
        text-align: center;
        border: 1px solid #E2E8F0;
        flex: 1;
    }

        .stat-box h4 {
            font-size: 1.5rem;
            margin: 0;
        }

    .filter-bar {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
        margin-bottom: 1rem;
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    th, td {
        padding: 0.6rem;
        text-align: left;
        border-bottom: 1px solid #E2E8F0;
    }

    .btn-sm {
        background: #0841C9;
        color: white;
        border: none;
        padding: 0.2rem 0.6rem;
        border-radius: 30px;
        cursor: pointer;
    }

    .status-badge {
        background: #F8D7DA;
        color: #721C24;
        padding: 0.2rem 0.5rem;
        border-radius: 30px;
        font-size: 0.7rem;
    }
</style>