@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "My Patients";
    ViewData["RoleSubtitle"] = "Doctor Portal";
    ViewData["UserGreeting"] = "Manage your patient roster";
    ViewData["UserInitials"] = "DJ";
    ViewData["UserName"] = "Dr. Sarah Johnson";
}

@section SidebarMenu {
    <li><a href="@Url.Action("Dashboard", "Doctor")"><i class="fas fa-chart-pie"></i> <span>Dashboard</span></a></li>
    <li><a href="@Url.Action("TestRequests", "Doctor")"><i class="fas fa-notes-medical"></i> <span>Test Requests</span></a></li>
    <li><a href="@Url.Action("Patients", "Doctor")" class="active"><i class="fas fa-users"></i> <span>My Patients</span></a></li>
    <li><a href="@Url.Action("Alerts", "Doctor")"><i class="fas fa-bell"></i> <span>Alerts</span></a></li>
    <li><a href="@Url.Action("Results", "Doctor")"><i class="fas fa-chart-line"></i> <span>Results</span></a></li>
    <li><a href="@Url.Action("Reports", "Doctor")"><i class="fas fa-file-alt"></i> <span>Reports</span></a></li>
}

<style>
    .card {
        background: white;
        border-radius: 16px;
        padding: 1rem;
        margin-bottom: 1rem;
        border: 1px solid #E2E8F0;
    }

    .filter-bar {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
        margin-bottom: 1rem;
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    th, td {
        padding: 0.6rem;
        text-align: left;
        border-bottom: 1px solid #E2E8F0;
        font-size: 0.75rem;
    }

    th {
        background: #F8FAFE;
        font-weight: 600;
        color: #5A6E7A;
    }

    .btn-sm {
        background: #0841C9;
        color: white;
        border: none;
        padding: 0.2rem 0.6rem;
        border-radius: 30px;
        cursor: pointer;
        font-size: 0.7rem;
    }

    .stats {
        display: flex;
        gap: 0.8rem;
        margin-bottom: 1rem;
    }

    .stat-box {
        background: white;
        border-radius: 12px;
        padding: 0.5rem;
        text-align: center;
        border: 1px solid #E2E8F0;
        flex: 1;
    }

        .stat-box h4 {
            font-size: 1.3rem;
            margin: 0;
            color: #032C7D;
        }

    .modal-overlay {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.5);
        z-index: 2000;
        align-items: center;
        justify-content: center;
    }

        .modal-overlay.active {
            display: flex;
        }

    .modal-container {
        background: white;
        border-radius: 20px;
        width: 90%;
        max-width: 500px;
    }

    .modal-header, .modal-footer {
        padding: 0.8rem 1rem;
        border-bottom: 1px solid #E2E8F0;
    }

    .modal-footer {
        border-bottom: none;
        border-top: 1px solid #E2E8F0;
        display: flex;
        justify-content: flex-end;
        gap: 0.5rem;
    }

    .form-group {
        margin-bottom: 0.8rem;
    }

        .form-group label {
            font-size: 0.75rem;
            font-weight: 500;
            display: block;
            margin-bottom: 0.2rem;
        }

    .form-control {
        width: 100%;
        padding: 0.4rem;
        border: 1px solid #E2E8F0;
        border-radius: 8px;
    }

    .medical-tag {
        display: inline-block;
        background: #F1F5F9;
        padding: 0.1rem 0.4rem;
        border-radius: 20px;
        font-size: 0.65rem;
        margin-right: 0.2rem;
    }
</style>

<div class="stats">
    <div class="stat-box"><h4>124</h4><p>Total Patients</p></div>
    <div class="stat-box"><h4>28</h4><p>Active This Month</p></div>
    <div class="stat-box"><h4>12</h4><p>With Abnormal Results</p></div>
</div>

<div class="card">
    <div class="filter-bar">
        <input type="text" id="patientSearch" class="form-control" placeholder="🔍 Search by name or ID" style="width:220px;">
        <button class="btn-sm" onclick="searchPatients()">Search</button>
        <button class="btn-sm" onclick="resetSearch()">Clear</button>
        <button class="btn-sm" onclick="openRegisterModal()" style="background:#10B981;">+ Register Patient</button>
    </div>
    <div class="table-container">
        <table id="patientsTable">
            <thead><tr><th>Name</th><th>ID Number</th><th>DOB</th><th>Contact</th><th>Conditions</th><th>Actions</th></tr></thead>
            <tbody id="patientsBody"></tbody>
        </table>
    </div>
</div>

<!-- Register Patient Modal -->
<div id="registerModal" class="modal-overlay">
    <div class="modal-container">
        <div class="modal-header"><h3>Register New Patient</h3><button class="close-modal" onclick="closeRegisterModal()">&times;</button></div>
        <div class="modal-body">
            <div class="form-group"><label>Full Name *</label><input type="text" id="regName" class="form-control" placeholder="First and Last name"></div>
            <div class="form-group"><label>SA ID Number *</label><input type="text" id="regID" class="form-control" placeholder="13-digit ID number"></div>
            <div class="form-group"><label>Date of Birth *</label><input type="date" id="regDOB" class="form-control"></div>
            <div class="form-group"><label>Cellphone *</label><input type="text" id="regPhone" class="form-control" placeholder="0821234567"></div>
            <div class="form-group"><label>Email</label><input type="email" id="regEmail" class="form-control" placeholder="patient@email.com"></div>
            <div class="form-group"><label>Address</label><textarea id="regAddress" rows="2" class="form-control" placeholder="Home address"></textarea></div>
        </div>
        <div class="modal-footer"><button class="btn-outline-sm" onclick="closeRegisterModal()">Cancel</button><button class="btn-sm" onclick="registerPatient()">Register Patient</button></div>
    </div>
</div>

<!-- View Patient History Modal -->
<div id="historyModal" class="modal-overlay">
    <div class="modal-container">
        <div class="modal-header"><h3>Patient Medical History</h3><button class="close-modal" onclick="closeHistoryModal()">&times;</button></div>
        <div class="modal-body" id="historyContent"></div>
        <div class="modal-footer"><button class="btn-sm" onclick="closeHistoryModal()">Close</button></div>
    </div>
</div>

<script>
    let patients = [
        { name:"Thabo Mbeki", idNumber:"8001015009087", dob:"1980-01-01", phone:"0821234567", conditions:["Hypertension"], allergies:["Penicillin"], medications:["Lisinopril 10mg"] },
        { name:"Lerato Dlamini", idNumber:"8505155009088", dob:"1985-05-15", phone:"0832345678", conditions:["Diabetes"], allergies:[], medications:["Metformin 500mg"] },
        { name:"John Smith", idNumber:"9001015009089", dob:"1990-01-01", phone:"0843456789", conditions:[], allergies:["Sulfa"], medications:[] }
    ];

    function renderPatients(search='') {
        let filtered = search ? patients.filter(p=>p.name.toLowerCase().includes(search)||p.idNumber.includes(search)) : patients;
        const tbody = document.getElementById('patientsBody');
        tbody.innerHTML = filtered.map(p => `<tr><td><strong>${p.name}</strong></td><td>${p.idNumber}</td><td>${p.dob}</td><td>${p.phone}</td><td>${p.conditions.map(c=>`<span class="medical-tag">${c}</span>`).join('')||'-'}</td>
        <td><button class="btn-sm" onclick="viewHistory('${p.name}','${p.conditions.join(',')}','${p.allergies.join(',')}','${p.medications.join(',')}')">History</button>
        <button class="btn-sm" onclick="location.href='@Url.Action("TestRequests", "Doctor")'">Request</button></td></tr>`).join('');
    }

    function viewHistory(name, conditions, allergies, medications) {
        document.getElementById('historyContent').innerHTML = `
            <p><strong>Patient:</strong> ${name}</p>
            <p><strong>Conditions:</strong> ${conditions || 'None'}</p>
            <p><strong>Allergies:</strong> ${allergies || 'None'}</p>
            <p><strong>Current Medications:</strong> ${medications || 'None'}</p>
            <hr>
            <p><strong>Recent Test Requests:</strong></p>
            <ul><li>REQ-001 - Full Blood Count (Apr 9, 2025)</li><li>REQ-004 - Lipid Profile (Mar 20, 2025)</li></ul>
        `;
        document.getElementById('historyModal').classList.add('active');
    }

    function searchPatients() { renderPatients(document.getElementById('patientSearch').value.toLowerCase()); }
    function resetSearch() { document.getElementById('patientSearch').value=''; renderPatients(); }
    function openRegisterModal() { document.getElementById('registerModal').classList.add('active'); }
    function closeRegisterModal() { document.getElementById('registerModal').classList.remove('active'); }
    function closeHistoryModal() { document.getElementById('historyModal').classList.remove('active'); }
    function registerPatient() {
        const name = document.getElementById('regName').value;
        if(!name) { alert('Please enter patient name'); return; }
        alert(`✅ Patient ${name} registered successfully!\n📧 Login credentials sent to email.`);
        closeRegisterModal();
        document.getElementById('regName').value=''; document.getElementById('regID').value=''; document.getElementById('regDOB').value=''; document.getElementById('regPhone').value=''; document.getElementById('regEmail').value=''; document.getElementById('regAddress').value='';
    }
    renderPatients();
</script>