@model NMB_HLabSys.Models.ViewModels.PatientIndexViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "My Patients";
    ViewData["RoleSubtitle"] = "Doctor Portal";
    ViewData["UserGreeting"] = "Manage your patient roster";
}

@section SidebarMenu {
    <li><a href="@Url.Action("Dashboard", "Doctor")"><i class="fas fa-chart-pie"></i> <span>Dashboard</span></a></li>
    <li><a href="@Url.Action("TestRequests", "Doctor")"><i class="fas fa-notes-medical"></i> <span>Test Requests</span></a></li>
    <li><a href="@Url.Action("Patients", "Doctor")" class="active"><i class="fas fa-users"></i> <span>My Patients</span></a></li>
    <li><a href="@Url.Action("Alerts", "Doctor")"><i class="fas fa-bell"></i> <span>Alerts</span></a></li>
    <li><a href="@Url.Action("Results", "Doctor")"><i class="fas fa-chart-line"></i> <span>Results</span></a></li>
    <li><a href="@Url.Action("Reports", "Doctor")"><i class="fas fa-file-alt"></i> <span>Reports</span></a></li>
    <li><a href="@Url.Action("Index", "Profile")"><i class="fas fa-user-circle"></i> <span>My Profile</span></a></li>
}

@section Styles {
    <style>
        .panel {
            background: white;
            border-radius: 20px;
            padding: 1.5rem;
            margin-bottom: 1.2rem;
            border: 1px solid #E2E8F0;
        }

        .stats-row {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 1rem;
            margin-bottom: 1.2rem;
        }

        .stat-box {
            background: white;
            border-radius: 16px;
            padding: 1.1rem 1.2rem;
            border: 1px solid #E2E8F0;
            display: flex;
            align-items: center;
            gap: 0.9rem;
            transition: all 0.2s;
        }

            .stat-box:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 24px rgba(8,65,201,0.08);
                border-color: #0841C9;
            }

        .stat-icon {
            width: 44px;
            height: 44px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 1.1rem;
            flex-shrink: 0;
        }

            .stat-icon.blue {
                background: linear-gradient(135deg, #0841C9, #1D97F1);
            }

            .stat-icon.green {
                background: linear-gradient(135deg, #10B981, #059669);
            }

            .stat-icon.amber {
                background: linear-gradient(135deg, #F59E0B, #D97706);
            }

        .stat-text h3 {
            font-size: 1.5rem;
            color: #032C7D;
            margin: 0;
            font-weight: 700;
            letter-spacing: -0.02em;
        }

        .stat-text p {
            margin: 0;
            font-size: 0.72rem;
            color: #5A6E7A;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            font-weight: 600;
        }

        .filter-bar {
            display: flex;
            gap: 0.6rem;
            flex-wrap: wrap;
            align-items: center;
            margin-bottom: 1rem;
        }

        .filter-input {
            padding: 0.6rem 1rem;
            border-radius: 30px;
            border: 1px solid #E2E8F0;
            font-size: 0.85rem;
            font-family: inherit;
            flex: 1;
            min-width: 220px;
        }

            .filter-input:focus {
                outline: none;
                border-color: #0841C9;
                box-shadow: 0 0 0 3px rgba(8,65,201,0.1);
            }

        .btn {
            padding: 0.6rem 1.3rem;
            border-radius: 30px;
            font-size: 0.82rem;
            font-weight: 600;
            cursor: pointer;
            border: none;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            transition: all 0.2s;
            font-family: inherit;
            white-space: nowrap;
        }

        .btn-primary {
            background: #0841C9;
            color: white;
        }

            .btn-primary:hover {
                background: #032C7D;
                color: white;
            }

        .btn-success {
            background: #10B981;
            color: white;
        }

            .btn-success:hover {
                background: #059669;
                color: white;
            }

        .btn-outline {
            background: transparent;
            border: 1px solid #E2E8F0;
            color: #1A2C3A;
        }

            .btn-outline:hover {
                background: #F1F5F9;
                color: #1A2C3A;
            }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th, td {
            padding: 0.75rem 0.6rem;
            text-align: left;
            border-bottom: 1px solid #E2E8F0;
            font-size: 0.83rem;
        }

        th {
            background: #F8FAFE;
            font-weight: 600;
            color: #5A6E7A;
            font-size: 0.72rem;
            text-transform: uppercase;
            letter-spacing: 0.04em;
        }

        tr:hover {
            background: #F8FAFE;
        }

        .patient-name {
            font-weight: 700;
            color: #032C7D;
        }

            .patient-name small {
                display: block;
                font-weight: 400;
                color: #5A6E7A;
                font-size: 0.72rem;
                margin-top: 0.15rem;
            }

        .medical-tag {
            display: inline-block;
            padding: 0.15rem 0.55rem;
            border-radius: 30px;
            font-size: 0.68rem;
            margin: 0.1rem 0.2rem 0.1rem 0;
            font-weight: 500;
        }

        .tag-condition {
            background: #FEF3C7;
            color: #92400E;
        }

        .tag-allergy {
            background: #FEE2E2;
            color: #991B1B;
        }

        .tag-medication {
            background: #D1FAE5;
            color: #065F46;
        }

        .tag-none {
            background: #F1F5F9;
            color: #94A3B8;
            font-style: italic;
        }

        .medical-tag.tag-more {
            background: #E0E7FF;
            color: #3730A3;
            cursor: help;
            font-weight: 600;
        }

            .medical-tag.tag-more:hover {
                background: #C7D2FE;
            }

        .row-actions {
            display: flex;
            gap: 0.4rem;
        }

            .row-actions .btn {
                padding: 0.35rem 0.75rem;
                font-size: 0.72rem;
            }

        .alert-success {
            padding: 0.8rem 1rem;
            border-radius: 10px;
            margin-bottom: 1rem;
            font-size: 0.85rem;
            background: #D1FAE5;
            color: #065F46;
            border-left: 4px solid #10B981;
        }

        .alert-danger {
            padding: 0.8rem 1rem;
            border-radius: 10px;
            margin-bottom: 1rem;
            font-size: 0.85rem;
            background: #FEE2E2;
            color: #991B1B;
            border-left: 4px solid #DC2626;
        }

        .empty-state {
            text-align: center;
            padding: 3rem 1rem;
            color: #94A3B8;
        }

            .empty-state i {
                font-size: 3rem;
                color: #CBD5E1;
                margin-bottom: 0.8rem;
                display: block;
            }

            .empty-state h3 {
                font-size: 1.1rem;
                color: #5A6E7A;
                margin: 0 0 0.3rem;
            }

            .empty-state p {
                font-size: 0.85rem;
                margin: 0 0 1rem;
            }

        @@media (max-width: 900px) {
            .stats-row {
                grid-template-columns: 1fr;
            }

            table {
                font-size: 0.78rem;
            }
        }
    </style>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert-danger">@TempData["ErrorMessage"]</div>
}

<!-- ─── STATS ─── -->
<div class="stats-row">
    <div class="stat-box">
        <div class="stat-icon blue"><i class="fas fa-users"></i></div>
        <div class="stat-text">
            <h3>@Model.Statistics.Total</h3>
            <p>Total Patients</p>
        </div>
    </div>
    <div class="stat-box">
        <div class="stat-icon green"><i class="fas fa-user-check"></i></div>
        <div class="stat-text">
            <h3>@Model.Statistics.ActiveThisMonth</h3>
            <p>Active This Month</p>
        </div>
    </div>
    <div class="stat-box">
        <div class="stat-icon amber"><i class="fas fa-exclamation-triangle"></i></div>
        <div class="stat-text">
            <h3>@Model.Statistics.WithAbnormalResults</h3>
            <p>With Abnormal Results</p>
        </div>
    </div>
</div>

<!-- ─── FILTER + ACTION BAR ─── -->
<div class="panel">
    <form method="get" asp-action="Patients" class="filter-bar">
        <input type="text" name="searchTerm" class="filter-input" maxlength="100"
               placeholder="Search by name or SA ID..."
               value="@ViewData["SearchTerm"]" />
        <button type="submit" class="btn btn-primary">
            <i class="fas fa-search"></i> Search
        </button>
        @if (!string.IsNullOrWhiteSpace(ViewData["SearchTerm"] as string))
        {
            <a asp-action="Patients" class="btn btn-outline">
                <i class="fas fa-times"></i> Clear
            </a>
        }
        <a asp-action="RegisterPatient" class="btn btn-success" style="margin-left:auto;">
            <i class="fas fa-user-plus"></i> Register New Patient
        </a>
    </form>

    @if (Model.Patients == null || !Model.Patients.Any())
    {
        <div class="empty-state">
            <i class="fas fa-user-friends"></i>
            <h3>No patients yet</h3>
            <p>Register a patient to get started with test requests.</p>
            <a asp-action="RegisterPatient" class="btn btn-success">
                <i class="fas fa-user-plus"></i> Register Your First Patient
            </a>
        </div>
    }
    else
    {
        <table>
            <thead>
                <tr>
                    <th>Patient</th>
                    <th>SA ID</th>
                    <th>Date of Birth</th>
                    <th>Contact</th>
                    <th>Medical Flags</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model.Patients)
                {
                    <tr>
                        <td>
                            <div class="patient-name">
                                @p.FullName
                            </div>
                        </td>
                        <td>@p.SAIDNumber</td>
                        <td>@p.DateOfBirth.ToString("yyyy-MM-dd")</td>
                        <td>@(string.IsNullOrEmpty(p.Cellphone) ? "—" : p.Cellphone)</td>
                        <td>
                            @{
                                var allFlags = new List<(string Name, string CssClass)>();
                                if (p.Conditions != null)
                                {
                                    foreach (var c in p.Conditions)
                                        allFlags.Add((c, "tag-condition"));
                                }
                                if (p.Allergies != null)
                                {
                                    foreach (var a in p.Allergies)
                                        allFlags.Add((a, "tag-allergy"));
                                }

                                var maxVisible = 3;
                                var visible = allFlags.Take(maxVisible).ToList();
                                var hidden = allFlags.Skip(maxVisible).ToList();
                            }

                            @if (allFlags.Count == 0)
                            {
                                <span class="medical-tag tag-none">No flags</span>
                            }
                            else
                            {
                                foreach (var flag in visible)
                                {
                                    <span class="medical-tag @flag.CssClass">@flag.Name</span>
                                }

                                @if (hidden.Any())
                                {
                                    var tooltipText = string.Join(", ", hidden.Select(h => h.Name));
                                    <span class="medical-tag tag-more" title="@tooltipText">
                                        +@hidden.Count more
                                    </span>
                                }
                            }
                        </td>
                        <td>
                            <div class="row-actions">
                                <a asp-action="PatientDetails" asp-route-id="@p.PatientID"
                                   class="btn btn-outline">
                                    <i class="fas fa-history"></i> History
                                </a>
                                <a asp-action="CreateTestRequest"
                                   asp-route-patientId="@p.PatientID"
                                   asp-route-saId="@p.SAIDNumber"
                                   class="btn btn-primary">
                                    <i class="fas fa-flask"></i> Request
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>