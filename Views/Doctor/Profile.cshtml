@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Doctor Profile";
    ViewData["RoleSubtitle"] = "Doctor Portal";
    ViewData["UserGreeting"] = @ViewBag.UserGreeting ?? "Sarah Johnson";
    ViewData["UserInitials"] = @ViewBag.UserInitials ?? "SJ";
    ViewData["UserName"] = @ViewBag.UserName ?? "Sarah Johnson";
}

@section SidebarMenu {
    <li><a href="@Url.Action("Dashboard", "Doctor")"><i class="fas fa-chart-pie"></i> <span>Dashboard</span></a></li>
    <li><a href="@Url.Action("TestRequests", "Doctor")"><i class="fas fa-notes-medical"></i> <span>Test Requests</span></a></li>
    <li><a href="@Url.Action("Patients", "Doctor")"><i class="fas fa-users"></i> <span>My Patients</span></a></li>
    <li><a href="@Url.Action("Alerts", "Doctor")"><i class="fas fa-bell"></i> <span>Alerts</span></a></li>
    <li><a href="@Url.Action("Results", "Doctor")"><i class="fas fa-chart-line"></i> <span>Results</span></a></li>
    <li><a href="@Url.Action("Reports", "Doctor")"><i class="fas fa-file-alt"></i> <span>Reports</span></a></li>
    <li><a href="@Url.Action("Profile", "Doctor")" class="active"><i class="fas fa-user-circle"></i> <span>My Profile</span></a></li>
}

@section Styles {
    <style>
        /* ─── PROFILE LAYOUT ─── */
        .profile-header {
            background: #fff;
            border-radius: var(--radius-card);
            padding: 2rem 2.5rem;
            margin-bottom: 1.8rem;
            box-shadow: var(--shadow-sm);
            border: 1px solid #E8EDF5;
            display: flex;
            align-items: center;
            gap: 2rem;
            flex-wrap: wrap;
            position: relative;
        }

        .profile-avatar-wrapper {
            position: relative;
            flex-shrink: 0;
        }

        .profile-avatar {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--primary-bright), var(--primary-light));
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 2rem;
            font-weight: 700;
            box-shadow: 0 4px 16px rgba(8,65,201,0.25);
            transition: filter 0.3s ease;
        }

        .profile-avatar-wrapper:hover .profile-avatar {
            filter: brightness(0.9);
        }

        .change-photo-btn {
            position: absolute;
            bottom: -4px;
            right: -4px;
            background: var(--primary-bright);
            color: #fff;
            width: 32px;
            height: 32px;
            border-radius: 50%;
            border: 2px solid #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.8rem;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 2px 8px rgba(0,0,0,0.15);
            text-decoration: none;
        }

            .change-photo-btn:hover {
                background: var(--primary-light);
                transform: scale(1.08);
            }

        .profile-header-info h2 {
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--text-dark);
            margin: 0 0 0.1rem;
        }

        .profile-header-info .role-tag {
            display: inline-block;
            background: rgba(8,65,201,0.08);
            color: var(--primary-bright);
            padding: 0.15rem 0.8rem;
            border-radius: 40px;
            font-size: 0.7rem;
            font-weight: 600;
        }

        .profile-header-info .sub-info {
            color: var(--text-muted);
            font-size: 0.85rem;
            margin-top: 0.2rem;
        }

            .profile-header-info .sub-info span {
                display: inline-block;
                margin-right: 0.8rem;
            }

            .profile-header-info .sub-info i {
                margin-right: 0.3rem;
                color: var(--primary-bright);
            }

        .profile-header-actions {
            margin-left: auto;
            display: flex;
            gap: 0.8rem;
            flex-wrap: wrap;
        }

        /* ─── TABS ─── */
        .profile-tabs {
            display: flex;
            gap: 0.2rem;
            background: #fff;
            border-radius: var(--radius-card);
            padding: 0.3rem;
            margin-bottom: 1.8rem;
            box-shadow: var(--shadow-sm);
            border: 1px solid #E8EDF5;
            overflow-x: auto;
            flex-wrap: nowrap;
        }

        .profile-tab {
            padding: 0.6rem 1.4rem;
            border-radius: var(--radius-element);
            border: none;
            background: transparent;
            font-weight: 600;
            font-size: 0.85rem;
            color: var(--text-muted);
            cursor: pointer;
            transition: all 0.3s ease;
            white-space: nowrap;
            font-family: 'Inter', sans-serif;
        }

            .profile-tab:hover {
                background: rgba(8,65,201,0.04);
                color: var(--text-dark);
            }

            .profile-tab.active {
                background: linear-gradient(135deg, var(--primary-bright), var(--primary-light));
                color: #fff;
                box-shadow: 0 4px 16px rgba(8,65,201,0.2);
            }

            .profile-tab i {
                margin-right: 0.4rem;
            }

        /* ─── TAB CONTENT ─── */
        .tab-content {
            display: none;
            animation: fadeUp 0.4s ease both;
        }

            .tab-content.active {
                display: block;
            }

        @@keyframes fadeUp {
            0% {
                opacity: 0;
                transform: translateY(12px);
            }

            100% {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .profile-card-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1.5rem;
        }

        .profile-card {
            background: #fff;
            border-radius: var(--radius-card);
            border: 1px solid #E8EDF5;
            box-shadow: var(--shadow-sm);
            overflow: hidden;
            transition: all 0.3s ease;
        }

            .profile-card:hover {
                box-shadow: var(--shadow-md);
                border-color: var(--primary-bright);
            }

        .profile-card-header {
            padding: 1rem 1.5rem;
            background: var(--bg-soft);
            border-bottom: 1px solid #E8EDF5;
            display: flex;
            align-items: center;
            gap: 0.6rem;
        }

            .profile-card-header h4 {
                font-size: 1rem;
                font-weight: 700;
                color: var(--text-dark);
                margin: 0;
            }

            .profile-card-header i {
                color: var(--primary-bright);
                font-size: 1.1rem;
            }

        .profile-card-body {
            padding: 1.5rem;
        }

            .profile-card-body .info-row {
                display: flex;
                justify-content: space-between;
                padding: 0.4rem 0;
                border-bottom: 1px solid #F1F5F9;
                font-size: 0.9rem;
            }

                .profile-card-body .info-row:last-child {
                    border-bottom: none;
                }

            .profile-card-body .info-label {
                color: var(--text-muted);
                font-weight: 500;
            }

            .profile-card-body .info-value {
                color: var(--text-dark);
                font-weight: 500;
            }

                .profile-card-body .info-value .badge-status {
                    display: inline-block;
                    padding: 0.15rem 0.6rem;
                    border-radius: 40px;
                    font-size: 0.7rem;
                    font-weight: 600;
                }

        .badge-status.active {
            background: rgba(16,185,129,0.08);
            color: #10B981;
        }

        .badge-status.inactive {
            background: rgba(239,68,68,0.08);
            color: #EF4444;
        }

        .badge-status.pending {
            background: rgba(217,119,6,0.08);
            color: #D97706;
        }

        .stat-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 1rem;
            margin-bottom: 1.5rem;
        }

        .stat-item {
            text-align: center;
            padding: 1rem;
            background: var(--bg-soft);
            border-radius: var(--radius-element);
            transition: background 0.3s ease;
        }

            .stat-item:hover {
                background: rgba(8,65,201,0.04);
            }

            .stat-item .stat-number {
                font-size: 1.8rem;
                font-weight: 800;
                color: var(--primary-bright);
                letter-spacing: -0.02em;
            }

            .stat-item .stat-label {
                font-size: 0.75rem;
                color: var(--text-muted);
                margin-top: 0.1rem;
            }

        .form-group {
            margin-bottom: 1.2rem;
        }

            .form-group label {
                font-size: 0.8rem;
                font-weight: 600;
                display: block;
                margin-bottom: 0.3rem;
                color: var(--primary-deep);
            }

        .form-control {
            width: 100%;
            padding: 0.6rem 0.8rem;
            border: 1.5px solid #E8EDF5;
            border-radius: var(--radius-element);
            font-size: 0.85rem;
            font-family: 'Inter', sans-serif;
            transition: all 0.3s ease;
            background: #F8FAFE;
            color: var(--text-dark);
        }

            .form-control:focus {
                outline: none;
                border-color: var(--primary-bright);
                box-shadow: 0 0 0 4px rgba(8,65,201,0.08);
                background: #fff;
            }

            .form-control:hover {
                border-color: #94A3B8;
            }

        .btn-primary {
            background: linear-gradient(135deg, var(--primary-bright), var(--primary-light));
            color: #fff;
            border: none;
            padding: 0.6rem 1.4rem;
            border-radius: 40px;
            font-weight: 600;
            font-size: 0.85rem;
            cursor: pointer;
            transition: all 0.3s cubic-bezier(0.25,0.46,0.45,0.94);
            box-shadow: 0 4px 16px rgba(8,65,201,0.2);
            font-family: 'Inter', sans-serif;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
        }

            .btn-primary:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 28px rgba(8,65,201,0.35);
            }

        .btn-outline {
            background: transparent;
            border: 1.5px solid #E8EDF5;
            padding: 0.6rem 1.4rem;
            border-radius: 40px;
            font-weight: 600;
            font-size: 0.85rem;
            cursor: pointer;
            transition: all 0.3s ease;
            font-family: 'Inter', sans-serif;
            color: var(--text-dark);
        }

            .btn-outline:hover {
                border-color: var(--primary-bright);
                color: var(--primary-bright);
                background: rgba(8,65,201,0.02);
            }

        .btn-danger {
            background: #EF4444;
            color: #fff;
            border: none;
            padding: 0.6rem 1.4rem;
            border-radius: 40px;
            font-weight: 600;
            font-size: 0.85rem;
            cursor: pointer;
            transition: all 0.3s ease;
            font-family: 'Inter', sans-serif;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
        }

            .btn-danger:hover {
                background: #DC2626;
                transform: translateY(-2px);
            }

        .row-2col {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1rem;
        }

        .row-3col {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 1rem;
        }

        .switch {
            position: relative;
            display: inline-block;
            width: 44px;
            height: 24px;
        }

            .switch input {
                opacity: 0;
                width: 0;
                height: 0;
            }

        .slider {
            position: absolute;
            cursor: pointer;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-color: #ccc;
            transition: .4s;
            border-radius: 24px;
        }

            .slider:before {
                position: absolute;
                content: "";
                height: 18px;
                width: 18px;
                left: 3px;
                bottom: 3px;
                background-color: white;
                transition: .4s;
                border-radius: 50%;
            }

        input:checked + .slider {
            background-color: var(--primary-bright);
        }

            input:checked + .slider:before {
                transform: translateX(20px);
            }

        .alert-success {
            background: #D1FAE5;
            color: #065F46;
            padding: 0.8rem 1rem;
            border-radius: var(--radius-element);
            margin-bottom: 1rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            border: 1px solid #A7F3D0;
        }

        .alert-error {
            background: #FEE2E2;
            color: #991B1B;
            padding: 0.8rem 1rem;
            border-radius: var(--radius-element);
            margin-bottom: 1rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            border: 1px solid #FECACA;
        }

        .password-requirements {
            font-size: 0.7rem;
            color: var(--text-muted);
            margin-top: 0.3rem;
            line-height: 1.6;
        }

            .password-requirements i {
                margin-right: 0.2rem;
            }

        .action-buttons {
            display: flex;
            gap: 0.8rem;
            flex-wrap: wrap;
            margin-top: 0.5rem;
        }

        /* ─── TOAST ─── */
        .toast-container {
            position: fixed;
            top: 1.5rem;
            right: 1.5rem;
            z-index: 99999;
            display: flex;
            flex-direction: column;
            gap: 0.8rem;
            max-width: 380px;
            width: 100%;
            pointer-events: none;
        }

        .toast-item {
            background: #fff;
            border-radius: var(--radius-element);
            padding: 1rem 1.2rem;
            box-shadow: 0 12px 40px rgba(0,0,0,0.15);
            display: flex;
            align-items: flex-start;
            gap: 0.8rem;
            border-left: 4px solid var(--primary-bright);
            animation: slideInRight 0.4s cubic-bezier(0.34,1.56,0.64,1) both;
            pointer-events: auto;
        }

            .toast-item .toast-icon {
                font-size: 1.4rem;
                margin-top: 0.1rem;
                flex-shrink: 0;
            }

                .toast-item .toast-icon.success {
                    color: #10B981;
                }

                .toast-item .toast-icon.error {
                    color: #EF4444;
                }

                .toast-item .toast-icon.info {
                    color: var(--primary-bright);
                }

            .toast-item .toast-content {
                flex: 1;
                display: flex;
                flex-direction: column;
                gap: 0.1rem;
            }

            .toast-item .toast-title {
                font-weight: 600;
                font-size: 0.9rem;
                color: var(--text-dark);
            }

            .toast-item .toast-message {
                font-size: 0.85rem;
                color: var(--text-muted);
                line-height: 1.4;
            }

            .toast-item .toast-close {
                background: none;
                border: none;
                font-size: 1.2rem;
                cursor: pointer;
                color: #94A3B8;
                padding: 0 0.2rem;
                transition: color 0.2s;
                pointer-events: auto;
            }

                .toast-item .toast-close:hover {
                    color: var(--text-dark);
                }

        @@keyframes slideInRight {
            0% {
                transform: translateX(40px);
                opacity: 0;
            }

            100% {
                transform: translateX(0);
                opacity: 1;
            }
        }

        /* ─── RESPONSIVE ─── */
        @@media (max-width: 1024px) {
            .profile-card-grid {
                grid-template-columns: 1fr;
            }

            .row-3col {
                grid-template-columns: 1fr 1fr;
            }
        }

        @@media (max-width: 868px) {
            .profile-header {
                flex-direction: column;
                align-items: flex-start;
                text-align: center;
                padding: 1.5rem;
            }

            .profile-header-actions {
                margin-left: 0;
                width: 100%;
                justify-content: center;
            }

            .stat-grid {
                grid-template-columns: 1fr 1fr;
            }

            .row-2col {
                grid-template-columns: 1fr;
            }

            .row-3col {
                grid-template-columns: 1fr;
            }
        }

        @@media (max-width: 480px) {
            .profile-tabs {
                gap: 0.1rem;
                padding: 0.2rem;
            }

            .profile-tab {
                font-size: 0.75rem;
                padding: 0.4rem 0.8rem;
            }

            .stat-grid {
                grid-template-columns: 1fr;
            }

            .toast-container {
                top: 1rem;
                right: 1rem;
                left: 1rem;
                max-width: none;
            }
        }
    </style>
}

<!-- ─── TOAST CONTAINER ─── -->
<div class="toast-container" id="toastContainer"></div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert-success">
        <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert-error">
        <i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]
    </div>
}

<!-- ─── PROFILE HEADER ─── -->
<div class="profile-header">
    <div class="profile-avatar-wrapper">
        <div class="profile-avatar">@ViewData["UserInitials"]</div>
        <a href="#" class="change-photo-btn" title="Change photo" onclick="showToast('info', 'Photo Upload', 'Click to upload a new profile photo. (Demo)')">
            <i class="fas fa-camera"></i>
        </a>
    </div>
    <div class="profile-header-info">
        <h2>Dr. @ViewData["UserGreeting"]</h2>
        <span class="role-tag"><i class="fas fa-user-md"></i> Haematology Specialist</span>
        <div class="sub-info">
            <span><i class="fas fa-id-card"></i> HPCSA: 1234567</span>
            <span><i class="fas fa-id-badge"></i> SA ID: 850615 1234 567</span>
            <span><i class="fas fa-map-pin"></i> 123 Medical Centre, Gqeberha, 6001</span>
            <span class="badge-status active"><i class="fas fa-circle" style="font-size:0.4rem; vertical-align:middle;"></i> Active</span>
        </div>
    </div>
    <div class="profile-header-actions">
        <a href="#" class="btn-outline" onclick="showToast('info', 'Export', 'Downloading your profile data.')"><i class="fas fa-download"></i> Export</a>
    </div>
</div>

<!-- ─── TABS ─── -->
<div class="profile-tabs" id="profileTabs">
    <button class="profile-tab active" data-tab="overview"><i class="fas fa-th-large"></i> Overview</button>
    <button class="profile-tab" data-tab="personal"><i class="fas fa-user"></i> Personal Info</button>
    <button class="profile-tab" data-tab="professional"><i class="fas fa-briefcase"></i> Professional</button>
    <button class="profile-tab" data-tab="security"><i class="fas fa-shield-alt"></i> Security</button>
    <button class="profile-tab" data-tab="notifications"><i class="fas fa-bell"></i> Notifications</button>
</div>

<!-- ─── TAB CONTENT ─── -->
<!-- OVERVIEW -->
