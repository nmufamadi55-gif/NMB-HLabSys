    <div class="stat-grid">
        <div class="stat-item">
            <div class="stat-number">142</div>
            <div class="stat-label">Patients</div>
        </div>
        <div class="stat-item">
            <div class="stat-number">28</div>
            <div class="stat-label">Pending Results</div>
        </div>
        <div class="stat-item">
            <div class="stat-number">4.9</div>
            <div class="stat-label">Avg. Rating</div>
        </div>
    </div>

    <div class="profile-card-grid">
        <div class="profile-card">
            <div class="profile-card-header">
                <i class="fas fa-user-circle"></i>
                <h4>Personal Information</h4>
            </div>
            <div class="profile-card-body">
                <div class="info-row"><span class="info-label">Title</span><span class="info-value">Dr.</span></div>
                <div class="info-row"><span class="info-label">Full Name</span><span class="info-value">Sarah Johnson</span></div>
                <div class="info-row"><span class="info-label">SA ID Number</span><span class="info-value">850615 1234 567</span></div>
                <div class="info-row"><span class="info-label">Email</span><span class="info-value">sarah.johnson@@nmblab.co.za</span></div>
                <div class="info-row"><span class="info-label">Phone</span><span class="info-value">+27 82 123 4567</span></div>
                <div class="info-row"><span class="info-label">Date of Birth</span><span class="info-value">15 June 1985</span></div>
                <div class="info-row"><span class="info-label">Gender</span><span class="info-value">Female</span></div>
                <div class="info-row" style="border-bottom:none;"><span class="info-label">Personal Address</span><span class="info-value">45 Oak Avenue, Summerstrand, Gqeberha, 6001</span></div>
            </div>
        </div>

        <div class="profile-card">
            <div class="profile-card-header">
                <i class="fas fa-clock"></i>
                <h4>Recent Activity</h4>
            </div>
            <div class="profile-card-body">
                <div class="info-row"><span class="info-label">Last Login</span><span class="info-value">Today, 09:45 AM</span></div>
                <div class="info-row"><span class="info-label">Tests Reviewed</span><span class="info-value">12 this week</span></div>
                <div class="info-row"><span class="info-label">Patients Seen</span><span class="info-value">8 today</span></div>
                <div class="info-row" style="border-bottom:none;"><span class="info-label">Pending Requests</span><span class="info-value">4</span></div>
                <div style="margin-top:1rem; padding-top:1rem; border-top:1px solid #F1F5F9;">
                    <span class="info-label">Quick Actions</span>
                    <div class="action-buttons">
                        <a href="@Url.Action("TestRequests", "Doctor")" class="btn-primary"><i class="fas fa-plus"></i> New Request</a>
                        <a href="@Url.Action("Patients", "Doctor")" class="btn-outline"><i class="fas fa-users"></i> Patients</a>
                        <a href="#" class="btn-outline" onclick="showToast('info', 'Schedule', 'Opening calendar to schedule a meeting.')"><i class="fas fa-calendar-alt"></i> Schedule</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- PERSONAL INFO -->
<div class="tab-content" id="tab-personal">
    <form method="post" action="@Url.Action("UpdateProfile", "Profile")" id="personalInfoForm">
        <div class="profile-card">
            <div class="profile-card-header">
                <i class="fas fa-user-circle"></i>
                <h4>Personal Details</h4>
            </div>
            <div class="profile-card-body">
                <div class="row-3col">
                    <div class="form-group">
                        <label>Title</label>
                        <select name="title" class="form-control">
                            <option value="Dr." selected>Dr.</option>
                            <option value="Prof.">Prof.</option>
                            <option value="Mr.">Mr.</option>
                            <option value="Mrs.">Mrs.</option>
                            <option value="Ms.">Ms.</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>First Name</label>
                        <input type="text" name="name" class="form-control" value="Sarah" placeholder="First name">
                    </div>
                    <div class="form-group">
                        <label>Last Name</label>
                        <input type="text" name="surname" class="form-control" value="Johnson" placeholder="Last name">
                    </div>
                </div>
                <div class="form-group">
                    <label>SA ID Number</label>
                    <input type="text" name="idNumber" class="form-control" value="850615 1234 567" placeholder="850615 1234 567">
