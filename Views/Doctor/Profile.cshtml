<script type="text/javascript">
    // ─── TABS ───
    document.querySelectorAll('.profile-tab').forEach(function(tab) {
        tab.addEventListener('click', function() {
            document.querySelectorAll('.profile-tab').forEach(function(t) {
                t.classList.remove('active');
            });
            this.classList.add('active');

            document.querySelectorAll('.tab-content').forEach(function(content) {
                content.classList.remove('active');
            });

            var tabId = this.getAttribute('data-tab');
            document.getElementById('tab-' + tabId).classList.add('active');
        });
    });

    // ─── PASSWORD VALIDATION ───
    function checkPasswordStrength() {
        var password = document.getElementById('newPassword').value;
        var lengthOk = password.length >= 8;
        var upperOk = /[A-Z]/.test(password);
        var numberOk = /[0-9]/.test(password);
        var specialOk = /[!@@#$%^&*(),.?":{}|<>]/.test(password);

        document.getElementById('reqLength').style.color = lengthOk ? '#10B981' : '#5A6E7A';
        document.getElementById('reqUpper').style.color = upperOk ? '#10B981' : '#5A6E7A';
        document.getElementById('reqNumber').style.color = numberOk ? '#10B981' : '#5A6E7A';
        document.getElementById('reqSpecial').style.color = specialOk ? '#10B981' : '#5A6E7A';

        document.getElementById('reqLength').className = lengthOk ? 'fas fa-check-circle' : 'fas fa-circle';
        document.getElementById('reqUpper').className = upperOk ? 'fas fa-check-circle' : 'fas fa-circle';
        document.getElementById('reqNumber').className = numberOk ? 'fas fa-check-circle' : 'fas fa-circle';
        document.getElementById('reqSpecial').className = specialOk ? 'fas fa-check-circle' : 'fas fa-circle';

        return lengthOk && upperOk && numberOk && specialOk;
    }

    function checkPasswordMatch() {
        var password = document.getElementById('newPassword').value;
        var confirm = document.getElementById('confirmPassword').value;
        var matchMsg = document.getElementById('matchMessage');

        if (confirm.length > 0) {
            if (password === confirm) {
                matchMsg.innerHTML = '<i class="fas fa-check-circle" style="color:#10B981;"></i> Passwords match';
                matchMsg.style.color = '#10B981';
            } else {
                matchMsg.innerHTML = '<i class="fas fa-exclamation-circle" style="color:#DC2626;"></i> Passwords do not match';
                matchMsg.style.color = '#DC2626';
            }
        } else {
            matchMsg.innerHTML = '';
        }
    }

    // ─── TOAST SYSTEM ───
    function showToast(type, title, message) {
        var container = document.getElementById('toastContainer');
        if (!container) {
            console.warn('Toast container not found');
            return;
        }

        var toast = document.createElement('div');
        toast.className = 'toast-item';

        var iconClass = type === 'success' ? 'success' : type === 'error' ? 'error' : 'info';
        var iconHtml = type === 'success' ? '<i class="fas fa-check-circle"></i>' :
                       type === 'error' ? '<i class="fas fa-exclamation-circle"></i>' :
                       '<i class="fas fa-info-circle"></i>';

        toast.innerHTML = `
            <div class="toast-icon ${iconClass}">${iconHtml}</div>
            <div class="toast-content">
                <div class="toast-title">${title}</div>
                <div class="toast-message">${message}</div>
            </div>
            <button class="toast-close" onclick="this.closest('.toast-item').remove()">&times;</button>
        `;
        container.appendChild(toast);

        setTimeout(function() {
            if (toast.parentNode) toast.remove();
        }, 5000);
    }

    // ─── FORM SUBMISSIONS ───
    function submitPersonalInfo() {
        showToast('success', 'Profile Updated', 'Your personal information has been saved successfully.');
    }

    function submitProfessional() {
        showToast('success', 'Professional Info Updated', 'Your professional information has been saved successfully.');
    }

    function submitPassword() {
        var password = document.getElementById('newPassword').value;
        var confirm = document.getElementById('confirmPassword').value;

        if (!checkPasswordStrength()) {
            showToast('error', 'Password Too Weak', 'Please ensure your password meets all requirements.');
            return;
        }

        if (password !== confirm) {
            showToast('error', 'Passwords Mismatch', 'Your passwords do not match. Please try again.');
            return;
        }

        if (password.length > 0) {
            showToast('success', 'Password Changed', 'Your password has been updated successfully.');
            document.getElementById('passwordForm').reset();
            document.getElementById('matchMessage').innerHTML = '';
        }
    }

    function toggleTwoFactor() {
        var isChecked = document.getElementById('twoFactorToggle').checked;
        if (isChecked) {
            showToast('info', '2FA Enabled', 'Two-Factor Authentication has been enabled. You will receive verification codes via SMS.');
        } else {
            showToast('info', '2FA Disabled', 'Two-Factor Authentication has been disabled.');
        }
    }

    // ─── EVENT LISTENERS ───
    var newPass = document.getElementById('newPassword');
    var confirmPass = document.getElementById('confirmPassword');

    if (newPass) {
        newPass.oninput = function() {
            checkPasswordStrength();
            checkPasswordMatch();
        };
    }

    if (confirmPass) {
        confirmPass.oninput = function() {
            checkPasswordMatch();
        };
    }

    console.log('👤 Doctor Profile loaded successfully.');
</script>