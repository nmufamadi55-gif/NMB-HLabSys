@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "My Profile";
    ViewData["RoleSubtitle"] = "Doctor Portal";
    ViewData["UserGreeting"] = ViewBag.UserGreeting ?? "Doctor";

    var userName = ViewBag.UserName as string ?? "Doctor";
    var userEmail = ViewBag.UserEmail as string ?? "";
    var initials = ViewBag.UserInitials as string ?? "DR";
    var greeting = ViewBag.UserGreeting as string ?? userName;
    var contact = ViewBag.ContactNumber as string ?? "";
    var hpcsa = ViewBag.HPCSANumber as string ?? "—";
    var specialization = ViewBag.Specialization as string ?? "—";
    var practiceName = ViewBag.PracticeName as string ?? "—";
    var practiceAddr = ViewBag.PracticeAddress as string ?? "—";
    var isVerified = ViewBag.IsVerified as bool? ?? false;
    var isActive = ViewBag.IsActive as bool? ?? true;
    var registeredDate = ViewBag.RegisteredDate as DateTime?;
    var createdDate = ViewBag.CreatedDate as DateTime?;
    var lastModified = ViewBag.LastModified as DateTime?;

    var nameParts = userName.Split(' ', 2, StringSplitOptions.RemoveEmptyEntries);
    var firstName = nameParts.Length > 0 ? nameParts[0] : "";
    var lastName = nameParts.Length > 1 ? nameParts[1] : "";
    var activeTab = ViewBag.ActiveTab as string ?? "overview";
}

@section SidebarMenu {
    <li><a href="@Url.Action("Dashboard", "Doctor")"><i class="fas fa-chart-pie"></i> <span>Dashboard</span></a></li>
    <li><a href="@Url.Action("TestRequests", "Doctor")"><i class="fas fa-notes-medical"></i> <span>Test Requests</span></a></li>
    <li><a href="@Url.Action("Patients", "Doctor")"><i class="fas fa-users"></i> <span>My Patients</span></a></li>
    <li><a href="@Url.Action("Alerts", "Doctor")"><i class="fas fa-bell"></i> <span>Alerts</span></a></li>
    <li><a href="@Url.Action("Results", "Doctor")"><i class="fas fa-chart-line"></i> <span>Results</span></a></li>
    <li><a href="@Url.Action("Reports", "Doctor")"><i class="fas fa-file-alt"></i> <span>Reports</span></a></li>
    <li><a href="@Url.Action("Index", "Profile")" class="active"><i class="fas fa-user-circle"></i> <span>My Profile</span></a></li>
}

@section Styles {
    <style>
        .profile-header {
            background: #fff;
            border-radius: 20px;
            padding: 2rem 2.5rem;
            margin-bottom: 1.8rem;
            box-shadow: 0 2px 12px rgba(0,0,0,0.04);
            border: 1px solid #E8EDF5;
            display: flex;
            align-items: center;
            gap: 2rem;
            flex-wrap: wrap;
            position: relative;
        }

        .profile-avatar-wrapper {
            position: relative;
            flex-shrink: 0;
        }

        .profile-avatar {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            background: linear-gradient(135deg, #0841C9, #1D97F1);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 2rem;
            font-weight: 700;
            box-shadow: 0 4px 16px rgba(8,65,201,0.25);
        }

        .profile-header-info h2 {
            font-size: 1.5rem;
            font-weight: 700;
            color: #1A2C3A;
            margin: 0 0 0.2rem;
        }

        .profile-header-info .role-tag {
            display: inline-block;
            background: rgba(8,65,201,0.08);
            color: #0841C9;
            padding: 0.15rem 0.8rem;
            border-radius: 40px;
            font-size: 0.7rem;
            font-weight: 600;
        }

        .profile-header-info .sub-info {
            color: #5A6E7A;
            font-size: 0.85rem;
            margin-top: 0.4rem;
            display: flex;
            flex-wrap: wrap;
            gap: 0.9rem;
        }

            .profile-header-info .sub-info span {
                display: inline-flex;
                align-items: center;
                gap: 0.3rem;
            }

            .profile-header-info .sub-info i {
                color: #0841C9;
            }

        .badge-status {
            display: inline-block;
            padding: 0.15rem 0.6rem;
            border-radius: 40px;
            font-size: 0.7rem;
            font-weight: 600;
        }

            .badge-status.active {
                background: rgba(16,185,129,0.08);
                color: #10B981;
            }

            .badge-status.inactive {
                background: rgba(239,68,68,0.08);
                color: #EF4444;
            }

        .profile-tabs {
            display: flex;
            gap: 0.2rem;
            background: #fff;
            border-radius: 20px;
            padding: 0.3rem;
            margin-bottom: 1.8rem;
            box-shadow: 0 2px 12px rgba(0,0,0,0.04);
            border: 1px solid #E8EDF5;
            overflow-x: auto;
        }

        .profile-tab {
            padding: 0.6rem 1.4rem;
            border-radius: 12px;
            border: none;
            background: transparent;
            font-weight: 600;
            font-size: 0.85rem;
            color: #5A6E7A;
            cursor: pointer;
            transition: all 0.25s;
            white-space: nowrap;
            font-family: inherit;
        }

            .profile-tab:hover {
                background: rgba(8,65,201,0.04);
                color: #1A2C3A;
            }

            .profile-tab.active {
                background: linear-gradient(135deg, #0841C9, #1D97F1);
                color: #fff;
                box-shadow: 0 4px 16px rgba(8,65,201,0.2);
            }

            .profile-tab i {
                margin-right: 0.4rem;
            }

        .tab-content {
            display: none;
            animation: fadeUp 0.4s ease both;
        }

            .tab-content.active {
                display: block;
            }

        @@keyframes fadeUp {
            0% {
                opacity: 0;
                transform: translateY(12px);
            }

            100% {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .profile-card-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1.5rem;
        }

        .profile-card {
            background: #fff;
            border-radius: 20px;
            border: 1px solid #E8EDF5;
            box-shadow: 0 2px 12px rgba(0,0,0,0.04);
            overflow: hidden;
        }

        .profile-card-header {
            padding: 1rem 1.5rem;
            background: #F8FAFE;
            border-bottom: 1px solid #E8EDF5;
            display: flex;
            align-items: center;
            gap: 0.6rem;
        }

            .profile-card-header h4 {
                font-size: 1rem;
                font-weight: 700;
                color: #1A2C3A;
                margin: 0;
            }

            .profile-card-header i {
                color: #0841C9;
                font-size: 1.1rem;
            }

        .profile-card-body {
            padding: 1.5rem;
        }

            .profile-card-body .info-row {
                display: flex;
                justify-content: space-between;
                padding: 0.5rem 0;
                border-bottom: 1px solid #F1F5F9;
                font-size: 0.9rem;
            }

                .profile-card-body .info-row:last-child {
                    border-bottom: none;
                }

            .profile-card-body .info-label {
                color: #5A6E7A;
                font-weight: 500;
            }

            .profile-card-body .info-value {
                color: #1A2C3A;
                font-weight: 500;
                text-align: right;
                word-break: break-word;
            }

        .form-group {
            margin-bottom: 1.2rem;
        }

            .form-group label {
                font-size: 0.8rem;
                font-weight: 600;
                display: block;
                margin-bottom: 0.3rem;
                color: #032C7D;
            }

        .form-control {
            width: 100%;
            padding: 0.6rem 0.8rem;
            border: 1.5px solid #E8EDF5;
            border-radius: 12px;
            font-size: 0.85rem;
            font-family: inherit;
            transition: all 0.25s;
            background: #F8FAFE;
            color: #1A2C3A;
        }

            .form-control:focus {
                outline: none;
                border-color: #0841C9;
                box-shadow: 0 0 0 4px rgba(8,65,201,0.08);
                background: #fff;
            }

        .btn-primary {
            background: linear-gradient(135deg, #0841C9, #1D97F1);
            color: #fff;
            border: none;
            padding: 0.6rem 1.4rem;
            border-radius: 40px;
            font-weight: 600;
            font-size: 0.85rem;
            cursor: pointer;
            transition: all 0.25s;
            box-shadow: 0 4px 16px rgba(8,65,201,0.2);
            font-family: inherit;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
        }

            .btn-primary:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 28px rgba(8,65,201,0.35);
            }

        .row-2col {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1rem;
        }

        .alert-success {
            background: #D1FAE5;
            color: #065F46;
            padding: 0.8rem 1rem;
            border-radius: 12px;
            margin-bottom: 1rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            border: 1px solid #A7F3D0;
            font-size: 0.85rem;
        }

        .alert-error {
            background: #FEE2E2;
            color: #991B1B;
            padding: 0.8rem 1rem;
            border-radius: 12px;
            margin-bottom: 1rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            border: 1px solid #FECACA;
            font-size: 0.85rem;
        }

        .password-requirements {
            font-size: 0.75rem;
            color: #5A6E7A;
            margin-top: 0.5rem;
            line-height: 1.9;
        }

            .password-requirements > div {
                display: flex;
                align-items: center;
                gap: 0.4rem;
                transition: color 0.2s;
            }

                .password-requirements > div i {
                    font-size: 0.5rem;
                    color: #CBD5E1;
                    transition: color 0.2s;
                }

                .password-requirements > div.met {
                    color: #10B981;
                }

                    .password-requirements > div.met i {
                        color: #10B981;
                    }

        @@media (max-width: 1024px) {
            .profile-card-grid {
                grid-template-columns: 1fr;
            }
        }

        @@media (max-width: 768px) {
            .profile-header {
                flex-direction: column;
                align-items: flex-start;
                padding: 1.5rem;
            }

            .row-2col {
                grid-template-columns: 1fr;
            }
        }

        @@media (max-width: 480px) {
            .profile-tab {
                font-size: 0.75rem;
                padding: 0.4rem 0.8rem;
            }
        }
    </style>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert-success">
        <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert-error">
        <i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]
    </div>
}

<div class="profile-header">
    <div class="profile-avatar-wrapper">
        <div class="profile-avatar">@initials</div>
    </div>
    <div class="profile-header-info">
        <h2>@greeting</h2>
        <span class="role-tag">
            <i class="fas fa-user-md"></i> @specialization
        </span>
        <div class="sub-info">
            <span><i class="fas fa-envelope"></i> @userEmail</span>
            @if (!string.IsNullOrEmpty(contact))
            {
                <span><i class="fas fa-phone"></i> @contact</span>
            }
            <span><i class="fas fa-id-card"></i> HPCSA: @hpcsa</span>
            <span class="badge-status @(isActive ? "active" : "inactive")">
                <i class="fas fa-circle" style="font-size:0.4rem; vertical-align:middle;"></i>
                @(isActive ? "Active" : "Inactive")
            </span>
            @if (isVerified)
            {
                <span class="badge-status active" style="background:rgba(8,65,201,0.08); color:#0841C9;">
                    <i class="fas fa-check-circle"></i> Verified
                </span>
            }
        </div>
    </div>
</div>

<div class="profile-tabs" id="profileTabs">
    <button type="button" class="profile-tab @(activeTab == "overview" ? "active" : "")" data-tab="overview">
        <i class="fas fa-th-large"></i> Overview
    </button>
    <button type="button" class="profile-tab @(activeTab == "personal" ? "active" : "")" data-tab="personal">
        <i class="fas fa-user"></i> Personal Info
    </button>
    <button type="button" class="profile-tab @(activeTab == "professional" ? "active" : "")" data-tab="professional">
        <i class="fas fa-briefcase"></i> Professional
    </button>
    <button type="button" class="profile-tab @(activeTab == "security" ? "active" : "")" data-tab="security">
        <i class="fas fa-shield-alt"></i> Security
    </button>
</div>

<div class="tab-content @(activeTab == "overview" ? "active" : "")" id="tab-overview">

    <div class="profile-card-grid">
        <div class="profile-card">
            <div class="profile-card-header">
                <i class="fas fa-user-circle"></i>
                <h4>Account Information</h4>
            </div>
            <div class="profile-card-body">
                <div class="info-row">
                    <span class="info-label">Full Name</span>
                    <span class="info-value">@userName</span>
                </div>
                <div class="info-row">
                    <span class="info-label">Email</span>
                    <span class="info-value">@userEmail</span>
                </div>
                <div class="info-row">
                    <span class="info-label">Contact Number</span>
                    <span class="info-value">@(string.IsNullOrEmpty(contact) ? "Not set" : contact)</span>
                </div>
                <div class="info-row">
                    <span class="info-label">HPCSA Number</span>
                    <span class="info-value">@hpcsa</span>
                </div>
                <div class="info-row">
                    <span class="info-label">Specialization</span>
                    <span class="info-value">@specialization</span>
                </div>
                <div class="info-row">
                    <span class="info-label">Account Status</span>
                    <span class="info-value">
                        <span class="badge-status @(isActive ? "active" : "inactive")">
                            @(isActive ? "Active" : "Inactive")
                        </span>
                    </span>
                </div>
            </div>
        </div>

        <div class="profile-card">
            <div class="profile-card-header">
                <i class="fas fa-briefcase"></i>
                <h4>Practice Information</h4>
            </div>
            <div class="profile-card-body">
                <div class="info-row">
                    <span class="info-label">Practice Name</span>
                    <span class="info-value">@practiceName</span>
                </div>
                <div class="info-row">
                    <span class="info-label">Practice Address</span>
                    <span class="info-value">@practiceAddr</span>
                </div>
                <div class="info-row">
                    <span class="info-label">Verified</span>
                    <span class="info-value">
                        @if (isVerified)
                        {
                            <span class="badge-status active">
                                <i class="fas fa-check-circle"></i> Verified
                            </span>
                        }
                        else
                        {
                            <span class="badge-status inactive">
                                <i class="fas fa-clock"></i> Pending
                            </span>
                        }
                    </span>
                </div>
                <div class="info-row">
                    <span class="info-label">Registered Date</span>
                    <span class="info-value">
                        @(registeredDate.HasValue? registeredDate.Value.ToString("dd MMM yyyy") : "—")
                    </span>
                </div>
            </div>
        </div>
    </div>

    <div class="profile-card" style="margin-top:1.5rem;">
        <div class="profile-card-header">
            <i class="fas fa-clock"></i>
            <h4>Account Timeline</h4>
        </div>
        <div class="profile-card-body">
            <div class="info-row">
                <span class="info-label">Account Created</span>
                <span class="info-value">
                    @(createdDate.HasValue? createdDate.Value.ToString("dd MMM yyyy HH:mm") : "—")
                </span>
            </div>
            <div class="info-row">
                <span class="info-label">Last Updated</span>
                <span class="info-value">
                    @(lastModified.HasValue? lastModified.Value.ToString("dd MMM yyyy HH:mm") : "Never")
                </span>
            </div>
        </div>
    </div>

</div>

<div class="tab-content @(activeTab == "personal" ? "active" : "")" id="tab-personal">
    <form method="post" action="@Url.Action("UpdateProfile", "Profile")" novalidate>
        @Html.AntiForgeryToken()

        <div class="profile-card">
            <div class="profile-card-header">
                <i class="fas fa-user-circle"></i>
                <h4>Personal Details</h4>
            </div>
            <div class="profile-card-body">

                <div class="row-2col">
                    <div class="form-group">
                        <label>First Name</label>
                        <input type="text" name="name" class="form-control"
                               value="@firstName" placeholder="First name" required />
                    </div>
                    <div class="form-group">
                        <label>Last Name</label>
                        <input type="text" name="surname" class="form-control"
                               value="@lastName" placeholder="Last name" required />
                    </div>
                </div>

                <div class="form-group">
                    <label>Email Address (Username)</label>
                    <input type="email" name="email" class="form-control"
                           value="@userEmail" placeholder="email@example.com" required />
                    <small style="font-size:0.7rem; color:#5A6E7A;">
                        This is your login username.
                    </small>
                </div>

                <div class="form-group">
                    <label>Phone Number</label>
                    <input type="tel" name="phone" class="form-control"
                           value="@contact" placeholder="082 123 4567" />
                </div>

                <div class="form-group">
                    <button type="submit" class="btn-primary">
                        <i class="fas fa-save"></i> Save Changes
                    </button>
                </div>

            </div>
        </div>
    </form>
</div>

<div class="tab-content @(activeTab == "professional" ? "active" : "")" id="tab-professional">
    <div class="profile-card">
        <div class="profile-card-header">
            <i class="fas fa-briefcase"></i>
            <h4>Professional Information</h4>
        </div>
        <div class="profile-card-body">

            <div class="info-row">
                <span class="info-label">HPCSA Number</span>
                <span class="info-value">@hpcsa</span>
            </div>
            <div class="info-row">
                <span class="info-label">Specialization</span>
                <span class="info-value">@specialization</span>
            </div>
            <div class="info-row">
                <span class="info-label">Practice Name</span>
                <span class="info-value">@practiceName</span>
            </div>
            <div class="info-row">
                <span class="info-label">Practice Address</span>
                <span class="info-value">@practiceAddr</span>
            </div>
            <div class="info-row">
                <span class="info-label">Verified</span>
                <span class="info-value">
                    @if (isVerified)
                    {
                        <span class="badge-status active">Verified</span>
                    }
                    else
                    {
                        <span class="badge-status inactive">Pending verification</span>
                    }
                </span>
            </div>
            <div class="info-row">
                <span class="info-label">Registered Date</span>
                <span class="info-value">
                    @(registeredDate.HasValue? registeredDate.Value.ToString("dd MMM yyyy") : "—")
                </span>
            </div>

            <div style="margin-top:1.2rem; padding-top:1.2rem; border-top:1px solid #F1F5F9;">
                <p style="font-size:0.78rem; color:#5A6E7A; margin:0;">
                    <i class="fas fa-info-circle" style="color:#0841C9;"></i>
                    Professional details are managed by the laboratory administrator.
                    Contact them to update your HPCSA number, practice, or verification status.
                </p>
            </div>

        </div>
    </div>
</div>

<div class="tab-content @(activeTab == "security" ? "active" : "")" id="tab-security">
    <div class="profile-card-grid">

        <div class="profile-card">
            <div class="profile-card-header">
                <i class="fas fa-lock"></i>
                <h4>Change Password</h4>
            </div>
            <div class="profile-card-body">
                <form method="post" action="@Url.Action("ChangePassword", "Profile")" novalidate>
                    @Html.AntiForgeryToken()

                    <div class="form-group">
                        <label>Current Password</label>
                        <input type="password" name="currentPassword" class="form-control"
                               placeholder="Enter your current password" required />
                    </div>

                    <div class="form-group">
                        <label>New Password</label>
                        <input type="password" name="newPassword" id="newPassword"
                               class="form-control" placeholder="Enter new password"
                               required minlength="8" />
                        <div class="password-requirements" id="pwdRequirements">
                            <div data-req="length"><i class="fas fa-circle"></i> At least 8 characters</div>
                            <div data-req="upper"><i class="fas fa-circle"></i> One uppercase letter</div>
                            <div data-req="lower"><i class="fas fa-circle"></i> One lowercase letter</div>
                            <div data-req="number"><i class="fas fa-circle"></i> One number</div>
                            <div data-req="special"><i class="fas fa-circle"></i> One special character (@@$!%*?&amp;)</div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Confirm New Password</label>
                        <input type="password" name="confirmPassword" class="form-control"
                               placeholder="Confirm new password" required minlength="8" />
                    </div>

                    <div class="form-group">
                        <button type="submit" class="btn-primary">
                            <i class="fas fa-key"></i> Update Password
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <div class="profile-card">
            <div class="profile-card-header">
                <i class="fas fa-shield-alt"></i>
                <h4>Account Security</h4>
            </div>
            <div class="profile-card-body">

                <div class="info-row">
                    <span class="info-label">Account Status</span>
                    <span class="info-value">
                        <span class="badge-status @(isActive ? "active" : "inactive")">
                            @(isActive ? "Active" : "Inactive")
                        </span>
                    </span>
                </div>

                <div class="info-row">
                    <span class="info-label">Role</span>
                    <span class="info-value">Doctor</span>
                </div>

                <div class="info-row">
                    <span class="info-label">Email</span>
                    <span class="info-value">@userEmail</span>
                </div>

                <div class="info-row" style="border-bottom:none;">
                    <span class="info-label">Account Created</span>
                    <span class="info-value">
                        @(createdDate.HasValue? createdDate.Value.ToString("dd MMM yyyy") : "—")
                    </span>
                </div>

                <div style="margin-top:1.2rem; padding-top:1.2rem; border-top:1px solid #F1F5F9;">
                    <p style="font-size:0.78rem; color:#5A6E7A; margin:0;">
                        <i class="fas fa-info-circle" style="color:#0841C9;"></i>
                        Keep your password confidential. Contact the administrator if you suspect
                        your account has been compromised.
                    </p>
                </div>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    <text>
        <script>
            // TABS
            document.querySelectorAll('.profile-tab').forEach(function (tab) {
                tab.addEventListener('click', function () {
                    document.querySelectorAll('.profile-tab').forEach(function (t) { t.classList.remove('active'); });
                    document.querySelectorAll('.tab-content').forEach(function (c) { c.classList.remove('active'); });
                    this.classList.add('active');
                    var tabId = this.getAttribute('data-tab');
                    var content = document.getElementById('tab-' + tabId);
                    if (content) content.classList.add('active');
                });
            });

            // LIVE PASSWORD REQUIREMENT INDICATORS
            (function () {
                var pwdInput = document.getElementById('newPassword');
                var reqs = document.querySelectorAll('#pwdRequirements > div');
                if (!pwdInput || !reqs.length) return;

                function checkRequirements(value) {
                    var tests = {
                        length:  value.length >= 8,
                        upper:   /[A-Z]/.test(value),
                        lower:   /[a-z]/.test(value),
                        number:  /[0-9]/.test(value),
                        special: /[^A-Za-z0-9]/.test(value)
                    };

                    reqs.forEach(function (req) {
                        var key = req.getAttribute('data-req');
                        var icon = req.querySelector('i');
                        if (tests[key]) {
                            req.classList.add('met');
                            if (icon) icon.className = 'fas fa-check-circle';
                        } else {
                            req.classList.remove('met');
                            if (icon) icon.className = 'fas fa-circle';
                        }
                    });

                    return Object.values(tests).every(Boolean);
                }

                pwdInput.addEventListener('input', function () {
                    checkRequirements(this.value);
                });

                if (pwdInput.value) checkRequirements(pwdInput.value);
            })();

            // CHANGE PASSWORD — inline error box
            var changePwdForm = document.querySelector('form[action*="ChangePassword"]');
            if (changePwdForm) {
                var errorBox = document.createElement('div');
                errorBox.id = 'changePwdErrorBox';
                errorBox.style.cssText = 'display:none; background:#FEE2E2; color:#991B1B; ' +
                                         'padding:0.75rem 1rem; border-radius:10px; font-size:0.85rem; ' +
                                         'margin-bottom:1rem; border-left:4px solid #DC2626;';
                var cardBody = changePwdForm.querySelector('.profile-card-body') || changePwdForm;
                cardBody.insertBefore(errorBox, cardBody.firstChild);

                function showErrors(errors) {
                    if (!errors.length) { errorBox.style.display = 'none'; return; }
                    errorBox.innerHTML = '<strong><i class="fas fa-exclamation-circle"></i> Please fix:</strong>' +
                        '<ul style="margin:0.4rem 0 0 1.2rem;">' +
                        errors.map(function (e) { return '<li>' + e + '</li>'; }).join('') +
                        '</ul>';
                    errorBox.style.display = 'block';
                    errorBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
                }

                changePwdForm.addEventListener('submit', function (e) {
                    var newPwd = document.getElementById('newPassword').value;
                    var confirmPwd = this.querySelector('input[name="confirmPassword"]').value;
                    var currentPwd = this.querySelector('input[name="currentPassword"]').value;
                    var errors = [];

                    if (!currentPwd) errors.push('Current password is required.');
                    if (newPwd.length < 8) errors.push('At least 8 characters.');
                    if (!/[A-Z]/.test(newPwd)) errors.push('One uppercase letter.');
                    if (!/[a-z]/.test(newPwd)) errors.push('One lowercase letter.');
                    if (!/[0-9]/.test(newPwd)) errors.push('One number.');
                    if (!/[^A-Za-z0-9]/.test(newPwd)) errors.push('One special character.');
                    if (newPwd !== confirmPwd) errors.push('Passwords must match.');

                    if (errors.length) {
                        e.preventDefault();
                        showErrors(errors);
                        return;
                    }

                    showErrors([]);
                    var btn = this.querySelector('button[type="submit"]');
                    if (btn) {
                        btn.disabled = true;
                        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Updating...';
                    }
                });
            }

            // UPDATE PROFILE — inline error box
            var updateProfileForm = document.querySelector('form[action*="UpdateProfile"]');
            if (updateProfileForm) {
                var pErrorBox = document.createElement('div');
                pErrorBox.id = 'updateProfileErrorBox';
                pErrorBox.style.cssText = 'display:none; background:#FEE2E2; color:#991B1B; ' +
                                          'padding:0.75rem 1rem; border-radius:10px; font-size:0.85rem; ' +
                                          'margin-bottom:1rem; border-left:4px solid #DC2626;';
                var pCardBody = updateProfileForm.querySelector('.profile-card-body') || updateProfileForm;
                pCardBody.insertBefore(pErrorBox, pCardBody.firstChild);

                function showProfileErrors(errors) {
                    if (!errors.length) { pErrorBox.style.display = 'none'; return; }
                    pErrorBox.innerHTML = '<strong><i class="fas fa-exclamation-circle"></i> Please fix:</strong>' +
                        '<ul style="margin:0.4rem 0 0 1.2rem;">' +
                        errors.map(function (e) { return '<li>' + e + '</li>'; }).join('') +
                        '</ul>';
                    pErrorBox.style.display = 'block';
                    pErrorBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
                }

                updateProfileForm.addEventListener('submit', function (e) {
                    var name = this.querySelector('input[name="name"]').value.trim();
                    var surname = this.querySelector('input[name="surname"]').value.trim();
                    var phone = this.querySelector('input[name="phone"]').value.trim();
                    var errors = [];

                    if (name.length < 2) errors.push('First name must be at least 2 characters.');
                    if (surname.length < 2) errors.push('Last name must be at least 2 characters.');

                    if (phone) {
                        var cleanPhone = phone.replace(/[\s\-]/g, '');
                        var phoneRe = /^(0[1-9][0-9]{8}|\+27[1-9][0-9]{8})$/;
                        if (!phoneRe.test(cleanPhone)) {
                            errors.push('Please enter a valid SA phone number (e.g. 0821234567).');
                        }
                    }

                    if (errors.length) {
                        e.preventDefault();
                        showProfileErrors(errors);
                        return;
                    }

                    showProfileErrors([]);
                    var btn = this.querySelector('button[type="submit"]');
                    if (btn) {
                        btn.disabled = true;
                        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Saving...';
                    }
                });
            }
        </script>
    </text>
}