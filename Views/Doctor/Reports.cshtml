@model NMB_HLabSys.Models.ViewModels.DoctorReportFilterViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Reports";
    ViewData["RoleSubtitle"] = "Doctor Portal";
    ViewData["UserGreeting"] = "Generate PDF reports";
    ViewData["UserInitials"] = "SJ";
    ViewData["UserName"] = "Sarah Johnson";
}

@section SidebarMenu {
    <li><a href="@Url.Action("Dashboard", "Doctor")"><i class="fas fa-chart-pie"></i> <span>Dashboard</span></a></li>
    <li><a href="@Url.Action("TestRequests", "Doctor")"><i class="fas fa-notes-medical"></i> <span>Test Requests</span></a></li>
    <li><a href="@Url.Action("Patients", "Doctor")"><i class="fas fa-users"></i> <span>My Patients</span></a></li>
    <li><a href="@Url.Action("Alerts", "Doctor")"><i class="fas fa-bell"></i> <span>Alerts</span></a></li>
    <li><a href="@Url.Action("Results", "Doctor")"><i class="fas fa-chart-line"></i> <span>Results</span></a></li>
    <li><a href="@Url.Action("Reports", "Doctor")" class="active"><i class="fas fa-file-alt"></i> <span>Reports</span></a></li>
    <li><a href="@Url.Action("Index", "Profile")"><i class="fas fa-user-circle"></i> <span>My Profile</span></a></li>
}

@section Styles {
    <style>
        .panel {
            background: white;
            border-radius: 20px;
            padding: 1.5rem;
            margin-bottom: 1.2rem;
            border: 1px solid #E2E8F0;
        }

        .panel-title {
            color: #032C7D;
            font-size: 1rem;
            margin: 0 0 1rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            padding-bottom: 0.6rem;
            border-bottom: 1px solid #E2E8F0;
        }

            .panel-title i {
                color: #0841C9;
            }

        .form-group {
            margin-bottom: 1.1rem;
        }

            .form-group label {
                display: block;
                font-size: 0.8rem;
                font-weight: 600;
                color: #032C7D;
                margin-bottom: 0.4rem;
            }

        .form-control {
            width: 100%;
            padding: 0.7rem 1rem;
            border: 1px solid #E2E8F0;
            border-radius: 12px;
            font-size: 0.9rem;
            font-family: inherit;
        }

            .form-control:focus {
                outline: none;
                border-color: #0841C9;
                box-shadow: 0 0 0 3px rgba(8,65,201,0.1);
            }

        .row-2col {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1rem;
        }

        .btn {
            padding: 0.7rem 1.5rem;
            border-radius: 12px;
            font-size: 0.85rem;
            font-weight: 600;
            cursor: pointer;
            border: none;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            transition: all 0.2s;
            font-family: inherit;
        }

        .btn-primary {
            background: #0841C9;
            color: white;
        }

            .btn-primary:hover {
                background: #032C7D;
                color: white;
            }

        .btn-success {
            background: #10B981;
            color: white;
        }

            .btn-success:hover {
                background: #059669;
                color: white;
            }

        .btn-outline {
            background: transparent;
            border: 1px solid #E2E8F0;
            color: #1A2C3A;
        }

            .btn-outline:hover {
                background: #F1F5F9;
                color: #1A2C3A;
            }

        .alert {
            padding: 0.8rem 1rem;
            border-radius: 10px;
            margin-bottom: 1rem;
            font-size: 0.85rem;
        }

        .alert-success {
            background: #D1FAE5;
            color: #065F46;
            border-left: 4px solid #10B981;
        }

        .alert-danger {
            background: #FEE2E2;
            color: #991B1B;
            border-left: 4px solid #DC2626;
        }

        .info-note {
            background: #EFF6FF;
            border-left: 4px solid #0841C9;
            border-radius: 10px;
            padding: 0.9rem 1rem;
            font-size: 0.82rem;
            color: #1A2C3A;
            line-height: 1.5;
            margin-bottom: 1rem;
        }

            .info-note i {
                color: #0841C9;
                margin-right: 0.4rem;
            }

        .quick-range {
            display: flex;
            gap: 0.5rem;
            flex-wrap: wrap;
            margin-top: 0.5rem;
        }

            .quick-range button {
                padding: 0.35rem 0.9rem;
                border-radius: 30px;
                border: 1px solid #E2E8F0;
                background: white;
                color: #1A2C3A;
                font-size: 0.75rem;
                font-weight: 600;
                cursor: pointer;
                transition: all 0.15s;
                font-family: inherit;
            }

                .quick-range button:hover {
                    border-color: #0841C9;
                    color: #0841C9;
                    background: #EFF6FF;
                }

        @@media (max-width: 768px) {
            .row-2col {
                grid-template-columns: 1fr;
            }
        }
    </style>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="panel">
    <h3 class="panel-title"><i class="fas fa-file-pdf"></i> Generate Test Request Report</h3>

    <div class="info-note">
        <i class="fas fa-info-circle"></i>
        This report includes all test requests you submitted in the selected date range,
        including patient details, test statuses, results, and abnormal flags.
    </div>

    <form asp-action="GenerateReport" method="post" target="_blank">
        @Html.AntiForgeryToken()

        <div class="row-2col">
            <div class="form-group">
                <label>Start Date <span style="color:#DC2626;">*</span></label>
                <input type="date" asp-for="StartDate" class="form-control"
                       value="@Model.StartDate.ToString("yyyy-MM-dd")" required />
            </div>
            <div class="form-group">
                <label>End Date <span style="color:#DC2626;">*</span></label>
                <input type="date" asp-for="EndDate" class="form-control"
                       value="@Model.EndDate.ToString("yyyy-MM-dd")" required />
            </div>
        </div>

        <div class="quick-range">
            <button type="button" onclick="setRange(7)">Last 7 days</button>
            <button type="button" onclick="setRange(30)">Last 30 days</button>
            <button type="button" onclick="setRange(90)">Last 90 days</button>
            <button type="button" onclick="setRange(365)">Last year</button>
        </div>

        <div class="row-2col" style="margin-top:1.1rem;">
            <div class="form-group">
                <label>Status</label>
                <select asp-for="Status" class="form-control">
                    <option value="all">All Statuses</option>
                    <option value="Submitted">Submitted</option>
                    <option value="Samples Received">Samples Received</option>
                    <option value="In Progress">In Progress</option>
                    <option value="Completed">Completed</option>
                    <option value="Verified">Verified</option>
                    <option value="Released">Released</option>
                    <option value="Cancelled">Cancelled</option>
                </select>
            </div>
            <div class="form-group">
                <label>Urgency</label>
                <select asp-for="Urgency" class="form-control">
                    <option value="all">All Urgencies</option>
                    <option value="stat">STAT</option>
                    <option value="urgent">Urgent</option>
                    <option value="routine">Routine</option>
                </select>
            </div>
        </div>

        <div style="display:flex; justify-content:flex-end; gap:0.6rem; margin-top:1rem;">
            <a asp-action="Reports" class="btn btn-outline">
                <i class="fas fa-redo"></i> Reset
            </a>
            <button type="submit" class="btn btn-success">
                <i class="fas fa-file-pdf"></i> Generate PDF Report
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        function setRange(days) {
            var end = new Date();
            var start = new Date();
            start.setDate(start.getDate() - days);

            document.getElementById('StartDate').value = toDateString(start);
            document.getElementById('EndDate').value = toDateString(end);
        }

        function toDateString(d) {
            var y = d.getFullYear();
            var m = String(d.getMonth() + 1).padStart(2, '0');
            var day = String(d.getDate()).padStart(2, '0');
            return y + '-' + m + '-' + day;
        }
    </script>
}