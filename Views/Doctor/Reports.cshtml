@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Reports";
    ViewData["RoleSubtitle"] = "Doctor Portal";
    ViewData["UserGreeting"] = "Generate and download reports";
    ViewData["UserInitials"] = "DJ";
    ViewData["UserName"] = "Dr. Sarah Johnson";
}

@section SidebarMenu {
    <li><a href="@Url.Action("Dashboard", "Doctor")"><i class="fas fa-chart-pie"></i> <span>Dashboard</span></a></li>
    <li><a href="@Url.Action("TestRequests", "Doctor")"><i class="fas fa-notes-medical"></i> <span>Test Requests</span></a></li>
    <li><a href="@Url.Action("Patients", "Doctor")"><i class="fas fa-users"></i> <span>My Patients</span></a></li>
    <li><a href="@Url.Action("Alerts", "Doctor")"><i class="fas fa-bell"></i> <span>Alerts</span></a></li>
    <li><a href="@Url.Action("Results", "Doctor")"><i class="fas fa-chart-line"></i> <span>Results</span></a></li>
    <li><a href="@Url.Action("Reports", "Doctor")" class="active"><i class="fas fa-file-alt"></i> <span>Reports</span></a></li>
}

<div class="card">
    <h3>Generate Report</h3>
    <div class="form-group"><label>Start Date</label><input type="date" id="reportStart" class="form-control"></div>
    <div class="form-group"><label>End Date</label><input type="date" id="reportEnd" class="form-control"></div>
    <div class="form-group"><label>Report Type</label><select id="reportType" class="form-control"><option value="all">All Test Requests</option><option value="completed">Completed</option><option value="abnormal">Abnormal Only</option></select></div>
    <button class="btn-primary" onclick="generateReport()">Generate PDF Report</button>
</div>

<div class="card">
    <h3>Quick Statistics</h3>
    <div class="stat-box"><h3 id="statTotal">0</h3><p>Total Requests (This Month)</p></div>
    <div class="stat-box"><h3 id="statCompleted">0</h3><p>Completed</p></div>
    <div class="stat-box"><h3 id="statAbnormal">0</h3><p>Abnormal Results</p></div>
</div>

<script>
    document.getElementById('statTotal').innerText = '47';
    document.getElementById('statCompleted').innerText = '32';
    document.getElementById('statAbnormal').innerText = '5';
    function generateReport() { alert('PDF Report Generated!\nDownload will start shortly.'); }
</script>

<style>
    .card {
        background: white;
        border-radius: 16px;
        padding: 1rem;
        margin-bottom: 1rem;
        border: 1px solid #E2E8F0;
    }

    .form-group {
        margin-bottom: 1rem;
    }

        .form-group label {
            font-size: 0.8rem;
            font-weight: 500;
            display: block;
            margin-bottom: 0.2rem;
        }

    .form-control {
        width: 100%;
        padding: 0.4rem;
        border: 1px solid #E2E8F0;
        border-radius: 8px;
    }

    .btn-primary {
        background: #0841C9;
        color: white;
        border: none;
        padding: 0.4rem 1rem;
        border-radius: 30px;
        cursor: pointer;
    }

    .stat-box {
        background: #F8FAFE;
        border-radius: 12px;
        padding: 0.5rem;
        text-align: center;
        margin-bottom: 0.5rem;
    }

        .stat-box h3 {
            font-size: 1.3rem;
            color: #032C7D;
            margin: 0;
        }
</style>