@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Reports";
    ViewData["RoleSubtitle"] = "Doctor Portal";
    ViewData["UserGreeting"] = "Generate and download reports";
    ViewData["UserInitials"] = "SJ";
    ViewData["UserName"] = "Sarah Johnson";

    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
}

@section SidebarMenu {
    <li><a href="@Url.Action("Dashboard", "Doctor")" class="active"><i class="fas fa-chart-pie"></i> <span>Dashboard</span></a></li>
    <li><a href="@Url.Action("TestRequests", "Doctor")"><i class="fas fa-notes-medical"></i> <span>Test Requests</span></a></li>
    <li><a href="@Url.Action("Patients", "Doctor")"><i class="fas fa-users"></i> <span>My Patients</span></a></li>
    <li><a href="@Url.Action("Alerts", "Doctor")"><i class="fas fa-bell"></i> <span>Alerts</span></a></li>
    <li><a href="@Url.Action("Results", "Doctor")"><i class="fas fa-chart-line"></i> <span>Results</span></a></li>
    <li><a href="@Url.Action("Reports", "Doctor")"><i class="fas fa-file-alt"></i> <span>Reports</span></a></li>
    <li><a href="@Url.Action("Index", "Profile")"><i class="fas fa-user-circle"></i> <span>My Profile</span></a></li>
}

<style>
    .card {
        background: white;
        border-radius: 16px;
        padding: 1rem;
        margin-bottom: 1rem;
        border: 1px solid #E2E8F0;
    }

    .form-group {
        margin-bottom: 1rem;
    }

        .form-group label {
            font-size: 0.8rem;
            font-weight: 500;
            display: block;
            margin-bottom: 0.2rem;
        }

    .form-control {
        width: 100%;
        padding: 0.4rem;
        border: 1px solid #E2E8F0;
        border-radius: 8px;
    }

    .btn-primary {
        background: #0841C9;
        color: white;
        border: none;
        padding: 0.4rem 1rem;
        border-radius: 30px;
        cursor: pointer;
    }

    .btn-sm {
        background: #0841C9;
        color: white;
        border: none;
        padding: 0.2rem 0.6rem;
        border-radius: 30px;
        cursor: pointer;
        font-size: 0.7rem;
    }

    .stat-box {
        background: #F8FAFE;
        border-radius: 12px;
        padding: 0.5rem;
        text-align: center;
        margin-bottom: 0.5rem;
    }

        .stat-box h3 {
            font-size: 1.3rem;
            color: #032C7D;
            margin: 0;
        }

        .stat-box p {
            margin: 0;
            font-size: 0.7rem;
            color: #5A6E7A;
        }

    .grid-2col {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 1rem;
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    th, td {
        padding: 0.6rem;
        text-align: left;
        border-bottom: 1px solid #E2E8F0;
        font-size: 0.75rem;
    }

    th {
        background: #F8FAFE;
        font-weight: 600;
        color: #5A6E7A;
    }
</style>

<div class="grid-2col">
    <div class="card">
        <h3><i class="fas fa-chart-simple"></i> Generate Report</h3>
        <div class="form-group">
            <label>Start Date</label>
            <input type="date" id="reportStart" class="form-control">
        </div>
        <div class="form-group">
            <label>End Date</label>
            <input type="date" id="reportEnd" class="form-control">
        </div>
        <div class="form-group">
            <label>Report Type</label>
            <select id="reportType" class="form-control">
                <option value="all">All Test Requests</option>
                <option value="completed">Completed Tests Only</option>
                <option value="abnormal">Abnormal Results Only</option>
            </select>
        </div>
        <div class="form-group">
            <label>Format</label>
            <select id="reportFormat" class="form-control">
                <option value="pdf">PDF Document</option>
                <option value="excel">Excel (CSV)</option>
            </select>
        </div>
        <button class="btn-primary" onclick="generateReport()"><i class="fas fa-file-pdf"></i> Generate PDF Report</button>
    </div>

    <div class="card">
        <h3><i class="fas fa-chart-pie"></i> Quick Statistics</h3>
        <div class="stat-box">
            <h3 id="statTotal">47</h3>
            <p>Total Requests (This Month)</p>
        </div>
        <div class="stat-box">
            <h3 id="statCompleted">32</h3>
            <p>Completed</p>
        </div>
        <div class="stat-box">
            <h3 id="statAbnormal">8</h3>
            <p>Abnormal Results</p>
        </div>
        <div class="stat-box">
            <h3 id="statPending">7</h3>
            <p>Pending Release</p>
        </div>
        <button class="btn-primary" onclick="location.href='@Url.Action("Results", "Doctor")'" style="background:#6B7280; margin-top:0.5rem;">View Detailed Analytics →</button>
    </div>
</div>

<div class="card">
    <h3><i class="fas fa-download"></i> Saved Reports</h3>
    <div class="table-container">
        <table>
            <thead>
                <tr>
                    <th>Report Name</th>
                    <th>Date Generated</th>
                    <th>Type</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>Monthly Summary - April 2025</td>
                    <td>2025-04-30</td>
                    <td>PDF</td>
                    <td><button class="btn-sm" onclick="downloadReport('Monthly Summary - April 2025')">Download</button></td>
                </tr>
                <tr>
                    <td>Abnormal Results Q1 2025</td>
                    <td>2025-03-31</td>
                    <td>PDF</td>
                    <td><button class="btn-sm" onclick="downloadReport('Abnormal Results Q1 2025')">Download</button></td>
                </tr>
                <tr>
                    <td>Patient Test History - Thabo Mbeki</td>
                    <td>2025-03-28</td>
                    <td>PDF</td>
                    <td><button class="btn-sm" onclick="downloadReport('Patient Test History - Thabo Mbeki')">Download</button></td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<script>
    function generateReport() {
        var start = document.getElementById('reportStart').value;
        var end = document.getElementById('reportEnd').value;
        var type = document.getElementById('reportType').value;
        var format = document.getElementById('reportFormat').value;

        var typeText = '';
        if (type === 'all') typeText = 'All Test Requests';
        else if (type === 'completed') typeText = 'Completed Tests Only';
        else typeText = 'Abnormal Results Only';

        alert('📄 Report Generated Successfully!\n\n📅 Period: ' + (start || 'All') + ' to ' + (end || 'All') + '\n📊 Type: ' + typeText + '\n📁 Format: ' + format.toUpperCase() + '\n\nDownload will start shortly.');
    }

    function downloadReport(reportName) {
        alert('📥 Downloading "' + reportName + '"...\n\nThe report would be downloaded as PDF.');
    }
</script>