@model NMB_HLabSys.Models.ViewModels.ResultItemViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Result " + Model.TestName;
    ViewData["RoleSubtitle"] = "Doctor Portal";
    ViewData["UserGreeting"] = "Review result";

    var openRelease = ViewBag.OpenRelease as bool? ?? false;
    var canAct = ViewBag.CanAct as bool? ?? false;
    var isConsentViewOnly = ViewBag.IsConsentViewOnly as bool? ?? false;
}

@section SidebarMenu {
    <li><a href="@Url.Action("Dashboard", "Doctor")"><i class="fas fa-chart-pie"></i> <span>Dashboard</span></a></li>
    <li><a href="@Url.Action("TestRequests", "Doctor")"><i class="fas fa-notes-medical"></i> <span>Test Requests</span></a></li>
    <li><a href="@Url.Action("Patients", "Doctor")"><i class="fas fa-users"></i> <span>My Patients</span></a></li>
    <li><a href="@Url.Action("Alerts", "Doctor")"><i class="fas fa-bell"></i> <span>Alerts</span></a></li>
    <li><a href="@Url.Action("Results", "Doctor")" class="active"><i class="fas fa-chart-line"></i> <span>Results</span></a></li>
    <li><a href="@Url.Action("Reports", "Doctor")"><i class="fas fa-file-alt"></i> <span>Reports</span></a></li>
    <li><a href="@Url.Action("Index", "Profile")"><i class="fas fa-user-circle"></i> <span>My Profile</span></a></li>
}

@section Styles {
    <style>
        .panel {
            background: white;
            border-radius: 20px;
            padding: 1.5rem;
            margin-bottom: 1.2rem;
            border: 1px solid #E2E8F0;
        }

        .panel-title {
            color: #032C7D;
            font-size: 1rem;
            margin: 0 0 1rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            padding-bottom: 0.6rem;
            border-bottom: 1px solid #E2E8F0;
        }

            .panel-title i {
                color: #0841C9;
            }

        .result-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 1rem;
            flex-wrap: wrap;
            margin-bottom: 1.2rem;
        }

            .result-header h1 {
                font-size: 1.6rem;
                color: #032C7D;
                margin: 0;
                letter-spacing: -0.02em;
            }

            .result-header .meta {
                display: flex;
                gap: 1rem;
                font-size: 0.8rem;
                color: #5A6E7A;
                margin-top: 0.3rem;
                flex-wrap: wrap;
            }

                .result-header .meta span {
                    display: inline-flex;
                    align-items: center;
                    gap: 0.3rem;
                }

        .status-badge {
            display: inline-block;
            padding: 0.35rem 1rem;
            border-radius: 30px;
            font-size: 0.72rem;
            font-weight: 700;
            letter-spacing: 0.04em;
            text-transform: uppercase;
        }

        .status-abnormal {
            background: #FEE2E2;
            color: #991B1B;
        }

        .status-normal {
            background: #D1FAE5;
            color: #065F46;
        }

        .status-released {
            background: #DBEAFE;
            color: #1E40AF;
        }

        .status-appointment {
            background: #FEF3C7;
            color: #78350F;
        }

        .result-card {
            border-radius: 16px;
            padding: 1.8rem;
            border: 2px solid #E2E8F0;
            text-align: center;
        }

            .result-card.abnormal {
                background: linear-gradient(135deg, #FEF2F2, #FFFFFF);
                border-color: #FECACA;
            }

            .result-card.normal {
                background: linear-gradient(135deg, #F0FDF4, #FFFFFF);
                border-color: #A7F3D0;
            }

        .result-value {
            font-family: 'Courier New', monospace;
            font-size: 3rem;
            font-weight: 800;
            line-height: 1;
            margin-bottom: 0.5rem;
            letter-spacing: -0.03em;
        }

        .result-card.abnormal .result-value {
            color: #DC2626;
        }

        .result-card.normal .result-value {
            color: #059669;
        }

        .result-unit {
            font-size: 1rem;
            color: #5A6E7A;
            margin-bottom: 1rem;
        }

        .result-range {
            display: inline-block;
            padding: 0.4rem 1rem;
            background: #F1F5F9;
            border-radius: 30px;
            font-size: 0.82rem;
            color: #1A2C3A;
            font-weight: 500;
        }

            .result-range strong {
                color: #032C7D;
            }

        .info-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1rem;
            margin-top: 1rem;
        }

        .info-block {
            background: #F8FAFE;
            border-radius: 12px;
            padding: 1rem;
            border-left: 4px solid #0841C9;
        }

            .info-block h4 {
                font-size: 0.78rem;
                font-weight: 700;
                color: #032C7D;
                margin: 0 0 0.4rem;
                text-transform: uppercase;
                letter-spacing: 0.04em;
            }

            .info-block p {
                margin: 0;
                font-size: 0.88rem;
                color: #1A2C3A;
                line-height: 1.5;
            }

        .action-bar {
            display: flex;
            justify-content: space-between;
            gap: 1rem;
            margin-bottom: 1.2rem;
            flex-wrap: wrap;
        }

        .btn {
            padding: 0.7rem 1.5rem;
            border-radius: 12px;
            font-size: 0.85rem;
            font-weight: 600;
            cursor: pointer;
            border: none;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            transition: all 0.2s;
            font-family: inherit;
        }

        .btn-primary {
            background: #0841C9;
            color: white;
        }

            .btn-primary:hover {
                background: #032C7D;
                color: white;
            }

        .btn-success {
            background: #10B981;
            color: white;
        }

            .btn-success:hover {
                background: #059669;
                color: white;
            }

        .btn-outline {
            background: transparent;
            border: 1px solid #E2E8F0;
            color: #1A2C3A;
        }

            .btn-outline:hover {
                background: #F1F5F9;
                color: #1A2C3A;
            }

        .form-group {
            margin-bottom: 1.1rem;
        }

            .form-group label {
                display: block;
                font-size: 0.8rem;
                font-weight: 600;
                color: #032C7D;
                margin-bottom: 0.4rem;
            }

        .form-control {
            width: 100%;
            padding: 0.7rem 1rem;
            border: 1px solid #E2E8F0;
            border-radius: 12px;
            font-size: 0.9rem;
            font-family: inherit;
        }

            .form-control:focus {
                outline: none;
                border-color: #0841C9;
                box-shadow: 0 0 0 3px rgba(8,65,201,0.1);
            }

            .form-control.error {
                border-color: #DC2626;
                background: #FEF2F2;
            }

        textarea.form-control {
            resize: vertical;
            min-height: 80px;
        }

        .field-error {
            display: none;
            color: #DC2626;
            font-size: 0.72rem;
            margin-top: 0.3rem;
        }

            .field-error.show {
                display: block;
            }

        .alert {
            padding: 0.8rem 1rem;
            border-radius: 10px;
            margin-bottom: 1rem;
            font-size: 0.85rem;
        }

        .alert-success {
            background: #D1FAE5;
            color: #065F46;
            border-left: 4px solid #10B981;
        }

        .alert-danger {
            background: #FEE2E2;
            color: #991B1B;
            border-left: 4px solid #DC2626;
        }

        .alert-info {
            background: #EFF6FF;
            color: #1E40AF;
            border-left: 4px solid #0841C9;
            display: flex;
            align-items: flex-start;
            gap: 0.5rem;
            line-height: 1.5;
        }

        .released-banner {
            background: #DBEAFE;
            border: 1px solid #93C5FD;
            border-radius: 12px;
            padding: 1rem 1.2rem;
            display: flex;
            align-items: flex-start;
            gap: 0.8rem;
            font-size: 0.88rem;
            color: #1E40AF;
        }

            .released-banner.appointment {
                background: #FEF3C7;
                border-color: #FCD34D;
                color: #78350F;
            }

            .released-banner i {
                font-size: 1.4rem;
                margin-top: 0.1rem;
            }

        .info-note {
            background: #EFF6FF;
            padding: 0.9rem;
            border-radius: 10px;
            border-left: 4px solid #0841C9;
            font-size: 0.82rem;
            margin-top: 1rem;
        }

        .modal-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0.6);
            backdrop-filter: blur(3px);
            z-index: 2000;
            align-items: center;
            justify-content: center;
        }

            .modal-overlay.active {
                display: flex;
            }

        .modal-container {
            background: white;
            border-radius: 24px;
            width: 90%;
            max-width: 500px;
            box-shadow: 0 25px 50px rgba(0,0,0,0.25);
        }

        .modal-header {
            padding: 1rem 1.5rem;
            border-bottom: 1px solid #E2E8F0;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

            .modal-header h3 {
                margin: 0;
                color: #032C7D;
                font-size: 1.1rem;
            }

        .modal-body {
            padding: 1.2rem 1.5rem;
        }

        .modal-footer {
            padding: 1rem 1.5rem;
            border-top: 1px solid #E2E8F0;
            display: flex;
            justify-content: flex-end;
            gap: 0.8rem;
        }

        .close-modal {
            background: none;
            border: none;
            font-size: 1.4rem;
            cursor: pointer;
            color: #5A6E7A;
        }

        @@media (max-width: 768px) {
            .info-grid {
                grid-template-columns: 1fr;
            }

            .result-value {
                font-size: 2.2rem;
            }
        }
    </style>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

@if (isConsentViewOnly)
{
    <div class="alert alert-info">
        <i class="fas fa-lock" style="margin-top:0.15rem; flex-shrink:0;"></i>
        <div>
            <strong>View-only access.</strong>
            This result was shared with you via patient consent.
            Only the doctor who created the request can release or modify it.
        </div>
    </div>
}

<!-- ─── HEADER ─── -->
<div class="panel">
    <div class="result-header">
        <div>
            <h1>@Model.TestName</h1>
            <div class="meta">
                <span><i class="fas fa-notes-medical"></i> @Model.RequestNumber</span>
                <span><i class="fas fa-user"></i> @Model.PatientName</span>
                <span><i class="fas fa-id-card"></i> @Model.SAIDNumber</span>
                <span><i class="fas fa-calendar"></i> @Model.ResultDate.ToString("yyyy-MM-dd HH:mm")</span>
            </div>
        </div>
        <div>
            @if (Model.IsReleased)
            {
                <span class="status-badge status-released">
                    <i class="fas fa-check-circle"></i> Released
                </span>
            }
            else if (Model.AppointmentRequestedDate.HasValue)
            {
                <span class="status-badge status-appointment">
                    <i class="fas fa-calendar-check"></i> Appointment
                </span>
            }
            else if (Model.IsAbnormal)
            {
                <span class="status-badge status-abnormal">
                    <i class="fas fa-exclamation-triangle"></i> Abnormal
                </span>
            }
            else
            {
                <span class="status-badge status-normal">
                    <i class="fas fa-check"></i> Normal
                </span>
            }
        </div>
    </div>

    <div class="result-card @(Model.IsAbnormal ? "abnormal" : "normal")">
        <div class="result-value">@Model.ResultValue</div>
        @if (!string.IsNullOrEmpty(Model.UnitOfMeasurement))
        {
            <div class="result-unit">@Model.UnitOfMeasurement</div>
        }
        <div class="result-range">
            <strong>Normal Range:</strong> @Model.NormalRange
        </div>
    </div>

    <div class="info-grid">
        <div class="info-block">
            <h4><i class="fas fa-stethoscope"></i> Interpretation</h4>
            <p>@Model.Interpretation</p>
        </div>
        @if (!string.IsNullOrEmpty(Model.Notes))
        {
            <div class="info-block">
                <h4><i class="fas fa-clipboard"></i> Lab Notes</h4>
                <p>@Model.Notes</p>
            </div>
        }
    </div>
</div>

<!-- ─── ACTION BAR ─── -->
<div class="action-bar">
    <a asp-action="Results" class="btn btn-outline">
        <i class="fas fa-arrow-left"></i> Back to Results
    </a>
    <div style="display:flex; gap:0.6rem; flex-wrap:wrap;">
        @if (canAct)
        {
            <a asp-action="TestRequestDetails" asp-route-id="@Model.RequestID" class="btn btn-outline">
                <i class="fas fa-notes-medical"></i> View Full Request
            </a>
        }
        <a asp-action="PatientDetails" asp-route-id="@Model.PatientID" class="btn btn-outline">
            <i class="fas fa-history"></i> Patient History
        </a>
        <a asp-action="DownloadResultPdf" asp-route-id="@Model.ResultID" class="btn btn-primary">
            <i class="fas fa-file-pdf"></i> Download PDF
        </a>
    </div>
</div>

<!-- ─── RELEASE / STATUS SECTION ─── -->
@if (Model.IsReleased)
{
    <div class="panel">
        <h3 class="panel-title"><i class="fas fa-check-circle"></i> Release Status</h3>
        <div class="released-banner">
            <i class="fas fa-paper-plane"></i>
            <div>
                <strong>Result released to patient.</strong>
                @if (Model.ReleasedDate.HasValue)
                {
                    <div style="font-size:0.82rem; margin-top:0.2rem;">
                        Released on @Model.ReleasedDate.Value.ToString("yyyy-MM-dd HH:mm")
                    </div>
                }
                @if (!string.IsNullOrEmpty(Model.ReleaseNote))
                {
                    <div style="font-size:0.82rem; margin-top:0.4rem; font-style:italic;">
                        "@Model.ReleaseNote"
                    </div>
                }
            </div>
        </div>
    </div>
}
else if (Model.AppointmentRequestedDate.HasValue)
{
    <div class="panel">
        <h3 class="panel-title"><i class="fas fa-calendar-check"></i> Appointment Requested</h3>
        <div class="released-banner appointment">
            <i class="fas fa-calendar-check"></i>
            <div>
                <strong>Patient has been asked to book an appointment.</strong>
                <div style="font-size:0.82rem; margin-top:0.2rem;">
                    Requested on @Model.AppointmentRequestedDate.Value.ToString("yyyy-MM-dd HH:mm")
                </div>
                @if (!string.IsNullOrEmpty(Model.ReleaseNote))
                {
                    <div style="font-size:0.82rem; margin-top:0.4rem; font-style:italic;">
                        "@Model.ReleaseNote"
                    </div>
                }
                <div style="font-size:0.78rem; margin-top:0.5rem;">
                    Results are <strong>not yet released</strong>. Release them once the patient has been seen.
                </div>
            </div>
        </div>

        @if (canAct)
        {
            <div style="display:flex; justify-content:flex-end; margin-top:1rem;">
                <form asp-action="ReleaseResult" method="post" id="appointmentReleaseForm" style="display:inline;">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="ResultID" value="@Model.ResultID" />
                    <input type="hidden" name="PatientName" value="@Model.PatientName" />
                    <input type="hidden" name="TestName" value="@Model.TestName" />
                    <input type="hidden" name="ResultValue" value="@Model.ResultValue" />
                    <input type="hidden" name="ReleaseMethod" value="email" />
                    <button type="submit" class="btn btn-success">
                        <i class="fas fa-paper-plane"></i> Release Results Now
                    </button>
                </form>
            </div>
        }
    </div>
}
else if (canAct)
{
    <div class="panel" id="releasePanel">
        <h3 class="panel-title">
            <i class="fas fa-paper-plane"></i> Handle This Result
        </h3>

        <form asp-action="ReleaseResult" method="post" id="releaseForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="ResultID" value="@Model.ResultID" />
            <input type="hidden" name="PatientName" value="@Model.PatientName" />
            <input type="hidden" name="TestName" value="@Model.TestName" />
            <input type="hidden" name="ResultValue" value="@Model.ResultValue" />

            <div class="form-group">
                <label>Note to Patient (optional)</label>
                <textarea name="Note" id="releaseNote" class="form-control" rows="3" maxlength="500"
                      placeholder="Add a personal message for the patient..."></textarea>
                <div class="field-error" id="noteError"></div>
            </div>

            <div class="info-note">
                <strong><i class="fas fa-info-circle"></i> Choose how to handle this result:</strong>
                <ul style="margin:0.5rem 0 0 1.2rem;">
                    <li><strong>Release Results</strong> — sends the PDF to the patient (email)</li>
                    <li><strong>Ask to Book Appointment</strong> — requests the patient come in to discuss results (not released until they're seen)</li>
                </ul>
                @if (Model.IsAbnormal)
                {
                    <div style="margin-top:0.5rem; padding:0.5rem 0.7rem; background:#FEE2E2; border-radius:8px; color:#991B1B; font-size:0.78rem;">
                        <i class="fas fa-exclamation-triangle"></i>
                        <strong>This result is abnormal.</strong> A note to the patient is required before releasing.
                    </div>
                }
            </div>

            <div style="display:flex; justify-content:flex-end; gap:0.6rem; margin-top:1.2rem; flex-wrap:wrap;">
                <a asp-action="Results" class="btn btn-outline">Cancel</a>

                <button type="submit" name="ReleaseMethod" value="appointment" class="btn btn-primary">
                    <i class="fas fa-calendar-check"></i> Ask to Book Appointment
                </button>

                <button type="submit" name="ReleaseMethod" value="email" class="btn btn-success">
                    <i class="fas fa-paper-plane"></i> Release Results
                </button>
            </div>
        </form>
    </div>
}

<!-- ─── CONFIRM RELEASE MODAL (only when the doctor can act) ─── -->
@if (canAct)
{
    <div id="confirmReleaseModal" class="modal-overlay">
        <div class="modal-container" style="max-width:480px;">
            <form id="confirmReleaseForm" asp-action="ReleaseResult" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="ResultID" value="@Model.ResultID" />
                <input type="hidden" name="PatientName" value="@Model.PatientName" />
                <input type="hidden" name="TestName" value="@Model.TestName" />
                <input type="hidden" name="ResultValue" value="@Model.ResultValue" />
                <input type="hidden" name="ReleaseMethod" id="confirmMethod" />
                <input type="hidden" name="Note" id="confirmNote" />

                <div class="modal-header">
                    <h3 id="confirmTitle">Release to Patient?</h3>
                    <button type="button" class="close-modal" onclick="closeConfirmRelease()">&times;</button>
                </div>
                <div class="modal-body">
                    <p id="confirmMessage" style="margin:0 0 1rem; color:#5A6E7A; font-size:0.9rem;"></p>

                    <label for="confirmNoteInput"
                           style="display:block; font-size:0.8rem; font-weight:600; color:#032C7D; margin-bottom:0.3rem;">
                        Note to Patient <span id="confirmNoteHint" style="color:#5A6E7A; font-weight:400;">(optional)</span>
                    </label>
                    <textarea id="confirmNoteInput" class="form-control" rows="3" maxlength="500"
                          placeholder="Add a personal message for the patient..."></textarea>
                    <div id="confirmError" class="field-error"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline" onclick="closeConfirmRelease()">Cancel</button>
                    <button type="submit" class="btn btn-success" id="confirmOkBtn">
                        <i class="fas fa-check"></i> Confirm
                    </button>
                </div>
            </form>
        </div>
    </div>
}

@section Scripts {
    <script>
        @if (openRelease && canAct)
        {
                        <text>document.getElementById('releasePanel')?.scrollIntoView({ behavior: 'smooth' });</text>
        }

        var isAbnormal = @Model.IsAbnormal.ToString().ToLower();

        function confirmRelease(method) {
            var noteEl = document.getElementById('releaseNote');
            var note = noteEl ? noteEl.value.trim() : '';

            var nInput = document.getElementById('confirmNoteInput');
            if (nInput) nInput.value = note;
            var hiddenNote = document.getElementById('confirmNote');
            if (hiddenNote) hiddenNote.value = note;

            var hint = document.getElementById('confirmNoteHint');
            if (hint) {
                hint.textContent = (method === 'email' && isAbnormal) ? '(required for abnormal)' : '(optional)';
                hint.style.color = (method === 'email' && isAbnormal) ? '#DC2626' : '#5A6E7A';
            }

            document.getElementById('confirmTitle').textContent =
                method === 'email' ? 'Release to Patient?' : 'Request Appointment?';
            document.getElementById('confirmMessage').textContent =
                method === 'email'
                    ? (isAbnormal
                        ? 'This is an ABNORMAL result. The patient will be notified by email with your note.'
                        : 'The patient will be notified by email with your note.')
                    : 'The patient will be asked to book an appointment. Results will not be released yet.';
            document.getElementById('confirmMethod').value = method;

            var errEl = document.getElementById('confirmError');
            if (errEl) { errEl.classList.remove('show'); errEl.textContent = ''; }

            document.getElementById('confirmReleaseModal').classList.add('active');

            setTimeout(function () {
                if (method === 'email' && isAbnormal && nInput) nInput.focus();
            }, 100);
        }

        function closeConfirmRelease() {
            document.getElementById('confirmReleaseModal').classList.remove('active');
        }

        (function () {
            var modal = document.getElementById('confirmReleaseModal');
            if (!modal) return;

            modal.addEventListener('click', function (e) {
                if (e.target === this) closeConfirmRelease();
            });
            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') closeConfirmRelease();
            });

            var releaseForm = document.getElementById('releaseForm');
            if (releaseForm) {
                releaseForm.querySelectorAll('button[type="submit"][name="ReleaseMethod"]').forEach(function (btn) {
                    btn.addEventListener('click', function (e) {
                        e.preventDefault();
                        confirmRelease(this.value);
                    });
                });
            }

            var apptForm = document.getElementById('appointmentReleaseForm');
            if (apptForm) {
                apptForm.addEventListener('submit', function (e) {
                    e.preventDefault();
                    confirmRelease('email');
                });
            }

            var confirmForm = document.getElementById('confirmReleaseForm');
            if (confirmForm) {
                confirmForm.addEventListener('submit', function (e) {
                    var method = document.getElementById('confirmMethod').value;
                    var noteField = document.getElementById('confirmNoteInput');
                    var note = (noteField ? noteField.value : '').trim();
                    document.getElementById('confirmNote').value = note;

                    var errEl = document.getElementById('confirmError');
                    if (errEl) { errEl.classList.remove('show'); errEl.textContent = ''; }

                    if (method === 'email' && isAbnormal && !note) {
                        e.preventDefault();
                        if (errEl) {
                            errEl.textContent = 'A note to the patient is required when releasing an abnormal result.';
                            errEl.classList.add('show');
                        }
                        if (noteField) noteField.focus();
                        return;
                    }

                    var btn = document.getElementById('confirmOkBtn');
                    if (btn) {
                        btn.disabled = true;
                        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Saving...';
                    }
                });
            }
        })();
    </script>
}