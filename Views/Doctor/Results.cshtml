@model NMB_HLabSys.Models.ViewModels.ResultsIndexViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Test Results";
    ViewData["RoleSubtitle"] = "Doctor Portal";
    ViewData["UserGreeting"] = "View and release patient test results";
    ViewData["UserSubtitle"] = "Review, release, or request an appointment";
}

@section SidebarMenu {
    <li><a href="@Url.Action("Dashboard", "Doctor")"><i class="fas fa-chart-pie"></i> <span>Dashboard</span></a></li>
    <li><a href="@Url.Action("TestRequests", "Doctor")"><i class="fas fa-notes-medical"></i> <span>Test Requests</span></a></li>
    <li><a href="@Url.Action("Patients", "Doctor")"><i class="fas fa-users"></i> <span>My Patients</span></a></li>
    <li><a href="@Url.Action("Alerts", "Doctor")"><i class="fas fa-bell"></i> <span>Alerts</span></a></li>
    <li><a href="@Url.Action("Results", "Doctor")" class="active"><i class="fas fa-chart-line"></i> <span>Results</span></a></li>
    <li><a href="@Url.Action("Reports", "Doctor")"><i class="fas fa-file-alt"></i> <span>Reports</span></a></li>
    <li><a href="@Url.Action("Index", "Profile")"><i class="fas fa-user-circle"></i> <span>My Profile</span></a></li>
}

@section Styles {
    <style>
        .stats-row {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 1rem;
            margin-bottom: 1.2rem;
        }

        .stat-box {
            background: white;
            border-radius: 16px;
            padding: 1rem 1.2rem;
            border: 1px solid #E2E8F0;
            display: flex;
            align-items: center;
            gap: 0.9rem;
            transition: all 0.2s;
        }

            .stat-box:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 24px rgba(8,65,201,0.08);
            }

        .stat-icon {
            width: 42px;
            height: 42px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 1.05rem;
            flex-shrink: 0;
        }

            .stat-icon.blue {
                background: linear-gradient(135deg, #0841C9, #1D97F1);
            }

            .stat-icon.red {
                background: linear-gradient(135deg, #DC2626, #EF4444);
            }

            .stat-icon.amber {
                background: linear-gradient(135deg, #F59E0B, #D97706);
            }

            .stat-icon.green {
                background: linear-gradient(135deg, #10B981, #059669);
            }

        .stat-text h3 {
            font-size: 1.4rem;
            color: #032C7D;
            margin: 0;
            font-weight: 700;
            letter-spacing: -0.02em;
        }

        .stat-text p {
            margin: 0;
            font-size: 0.7rem;
            color: #5A6E7A;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            font-weight: 600;
        }

        .panel {
            background: white;
            border-radius: 20px;
            padding: 1.5rem;
            margin-bottom: 1.2rem;
            border: 1px solid #E2E8F0;
        }

        .filter-bar {
            display: flex;
            gap: 0.6rem;
            flex-wrap: wrap;
            align-items: center;
        }

        .filter-input, .filter-select {
            padding: 0.6rem 1rem;
            border-radius: 30px;
            border: 1px solid #E2E8F0;
            font-size: 0.85rem;
            font-family: inherit;
        }

        .filter-input {
            flex: 1;
            min-width: 200px;
        }

            .filter-input:focus, .filter-select:focus {
                outline: none;
                border-color: #0841C9;
                box-shadow: 0 0 0 3px rgba(8,65,201,0.1);
            }

        .btn {
            padding: 0.6rem 1.3rem;
            border-radius: 30px;
            font-size: 0.82rem;
            font-weight: 600;
            cursor: pointer;
            border: none;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            transition: all 0.2s;
            font-family: inherit;
            white-space: nowrap;
        }

        .btn-primary {
            background: #0841C9;
            color: white;
        }

            .btn-primary:hover {
                background: #032C7D;
                color: white;
            }

        .btn-success {
            background: #10B981;
            color: white;
        }

            .btn-success:hover {
                background: #059669;
                color: white;
            }

        .btn-outline {
            background: transparent;
            border: 1px solid #E2E8F0;
            color: #1A2C3A;
        }

            .btn-outline:hover {
                background: #F1F5F9;
                color: #1A2C3A;
            }

        .btn-sm {
            padding: 0.35rem 0.8rem;
            font-size: 0.72rem;
        }

        .request-group {
            background: white;
            border-radius: 16px;
            border: 1px solid #E2E8F0;
            margin-bottom: 1rem;
            overflow: hidden;
        }

        .request-header {
            padding: 1rem 1.3rem;
            background: linear-gradient(135deg, #F8FAFE, #FFFFFF);
            border-bottom: 1px solid #E2E8F0;
            display: flex;
            justify-content: space-between;
            align-items: center;
            cursor: pointer;
            gap: 1rem;
            flex-wrap: wrap;
            user-select: none;
        }

            .request-header:hover {
                background: #EFF6FF;
            }

            .request-header h4 {
                color: #032C7D;
                font-size: 0.95rem;
                margin: 0;
                font-weight: 700;
                display: flex;
                align-items: center;
                gap: 0.6rem;
            }

            .request-header .meta {
                font-size: 0.75rem;
                color: #5A6E7A;
                margin-top: 0.15rem;
            }

            .request-header .badges {
                display: flex;
                gap: 0.4rem;
                align-items: center;
            }

            .request-header .arrow {
                transition: transform 0.25s;
                color: #5A6E7A;
                font-size: 0.8rem;
            }

        .request-group.open .request-header .arrow {
            transform: rotate(180deg);
        }

        .request-body {
            display: none;
            padding: 0.5rem 1.3rem 1rem;
        }

        .request-group.open .request-body {
            display: block;
        }

        .badge {
            display: inline-block;
            padding: 0.2rem 0.6rem;
            border-radius: 30px;
            font-size: 0.68rem;
            font-weight: 700;
            letter-spacing: 0.03em;
            text-transform: uppercase;
        }

        .badge-abnormal {
            background: #FEE2E2;
            color: #991B1B;
        }

        .badge-pending {
            background: #FEF3C7;
            color: #92400E;
        }

        .badge-released {
            background: #D1FAE5;
            color: #065F46;
        }

        /* ─── IMPROVEMENT: Darker, more readable appointment badge ─── */
        .badge-appointment {
            background: #FDE68A;
            color: #92400E;
            border: 1px solid #FCD34D;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th, td {
            padding: 0.7rem 0.5rem;
            text-align: left;
            border-bottom: 1px solid #F1F5F9;
            font-size: 0.83rem;
        }

        th {
            color: #5A6E7A;
            font-size: 0.68rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            font-weight: 700;
        }

        tbody tr:hover {
            background: #F8FAFE;
        }

        tbody tr.abnormal-row {
            background: #FEF2F2;
        }

            tbody tr.abnormal-row:hover {
                background: #FEE2E2;
            }

        .result-value {
            font-family: 'Courier New', monospace;
            font-weight: 700;
            font-size: 0.9rem;
        }

        .result-normal {
            color: #065F46;
        }

        .result-abnormal {
            color: #DC2626;
        }

        .alert {
            padding: 0.8rem 1rem;
            border-radius: 10px;
            margin-bottom: 1rem;
            font-size: 0.85rem;
        }

        .alert-success {
            background: #D1FAE5;
            color: #065F46;
            border-left: 4px solid #10B981;
        }

        .alert-danger {
            background: #FEE2E2;
            color: #991B1B;
            border-left: 4px solid #DC2626;
        }

        .empty-state {
            text-align: center;
            padding: 3rem 1rem;
            color: #94A3B8;
        }

            .empty-state i {
                font-size: 3rem;
                color: #CBD5E1;
                margin-bottom: 0.8rem;
                display: block;
            }

            .empty-state h3 {
                color: #5A6E7A;
                font-size: 1.1rem;
                margin: 0 0 0.3rem;
            }

            .empty-state p {
                font-size: 0.85rem;
                margin: 0;
            }

        /* ─── MODAL ─── */
        .modal-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0.6);
            backdrop-filter: blur(3px);
            z-index: 2000;
            align-items: center;
            justify-content: center;
        }

            .modal-overlay.active {
                display: flex;
            }

        .modal-container {
            background: white;
            border-radius: 24px;
            width: 90%;
            max-width: 500px;
            box-shadow: 0 25px 50px rgba(0,0,0,0.25);
        }

        .modal-header {
            padding: 1rem 1.5rem;
            border-bottom: 1px solid #E2E8F0;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

            .modal-header h3 {
                margin: 0;
                color: #032C7D;
                font-size: 1.1rem;
            }

        .modal-body {
            padding: 1.2rem 1.5rem;
        }

        .modal-footer {
            padding: 1rem 1.5rem;
            border-top: 1px solid #E2E8F0;
            display: flex;
            justify-content: flex-end;
            gap: 0.8rem;
        }

        .close-modal {
            background: none;
            border: none;
            font-size: 1.4rem;
            cursor: pointer;
            color: #5A6E7A;
        }

        .form-control {
            width: 100%;
            padding: 0.7rem 1rem;
            border: 1px solid #E2E8F0;
            border-radius: 12px;
            font-size: 0.9rem;
            font-family: inherit;
        }

            .form-control:focus {
                outline: none;
                border-color: #0841C9;
                box-shadow: 0 0 0 3px rgba(8,65,201,0.1);
            }

        .field-error {
            display: none;
            color: #DC2626;
            font-size: 0.72rem;
            margin-top: 0.3rem;
        }

            .field-error.show {
                display: block;
            }

        media (max-width: 900px) {
            .stats-row

        {
            grid-template-columns: 1fr 1fr;
        }

        }
    </style>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<!-- ─── STATS ─── -->
<div class="stats-row">
    <div class="stat-box">
        <div class="stat-icon blue"><i class="fas fa-vial"></i></div>
        <div class="stat-text">
            <h3>@Model.Statistics.TotalResults</h3>
            <p>Total Results</p>
        </div>
    </div>
    <div class="stat-box">
        <div class="stat-icon red"><i class="fas fa-exclamation-triangle"></i></div>
        <div class="stat-text">
            <h3>@Model.Statistics.AbnormalResults</h3>
            <p>Abnormal</p>
        </div>
    </div>
    <div class="stat-box">
        <div class="stat-icon amber"><i class="fas fa-hourglass-half"></i></div>
        <div class="stat-text">
            <h3>@Model.Statistics.PendingRelease</h3>
            <p>Pending Release</p>
        </div>
    </div>
    <div class="stat-box">
        <div class="stat-icon green"><i class="fas fa-check-circle"></i></div>
        <div class="stat-text">
            <h3>@(Model.Statistics.TotalResults - Model.Statistics.PendingRelease)</h3>
            <p>Released</p>
        </div>
    </div>
</div>

<!-- ─── FILTERS ─── -->
<div class="panel">
    <form method="get" asp-action="Results" class="filter-bar">
        <input type="text" name="SearchTerm" class="filter-input" maxlength="100"
               placeholder="Search by patient or request #"
               value="@Model.Filter.SearchTerm" />

        <select name="Status" class="filter-select">
            <option value="">All Status</option>
            <option value="pending" selected="@(Model.Filter.Status == "pending")">Pending Release</option>
            <option value="released" selected="@(Model.Filter.Status == "released")">Released</option>
        </select>

        <select name="AbnormalFilter" class="filter-select">
            <option value="">All Results</option>
            <option value="abnormal" selected="@(Model.Filter.AbnormalFilter == "abnormal")">Abnormal Only</option>
        </select>

        <button type="submit" class="btn btn-primary">
            <i class="fas fa-filter"></i> Apply
        </button>
        <a asp-action="Results" class="btn btn-outline">
            <i class="fas fa-times"></i> Reset
        </a>
    </form>
</div>

<!-- ─── RESULTS ─── -->
@if (Model.Results == null || !Model.Results.Any())
{
    <div class="panel">
        <div class="empty-state">
            <i class="fas fa-flask"></i>
            <h3>No results yet</h3>
            <p>Results will appear here once technicians complete and verify tests.</p>
        </div>
    </div>
}
else
{
    foreach (var group in Model.Results)
    {
        <div class="request-group open">
            <div class="request-header" onclick="toggleGroup(this)">
                <div>
                    <h4>
                        <i class="fas fa-notes-medical" style="color:#0841C9;"></i>
                        @group.RequestNumber — @group.PatientName
                    </h4>
                    <div class="meta">Requested @group.RequestDate.ToString("yyyy-MM-dd HH:mm")</div>
                </div>
                <div class="badges">
                    @if (group.HasAbnormal)
                    {
                        <span class="badge badge-abnormal"><i class="fas fa-exclamation-triangle"></i> Abnormal</span>
                    }

                    @{
                        var anyAppointment = group.AppointmentRequestedDate.HasValue
                        || group.TestResults.Any(x => x.AppointmentRequestedDate.HasValue);
                        var anyReleased = group.ReleasedToPatientDate.HasValue
                        || group.TestResults.Any(x => x.IsReleased);
                    }
                    @if (anyReleased)
                    {
                        <span class="badge badge-released">Released</span>
                    }
                    else if (anyAppointment || group.RequestStatus == "Appointment Requested")
                    {
                        <span class="badge badge-appointment">Appointment Requested</span>
                    }
                    else
                    {
                        <span class="badge badge-pending">Pending Release</span>
                    }

                    <i class="fas fa-chevron-down arrow"></i>
                </div>
            </div>
            <div class="request-body">
                <table>
                    <thead>
                        <tr>
                            <th>Test</th>
                            <th>Result</th>
                            <th>Normal Range</th>
                            <th>Status</th>
                            <th>Date</th>
                            <th style="min-width:260px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in group.TestResults)
                        {
                            <tr class="@(r.IsAbnormal ? "abnormal-row" : "")">
                                <td><strong>@r.TestName</strong></td>
                                <td>
                                    <span class="result-value @(r.IsAbnormal ? "result-abnormal" : "result-normal")">
                                        @r.ResultValue
                                    </span>
                                    @if (r.IsAbnormal)
                                    {
                                        <i class="fas fa-exclamation-triangle" style="color:#DC2626; margin-left:0.3rem;" title="Abnormal"></i>
                                    }
                                </td>
                                <td>@r.NormalRange</td>
                                <td>
                                    @if (r.IsReleased)
                                    {
                                        <span class="badge badge-released">Released</span>
                                    }
                                    else if (r.AppointmentRequestedDate.HasValue)
                                    {
                                        <span class="badge badge-appointment">Appointment</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-pending">Pending</span>
                                    }
                                </td>
                                <td>@r.ResultDate.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>
                                    <div style="display:flex; gap:0.35rem; flex-wrap:wrap;">
                                        <a asp-action="ResultDetails" asp-route-id="@r.ResultID"
                                           class="btn btn-outline btn-sm">
                                            <i class="fas fa-eye"></i> View
                                        </a>

                                        @if (!r.IsReleased && !r.AppointmentRequestedDate.HasValue)
                                        {
                                            <button type="button" class="btn btn-success btn-sm"
                                                    onclick="openReleaseModal(@r.ResultID, '@r.RequestNumber', true, @(r.IsAbnormal ? "true" : "false"))">
                                                <i class="fas fa-paper-plane"></i> Release
                                            </button>

                                            <button type="button" class="btn btn-primary btn-sm"
                                                    onclick="openReleaseModal(@r.ResultID, '@r.RequestNumber', false, @(r.IsAbnormal ? "true" : "false"))">
                                                <i class="fas fa-calendar-check"></i> Book Appointment
                                            </button>
                                        }
                                        else if (r.AppointmentRequestedDate.HasValue && !r.IsReleased)
                                        {
                                            <button type="button" class="btn btn-success btn-sm"
                                                    onclick="openReleaseModal(@r.ResultID, '@r.RequestNumber', true, @(r.IsAbnormal ? "true" : "false"))">
                                                <i class="fas fa-paper-plane"></i> Release Now
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="btn btn-outline btn-sm" style="pointer-events:none; opacity:0.6;">
                                                <i class="fas fa-check"></i> Released
                                            </span>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

<!-- ─── RELEASE / BOOK APPOINTMENT MODAL (outside script) ─── -->
<div id="releaseModal" class="modal-overlay">
    <div class="modal-container">
        <form id="releaseForm" asp-action="ReleaseResult" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="ResultID" id="relResultId" />
            <input type="hidden" name="ReleaseMethod" id="relMethod" />

            <div class="modal-header">
                <h3 id="relTitle">Release Result</h3>
                <button type="button" class="close-modal" onclick="closeReleaseModal()">&times;</button>
            </div>

            <div class="modal-body">
                <p id="relIntro" style="margin:0 0 1rem; font-size:0.85rem; color:#5A6E7A;"></p>

                <label style="display:block; font-size:0.8rem; font-weight:600; color:#032C7D; margin-bottom:0.3rem;">
                    Note to Patient <span style="color:#5A6E7A; font-weight:400;">(required for abnormal release)</span>
                </label>
                <textarea name="Note" id="relNote" class="form-control" rows="3" maxlength="500"
                          placeholder="Add a personal message for the patient..."></textarea>
                <div id="relError" class="field-error"></div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-outline" onclick="closeReleaseModal()">Cancel</button>
                <button type="submit" class="btn btn-success" id="relSubmitBtn">
                    <i class="fas fa-paper-plane"></i> Confirm
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function toggleGroup(header) {
            header.closest('.request-group').classList.toggle('open');
        }

        var relIsAbnormal = false;
        var relIsRelease = true;

        function openReleaseModal(resultId, requestNumber, isRelease, isAbnormal) {
            relIsRelease = !!isRelease;
            relIsAbnormal = !!isAbnormal;

            document.getElementById('relResultId').value = resultId;
            document.getElementById('relMethod').value = relIsRelease ? 'email' : 'appointment';
            document.getElementById('relTitle').textContent = relIsRelease ? 'Release Result' : 'Request Appointment';
            document.getElementById('relIntro').textContent = relIsRelease
                ? (relIsAbnormal
                    ? 'This is an ABNORMAL result. The patient will be notified by email and a note is required.'
                    : 'The result will be emailed to the patient and marked as released.')
                : 'The patient will be asked to book an appointment to discuss the result.';
            document.getElementById('relNote').value = '';
            document.getElementById('relError').classList.remove('show');
            document.getElementById('relError').textContent = '';
            document.getElementById('relSubmitBtn').innerHTML = relIsRelease
                ? '<i class="fas fa-paper-plane"></i> Release'
                : '<i class="fas fa-calendar-check"></i> Request Appointment';

            document.getElementById('releaseModal').classList.add('active');
        }

        function closeReleaseModal() {
            document.getElementById('releaseModal').classList.remove('active');
        }

        document.getElementById('releaseModal').addEventListener('click', function (e) {
            if (e.target === this) closeReleaseModal();
        });

        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') closeReleaseModal();
        });

        document.getElementById('releaseForm').addEventListener('submit', function (e) {
            var note = document.getElementById('relNote').value.trim();
            var err = document.getElementById('relError');

            err.classList.remove('show');
            err.textContent = '';

            if (relIsRelease && relIsAbnormal && !note) {
                e.preventDefault();
                err.textContent = 'A note to the patient is required when releasing an abnormal result.';
                err.classList.add('show');
                return;
            }

            var btn = document.getElementById('relSubmitBtn');
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Saving...';
        });
    </script>
}