@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Test Results";
    ViewData["RoleSubtitle"] = "Doctor Portal";
    ViewData["UserGreeting"] = "View and release patient test results";
    ViewData["UserInitials"] = "DJ";
    ViewData["UserName"] = "Dr. Sarah Johnson";
}

@section SidebarMenu {
    <li><a href="@Url.Action("Dashboard", "Doctor")"><i class="fas fa-chart-pie"></i> <span>Dashboard</span></a></li>
    <li><a href="@Url.Action("TestRequests", "Doctor")"><i class="fas fa-notes-medical"></i> <span>Test Requests</span></a></li>
    <li><a href="@Url.Action("Patients", "Doctor")"><i class="fas fa-users"></i> <span>My Patients</span></a></li>
    <li><a href="@Url.Action("Alerts", "Doctor")"><i class="fas fa-bell"></i> <span>Alerts</span></a></li>
    <li><a href="@Url.Action("Results", "Doctor")" class="active"><i class="fas fa-chart-line"></i> <span>Results</span></a></li>
    <li><a href="@Url.Action("Reports", "Doctor")"><i class="fas fa-file-alt"></i> <span>Reports</span></a></li>
}

<div class="stats" style="display: flex; gap: 1rem; margin-bottom: 1rem;">
    <div class="stat-box"><h4 id="totalResults">0</h4><p>Total</p></div>
    <div class="stat-box"><h4 id="abnormalResults">0</h4><p>Abnormal</p></div>
    <div class="stat-box"><h4 id="pendingResults">0</h4><p>Pending Release</p></div>
</div>

<div class="card">
    <div class="filter-bar">
        <input type="text" id="resultSearch" placeholder="🔍 Search" style="padding:0.3rem; border-radius:30px;">
        <select id="resultStatusFilter" style="padding:0.3rem; border-radius:30px;">
            <option value="all">All</option>
            <option value="pending">Pending</option>
            <option value="released">Released</option>
        </select>
        <button class="btn-sm" onclick="applyFilters()">Apply</button>
        <button class="btn-sm" onclick="resetFilters()">Reset</button>
    </div>
    <div class="table-container">
        <table id="resultsTable">
            <thead><tr><th>Date</th><th>Patient</th><th>Test</th><th>Result</th><th>Normal</th><th>Status</th><th>Action</th></tr></thead>
            <tbody id="resultsBody"></tbody>
        </table>
    </div>
</div>

<script>
    let results = [
        { date:"2025-04-09", patient:"Thabo Mbeki", test:"Haemoglobin", result:"7.2", normal:"12-16", abnormal:true, released:false },
        { date:"2025-04-08", patient:"Lerato Dlamini", test:"PT/INR", result:"12.5", normal:"11-13.5", abnormal:false, released:false },
        { date:"2025-04-07", patient:"John Smith", test:"Platelets", result:"45", normal:"150-450", abnormal:true, released:false }
    ];
    function renderResults() {
        const tbody = document.getElementById('resultsBody');
        tbody.innerHTML = results.map(r => `<tr ${r.abnormal ? 'style="background:#FEF2F2;"' : ''}><td>${r.date}</td><td>${r.patient}</td><td>${r.test}</td><td style="${r.abnormal ? 'color:#DC2626; font-weight:bold;' : ''}">${r.result}</td><td>${r.normal}</td><td><span class="status-badge ${!r.released ? 'status-pending' : 'status-released'}">${!r.released ? 'Pending' : 'Released'}</span></td><td><button class="btn-sm" onclick="alert('View results for ${r.patient}')">View</button> ${!r.released ? `<button class="btn-sm" onclick="alert('Release to ${r.patient}')" style="background:#10B981;">Release</button>` : ''}</td></tr>`).join('');
        document.getElementById('totalResults').innerText = results.length;
        document.getElementById('abnormalResults').innerText = results.filter(r=>r.abnormal).length;
        document.getElementById('pendingResults').innerText = results.filter(r=>!r.released).length;
    }
    function applyFilters() { renderResults(); }
    function resetFilters() { renderResults(); }
    renderResults();
</script>

<style>
    .card {
        background: white;
        border-radius: 16px;
        padding: 1rem;
        border: 1px solid #E2E8F0;
    }

    .stat-box {
        background: white;
        border-radius: 12px;
        padding: 0.5rem;
        text-align: center;
        border: 1px solid #E2E8F0;
        flex: 1;
    }

        .stat-box h4 {
            font-size: 1.5rem;
            margin: 0;
        }

    .filter-bar {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
        margin-bottom: 1rem;
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    th, td {
        padding: 0.6rem;
        text-align: left;
        border-bottom: 1px solid #E2E8F0;
    }

    .btn-sm {
        background: #0841C9;
        color: white;
        border: none;
        padding: 0.2rem 0.6rem;
        border-radius: 30px;
        cursor: pointer;
    }

    .status-pending {
        background: #FEF3C7;
        color: #92400E;
    }

    .status-released {
        background: #D1FAE5;
        color: #065F46;
    }
</style>