@model NMB_HLabSys.Models.TestRequest
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Request " + Model.RequestNumber;
    ViewData["RoleSubtitle"] = "Doctor Portal";
    ViewData["UserGreeting"] = "View test request details";

    var patient = ViewBag.PatientInfo as NMB_HLabSys.Models.ViewModels.PatientMedicalInfoViewModel;

    var statusSteps = new[] { "Submitted", "Samples Received", "In Progress", "Completed", "Verified", "Released" };
    var currentStep = Array.IndexOf(statusSteps, Model.Status);
    if (currentStep < 0) currentStep = 0;

    var canCancel = Model.Status == "Submitted" || Model.Status == "Samples Received";
    var canAct = ViewBag.CanAct as bool? ?? false;
    var isConsentViewOnly = ViewBag.IsConsentViewOnly as bool? ?? false;
}

@section SidebarMenu {
    <li><a href="@Url.Action("Dashboard", "Doctor")"><i class="fas fa-chart-pie"></i> <span>Dashboard</span></a></li>
    <li><a href="@Url.Action("TestRequests", "Doctor")" class="active"><i class="fas fa-notes-medical"></i> <span>Test Requests</span></a></li>
    <li><a href="@Url.Action("Patients", "Doctor")"><i class="fas fa-users"></i> <span>My Patients</span></a></li>
    <li><a href="@Url.Action("Alerts", "Doctor")"><i class="fas fa-bell"></i> <span>Alerts</span></a></li>
    <li><a href="@Url.Action("Results", "Doctor")"><i class="fas fa-chart-line"></i> <span>Results</span></a></li>
    <li><a href="@Url.Action("Reports", "Doctor")"><i class="fas fa-file-alt"></i> <span>Reports</span></a></li>
    <li><a href="@Url.Action("Index", "Profile")"><i class="fas fa-user-circle"></i> <span>My Profile</span></a></li>
}

@section Styles {
    <style>
        .panel {
            background: white;
            border-radius: 20px;
            padding: 1.5rem;
            margin-bottom: 1.2rem;
            border: 1px solid #E2E8F0;
        }

        .panel-title {
            color: #032C7D;
            font-size: 1rem;
            margin: 0 0 1rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            padding-bottom: 0.6rem;
            border-bottom: 1px solid #E2E8F0;
        }

            .panel-title i {
                color: #0841C9;
            }

        .req-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 1rem;
            margin-bottom: 1.2rem;
        }

            .req-header h1 {
                margin: 0;
                font-size: 1.6rem;
                color: #032C7D;
                letter-spacing: -0.02em;
            }

            .req-header .meta {
                display: flex;
                gap: 1rem;
                font-size: 0.82rem;
                color: #5A6E7A;
                margin-top: 0.3rem;
            }

                .req-header .meta span {
                    display: inline-flex;
                    align-items: center;
                    gap: 0.3rem;
                }

        .status-badge {
            display: inline-block;
            padding: 0.3rem 0.9rem;
            border-radius: 30px;
            font-size: 0.75rem;
            font-weight: 700;
            letter-spacing: 0.03em;
            text-transform: uppercase;
        }

        .status-submitted {
            background: #FFF3CD;
            color: #856404;
        }

        .status-progress {
            background: #CDE8FF;
            color: #004085;
        }

        .status-completed {
            background: #D4EDDA;
            color: #155724;
        }

        .status-verified {
            background: #D1F7EA;
            color: #0D5E4A;
        }

        .status-released {
            background: #DBEAFE;
            color: #1E40AF;
        }

        .status-cancelled {
            background: #FEE2E2;
            color: #991B1B;
        }

        .priority-stat {
            color: #DC2626;
            font-weight: 700;
        }

        .priority-urgent {
            color: #F59E0B;
            font-weight: 700;
        }

        .priority-routine {
            color: #10B981;
            font-weight: 600;
        }

        .patient-info-card {
            background: #F0F9FF;
            border-radius: 12px;
            padding: 1rem 1.2rem;
            border-left: 4px solid #0841C9;
            font-size: 0.85rem;
            line-height: 1.5;
        }

            .patient-info-card .name {
                font-weight: 700;
                color: #032C7D;
                font-size: 1.05rem;
                margin-bottom: 0.2rem;
            }

            .patient-info-card .meta {
                font-size: 0.78rem;
                color: #5A6E7A;
                margin-bottom: 0.4rem;
            }

                .patient-info-card .meta span {
                    display: inline-block;
                    margin-right: 0.9rem;
                }

                    .patient-info-card .meta span strong {
                        color: #1A2C3A;
                    }

        .medical-tag {
            display: inline-block;
            padding: 0.15rem 0.55rem;
            border-radius: 30px;
            font-size: 0.7rem;
            margin-right: 0.3rem;
            margin-bottom: 0.2rem;
            font-weight: 500;
        }

        .tag-condition {
            background: #FEF3C7;
            color: #92400E;
        }

        .tag-allergy {
            background: #FEE2E2;
            color: #991B1B;
        }

        .tag-medication {
            background: #D1FAE5;
            color: #065F46;
        }

        .tag-none {
            background: #F1F5F9;
            color: #5A6E7A;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th, td {
            padding: 0.7rem 0.5rem;
            text-align: left;
            border-bottom: 1px solid #E2E8F0;
            font-size: 0.82rem;
        }

        th {
            background: #F8FAFE;
            font-weight: 600;
            color: #5A6E7A;
            font-size: 0.72rem;
            text-transform: uppercase;
            letter-spacing: 0.04em;
        }

        tr:hover {
            background: #F8FAFE;
        }

        .test-status {
            display: inline-block;
            padding: 0.15rem 0.55rem;
            border-radius: 30px;
            font-size: 0.68rem;
            font-weight: 600;
        }

        .ts-submitted {
            background: #FFF3CD;
            color: #856404;
        }

        .ts-progress {
            background: #CDE8FF;
            color: #004085;
        }

        .ts-completed {
            background: #D4EDDA;
            color: #155724;
        }

        .ts-verified {
            background: #D1F7EA;
            color: #0D5E4A;
        }

        .ts-cancelled {
            background: #FEE2E2;
            color: #991B1B;
        }

        .ts-review {
            background: #FED7AA;
            color: #9A3412;
        }

        .result-val {
            font-family: monospace;
            font-weight: 600;
        }

        .result-normal {
            color: #065F46;
        }

        .result-abnormal {
            color: #DC2626;
        }

        .result-none {
            color: #94A3B8;
            font-style: italic;
            font-weight: 400;
        }

        .barcode-chip {
            display: inline-block;
            font-family: monospace;
            background: #F0FDF4;
            color: #065F46;
            padding: 0.25rem 0.7rem;
            border-radius: 8px;
            border: 1px solid #A7F3D0;
            font-size: 0.82rem;
            font-weight: 600;
            letter-spacing: 0.03em;
        }

        .timeline {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-top: 1rem;
            position: relative;
            padding: 0 0.5rem;
        }

            .timeline::before {
                content: '';
                position: absolute;
                top: 16px;
                left: 5%;
                right: 5%;
                height: 3px;
                background: #E2E8F0;
                border-radius: 3px;
                z-index: 0;
            }

        .timeline-progress {
            position: absolute;
            top: 16px;
            left: 5%;
            height: 3px;
            background: #10B981;
            border-radius: 3px;
            z-index: 1;
            transition: width 0.4s;
        }

        .tl-step {
            text-align: center;
            flex: 1;
            position: relative;
            z-index: 2;
        }

        .tl-circle {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            background: #E2E8F0;
            color: #94A3B8;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 0.4rem;
            font-size: 0.75rem;
            font-weight: 700;
            border: 3px solid white;
            box-shadow: 0 0 0 1px #E2E8F0;
        }

        .tl-step.done .tl-circle {
            background: #10B981;
            color: white;
            box-shadow: 0 0 0 1px #10B981;
        }

        .tl-step.active .tl-circle {
            background: #0841C9;
            color: white;
            box-shadow: 0 0 0 1px #0841C9, 0 0 0 5px rgba(8,65,201,0.15);
        }

        .tl-label {
            font-size: 0.68rem;
            color: #5A6E7A;
            font-weight: 500;
            line-height: 1.2;
        }

        .tl-step.active .tl-label, .tl-step.done .tl-label {
            color: #032C7D;
            font-weight: 600;
        }

        .action-bar {
            display: flex;
            justify-content: space-between;
            gap: 1rem;
            margin-top: 1rem;
            flex-wrap: wrap;
        }

        .btn {
            padding: 0.7rem 1.5rem;
            border-radius: 12px;
            font-size: 0.85rem;
            font-weight: 600;
            cursor: pointer;
            border: none;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            transition: all 0.2s;
            font-family: inherit;
        }

        .btn-outline {
            background: transparent;
            border: 1px solid #E2E8F0;
            color: #1A2C3A;
        }

            .btn-outline:hover {
                background: #F1F5F9;
                color: #1A2C3A;
            }

        .btn-danger {
            background: #DC2626;
            color: white;
        }

            .btn-danger:hover {
                background: #991B1B;
                color: white;
            }

        .alert {
            padding: 0.8rem 1rem;
            border-radius: 10px;
            margin-bottom: 1rem;
            font-size: 0.85rem;
        }

        .alert-success {
            background: #D1FAE5;
            color: #065F46;
            border-left: 4px solid #10B981;
        }

        .alert-danger {
            background: #FEE2E2;
            color: #991B1B;
            border-left: 4px solid #DC2626;
        }

        .alert-info {
            background: #EFF6FF;
            color: #1E40AF;
            border-left: 4px solid #0841C9;
            display: flex;
            align-items: flex-start;
            gap: 0.5rem;
            line-height: 1.5;
        }

        .empty-row {
            text-align: center;
            color: #94A3B8;
            font-style: italic;
            padding: 1.2rem 0;
        }

        .modal-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0.6);
            backdrop-filter: blur(3px);
            z-index: 2000;
            align-items: center;
            justify-content: center;
        }

            .modal-overlay.active {
                display: flex;
            }

        .modal-container {
            background: white;
            border-radius: 24px;
            width: 90%;
            max-width: 500px;
            box-shadow: 0 25px 50px rgba(0,0,0,0.25);
        }

        .modal-header {
            padding: 1rem 1.5rem;
            border-bottom: 1px solid #E2E8F0;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

            .modal-header h3 {
                margin: 0;
                color: #032C7D;
                font-size: 1.1rem;
            }

        .modal-body {
            padding: 1.2rem 1.5rem;
        }

        .modal-footer {
            padding: 1rem 1.5rem;
            border-top: 1px solid #E2E8F0;
            display: flex;
            justify-content: flex-end;
            gap: 0.8rem;
        }

        .close-modal {
            background: none;
            border: none;
            font-size: 1.4rem;
            cursor: pointer;
            color: #5A6E7A;
        }

        .form-control {
            width: 100%;
            padding: 0.6rem 0.8rem;
            border: 1px solid #E2E8F0;
            border-radius: 10px;
            font-size: 0.85rem;
            font-family: inherit;
        }

            .form-control:focus {
                outline: none;
                border-color: #0841C9;
                box-shadow: 0 0 0 3px rgba(8,65,201,0.1);
            }

        @@media (max-width: 768px) {
            .tl-label {
                font-size: 0.6rem;
            }

            .tl-circle {
                width: 26px;
                height: 26px;
                font-size: 0.65rem;
            }

            .timeline::before, .timeline-progress {
                top: 12px;
            }
        }
    </style>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

@if (isConsentViewOnly)
{
    <div class="alert alert-info">
        <i class="fas fa-lock" style="margin-top:0.15rem; flex-shrink:0;"></i>
        <div>
            <strong>View-only access.</strong>
            The patient granted you consent to view this request.
            You cannot modify, cancel, or release it — those actions belong to the doctor who created it.
        </div>
    </div>
}

<!-- ─── REQUEST HEADER ─── -->
<div class="req-header">
    <div>
        <h1>@Model.RequestNumber</h1>
        <div class="meta">
            <span><i class="fas fa-calendar"></i> @Model.RequestDate.ToString("yyyy-MM-dd HH:mm")</span>
            <span>
                <i class="fas fa-exclamation-circle"></i>
                Urgency: <span class="@(Model.Urgency == "stat" ? "priority-stat" : Model.Urgency == "urgent" ? "priority-urgent" : "priority-routine")">
                    @Model.Urgency.ToUpper()
                </span>
            </span>
            <span><i class="fas fa-user-md"></i> @Model.Doctor?.User?.Email</span>
        </div>
    </div>
    <div>
        @{
            var statusClass = Model.Status == "In Progress" ? "status-progress"
            : Model.Status == "Completed" ? "status-completed"
            : Model.Status == "Verified" ? "status-verified"
            : Model.Status == "Released" ? "status-released"
            : Model.Status == "Cancelled" ? "status-cancelled"
            : "status-submitted";
        }
        <span class="status-badge @statusClass">@Model.Status</span>
    </div>
</div>

<!-- ─── STATUS TIMELINE ─── -->
<div class="panel">
    <h3 class="panel-title"><i class="fas fa-stream"></i> Status Timeline</h3>

    @if (Model.Status == "Cancelled")
    {
        <div class="alert alert-danger" style="margin:0;">
            <strong>Request Cancelled</strong>
            @if (!string.IsNullOrEmpty(Model.CancellationReason))
            {
                <div style="margin-top:0.4rem; font-size:0.82rem;">Reason: @Model.CancellationReason</div>
            }
            @if (Model.CancelledDate.HasValue)
            {
                <div style="font-size:0.75rem; color:#991B1B;">on @Model.CancelledDate.Value.ToString("yyyy-MM-dd HH:mm")</div>
            }
        </div>
    }
    else
    {
        var progressPct = statusSteps.Length > 1 ? (currentStep * 100.0) / (statusSteps.Length - 1) : 0;
        <div class="timeline">
            <div class="timeline-progress" style="width: calc((100% - 10%) * @progressPct / 100);"></div>
            @for (int i = 0; i < statusSteps.Length; i++)
            {
                var cls = i < currentStep ? "done" : (i == currentStep ? "active" : "");
                <div class="tl-step @cls">
                    <div class="tl-circle">
                        @if (i < currentStep)
                        {
                            <i class="fas fa-check"></i>
                        }
                        else
                        {
                            @(i + 1)
                        }
                    </div>
                    <div class="tl-label">@statusSteps[i]</div>
                </div>
            }
        </div>
    }
</div>

<!-- ─── PATIENT CARD ─── -->
<div class="panel">
    <h3 class="panel-title"><i class="fas fa-user"></i> Patient</h3>
    @if (patient != null)
    {
        <div class="patient-info-card">
            <div class="name">@patient.FullName</div>
            <div class="meta">
                <span><strong>ID:</strong> @patient.SAIDNumber</span>
                <span><strong>Age:</strong> @patient.Age years</span>
                <span><strong>Gender:</strong> @patient.Gender</span>
                <span><strong>DOB:</strong> @patient.DateOfBirth.ToString("yyyy-MM-dd")</span>
            </div>
            <div class="meta">
                <span><i class="fas fa-phone"></i> @(string.IsNullOrEmpty(patient.Cellphone) ? "N/A" : patient.Cellphone)</span>
                <span><i class="fas fa-envelope"></i> @(string.IsNullOrEmpty(patient.Email) ? "N/A" : patient.Email)</span>
            </div>
            <div class="tags" style="margin-top:0.5rem;">
                <div style="margin-bottom:0.3rem;">
                    <strong>Conditions:</strong>
                    @if (patient.Conditions.Any())
                    {
                        @foreach (var c in patient.Conditions)
                        {
                            <span class="medical-tag tag-condition">@c.ConditionName</span>
                        }
                    }
                    else
                    {
                        <span class="medical-tag tag-none">None recorded</span>
                    }
                </div>
                <div style="margin-bottom:0.3rem;">
                    <strong>Allergies:</strong>
                    @if (patient.Allergies.Any())
                    {
                        @foreach (var a in patient.Allergies)
                        {
                            <span class="medical-tag tag-allergy">@a.AllergyName</span>
                        }
                    }
                    else
                    {
                        <span class="medical-tag tag-none">No known allergies</span>
                    }
                </div>
                <div>
                    <strong>Medications:</strong>
                    @if (patient.Medications.Any())
                    {
                        @foreach (var m in patient.Medications)
                        {
                            <span class="medical-tag tag-medication">@m.MedicationName</span>
                        }
                    }
                    else
                    {
                        <span class="medical-tag tag-none">None current</span>
                    }
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="empty-row">Patient information not available.</div>
    }

    @if (!string.IsNullOrEmpty(Model.ClinicalNotes))
    {
        <div style="margin-top:1rem; padding:0.8rem 1rem; background:#FEF9C3; border-radius:10px; border-left:4px solid #F59E0B; font-size:0.85rem;">
            <strong style="color:#92400E;">Clinical Notes:</strong>
            <div style="margin-top:0.3rem; color:#1A2C3A;">@Model.ClinicalNotes</div>
        </div>
    }
</div>

<!-- ─── SAMPLES + BARCODES ─── -->
<div class="panel">
    <h3 class="panel-title"><i class="fas fa-vial"></i> Samples &amp; Barcodes</h3>
    @if (Model.Samples != null && Model.Samples.Any())
    {
        <table>
            <thead>
                <tr>
                    <th>Barcode</th>
                    <th>Sample Type</th>
                    <th>Status</th>
                    <th>Received</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model.Samples)
                {
                    <tr>
                        <td><span class="barcode-chip">@s.Barcode</span></td>
                        <td>@(s.SampleType?.SampleTypeName ?? "—")</td>
                        <td>@s.Status</td>
                        <td>
                            @if (s.DateReceived.HasValue)
                            {
                                @s.DateReceived.Value.ToString("yyyy-MM-dd HH:mm")
                            }
                            else
                            {
                                <span style="color:#94A3B8;">Pending</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="empty-row">No samples linked to this request.</div>
    }
</div>

<!-- ─── TESTS REQUESTED ─── -->
<div class="panel">
    <h3 class="panel-title"><i class="fas fa-flask"></i> Tests Requested</h3>
    @if (Model.RequestTestTypes != null && Model.RequestTestTypes.Any())
    {
        <table>
            <thead>
                <tr>
                    <th>Test</th>
                    <th>Category</th>
                    <th>Sample Type</th>
                    <th>Status</th>
                    <th>Result</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var rt in Model.RequestTestTypes.OrderBy(r => r.TestType?.Category?.CategoryName))
                {
                    var tsCls = rt.Status == "In Progress" ? "ts-progress"
                    : rt.Status == "Completed" ? "ts-completed"
                    : rt.Status == "Verified" ? "ts-verified"
                    : rt.Status == "To be reviewed" ? "ts-review"
                    : rt.Status == "Cancelled" ? "ts-cancelled"
                    : "ts-submitted";

                    var result = rt.TestResults?.OrderByDescending(r => r.ResultDate).FirstOrDefault();

                    <tr>
                        <td><strong>@(rt.TestType?.TestName ?? "—")</strong></td>
                        <td>@(rt.TestType?.Category?.CategoryName ?? "—")</td>
                        <td>@(rt.TestType?.SampleType?.SampleTypeName ?? "—")</td>
                        <td><span class="test-status @tsCls">@rt.Status</span></td>
                        <td>
                            @if (result != null)
                            {
                                <span class="result-val @(result.IsAbnormal ? "result-abnormal" : "result-normal")">
                                    @result.ResultValue
                                    @if (result.IsAbnormal)
                                    {
                                        <span title="Abnormal">⚠</span>
                                    }
                                </span>
                                @if (!string.IsNullOrEmpty(rt.TestType?.UnitOfMeasurement))
                                {
                                    <span style="font-size:0.7rem; color:#5A6E7A;">@rt.TestType.UnitOfMeasurement</span>
                                }
                            }
                            else
                            {
                                <span class="result-none">@(Model.Status == "Cancelled" ? "—" : "Pending")</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="empty-row">No tests linked to this request.</div>
    }
</div>

<!-- ─── ACTION BAR ─── -->
<div class="action-bar">
    <a asp-action="TestRequests" class="btn btn-outline">
        <i class="fas fa-arrow-left"></i> Back to Requests
    </a>
    @if (canCancel && canAct)
    {
        <button type="button" class="btn btn-danger" onclick="openCancelModal()">
            <i class="fas fa-times"></i> Cancel Request
        </button>
    }
</div>

<!-- ─── CANCEL MODAL (rendered only when the doctor can act) ─── -->
@if (canAct)
{
    <div id="cancelModal" class="modal-overlay">
        <div class="modal-container">
            <form asp-action="CancelTestRequest" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.RequestID" />

                <div class="modal-header">
                    <h3>Cancel @Model.RequestNumber</h3>
                    <button type="button" class="close-modal" onclick="closeCancelModal()">&times;</button>
                </div>

                <div class="modal-body">
                    <label style="display:block; font-size:0.8rem; font-weight:600; color:#032C7D; margin-bottom:0.3rem;">
                        Reason for cancellation <span style="color:#DC2626;">*</span>
                    </label>
                    <textarea name="reason" class="form-control" rows="3"
                          required minlength="10" maxlength="500"
                          placeholder="Please provide a reason (min 10 characters)..."></textarea>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-outline" onclick="closeCancelModal()">Close</button>
                    <button type="submit" class="btn btn-danger">Cancel Request</button>
                </div>
            </form>
        </div>
    </div>
}

@section Scripts {
    <script>
        function openCancelModal() {
            var m = document.getElementById('cancelModal');
            if (m) m.classList.add('active');
        }
        function closeCancelModal() {
            var m = document.getElementById('cancelModal');
            if (m) m.classList.remove('active');
        }

        (function () {
            var modal = document.getElementById('cancelModal');
            if (!modal) return;

            modal.addEventListener('click', function (e) {
                if (e.target === this) closeCancelModal();
            });
            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') closeCancelModal();
            });

            var form = modal.querySelector('form');
            if (form) {
                form.addEventListener('submit', function (e) {
                    var reason = this.querySelector('textarea[name="reason"]').value.trim();
                    if (reason.length < 10) {
                        e.preventDefault();
                        alert('Please provide a reason of at least 10 characters.');
                        return;
                    }
                    var btn = this.querySelector('button[type="submit"]');
                    btn.disabled = true;
                    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Cancelling...';
                });
            }
        })();
    </script>
}