@model NMB_HLabSys.Models.ViewModels.TestRequestIndexViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Test Requests";
    ViewData["RoleSubtitle"] = "Doctor Portal";
    ViewData["UserGreeting"] = "Manage and track all test requests";
    ViewData["UserSubtitle"] = "Create, track, and manage your laboratory requests";
}

@section SidebarMenu {
    <li><a href="@Url.Action("Dashboard", "Doctor")"><i class="fas fa-chart-pie"></i> <span>Dashboard</span></a></li>
    <li><a href="@Url.Action("TestRequests", "Doctor")" class="active"><i class="fas fa-notes-medical"></i> <span>Test Requests</span></a></li>
    <li><a href="@Url.Action("Patients", "Doctor")"><i class="fas fa-users"></i> <span>My Patients</span></a></li>
    <li><a href="@Url.Action("Alerts", "Doctor")"><i class="fas fa-bell"></i> <span>Alerts</span></a></li>
    <li><a href="@Url.Action("Results", "Doctor")"><i class="fas fa-chart-line"></i> <span>Results</span></a></li>
    <li><a href="@Url.Action("Reports", "Doctor")"><i class="fas fa-file-alt"></i> <span>Reports</span></a></li>
    <li><a href="@Url.Action("Index", "Profile")"><i class="fas fa-user-circle"></i> <span>My Profile</span></a></li>
}

@section Styles {
    <style>
        /* ─── COLORFUL STATS ROW ─── */
        .stats-row {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 1rem;
            margin-bottom: 1.2rem;
        }

        .stat-box {
            background: white;
            border-radius: 16px;
            padding: 1rem 1.2rem;
            border: 1px solid #E2E8F0;
            display: flex;
            align-items: center;
            gap: 0.9rem;
            transition: all 0.2s;
        }

            .stat-box:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 24px rgba(8,65,201,0.08);
            }

        .stat-icon {
            width: 42px;
            height: 42px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 1.05rem;
            flex-shrink: 0;
        }

            .stat-icon.blue {
                background: linear-gradient(135deg, #0841C9, #1D97F1);
            }

            .stat-icon.amber {
                background: linear-gradient(135deg, #F59E0B, #D97706);
            }

            .stat-icon.green {
                background: linear-gradient(135deg, #10B981, #059669);
            }

            .stat-icon.red {
                background: linear-gradient(135deg, #DC2626, #EF4444);
            }

        .stat-text h3 {
            font-size: 1.4rem;
            color: #032C7D;
            margin: 0;
            font-weight: 700;
            letter-spacing: -0.02em;
        }

        .stat-text p {
            margin: 0;
            font-size: 0.7rem;
            color: #5A6E7A;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            font-weight: 600;
        }

        /* ─── MAIN PANEL & FILTERS ─── */
        .card {
            background: white;
            border-radius: 20px;
            padding: 1.2rem;
            margin-bottom: 1.2rem;
            border: 1px solid #E2E8F0;
        }

        .filter-bar {
            display: flex;
            gap: 0.5rem;
            flex-wrap: wrap;
            margin-bottom: 1rem;
            align-items: center;
        }

        .filter-input, .filter-select {
            padding: 0.4rem 0.7rem;
            border-radius: 30px;
            border: 1px solid #E2E8F0;
            font-size: 0.78rem;
            font-family: inherit;
        }

        /* ─── TABLE ─── */
        table {
            width: 100%;
            border-collapse: collapse;
        }

        th, td {
            padding: 0.6rem 0.4rem;
            text-align: left;
            border-bottom: 1px solid #E2E8F0;
            font-size: 0.78rem;
        }

        th {
            background: #F8FAFE;
            font-weight: 600;
            color: #5A6E7A;
            font-size: 0.72rem;
            text-transform: uppercase;
            letter-spacing: 0.04em;
        }

        tr:hover {
            background: #F8FAFE;
        }

        .status-badge {
            display: inline-block;
            padding: 0.15rem 0.55rem;
            border-radius: 30px;
            font-size: 0.68rem;
            font-weight: 600;
        }

        .status-submitted {
            background: #FFF3CD;
            color: #856404;
        }

        .status-progress {
            background: #CDE8FF;
            color: #004085;
        }

        .status-completed {
            background: #D4EDDA;
            color: #155724;
        }

        .status-verified {
            background: #D1F7EA;
            color: #0D5E4A;
        }

        .status-released {
            background: #DBEAFE;
            color: #1E40AF;
        }

        .status-cancelled {
            background: #FEE2E2;
            color: #991B1B;
        }

        .status-appointment {
            background: #FDE68A;
            color: #92400E;
            border: 1px solid #FCD34D;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            line-height: 1.2;
        }

        .priority-stat {
            color: #DC2626;
            font-weight: 700;
        }

        .priority-urgent {
            color: #F59E0B;
            font-weight: 700;
        }

        .priority-routine {
            color: #10B981;
        }

        /* ─── BUTTONS ─── */
        .btn-sm {
            background: #0841C9;
            color: white;
            border: none;
            padding: 0.25rem 0.7rem;
            border-radius: 30px;
            cursor: pointer;
            font-size: 0.72rem;
            text-decoration: none;
            display: inline-block;
            font-family: inherit;
        }

            .btn-sm:hover {
                background: #032C7D;
                color: white;
            }

        .btn-success-sm {
            background: #10B981;
            color: white;
        }

            .btn-success-sm:hover {
                background: #059669;
            }

        .btn-outline-sm {
            background: transparent;
            border: 1px solid #E2E8F0;
            padding: 0.25rem 0.7rem;
            border-radius: 30px;
            cursor: pointer;
            font-size: 0.72rem;
            text-decoration: none;
            display: inline-block;
            color: #1A2C3A;
        }

            .btn-outline-sm:hover {
                background: #F1F5F9;
            }

        /* ─── MISC ─── */
        .alert {
            padding: 0.7rem 1rem;
            border-radius: 10px;
            margin-bottom: 1rem;
            font-size: 0.85rem;
        }

        .alert-success {
            background: #D1FAE5;
            color: #065F46;
        }

        .alert-danger {
            background: #FEE2E2;
            color: #991B1B;
        }

        .empty-state {
            text-align: center;
            padding: 3rem 1rem;
            color: #5A6E7A;
        }

            .empty-state i {
                font-size: 3rem;
                color: #CBD5E1;
                margin-bottom: 0.8rem;
                display: block;
            }

        /* ─── MODAL ─── */
        .modal-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0.6);
            backdrop-filter: blur(3px);
            z-index: 2000;
            align-items: center;
            justify-content: center;
        }

            .modal-overlay.active {
                display: flex;
            }

        .modal-container {
            background: white;
            border-radius: 24px;
            width: 90%;
            max-width: 500px;
            box-shadow: 0 25px 50px rgba(0,0,0,0.25);
        }

        .modal-header {
            padding: 1rem 1.5rem;
            border-bottom: 1px solid #E2E8F0;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

            .modal-header h3 {
                margin: 0;
                color: #032C7D;
                font-size: 1.1rem;
            }

        .modal-body {
            padding: 1.2rem 1.5rem;
        }

        .modal-footer {
            padding: 1rem 1.5rem;
            border-top: 1px solid #E2E8F0;
            display: flex;
            justify-content: flex-end;
            gap: 0.8rem;
        }

        .close-modal {
            background: none;
            border: none;
            font-size: 1.4rem;
            cursor: pointer;
            color: #5A6E7A;
        }

        .form-control {
            width: 100%;
            padding: 0.6rem 0.8rem;
            border: 1px solid #E2E8F0;
            border-radius: 10px;
            font-size: 0.85rem;
            font-family: inherit;
        }

            .form-control:focus {
                outline: none;
                border-color: #0841C9;
                box-shadow: 0 0 0 3px rgba(8,65,201,0.1);
            }

        @@media (max-width: 900px) {
            .stats-row {
                grid-template-columns: 1fr 1fr;
            }
        }
    </style>
}

<!-- ─── COLORFUL STATS ─── -->
<div class="stats-row">
    <div class="stat-box">
        <div class="stat-icon blue"><i class="fas fa-clipboard-list"></i></div>
        <div class="stat-text">
            <h3>@Model.Statistics.Total</h3>
            <p>Total Requests</p>
        </div>
    </div>
    <div class="stat-box">
        <div class="stat-icon amber"><i class="fas fa-clock"></i></div>
        <div class="stat-text">
            <h3>@(Model.Statistics.Submitted + Model.Statistics.InProgress)</h3>
            <p>Pending</p>
        </div>
    </div>
    <div class="stat-box">
        <div class="stat-icon green"><i class="fas fa-check-circle"></i></div>
        <div class="stat-text">
            <h3>@Model.Statistics.Completed</h3>
            <p>Completed</p>
        </div>
    </div>
    <div class="stat-box">
        <div class="stat-icon red"><i class="fas fa-exclamation-triangle"></i></div>
        <div class="stat-text">
            <h3>@Model.Statistics.Abnormal</h3>
            <p>Abnormal</p>
        </div>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="card">
    <form method="get" asp-action="TestRequests" class="filter-bar">
        <input type="text" name="SearchTerm" class="filter-input" maxlength="100"
               placeholder="Search by patient or request #"
               value="@Model.Filter.SearchTerm" style="width:220px;" />

        <select name="Status" class="filter-select">
            <option value="">All Status</option>
            <option value="Submitted" selected="@(Model.Filter.Status == "Submitted")">Submitted</option>
            <option value="In Progress" selected="@(Model.Filter.Status == "In Progress")">In Progress</option>
            <option value="Completed" selected="@(Model.Filter.Status == "Completed")">Completed</option>
            <option value="Verified" selected="@(Model.Filter.Status == "Verified")">Verified</option>
            <option value="Released" selected="@(Model.Filter.Status == "Released")">Released</option>
            <option value="Cancelled" selected="@(Model.Filter.Status == "Cancelled")">Cancelled</option>
        </select>

        <select name="Urgency" class="filter-select">
            <option value="">All Urgency</option>
            <option value="stat" selected="@(Model.Filter.Urgency == "stat")">STAT</option>
            <option value="urgent" selected="@(Model.Filter.Urgency == "urgent")">Urgent</option>
            <option value="routine" selected="@(Model.Filter.Urgency == "routine")">Routine</option>
        </select>

        <button type="submit" class="btn-sm">Apply</button>
        <a asp-action="TestRequests" class="btn-outline-sm">Reset</a>

        <a asp-action="CreateTestRequest" class="btn-sm btn-success-sm" style="margin-left:auto;">
            <i class="fas fa-plus"></i> New Request
        </a>
    </form>

    @if (!Model.Requests.Any())
    {
        <div class="empty-state">
            <i class="fas fa-notes-medical"></i>
            <h3>No test requests yet</h3>
            <p>Click "New Request" above to create your first test request.</p>
        </div>
    }
    else
    {
        <table>
            <thead>
                <tr>
                    <th>Req #</th>
                    <th>Patient</th>
                    <th>Date</th>
                    <th>Tests</th>
                    <th>Status</th>
                    <th>Urgency</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Requests)
                {
                    var statusClass = r.Status == "In Progress" ? "status-progress"
                    : r.Status == "Completed" ? "status-completed"
                    : r.Status == "Verified" ? "status-verified"
                    : r.Status == "Released" ? "status-released"
                    : r.Status == "Cancelled" ? "status-cancelled"
                    : r.Status == "Appointment Requested" ? "status-appointment"
                    : "status-submitted";

                    var urgencyClass = r.Urgency == "stat" ? "priority-stat"
                    : r.Urgency == "urgent" ? "priority-urgent"
                    : "priority-routine";

                    <tr>
                        <td><strong>@r.RequestNumber</strong></td>
                        <td>@r.PatientName</td>
                        <td>@r.RequestDate.ToString("yyyy-MM-dd")</td>
                        <td>
                            @if (r.Tests.Any())
                            {
                                @string.Join(", ", r.Tests)
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td>
                            <span class="status-badge @statusClass">@r.Status</span>
                            @if (r.HasAbnormal)
                            {
                                <span title="Contains abnormal results" style="color:#DC2626; margin-left:0.3rem;">⚠</span>
                            }
                        </td>
                        <td><span class="@urgencyClass">@r.Urgency.ToUpper()</span></td>
                        <td>
                            <a asp-action="TestRequestDetails" asp-route-id="@r.RequestID"
                               class="btn-sm">View</a>
                            @if (r.CanCancel)
                            {
                                <button type="button" class="btn-outline-sm"
                                        onclick="openCancelModal(@r.RequestID, '@r.RequestNumber')">
                                    Cancel
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<!-- Cancel Modal -->
<div id="cancelModal" class="modal-overlay">
    <div class="modal-container">
        <form asp-action="CancelTestRequest" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" id="cancelRequestId" />

            <div class="modal-header">
                <h3>Cancel Test Request</h3>
                <button type="button" class="close-modal" onclick="closeCancelModal()">&times;</button>
            </div>

            <div class="modal-body">
                <p style="margin:0 0 1rem; font-size:0.85rem; color:#5A6E7A;">
                    You are about to cancel <strong id="cancelRequestNumber"></strong>.
                </p>
                <label style="display:block; font-size:0.8rem; font-weight:600; color:#032C7D; margin-bottom:0.3rem;">
                    Reason for cancellation <span style="color:#DC2626;">*</span>
                </label>
                <textarea name="reason" class="form-control" rows="3"
                          required minlength="10" maxlength="500"
                          placeholder="Please provide a reason (min 10 characters)..."></textarea>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn-outline-sm" onclick="closeCancelModal()">Close</button>
                <button type="submit" class="btn-sm" style="background:#DC2626;">
                    Cancel Request
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function openCancelModal(id, reqNumber) {
            document.getElementById('cancelRequestId').value = id;
            document.getElementById('cancelRequestNumber').textContent = reqNumber;
            document.getElementById('cancelModal').classList.add('active');
        }

        function closeCancelModal() {
            document.getElementById('cancelModal').classList.remove('active');
        }

        document.getElementById('cancelModal').addEventListener('click', function (e) {
            if (e.target === this) closeCancelModal();
        });

        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') closeCancelModal();
        });

        document.querySelector('#cancelModal form').addEventListener('submit', function (e) {
            var reason = this.querySelector('textarea[name="reason"]').value.trim();
            if (reason.length < 10) {
                e.preventDefault();
                alert('Please provide a reason of at least 10 characters.');
                return;
            }
            var btn = this.querySelector('button[type="submit"]');
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Cancelling...';
        });
    </script>
}