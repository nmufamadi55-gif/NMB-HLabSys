@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Test Requests";
    ViewData["RoleSubtitle"] = "Doctor Portal";
    ViewData["UserGreeting"] = "Manage and track all test requests";
    ViewData["UserInitials"] = "SJ";
    ViewData["UserName"] = "Sarah Johnson";

    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
}

@section SidebarMenu {
    <li><a href="@Url.Action("Dashboard", "Doctor")" class="active"><i class="fas fa-chart-pie"></i> <span>Dashboard</span></a></li>
    <li><a href="@Url.Action("TestRequests", "Doctor")"><i class="fas fa-notes-medical"></i> <span>Test Requests</span></a></li>
    <li><a href="@Url.Action("Patients", "Doctor")"><i class="fas fa-users"></i> <span>My Patients</span></a></li>
    <li><a href="@Url.Action("Alerts", "Doctor")"><i class="fas fa-bell"></i> <span>Alerts</span></a></li>
    <li><a href="@Url.Action("Results", "Doctor")"><i class="fas fa-chart-line"></i> <span>Results</span></a></li>
    <li><a href="@Url.Action("Reports", "Doctor")"><i class="fas fa-file-alt"></i> <span>Reports</span></a></li>
    <li><a href="@Url.Action("Index", "Profile")"><i class="fas fa-user-circle"></i> <span>My Profile</span></a></li>
}

<style>
    .card {
        background: white;
        border-radius: 20px;
        padding: 1.2rem;
        margin-bottom: 1.2rem;
        border: 1px solid #E2E8F0;
    }

    .filter-bar {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
        margin-bottom: 1rem;
        align-items: center;
    }

    .filter-input, .filter-select {
        padding: 0.3rem 0.6rem;
        border-radius: 30px;
        border: 1px solid #E2E8F0;
        font-size: 0.75rem;
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    th, td {
        padding: 0.6rem 0.4rem;
        text-align: left;
        border-bottom: 1px solid #E2E8F0;
        font-size: 0.75rem;
    }

    th {
        background: #F8FAFE;
        font-weight: 600;
        color: #5A6E7A;
    }

    .status-badge {
        display: inline-block;
        padding: 0.15rem 0.5rem;
        border-radius: 30px;
        font-size: 0.65rem;
        font-weight: 600;
    }

    .status-submitted {
        background: #FFF3CD;
        color: #856404;
    }

    .status-progress {
        background: #CDE8FF;
        color: #004085;
    }

    .status-completed {
        background: #D4EDDA;
        color: #155724;
    }

    .status-verified {
        background: #D1F7EA;
        color: #0D5E4A;
    }

    .priority-stat {
        color: #DC2626;
        font-weight: bold;
    }

    .priority-urgent {
        color: #F59E0B;
        font-weight: bold;
    }

    .priority-routine {
        color: #10B981;
        font-weight: normal;
    }

    .btn-sm {
        background: #0841C9;
        color: white;
        border: none;
        padding: 0.2rem 0.6rem;
        border-radius: 30px;
        cursor: pointer;
        font-size: 0.7rem;
    }

    .btn-outline-sm {
        background: transparent;
        border: 1px solid #E2E8F0;
        padding: 0.2rem 0.6rem;
        border-radius: 30px;
        cursor: pointer;
        font-size: 0.7rem;
    }

    .stats-mini {
        display: flex;
        gap: 0.8rem;
        flex-wrap: wrap;
        margin-bottom: 1rem;
    }

    .stat-mini {
        background: white;
        border-radius: 12px;
        padding: 0.5rem 1rem;
        flex: 1;
        text-align: center;
        border: 1px solid #E2E8F0;
    }

        .stat-mini h4 {
            font-size: 1.3rem;
            color: #032C7D;
            margin: 0;
        }

    .modal-overlay {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.6);
        backdrop-filter: blur(3px);
        z-index: 2000;
        align-items: center;
        justify-content: center;
    }

        .modal-overlay.active {
            display: flex;
        }

    .modal-container {
        background: white;
        border-radius: 28px;
        width: 90%;
        max-width: 750px;
        max-height: 85vh;
        overflow-y: auto;
        box-shadow: 0 25px 50px rgba(0,0,0,0.25);
    }

    .modal-header {
        padding: 1.2rem 1.8rem;
        border-bottom: 1px solid #E2E8F0;
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: #F8FAFE;
        border-radius: 28px 28px 0 0;
    }

        .modal-header h3 {
            margin: 0;
            color: #032C7D;
            font-size: 1.3rem;
        }

    .modal-body {
        padding: 1.5rem 1.8rem;
    }

    .modal-footer {
        padding: 1rem 1.8rem;
        border-top: 1px solid #E2E8F0;
        display: flex;
        justify-content: flex-end;
        gap: 1rem;
        background: #F8FAFE;
        border-radius: 0 0 28px 28px;
    }

    .close-modal {
        background: none;
        border: none;
        font-size: 1.5rem;
        cursor: pointer;
        color: #5A6E7A;
    }

    .form-group {
        margin-bottom: 1.2rem;
    }

        .form-group label {
            font-size: 0.85rem;
            font-weight: 600;
            display: block;
            margin-bottom: 0.4rem;
            color: #032C7D;
        }

    .form-control {
        width: 100%;
        padding: 0.7rem 1rem;
        border: 1px solid #E2E8F0;
        border-radius: 12px;
        font-size: 0.9rem;
    }

    textarea.form-control {
        resize: vertical;
        min-height: 80px;
        font-family: inherit;
    }

    .category-group {
        margin-bottom: 1rem;
        border: 1px solid #E2E8F0;
        border-radius: 12px;
        overflow: hidden;
    }

    .category-header {
        background: #F8FAFE;
        padding: 0.7rem 1rem;
