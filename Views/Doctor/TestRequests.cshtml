@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Test Requests";
    ViewData["RoleSubtitle"] = "Doctor Portal";
    ViewData["UserGreeting"] = "Manage and track all test requests";
    ViewData["UserInitials"] = "DJ";
    ViewData["UserName"] = "Dr. Sarah Johnson";
}

@section SidebarMenu {
    <li><a href="@Url.Action("Dashboard", "Doctor")"><i class="fas fa-chart-pie"></i> <span>Dashboard</span></a></li>
    <li><a href="@Url.Action("TestRequests", "Doctor")" class="active"><i class="fas fa-notes-medical"></i> <span>Test Requests</span></a></li>
    <li><a href="@Url.Action("Patients", "Doctor")"><i class="fas fa-users"></i> <span>My Patients</span></a></li>
    <li><a href="@Url.Action("Alerts", "Doctor")"><i class="fas fa-bell"></i> <span>Alerts</span></a></li>
    <li><a href="@Url.Action("Results", "Doctor")"><i class="fas fa-chart-line"></i> <span>Results</span></a></li>
    <li><a href="@Url.Action("Reports", "Doctor")"><i class="fas fa-file-alt"></i> <span>Reports</span></a></li>
}

<style>
    .card {
        background: white;
        border-radius: 16px;
        padding: 1rem;
        margin-bottom: 1rem;
        border: 1px solid #E2E8F0;
    }

    .filter-bar {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
        margin-bottom: 1rem;
        align-items: center;
    }

    .filter-input, .filter-select {
        padding: 0.3rem 0.6rem;
        border-radius: 30px;
        border: 1px solid #E2E8F0;
        font-size: 0.75rem;
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    th, td {
        padding: 0.6rem 0.4rem;
        text-align: left;
        border-bottom: 1px solid #E2E8F0;
        font-size: 0.75rem;
    }

    th {
        background: #F8FAFE;
        font-weight: 600;
        color: #5A6E7A;
    }

    .status-badge {
        display: inline-block;
        padding: 0.15rem 0.5rem;
        border-radius: 30px;
        font-size: 0.65rem;
        font-weight: 600;
    }

    .status-submitted {
        background: #FFF3CD;
        color: #856404;
    }

    .status-progress {
        background: #CDE8FF;
        color: #004085;
    }

    .status-completed {
        background: #D4EDDA;
        color: #155724;
    }

    .status-verified {
        background: #D1F7EA;
        color: #0D5E4A;
    }

    .priority-stat {
        background: #F8D7DA;
        color: #721C24;
    }

    .btn-sm {
        background: #0841C9;
        color: white;
        border: none;
        padding: 0.2rem 0.6rem;
        border-radius: 30px;
        cursor: pointer;
        font-size: 0.7rem;
    }

    .btn-outline-sm {
        background: transparent;
        border: 1px solid #E2E8F0;
        padding: 0.2rem 0.6rem;
        border-radius: 30px;
        cursor: pointer;
        font-size: 0.7rem;
    }

    .stats-mini {
        display: flex;
        gap: 0.8rem;
        flex-wrap: wrap;
        margin-bottom: 1rem;
    }

    .stat-mini {
        background: white;
        border-radius: 12px;
        padding: 0.5rem 1rem;
        flex: 1;
        text-align: center;
        border: 1px solid #E2E8F0;
    }

        .stat-mini h4 {
            font-size: 1.3rem;
            color: #032C7D;
            margin: 0;
        }

    .modal-overlay {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.5);
        z-index: 2000;
        align-items: center;
        justify-content: center;
    }

        .modal-overlay.active {
            display: flex;
        }

    .modal-container {
        background: white;
        border-radius: 20px;
        width: 90%;
        max-width: 500px;
        max-height: 90vh;
        overflow-y: auto;
    }

    .modal-header, .modal-footer {
        padding: 0.8rem 1rem;
        border-bottom: 1px solid #E2E8F0;
    }

    .modal-footer {
        border-bottom: none;
        border-top: 1px solid #E2E8F0;
        display: flex;
        justify-content: flex-end;
        gap: 0.5rem;
    }

    .form-group {
        margin-bottom: 0.8rem;
    }

        .form-group label {
            font-size: 0.75rem;
            font-weight: 500;
            display: block;
            margin-bottom: 0.2rem;
        }

    .form-control {
        width: 100%;
        padding: 0.4rem;
        border: 1px solid #E2E8F0;
        border-radius: 8px;
        font-size: 0.8rem;
    }

    .close-modal {
        background: none;
        border: none;
        font-size: 1.2rem;
        cursor: pointer;
    }
</style>

<div class="stats-mini">
    <div class="stat-mini"><h4 id="totalCount">0</h4><p>Total</p></div>
    <div class="stat-mini"><h4 id="pendingCount">0</h4><p>Pending</p></div>
    <div class="stat-mini"><h4 id="completedCount">0</h4><p>Completed</p></div>
    <div class="stat-mini"><h4 id="abnormalCount">0</h4><p>Abnormal</p></div>
</div>

<div class="card">
    <div class="filter-bar">
        <input type="text" id="searchReq" class="filter-input" placeholder="🔍 Search by patient or request #" style="width:200px;">
        <select id="statusFilter" class="filter-select"><option value="all">All Status</option><option>Submitted</option><option>In Progress</option><option>Completed</option><option>Verified</option></select>
        <select id="urgencyFilter" class="filter-select"><option value="all">All Urgency</option><option>stat</option><option>urgent</option><option>routine</option></select>
        <input type="date" id="dateFilter" class="filter-input" style="width:130px;">
        <button class="btn-sm" onclick="applyFilters()">Apply</button>
        <button class="btn-outline-sm" onclick="resetFilters()">Reset</button>
        <button class="btn-sm" onclick="openNewRequestModal()" style="background:#10B981;">+ New Request</button>
    </div>
    <div class="table-container">
        <table id="requestsTable">
            <thead><tr><th>Req #</th><th>Patient</th><th>Date</th><th>Tests</th><th>Status</th><th>Urgency</th><th>Action</th></tr></thead>
            <tbody id="requestsBody"></tbody>
        </table>
    </div>
</div>

<!-- New Request Modal -->
<div id="newRequestModal" class="modal-overlay">
    <div class="modal-container">
        <div class="modal-header"><h3>New Test Request</h3><button class="close-modal" onclick="closeModal('newRequestModal')">&times;</button></div>
        <div class="modal-body">
            <div class="form-group"><label>Patient *</label><select id="newPatient" class="form-control"><option value="1">Thabo Mbeki (8001015009087)</option><option value="2">Lerato Dlamini (8505155009088)</option><option value="3">John Smith (9001015009089)</option></select></div>
            <div class="form-group"><label>Urgency *</label><select id="newUrgency" class="form-control"><option>Routine</option><option>Urgent</option><option>STAT</option></select></div>
            <div class="form-group"><label>Test Types *</label><div id="testChecks"><label><input type="checkbox" value="FBC"> Full Blood Count</label><br><label><input type="checkbox" value="Coagulation"> Coagulation Studies</label><br><label><input type="checkbox" value="Differential"> Differential Count</label></div></div>
            <div class="form-group"><label>Clinical Notes</label><textarea rows="2" class="form-control" id="newNotes"></textarea></div>
            <div id="barcodeDisplay" style="display:none; background:#F1F5F9; padding:0.5rem; border-radius:8px; margin-top:0.5rem;"></div>
        </div>
        <div class="modal-footer"><button class="btn-outline-sm" onclick="closeModal('newRequestModal')">Cancel</button><button class="btn-sm" onclick="submitNewRequest()">Submit Request</button></div>
    </div>
</div>

<!-- Cancel Modal -->
<div id="cancelModal" class="modal-overlay">
    <div class="modal-container">
        <div class="modal-header"><h3>Cancel Request</h3><button class="close-modal" onclick="closeModal('cancelModal')">&times;</button></div>
        <div class="modal-body"><div class="form-group"><label>Reason for cancellation</label><textarea id="cancelReason" rows="2" class="form-control" placeholder="Please provide a reason..."></textarea></div></div>
        <div class="modal-footer"><button class="btn-outline-sm" onclick="closeModal('cancelModal')">Close</button><button class="btn-sm" style="background:#DC2626;" onclick="confirmCancel()">Cancel Request</button></div>
    </div>
</div>

<script>
    let requests = [
        { id:1, reqNo:"REQ-001", patient:"Thabo Mbeki", date:"2025-04-09", tests:["FBC"], status:"In Progress", urgency:"stat", hasAbnormal:false },
        { id:2, reqNo:"REQ-002", patient:"Lerato Dlamini", date:"2025-04-08", tests:["Coagulation"], status:"Completed", urgency:"routine", hasAbnormal:false },
        { id:3, reqNo:"REQ-003", patient:"John Smith", date:"2025-04-07", tests:["Platelets"], status:"Verified", urgency:"urgent", hasAbnormal:true },
        { id:4, reqNo:"REQ-004", patient:"Maria Santos", date:"2025-04-10", tests:["FBC"], status:"Submitted", urgency:"stat", hasAbnormal:false }
    ];
    let cancelId = null;

    function renderRequests() {
        let filtered = [...requests];
        const search = document.getElementById('searchReq')?.value.toLowerCase() || '';
        const status = document.getElementById('statusFilter')?.value || 'all';
        const urgency = document.getElementById('urgencyFilter')?.value || 'all';
        const date = document.getElementById('dateFilter')?.value || '';
        if(search) filtered = filtered.filter(r=>r.reqNo.toLowerCase().includes(search)||r.patient.toLowerCase().includes(search));
        if(status!='all') filtered = filtered.filter(r=>r.status===status);
        if(urgency!='all') filtered = filtered.filter(r=>r.urgency===urgency);
        if(date) filtered = filtered.filter(r=>r.date===date);

        document.getElementById('totalCount').innerText = requests.length;
        document.getElementById('pendingCount').innerText = requests.filter(r=>r.status!=='Completed'&&r.status!=='Verified').length;
        document.getElementById('completedCount').innerText = requests.filter(r=>r.status==='Completed').length;
        document.getElementById('abnormalCount').innerText = requests.filter(r=>r.hasAbnormal).length;

        const tbody = document.getElementById('requestsBody');
        tbody.innerHTML = filtered.map(r => {
            let statusClass = r.status==='In Progress'?'status-progress':r.status==='Completed'?'status-completed':r.status==='Verified'?'status-verified':'status-submitted';
            return `<tr><td><strong>${r.reqNo}</strong></td><td>${r.patient}</td><td>${r.date}</td><td>${r.tests.join(', ')}</td><td><span class="status-badge ${statusClass}">${r.status}</span></td><td><span class="status-badge ${r.urgency==='stat'?'priority-stat':''}">${r.urgency}</span></td>
            <td><button class="btn-sm" onclick="viewRequest(${r.id})">View</button> ${(r.status==='Submitted'||r.status==='In Progress')?`<button class="btn-outline-sm" onclick="openCancelModal(${r.id})">Cancel</button>`:''}</td></tr>`;
        }).join('');
    }

    function viewRequest(id) { alert(`📋 Viewing request #${id} - Full details would open here.`); }
    function openNewRequestModal() { document.getElementById('newRequestModal').classList.add('active'); }
    function openCancelModal(id) { cancelId=id; document.getElementById('cancelModal').classList.add('active'); }
    function closeModal(id) { document.getElementById(id).classList.remove('active'); document.getElementById('cancelReason').value=''; }
    function confirmCancel() { if(cancelId){ requests=requests.filter(r=>r.id!==cancelId); renderRequests(); alert('Request cancelled.'); } closeModal('cancelModal'); }
    function applyFilters() { renderRequests(); }
    function resetFilters() { document.getElementById('searchReq').value=''; document.getElementById('statusFilter').value='all'; document.getElementById('urgencyFilter').value='all'; document.getElementById('dateFilter').value=''; renderRequests(); }
    function submitNewRequest() { alert('✅ Test request submitted!\n📧 Patient notified via email.\n📦 Barcodes generated.'); closeModal('newRequestModal'); renderRequests(); }
    renderRequests();
</script>