        font-weight: 600;
        color: #032C7D;
    }

    .test-list {
        padding: 0.8rem 1rem;
        display: none;
        background: white;
    }

        .test-list.show {
            display: block;
        }

        .test-list label {
            display: inline-block;
            width: 48%;
            margin: 0.3rem 0;
            font-size: 0.8rem;
            cursor: pointer;
        }

    .sample-requirements {
        background: #EFF6FF;
        border-radius: 12px;
        padding: 0.8rem;
        margin-top: 1rem;
        border-left: 4px solid #0841C9;
    }

    .sample-item {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.4rem 0;
        border-bottom: 1px solid #E2E8F0;
        font-size: 0.8rem;
    }

        .sample-item:last-child {
            border-bottom: none;
        }

    .sample-icon {
        font-size: 1.2rem;
    }

    .sample-details {
        flex: 1;
    }

    .sample-name {
        font-weight: 600;
        color: #032C7D;
    }

    .sample-instruction {
        font-size: 0.7rem;
        color: #5A6E7A;
    }

    .selected-tests-summary {
        background: #F1F5F9;
        border-radius: 12px;
        padding: 0.8rem;
        margin-top: 0.5rem;
    }

    .selected-test-tag {
        display: inline-block;
        background: #0841C9;
        color: white;
        padding: 0.2rem 0.6rem;
        border-radius: 20px;
        font-size: 0.7rem;
        margin: 0.2rem;
    }

    .barcode-item {
        background: #F1F5F9;
        padding: 0.4rem 0.8rem;
        border-radius: 8px;
        margin-bottom: 0.4rem;
        display: flex;
        justify-content: space-between;
        font-family: monospace;
        font-size: 0.75rem;
    }

    .medical-tag {
        display: inline-block;
        background: #F1F5F9;
        padding: 0.2rem 0.5rem;
        border-radius: 20px;
        font-size: 0.7rem;
        margin-right: 0.3rem;
        margin-bottom: 0.2rem;
    }

    .tag-condition {
        background: #FEF3C7;
        color: #92400E;
    }

    .tag-allergy {
        background: #FEE2E2;
        color: #991B1B;
    }

    .tag-medication {
        background: #D1FAE5;
        color: #065F46;
    }

    .patient-info-card {
        background: #F0F9FF;
        border-radius: 12px;
        padding: 0.8rem;
        margin-bottom: 1rem;
        border-left: 4px solid #0841C9;
    }

    .detail-section {
        margin-bottom: 1.2rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid #E2E8F0;
    }

        .detail-section:last-child {
            border-bottom: none;
        }

        .detail-section h4 {
            color: #032C7D;
            font-size: 0.95rem;
            margin-bottom: 0.8rem;
        }

    .detail-row {
        display: flex;
        margin-bottom: 0.5rem;
        font-size: 0.85rem;
    }

    .detail-label {
        width: 130px;
        font-weight: 600;
        color: #5A6E7A;
    }

    .detail-value {
        flex: 1;
        color: #1A2C3A;
    }

    .test-item {
        background: #F8FAFE;
        border-radius: 12px;
        padding: 0.8rem;
        margin-bottom: 0.5rem;
    }

    .test-name {
        font-weight: 600;
        color: #032C7D;
    }

    .result-badge {
        display: inline-block;
        padding: 0.2rem 0.5rem;
        border-radius: 20px;
        font-size: 0.65rem;
    }

    .result-normal {
        background: #D1FAE5;
        color: #065F46;
    }

    .result-abnormal {
        background: #FEE2E2;
        color: #991B1B;
    }

    .result-pending {
        background: #FEF3C7;
        color: #92400E;
        display: inline-block;
        padding: 0.2rem 0.5rem;
        border-radius: 20px;
        font-size: 0.65rem;
    }

    .status-timeline {
        display: flex;
        justify-content: space-between;
        margin-top: 1rem;
        flex-wrap: wrap;
    }

    .timeline-step {
        text-align: center;
        flex: 1;
        min-width: 70px;
    }

        .timeline-step .step-circle {
            width: 28px;
            height: 28px;
            background: #E2E8F0;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 0.3rem;
            font-size: 0.7rem;
        }

        .timeline-step.completed .step-circle {
            background: #10B981;
            color: white;
        }

        .timeline-step.active .step-circle {
            background: #0841C9;
            color: white;
        }

        .timeline-step .step-label {
            font-size: 0.6rem;
            color: #5A6E7A;
        }
</style>

<div class="stats-mini">
    <div class="stat-mini"><h4 id="totalCount">0</h4><p>Total Requests</p></div>
    <div class="stat-mini"><h4 id="pendingCount">0</h4><p>Pending</p></div>
    <div class="stat-mini"><h4 id="completedCount">0</h4><p>Completed</p></div>
    <div class="stat-mini"><h4 id="abnormalCount">0</h4><p>Abnormal</p></div>
</div>

<div class="card">
    <div class="filter-bar">
        <input type="text" id="searchReq" class="filter-input" placeholder="Search by patient or request #" style="width:200px;">
        <select id="statusFilter" class="filter-select"><option value="all">All Status</option><option>Submitted</option><option>In Progress</option><option>Completed</option><option>Verified</option></select>
        <select id="urgencyFilter" class="filter-select"><option value="all">All Urgency</option><option>stat</option><option>urgent</option><option>routine</option></select>
        <input type="date" id="dateFilter" class="filter-input" style="width:130px;">
        <button class="btn-sm" onclick="applyFilters()">Apply</button>
        <button class="btn-outline-sm" onclick="resetFilters()">Reset</button>
        <button class="btn-sm" onclick="openNewRequestModal()" style="background:#10B981;">+ New Request</button>
    </div>
    <div class="table-container">
        <table id="requestsTable">
            <thead><tr><th>Req #</th><th>Patient</th><th>Date</th><th>Tests</th><th>Status</th><th>Urgency</th><th>Action</th></tr></thead>
            <tbody id="requestsBody"></tbody>
        </table>
    </div>
</div>

<!-- View Request Modal -->
<div id="viewRequestModal" class="modal-overlay">
    <div class="modal-container">
        <div class="modal-header"><h3>Request Details</h3><button class="close-modal" onclick="closeModal('viewRequestModal')">&times;</button></div>
        <div class="modal-body" id="viewRequestContent"></div>
        <div class="modal-footer"><button class="btn-outline-sm" onclick="closeModal('viewRequestModal')">Close</button><button class="btn-sm" onclick="downloadRequestPDF()" style="background:#10B981;">Download PDF</button></div>
    </div>
</div>

<!-- New Request Modal -->
<div id="newRequestModal" class="modal-overlay">
    <div class="modal-container">
        <div class="modal-header"><h3>New Test Request</h3><button class="close-modal" onclick="closeModal('newRequestModal')">&times;</button></div>
        <div class="modal-body">
            <div class="form-group"><label>Enter Patient SA ID Number *</label><div style="display:flex; gap:0.5rem;"><input type="text" id="patientIdSearch" class="form-control" placeholder="e.g., 8001015009087"><button type="button" class="btn-sm" onclick="searchPatientById()" style="background:#1D97F1;">Search</button></div></div>
            <div id="patientMedicalInfo"></div>
            <div id="requestFormFields" style="display:none;">
                <div class="form-group">
                    <label>Urgency *</label>
                    <div style="display:flex; gap:1rem; align-items:center;">
                        <label style="display:flex; align-items:center; gap:0.3rem;"><input type="radio" name="urgency" value="routine" checked> <span class="priority-routine">Routine</span></label>
                        <label style="display:flex; align-items:center; gap:0.3rem;"><input type="radio" name="urgency" value="urgent"> <span class="priority-urgent">Urgent</span></label>
                        <label style="display:flex; align-items:center; gap:0.3rem;"><input type="radio" name="urgency" value="stat"> <span class="priority-stat">STAT</span></label>
                    </div>
                </div>
                <div class="form-group"><label>Select Test Types *</label><div id="testCategoriesContainer"></div><div id="selectedTestsSummary" class="selected-tests-summary" style="display:none;"><strong>Selected Tests:</strong> <div id="selectedTestsList"></div></div></div>
                <div class="form-group"><label>Clinical Notes</label><textarea id="newNotes" rows="3" class="form-control" placeholder="Enter relevant clinical information, symptoms, or special instructions for the lab..."></textarea></div>
                <div id="sampleRequirements" style="display:none;"></div>
                <div id="barcodeDisplay" style="display:none;"></div>
            </div>
        </div>
        <div class="modal-footer"><button class="btn-outline-sm" onclick="closeModal('newRequestModal')">Cancel</button><button class="btn-sm" id="submitRequestBtn" onclick="submitNewRequest()" style="background:#10B981; display:none;">Submit Request</button></div>
    </div>
</div>

<!-- Cancel Modal -->
<div id="cancelModal" class="modal-overlay">
    <div class="modal-container" style="max-width:450px;">
        <div class="modal-header"><h3>Cancel Request</h3><button class="close-modal" onclick="closeModal('cancelModal')">&times;</button></div>
        <div class="modal-body"><div class="form-group"><label>Reason for cancellation *</label><textarea id="cancelReason" rows="3" class="form-control" placeholder="Please provide a reason..."></textarea></div></div>
        <div class="modal-footer"><button class="btn-outline-sm" onclick="closeModal('cancelModal')">Close</button><button class="btn-sm" style="background:#DC2626;" onclick="confirmCancel()">Cancel Request</button></div>
    </div>
</div>

<script type="text/javascript">
    // Mock Data
    var requests = [
        { id:1, reqNo:"REQ-001", patient:"Thabo Mbeki", patientId:"8001015009087", patientInfo:{name:"Thabo", surname:"Mbeki", dob:"1980-01-01", phone:"0821234567", conditions:["Hypertension"], allergies:["Penicillin"], medications:["Lisinopril 10mg"]}, date:"2025-04-09", tests:["Haemoglobin (Hb)", "White Cell Count (WCC)"], status:"In Progress", urgency:"stat", hasAbnormal:true, results:[{name:"Haemoglobin (Hb)", result:"7.2", normal:"12-16", abnormal:true},{name:"White Cell Count (WCC)", result:"8.5", normal:"4-11", abnormal:false}], clinicalNotes:"Patient presents with fatigue and pallor" },
        { id:2, reqNo:"REQ-002", patient:"Lerato Dlamini", patientId:"8505155009088", patientInfo:{name:"Lerato", surname:"Dlamini", dob:"1985-05-15", phone:"0832345678", conditions:["Type 2 Diabetes"], allergies:[], medications:["Metformin 500mg"]}, date:"2025-04-08", tests:["PT/INR"], status:"Completed", urgency:"routine", hasAbnormal:false, results:[{name:"PT/INR", result:"12.5", normal:"11-13.5", abnormal:false}], clinicalNotes:"Routine follow-up" },
        { id:3, reqNo:"REQ-003", patient:"John Smith", patientId:"9001015009089", patientInfo:{name:"John", surname:"Smith", dob:"1990-01-01", phone:"0843456789", conditions:[], allergies:["Sulfa"], medications:[]}, date:"2025-04-07", tests:["Platelet Count"], status:"Verified", urgency:"urgent", hasAbnormal:true, results:[{name:"Platelet Count", result:"45", normal:"150-450", abnormal:true}], clinicalNotes:"Unexplained bruising" },
        { id:4, reqNo:"REQ-004", patient:"Thabo Mbeki", patientId:"8001015009087", patientInfo:{name:"Thabo", surname:"Mbeki", dob:"1980-01-01", phone:"0821234567", conditions:["Hypertension"], allergies:["Penicillin"], medications:["Lisinopril 10mg"]}, date:"2025-04-10", tests:["WCC","Neutrophils"], status:"Submitted", urgency:"stat", hasAbnormal:false, results:null, clinicalNotes:"Post-treatment monitoring" }
    ];

    var testDatabase = [
        { name: "Haemoglobin (Hb)", category: "Full Blood Count (FBC)", sampleType: "Whole Blood", tube: "EDTA Tube", tubeColor: "Purple top", volume: "3-5 mL", instructions: "Gently invert 8-10 times to mix", equipment: "Vacutainer system" },
        { name: "White Cell Count (WCC)", category: "Full Blood Count (FBC)", sampleType: "Whole Blood", tube: "EDTA Tube", tubeColor: "Purple top", volume: "3-5 mL", instructions: "Gently invert 8-10 times to mix", equipment: "Vacutainer system" },
        { name: "Platelet Count", category: "Full Blood Count (FBC)", sampleType: "Whole Blood", tube: "EDTA Tube", tubeColor: "Purple top", volume: "3-5 mL", instructions: "Gently invert 8-10 times to mix", equipment: "Vacutainer system" },
        { name: "Red Cell Count (RCC)", category: "Full Blood Count (FBC)", sampleType: "Whole Blood", tube: "EDTA Tube", tubeColor: "Purple top", volume: "3-5 mL", instructions: "Gently invert 8-10 times to mix", equipment: "Vacutainer system" },
        { name: "PT/INR", category: "Coagulation Studies", sampleType: "Plasma", tube: "Citrate Tube", tubeColor: "Light blue top", volume: "2.7 mL", instructions: "Fill completely, invert gently 3-4 times", equipment: "Sodium citrate anticoagulant" },
        { name: "APTT", category: "Coagulation Studies", sampleType: "Plasma", tube: "Citrate Tube", tubeColor: "Light blue top", volume: "2.7 mL", instructions: "Fill completely, invert gently 3-4 times", equipment: "Sodium citrate anticoagulant" },
        { name: "Fibrinogen", category: "Coagulation Studies", sampleType: "Plasma", tube: "Citrate Tube", tubeColor: "Light blue top", volume: "2.7 mL", instructions: "Fill completely, invert gently 3-4 times", equipment: "Sodium citrate anticoagulant" },
        { name: "Neutrophils", category: "Differential Count", sampleType: "Whole Blood", tube: "EDTA Tube", tubeColor: "Purple top", volume: "3-5 mL", instructions: "Blood smear required", equipment: "Microscope slides, stain" },
        { name: "Lymphocytes", category: "Differential Count", sampleType: "Whole Blood", tube: "EDTA Tube", tubeColor: "Purple top", volume: "3-5 mL", instructions: "Blood smear required", equipment: "Microscope slides, stain" },
        { name: "Monocytes", category: "Differential Count", sampleType: "Whole Blood", tube: "EDTA Tube", tubeColor: "Purple top", volume: "3-5 mL", instructions: "Blood smear required", equipment: "Microscope slides, stain" },
        { name: "Film Comment", category: "Peripheral Blood Film", sampleType: "Whole Blood", tube: "EDTA Tube", tubeColor: "Purple top", volume: "3-5 mL", instructions: "Prepare thin blood smear", equipment: "Microscope, staining kit" },
        { name: "Blast Cells", category: "Peripheral Blood Film", sampleType: "Whole Blood", tube: "EDTA Tube", tubeColor: "Purple top", volume: "3-5 mL", instructions: "Prepare thin blood smear", equipment: "Microscope, staining kit" }
    ];

    var categories = [...new Set(testDatabase.map(function(t) { return t.category; }))];
    var currentSelectedPatient = null;
    var currentSelectedTests = [];
    var currentViewRequest = null;
    var cancelId = null;
    var patientDatabase = {
        "8001015009087": { name:"Thabo", surname:"Mbeki", dob:"1980-01-01", phone:"0821234567", conditions:["Hypertension"], allergies:["Penicillin"], medications:["Lisinopril 10mg"] },
        "8505155009088": { name:"Lerato", surname:"Dlamini", dob:"1985-05-15", phone:"0832345678", conditions:["Type 2 Diabetes"], allergies:[], medications:["Metformin 500mg"] },
        "9001015009089": { name:"John", surname:"Smith", dob:"1990-01-01", phone:"0843456789", conditions:[], allergies:["Sulfa"], medications:[] }
    };

    function renderRequests() {
        var filtered = requests.slice();
        var search = document.getElementById('searchReq') ? document.getElementById('searchReq').value.toLowerCase() : '';
        var status = document.getElementById('statusFilter') ? document.getElementById('statusFilter').value : 'all';
        var urgency = document.getElementById('urgencyFilter') ? document.getElementById('urgencyFilter').value : 'all';
        var date = document.getElementById('dateFilter') ? document.getElementById('dateFilter').value : '';

        if(search) filtered = filtered.filter(function(r) { return r.reqNo.toLowerCase().includes(search) || r.patient.toLowerCase().includes(search); });
        if(status !== 'all') filtered = filtered.filter(function(r) { return r.status === status; });
        if(urgency !== 'all') filtered = filtered.filter(function(r) { return r.urgency === urgency; });
        if(date) filtered = filtered.filter(function(r) { return r.date === date; });

        document.getElementById('totalCount').innerText = requests.length;
        document.getElementById('pendingCount').innerText = requests.filter(function(r) { return r.status !== 'Completed' && r.status !== 'Verified'; }).length;
        document.getElementById('completedCount').innerText = requests.filter(function(r) { return r.status === 'Completed'; }).length;
        document.getElementById('abnormalCount').innerText = requests.filter(function(r) { return r.hasAbnormal; }).length;

        var tbody = document.getElementById('requestsBody');
        tbody.innerHTML = filtered.map(function(r) {
            var statusClass = r.status === 'In Progress' ? 'status-progress' : (r.status === 'Completed' ? 'status-completed' : (r.status === 'Verified' ? 'status-verified' : 'status-submitted'));
            var urgencyClass = r.urgency === 'stat' ? 'priority-stat' : (r.urgency === 'urgent' ? 'priority-urgent' : 'priority-routine');
            return '<tr>' +
                '<td><strong>' + r.reqNo + '</strong></td>' +
                '<td>' + r.patient + '</td>' +
                '<td>' + r.date + '</td>' +
                '<td>' + r.tests.join(', ') + '</td>' +
                '<td><span class="status-badge ' + statusClass + '">' + r.status + '</span></td>' +
                '<td><span class="' + urgencyClass + '">' + r.urgency.toUpperCase() + '</span></td>' +
                '<td><button class="btn-sm" onclick="viewRequestDetails(' + r.id + ')">View</button> ' + ((r.status === 'Submitted' || r.status === 'In Progress') ? '<button class="btn-outline-sm" onclick="openCancelModal(' + r.id + ')">Cancel</button>' : '') + '</td>' +
                '</tr>';
        }).join('');
    }

    function viewRequestDetails(id) {
        var request = requests.find(function(r) { return r.id === id; });
        if (!request) return;
        currentViewRequest = request;
        var statusSteps = ["Submitted", "Samples Received", "In Progress", "Completed", "Verified", "Released"];
        var currentStepIndex = statusSteps.indexOf(request.status);

        var resultsHtml = '';
        if (request.results && request.results.length > 0) {
            resultsHtml = '<div class="detail-section"><h4>Test Results</h4>';
            request.results.forEach(function(r) {
                resultsHtml += '<div class="test-item"><div class="test-name">' + r.name + '</div><div class="detail-row"><div class="detail-label">Result:</div><div class="detail-value"><span class="result-badge ' + (r.abnormal ? 'result-abnormal' : 'result-normal') + '">' + r.result + ' ' + (r.abnormal ? 'Abnormal' : '') + '</span> (Normal: ' + r.normal + ')</div></div></div>';
            });
            resultsHtml += '</div>';
        } else {
            resultsHtml = '<div class="detail-section"><h4>Test Results</h4><p class="result-pending" style="text-align:center;">Results pending - Lab currently processing</p></div>';
        }

        var patient = request.patientInfo;
        var content = '<div class="detail-section"><h4>Request Information</h4>' +
            '<div class="detail-row"><div class="detail-label">Request Number:</div><div class="detail-value"><strong>' + request.reqNo + '</strong></div></div>' +
            '<div class="detail-row"><div class="detail-label">Request Date:</div><div class="detail-value">' + request.date + '</div></div>' +
            '<div class="detail-row"><div class="detail-label">Urgency:</div><div class="detail-value"><span class="' + (request.urgency === 'stat' ? 'priority-stat' : (request.urgency === 'urgent' ? 'priority-urgent' : 'priority-routine')) + '">' + request.urgency.toUpperCase() + '</span></div></div>' +
            '<div class="detail-row"><div class="detail-label">Status:</div><div class="detail-value"><span class="status-badge">' + request.status + '</span></div></div>' +
            '<div class="detail-row"><div class="detail-label">Clinical Notes:</div><div class="detail-value">' + (request.clinicalNotes || 'None') + '</div></div></div>' +
            '<div class="detail-section"><h4>Patient Information</h4>' +
            '<div class="detail-row"><div class="detail-label">Full Name:</div><div class="detail-value">' + patient.name + ' ' + patient.surname + '</div></div>' +
            '<div class="detail-row"><div class="detail-label">ID Number:</div><div class="detail-value">' + request.patientId + '</div></div>' +
            '<div class="detail-row"><div class="detail-label">DOB:</div><div class="detail-value">' + patient.dob + '</div></div>' +
            '<div class="detail-row"><div class="detail-label">Contact:</div><div class="detail-value">' + patient.phone + '</div></div>' +
            '<div class="detail-row"><div class="detail-label">Conditions:</div><div class="detail-value">' + (patient.conditions.map(function(c) { return '<span class="medical-tag tag-condition">' + c + '</span>'; }).join('') || 'None') + '</div></div>' +
            '<div class="detail-row"><div class="detail-label">Allergies:</div><div class="detail-value">' + (patient.allergies.map(function(a) { return '<span class="medical-tag tag-allergy">' + a + '</span>'; }).join('') || 'None') + '</div></div>' +
            '<div class="detail-row"><div class="detail-label">Medications:</div><div class="detail-value">' + (patient.medications.map(function(m) { return '<span class="medical-tag tag-medication">' + m + '</span>'; }).join('') || 'None') + '</div></div></div>' +
            '<div class="detail-section"><h4>Tests Requested</h4>' +
            '<div class="detail-row"><div class="detail-label">Test Types:</div><div class="detail-value">' + request.tests.join(', ') + '</div></div></div>' +
            resultsHtml +
            '<div class="detail-section"><h4>Status Timeline</h4><div class="status-timeline">' + statusSteps.map(function(step, idx) { return '<div class="timeline-step ' + (idx < currentStepIndex ? 'completed' : (idx === currentStepIndex ? 'active' : '')) + '"><div class="step-circle">' + (idx < currentStepIndex ? '✓' : (idx === currentStepIndex ? '●' : (idx+1))) + '</div><div class="step-label">' + step + '</div></div>'; }).join('') + '</div></div>';
        document.getElementById('viewRequestContent').innerHTML = content;
        document.getElementById('viewRequestModal').classList.add('active');
    }

    function downloadRequestPDF() { alert('Downloading PDF for ' + (currentViewRequest ? currentViewRequest.reqNo : 'request')); }
    function openCancelModal(id) { cancelId = id; document.getElementById('cancelModal').classList.add('active'); }
    function confirmCancel() { if(cancelId){ var reason = document.getElementById('cancelReason').value; requests = requests.filter(function(r) { return r.id !== cancelId; }); renderRequests(); alert('Request cancelled.\nReason: ' + (reason || 'No reason provided')); } closeModal('cancelModal'); }
    function closeModal(id) { document.getElementById(id).classList.remove('active'); if(document.getElementById('cancelReason')) document.getElementById('cancelReason').value = ''; }
    function applyFilters() { renderRequests(); }
    function resetFilters() {
        if(document.getElementById('searchReq')) document.getElementById('searchReq').value = '';
        if(document.getElementById('statusFilter')) document.getElementById('statusFilter').value = 'all';
        if(document.getElementById('urgencyFilter')) document.getElementById('urgencyFilter').value = 'all';
        if(document.getElementById('dateFilter')) document.getElementById('dateFilter').value = '';
        renderRequests();
    }

    function searchPatientById() {
        var id = document.getElementById('patientIdSearch').value.trim();
        var patient = patientDatabase[id];
        var infoDiv = document.getElementById('patientMedicalInfo');
        var formFields = document.getElementById('requestFormFields');
        var submitBtn = document.getElementById('submitRequestBtn');
        if(patient) {
            currentSelectedPatient = patient;
            infoDiv.innerHTML = '<div class="patient-info-card"><strong>Patient Found:</strong> ' + patient.name + ' ' + patient.surname + '<br><small>ID: ' + id + ' | DOB: ' + patient.dob + ' | Contact: ' + patient.phone + '</small><br><small><strong>Conditions:</strong> ' + (patient.conditions.join(', ') || 'None') + ' | <strong>Allergies:</strong> ' + (patient.allergies.join(', ') || 'None') + '</small></div>';
            formFields.style.display = 'block';
            submitBtn.style.display = 'inline-block';
            loadTestCategories();
        } else {
            infoDiv.innerHTML = '<div class="patient-info-card" style="border-left-color:#DC2626; color:#DC2626;">Patient not found. Please register first.</div>';
            formFields.style.display = 'none';
            submitBtn.style.display = 'none';
        }
    }

    function loadTestCategories() {
        var container = document.getElementById('testCategoriesContainer');
        var html = '';
        for(var c = 0; c < categories.length; c++) {
            var cat = categories[c];
            var testsHtml = '';
            var categoryTests = testDatabase.filter(function(t) { return t.category === cat; });
            for(var t = 0; t < categoryTests.length; t++) {
                testsHtml += '<label><input type="checkbox" value="' + categoryTests[t].name + '" data-test-name="' + categoryTests[t].name + '" onchange="updateSelectedTests()"> ' + categoryTests[t].name + '</label>';
            }
            html += '<div class="category-group"><div class="category-header" onclick="toggleCategory(' + c + ')">' + cat + ' <span style="float:right;">▼</span></div><div class="test-list" id="category-' + c + '">' + testsHtml + '</div></div>';
        }
        container.innerHTML = html;
    }

    function toggleCategory(idx) {
        var el = document.getElementById('category-' + idx);
        if(el) el.classList.toggle('show');
    }

    function updateSelectedTests() {
        var checkboxes = document.querySelectorAll('#testCategoriesContainer input:checked');
        currentSelectedTests = Array.from(checkboxes).map(function(cb) { return cb.value; });
        var selectedTestDetails = currentSelectedTests.map(function(testName) { return testDatabase.find(function(t) { return t.name === testName; }); }).filter(function(t) { return t; });

        var uniqueSamples = new Map();
        for(var s = 0; s < selectedTestDetails.length; s++) {
            var test = selectedTestDetails[s];
            if(!uniqueSamples.has(test.tube)) {
                uniqueSamples.set(test.tube, { tube: test.tube, tubeColor: test.tubeColor, instructions: test.instructions, volume: test.volume, equipment: test.equipment });
            }
        }

        var summaryDiv = document.getElementById('selectedTestsSummary');
        var samplesDiv = document.getElementById('sampleRequirements');
        if(currentSelectedTests.length > 0) {
            summaryDiv.style.display = 'block';
            document.getElementById('selectedTestsList').innerHTML = currentSelectedTests.map(function(t) { return '<span class="selected-test-tag">' + t + '</span>'; }).join('');
            samplesDiv.style.display = 'block';
            var samplesHtml = '<div class="sample-requirements"><strong>Sample Collection Requirements:</strong><br>';
            var uniqueArray = Array.from(uniqueSamples.values());
            for(var u = 0; u < uniqueArray.length; u++) {
                var samp = uniqueArray[u];
                samplesHtml += '<div class="sample-item"><div class="sample-icon">🧪</div><div class="sample-details"><div class="sample-name">' + samp.tube + ' (' + samp.tubeColor + ')</div><div class="sample-instruction">Volume: ' + samp.volume + ' | ' + samp.instructions + ' | Equipment: ' + samp.equipment + '</div></div></div>';
            }
            samplesHtml += '</div>';
            samplesDiv.innerHTML = samplesHtml;
        } else {
            summaryDiv.style.display = 'none';
            samplesDiv.style.display = 'none';
        }
    }

    function submitNewRequest() {
        if(!currentSelectedPatient) { alert("Please search and select a patient first."); return; }
        if(currentSelectedTests.length === 0) { alert("Please select at least one test type."); return; }
        var urgencyRadio = document.querySelector('input[name="urgency"]:checked');
        var urgency = urgencyRadio ? urgencyRadio.value : 'routine';
        var newRequest = {
            id: requests.length + 1,
            reqNo: 'REQ-' + String(requests.length + 1).padStart(3,'0'),
            patient: currentSelectedPatient.name + ' ' + currentSelectedPatient.surname,
            patientId: document.getElementById('patientIdSearch').value.trim(),
            patientInfo: currentSelectedPatient,
            date: new Date().toISOString().split('T')[0],
            tests: currentSelectedTests.slice(),
            status: "Submitted",
            urgency: urgency,
            hasAbnormal: false,
            results: null,
            clinicalNotes: document.getElementById('newNotes').value
        };
        requests.unshift(newRequest);
        var barcodes = currentSelectedTests.map(function() { return 'BAR' + Date.now() + Math.random().toString(36).substring(2,6).toUpperCase(); });
        var barcodeHtml = '<div class="sample-requirements"><strong>Generated Barcodes:</strong><br>';
        for(var b = 0; b < currentSelectedTests.length; b++) {
            barcodeHtml += '<div class="barcode-item"><span>' + currentSelectedTests[b] + '</span><span><strong>' + barcodes[b] + '</strong></span></div>';
        }
        barcodeHtml += '</div>';
        document.getElementById('barcodeDisplay').innerHTML = barcodeHtml;
        document.getElementById('barcodeDisplay').style.display = 'block';
        alert('Test request ' + newRequest.reqNo + ' submitted!\nPatient notified.\nTests: ' + currentSelectedTests.join(', '));
        setTimeout(function() { closeModal('newRequestModal'); renderRequests(); resetNewRequestForm(); }, 2000);
    }

    function resetNewRequestForm() {
        document.getElementById('patientIdSearch').value = '';
        document.getElementById('patientMedicalInfo').innerHTML = '';
        document.getElementById('requestFormFields').style.display = 'none';
        document.getElementById('submitRequestBtn').style.display = 'none';
        document.getElementById('barcodeDisplay').style.display = 'none';
        document.getElementById('newNotes').value = '';
        var routineRadio = document.querySelector('input[name="urgency"][value="routine"]');
        if(routineRadio) routineRadio.checked = true;
        currentSelectedTests = [];
    }

    function openNewRequestModal() {
        document.getElementById('newRequestModal').classList.add('active');
        resetNewRequestForm();
    }

    renderRequests();
</script>