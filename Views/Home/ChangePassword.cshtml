@model NMB_HLabSys.ViewModels.ChangePasswordViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = Model.IsFirstLogin ? "First Login - Change Password" : "Change Password";
}

@section SidebarMenu {
    <li><a href="@Url.Action("Dashboard", "Manager")" class="active"><i class="fas fa-chart-pie"></i> <span>Dashboard</span></a></li>
    <li><a href="@Url.Action("TestCatalogue", "Manager")"><i class="fas fa-flask"></i> <span>Test Catalogue</span></a></li>
    <li><a href="@Url.Action("StockManagement", "Manager")"><i class="fas fa-boxes"></i> <span>Stock Management</span></a></li>
    <li><a href="@Url.Action("ViewOrder", "Manager")"><i class="fas fa-shopping-cart"></i> <span>Orders</span></a></li>
    <li><a href="@Url.Action("StaffManagement", "Manager")"><i class="fas fa-users-cog"></i> <span>Staff Management</span></a></li>
    <li><a href="@Url.Action("Reports", "Manager")"><i class="fas fa-file-alt"></i> <span>Reports</span></a></li>
    <li><a href="@Url.Action("Settings", "Manager")"><i class="fas fa-cog"></i> <span>Settings</span></a></li>
}

<style>
    .password-container {
        max-width: 600px;
        margin: 0 auto;
    }

    .password-card {
        background: white;
        border-radius: 16px;
        padding: 2rem;
        border: 1px solid #E2E8F0;
        box-shadow: 0 2px 8px rgba(0,0,0,0.04);
    }

    .password-header {
        text-align: center;
        margin-bottom: 1.5rem;
    }

        .password-header .icon-circle {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 64px;
            height: 64px;
            background: linear-gradient(135deg, #032C7D, #0841C9);
            border-radius: 50%;
            color: white;
            font-size: 1.5rem;
            margin-bottom: 0.5rem;
        }

        .password-header h3 {
            color: #032C7D;
            margin: 0;
            font-size: 1.2rem;
        }

        .password-header p {
            color: #5A6E7A;
            font-size: 0.85rem;
            margin: 0.3rem 0 0;
        }

    .form-group {
        margin-bottom: 1.2rem;
    }

        .form-group label {
            display: block;
            font-size: 0.8rem;
            font-weight: 500;
            color: #032C7D;
            margin-bottom: 0.3rem;
        }

    .input-with-icon {
        position: relative;
    }

        .input-with-icon i {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: #5A6E7A;
            font-size: 0.9rem;
        }

        .input-with-icon input {
            width: 100%;
            padding: 0.7rem 0.7rem 0.7rem 2.5rem;
            border: 1px solid #E2E8F0;
            border-radius: 10px;
            font-size: 0.9rem;
            font-family: 'Inter', sans-serif;
            transition: all 0.2s;
            background: white;
        }

            .input-with-icon input:focus {
                outline: none;
                border-color: #0841C9;
                box-shadow: 0 0 0 3px rgba(8,65,201,0.1);
            }

    .password-wrapper {
        position: relative;
    }

        .password-wrapper input {
            padding-right: 2.5rem;
        }

    .toggle-password {
        position: absolute;
        right: 12px;
        top: 50%;
        transform: translateY(-50%);
        background: none;
        border: none;
        cursor: pointer;
        color: #5A6E7A;
        padding: 4px;
    }

        .toggle-password:hover {
            color: #0841C9;
        }

    .text-danger {
        color: #991B1B;
        font-size: 0.75rem;
        display: block;
        margin-top: 0.2rem;
    }

    .text-muted {
        color: #5A6E7A;
        font-size: 0.7rem;
        display: block;
        margin-top: 0.2rem;
    }

    .btn-primary {
        width: 100%;
        background: linear-gradient(135deg, #0841C9, #1D97F1);
        color: white;
        border: none;
        padding: 0.75rem;
        border-radius: 40px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
        font-size: 0.9rem;
        font-family: 'Inter', sans-serif