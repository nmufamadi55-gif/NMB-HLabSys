@{
    ViewData["Title"] = "Cookie Policy";
    Layout = "~/Views/Shared/_PublicLayout.cshtml";
}

@section Styles {
    <style>
        .legal-page {
            padding: 6rem 0 3rem;
            background: var(--bg-soft);
        }

        .legal-header {
            text-align: center;
            margin-bottom: 2.5rem;
        }

            .legal-header h1 {
                font-size: 2.8rem;
                font-weight: 800;
                color: var(--primary-dark);
                letter-spacing: -0.02em;
            }

        .last-updated {
            color: var(--text-muted);
            font-size: 0.9rem;
            margin-top: 0.3rem;
        }

        .legal-body {
            max-width: 820px;
            margin: 0 auto;
            background: #fff;
            padding: 2.5rem 3rem;
            border-radius: var(--radius-card);
            box-shadow: var(--shadow-md);
        }

            .legal-body h2 {
                font-size: 1.4rem;
                font-weight: 700;
                color: var(--primary-dark);
                margin-top: 1.8rem;
                margin-bottom: 0.8rem;
                padding-bottom: 0.3rem;
                border-bottom: 1px solid #E8EDF5;
            }

            .legal-body p {
                color: var(--text-muted);
                line-height: 1.8;
                margin-bottom: 1rem;
            }

            .legal-body ul {
                margin: 0.5rem 0 1.2rem 1.5rem;
            }

                .legal-body ul li {
                    color: var(--text-muted);
                    line-height: 1.7;
                    margin-bottom: 0.4rem;
                }

            .legal-body a {
                color: var(--primary-bright);
                text-decoration: none;
            }

                .legal-body a:hover {
                    text-decoration: underline;
                }

        @@media (max-width: 768px) {
            .legal-body {
                padding: 1.8rem;
            }

            .legal-header h1 {
                font-size: 2rem;
            }
        }
    </style>
}

<div class="legal-page">
    <div class="container">
        <div class="legal-header">
            <h1>Cookie Policy</h1>
            <p class="last-updated">Last Updated: 1 July 2025</p>
        </div>

        <div class="legal-body">
            <p>
                This Cookie Policy explains how Nelson Mandela Bay Haematology Diagnostic Laboratories (NMBHDL) uses cookies and similar technologies when you visit NMB-HLabSys. We are committed to being transparent about our use of cookies and giving you control over your preferences.
            </p>

            <h2>1. What Are Cookies?</h2>
            <p>
                Cookies are small text files that are stored on your device (computer, tablet, or mobile) when you visit a website. They help the website remember your actions and preferences over time, improving your experience.
            </p>

            <h2>2. Types of Cookies We Use</h2>
            <ul>
                <li><strong>Essential Cookies:</strong> These are necessary for the website to function properly (e.g., logging in, session management, security). They cannot be turned off.</li>
                <li><strong>Functional Cookies:</strong> These remember your preferences (e.g., language, theme) to enhance your experience.</li>
                <li><strong>Analytics Cookies:</strong> We use Google Analytics to collect anonymous information about how users interact with the site. This helps us improve performance and user experience.</li>
                <li><strong>Consent Cookies:</strong> We store your cookie preferences for future visits.</li>
            </ul>

            <h2>3. Third-Party Cookies</h2>
            <p>
                We may also use third-party services (e.g., Google Analytics, social media plugins) that set their own cookies. We do not control these cookies; please refer to the respective third-party privacy policies.
            </p>

            <h2>4. Managing Cookies</h2>
            <p>
                You can manage your cookie preferences through your browser settings. Most browsers allow you to:
            </p>
            <ul>
                <li>View and delete cookies.</li>
                <li>Block all or specific cookies.</li>
                <li>Set preferences for different websites.</li>
            </ul>
            <p>
                Please note that disabling essential cookies may affect the functionality of NMB-HLabSys.
            </p>

            <h2>5. Consent</h2>
            <p>
                By continuing to use NMB-HLabSys, you consent to our use of cookies as described in this policy. If you do not agree, you can adjust your browser settings or leave the site.
            </p>

            <h2>6. Contact</h2>
            <p>
                If you have any questions about this Cookie Policy, please contact us at <a href="mailto:privacy@nmblab.co.za">privacy@nmblab.co.za</a>.
            </p>
        </div>
    </div>
</div>