@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NMB-HLabSys | Haematology Lab System</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }

        :root {
            --primary-deep: #032C7D;
            --primary-bright: #0841C9;
            --primary-light: #1D97F1;
            --primary-dark: #020D2F;
            --primary-soft: #C4C7F2;
            --text-muted: #5A6E7A;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: linear-gradient(135deg, var(--primary-dark) 0%, var(--primary-deep) 50%, var(--primary-bright) 100%);
            min-height: 100vh;
            color: white;
        }

        .landing-wrapper {
            min-height: 100vh;
            position: relative;
            display: flex;
            flex-direction: column;
        }

        .landing-bg-pattern {
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            background-image: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" opacity="0.05"><path fill="white" d="M20,20 L30,20 L25,30 Z M70,70 L80,70 L75,80 Z M45,45 L55,45 L50,55 Z"/></svg>');
            background-repeat: repeat;
            pointer-events: none;
        }

        .landing-nav {
            background: rgba(2, 13, 47, 0.8);
            backdrop-filter: blur(12px);
            position: fixed;
            width: 100%;
            top: 0;
            z-index: 1000;
            border-bottom: 1px solid rgba(255,255,255,0.1);
        }

        .nav-container {
            max-width: 1280px;
            margin: 0 auto;
            padding: 1rem 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo h1 {
            font-size: 1.5rem;
            font-weight: 700;
            color: white;
        }

        .hero-section {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 6rem 2rem 3rem;
            position: relative;
        }

        .hero-content {
            max-width: 650px;
            width: 100%;
            z-index: 2;
            text-align: center;
        }

        .hero-badge {
            background: rgba(255,255,255,0.15);
            backdrop-filter: blur(4px);
            padding: 0.5rem 1.2rem;
            border-radius: 60px;
            display: inline-block;
            font-size: 0.8rem;
            font-weight: 500;
            color: var(--primary-soft);
            margin-bottom: 1.5rem;
        }

        .hero-content h1 {
            font-size: 2.8rem;
            font-weight: 800;
            margin-bottom: 1rem;
            line-height: 1.2;
        }

        .hero-content > p {
            font-size: 1.1rem;
            color: rgba(255,255,255,0.8);
            margin-bottom: 2rem;
            line-height: 1.6;
        }

        .cta-buttons {
            display: flex;
            gap: 1rem;
            justify-content: center;
            flex-wrap: wrap;
            margin-bottom: 3rem;
        }

        .btn-primary {
            background: linear-gradient(135deg, var(--primary-light), #38BDF8);
            color: white;
            padding: 1rem 2.5rem;
            border-radius: 40px;
            text-decoration: none;
            font-weight: 600;
            font-size: 1rem;
            transition: all 0.3s;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            box-shadow: 0 10px 30px rgba(29, 151, 241, 0.4);
        }

        .btn-primary:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 40px rgba(29, 151, 241, 0.6);
        }

        .btn-secondary {
            background: rgba(255,255,255,0.1);
            color: white;
            padding: 1rem 2.5rem;
            border-radius: 40px;
            text-decoration: none;
            font-weight: 600;
            font-size: 1rem;
            transition: all 0.3s;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            border: 1px solid rgba(255,255,255,0.3);
        }

        .btn-secondary:hover {
            background: rgba(255,255,255,0.2);
            transform: translateY(-3px);
        }

        .features-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 1.5rem;
            margin-top: 3rem;
            max-width: 900px;
            margin-left: auto;
            margin-right: auto;
        }

        .feature-card {
            background: rgba(255,255,255,0.08);
            backdrop-filter: blur(8px);
            padding: 1.5rem;
            border-radius: 20px;
            border: 1px solid rgba(255,255,255,0.15);
            text-align: center;
            transition: all 0.3s;
        }

        .feature-card:hover {
            background: rgba(255,255,255,0.12);
            transform: translateY(-5px);
        }

        .feature-icon {
            font-size: 2rem;
            margin-bottom: 0.8rem;
        }

        .feature-card h3 {
            font-size: 1rem;
            margin-bottom: 0.4rem;
            font-weight: 600;
        }

        .feature-card p {
            font-size: 0.8rem;
            color: rgba(255,255,255,0.7);
            line-height: 1.5;
        }

        footer {
            text-align: center;
            padding: 1.5rem;
            color: rgba(255,255,255,0.6);
            font-size: 0.75rem;
        }
    </style>
</head>
<body>
    <div class="landing-wrapper">
        <div class="landing-bg-pattern"></div>

        <nav class="landing-nav">
            <div class="nav-container">
                <div class="logo"><h1><i class="fas fa-microscope"></i> NMB-HLabSys</h1></div>
                <div>
                    <a href="@Url.Action("Login", "Account")" style="color: white; text-decoration: none; font-weight: 500; margin-right: 1rem;">
                        <i class="fas fa-sign-in-alt"></i> Login
                    </a>
                    <a href="@Url.Action("Register", "Patient")" style="background: rgba(255,255,255,0.2); color: white; text-decoration: none; padding: 0.5rem 1rem; border-radius: 20px; font-weight: 500;">
                        Register
                    </a>
                </div>
            </div>
        </nav>

        <div class="hero-section">
            <div class="hero-content">
                <div class="hero-badge">
                    <i class="fas fa-heartbeat"></i> UN SDG 3 · Good Health & Well-Being
                </div>

                <h1>Nelson Mandela Bay<br>Haematology Laboratory</h1>

                <p>
                    Intelligent Test Request Management · Real-time Results · Patient Empowerment
                </p>

                <div class="cta-buttons">
                    <a href="@Url.Action("Login", "Account")" class="btn-primary">
                        <i class="fas fa-sign-in-alt"></i> Login to Your Account
                    </a>
                    <a href="@Url.Action("Register", "Patient")" class="btn-secondary">
                        <i class="fas fa-user-plus"></i> Register as Patient
                    </a>
                </div>

                <div class="features-grid">
                    <div class="feature-card">
                        <div class="feature-icon">🧪</div>
                        <h3>Test Requests</h3>
                        <p>Submit and track lab test requests</p>
                    </div>
                    <div class="feature-card">
                        <div class="feature-icon">📊</div>
                        <h3>Real-time Results</h3>
                        <p>View results as soon as they're ready</p>
                    </div>
                    <div class="feature-card">
                        <div class="feature-icon">🔒</div>
                        <h3>Secure Access</h3>
                        <p>Role-based access control</p>
                    </div>
                    <div class="feature-card">
                        <div class="feature-icon">👥</div>
                        <h3>Patient Portal</h3>
                        <p>Manage your health records</p>
                    </div>
                </div>
            </div>
        </div>

        <footer>
            <p>© 2025 Nelson Mandela Bay Haematology Diagnostic Laboratories | Aligned with UN SDG 3</p>
        </footer>
    </div>
</body>
</html>
