@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NMB-HLabSys | Haematology Lab System</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --primary-deep: #032C7D;
            --primary-bright: #0841C9;
            --primary-light: #1D97F1;
            --primary-dark: #020D2F;
            --primary-soft: #C4C7F2;
            --bg-soft: #F0F4F8;
            --card-white: #FFFFFF;
            --text-dark: #1A2C3A;
            --text-muted: #5A6E7A;
            --border-light: #E2E8F0;
            --shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.04);
            --shadow-md: 0 4px 16px rgba(0, 0, 0, 0.06);
            --shadow-lg: 0 8px 24px rgba(0, 0, 0, 0.08);
            --radius-card: 20px;
            --radius-element: 12px;
            --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        body {
            font-family: 'Inter', sans-serif;
            background: linear-gradient(135deg, var(--bg-soft) 0%, #E8EDF5 100%);
            color: var(--text-dark);
            min-height: 100vh;
        }

        /* ========== LANDING PAGE ========== */
        .landing-wrapper {
            min-height: 100vh;
            background: linear-gradient(135deg, var(--primary-dark) 0%, var(--primary-deep) 50%, var(--primary-bright) 100%);
            position: relative;
            overflow-x: hidden;
        }

        .landing-bg-pattern {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-image: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" opacity="0.05"><path fill="white" d="M20,20 L30,20 L25,30 Z M70,70 L80,70 L75,80 Z M45,45 L55,45 L50,55 Z"/><circle cx="80" cy="20" r="5"/><circle cx="15" cy="85" r="8"/></svg>');
            background-repeat: repeat;
            pointer-events: none;
        }

        .landing-nav {
            background: rgba(2, 13, 47, 0.8);
            backdrop-filter: blur(12px);
            position: fixed;
            width: 100%;
            top: 0;
            z-index: 1000;
            border-bottom: 1px solid rgba(255,255,255,0.1);
        }

        .nav-container {
            max-width: 1280px;
            margin: 0 auto;
            padding: 1rem 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo h1 {
            font-size: 1.5rem;
            font-weight: 700;
            background: linear-gradient(135deg, #FFFFFF, var(--primary-soft));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .hero-section {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            padding: 6rem 2rem 4rem;
            position: relative;
        }

        .hero-content {
            max-width: 900px;
            z-index: 2;
        }

        .hero-badge {
            background: rgba(255,255,255,0.15);
            backdrop-filter: blur(4px);
            padding: 0.5rem 1.2rem;
            border-radius: 60px;
            display: inline-block;
            font-size: 0.8rem;
            font-weight: 500;
            color: var(--primary-soft);
            margin-bottom: 1.5rem;
        }

        .hero-content h1 {
            font-size: 3.5rem;
            font-weight: 800;
            background: linear-gradient(135deg, #FFFFFF, var(--primary-light));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 1.5rem;
        }

        .hero-content p {
            font-size: 1.2rem;
            color: rgba(255,255,255,0.8);
            margin-bottom: 2.5rem;
        }

        .login-card {
            background: rgba(255,255,255,0.98);
            backdrop-filter: blur(12px);
            border-radius: 32px;
            padding: 2rem;
            max-width: 500px;
            margin: 0 auto;
            box-shadow: 0 25px 45px rgba(0,0,0,0.2);
            border: 1px solid rgba(255,255,255,0.3);
        }

            .login-card h3 {
                color: var(--primary-deep);
                margin-bottom: 1rem;
            }

        .role-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
            gap: 1rem;
            margin: 1.5rem 0;
        }

        .role-btn {
            background: linear-gradient(135deg, var(--primary-soft) 0%, #E0E5FF 100%);
            border: none;
            padding: 1rem;
            border-radius: 20px;
            font-weight: 600;
            font-size: 0.9rem;
            cursor: pointer;
            transition: var(--transition);
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 8px;
            color: var(--primary-dark);
            text-decoration: none;
        }

            .role-btn i {
                font-size: 1.6rem;
            }

            .role-btn:hover {
                transform: translateY(-4px);
                box-shadow: var(--shadow-lg);
                background: linear-gradient(135deg, #FFFFFF, var(--primary-light));
            }

        .role-doctor {
            border-left: 4px solid #0841C9;
        }

        .role-technician {
            border-left: 4px solid #1D97F1;
        }

        .role-manager {
            border-left: 4px solid #032C7D;
        }

        .role-patient {
            border-left: 4px solid #10B981;
        }

        .role-admin {
            border-left: 4px solid #6B7280;
        }

        footer {
            text-align: center;
            padding: 2rem;
            color: rgba(255,255,255,0.6);
            font-size: 0.8rem;
        }
        media (max-width: 768px) {
            .hero-content h1

        {
            font-size: 2rem;
        }

        .role-grid {
            grid-template-columns: 1fr;
        }

        }
    </style>
</head>
<body>
    <div class="landing-wrapper">
        <div class="landing-bg-pattern"></div>
        <nav class="landing-nav">
            <div class="nav-container">
                <div class="logo"><h1><i class="fas fa-microscope"></i> NMB-HLabSys</h1></div>
            </div>
        </nav>
        <div class="hero-section">
            <div class="hero-content">
                <div class="hero-badge"><i class="fas fa-heartbeat"></i> UN SDG 3 · Good Health & Well-Being</div>
                <h1>Nelson Mandela Bay<br>Haematology Laboratory</h1>
                <p>Intelligent Test Request Management · Real-time Results · Patient Empowerment</p>
                <div class="login-card">
                    <h3><i class="fas fa-lock"></i> Access Laboratory Portal</h3>
                    <p style="font-size:0.85rem; color:var(--text-muted);">Select your role to enter the dashboard</p>
                    <div class="role-grid">
                        <a href="@Url.Action("Dashboard", "Doctor")" class="role-btn role-doctor">
                            <i class="fas fa-user-md"></i> Doctor
                        </a>
                        <a href="@Url.Action("Dashboard", "Technician")" class="role-btn role-technician">
                            <i class="fas fa-flask"></i> Technician
                        </a>
                        <a href="@Url.Action("Dashboard", "Manager")" class="role-btn role-manager">
                            <i class="fas fa-chart-line"></i> Manager
                        </a>
                        <a href="@Url.Action("Dashboard", "Patient")" class="role-btn role-patient">
                            <i class="fas fa-user-injured"></i> Patient
                        </a>
                        <a href="@Url.Action("Dashboard", "Admin")" class="role-btn role-admin">
                            <i class="fas fa-cogs"></i> Admin
                        </a>
                    </div>
                    <p style="font-size:0.7rem; margin-top:1rem; color:var(--text-muted);">
                        <i class="fas fa-info-circle"></i> Demo Prototype | Hardcoded Data | Backend Ready
                    </p>
                </div>
            </div>
        </div>
        <footer>
            <p>© 2025 Nelson Mandela Bay Haematology Diagnostic Laboratories | Aligned with UN SDG 3</p>
        </footer>
    </div>
</body>
</html>