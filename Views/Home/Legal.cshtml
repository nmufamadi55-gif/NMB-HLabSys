@{
    ViewData["Title"] = "Legal Notice";
    Layout = "~/Views/Shared/_PublicLayout.cshtml";
}

@section Styles {
    <style>
        .legal-page {
            padding: 6rem 0 3rem;
            background: var(--bg-soft);
        }

        .legal-header {
            text-align: center;
            margin-bottom: 2.5rem;
        }

            .legal-header h1 {
                font-size: 2.8rem;
                font-weight: 800;
                color: var(--primary-dark);
                letter-spacing: -0.02em;
            }

        .last-updated {
            color: var(--text-muted);
            font-size: 0.9rem;
            margin-top: 0.3rem;
        }

        .legal-body {
            max-width: 820px;
            margin: 0 auto;
            background: #fff;
            padding: 2.5rem 3rem;
            border-radius: var(--radius-card);
            box-shadow: var(--shadow-md);
        }

            .legal-body h2 {
                font-size: 1.4rem;
                font-weight: 700;
                color: var(--primary-dark);
                margin-top: 1.8rem;
                margin-bottom: 0.8rem;
                padding-bottom: 0.3rem;
                border-bottom: 1px solid #E8EDF5;
            }

            .legal-body p {
                color: var(--text-muted);
                line-height: 1.8;
                margin-bottom: 1rem;
            }

            .legal-body ul {
                margin: 0.5rem 0 1.2rem 1.5rem;
            }

                .legal-body ul li {
                    color: var(--text-muted);
                    line-height: 1.7;
                    margin-bottom: 0.4rem;
                }

            .legal-body a {
                color: var(--primary-bright);
                text-decoration: none;
            }

                .legal-body a:hover {
                    text-decoration: underline;
                }

        @@media (max-width: 768px) {
            .legal-body {
                padding: 1.8rem;
            }

            .legal-header h1 {
                font-size: 2rem;
            }
        }
    </style>
}

<div class="legal-page">
    <div class="container">
        <div class="legal-header">
            <h1>Legal Notice</h1>
            <p class="last-updated">Last Updated: 1 July 2025</p>
        </div>

        <div class="legal-body">
            <h2>1. General Information</h2>
            <p>
                This website and the NMB-HLabSys platform are operated by Nelson Mandela Bay Haematology Diagnostic Laboratories (NMBHDL). NMBHDL is a private medical laboratory registered in South Africa.
            </p>

            <h2>2. Ownership</h2>
            <p>
                All intellectual property rights, including but not limited to software, design, text, images, and databases, are owned by NMBHDL or its licensors. Unauthorized use is strictly prohibited.
            </p>

            <h2>3. Regulatory Compliance</h2>
            <p>
                NMBHDL complies with all applicable South African laws, including the Protection of Personal Information Act (POPIA) and the Health Professions Act. Our laboratory is accredited by the South African National Accreditation System (SANAS).
            </p>

            <h2>4. Disclaimer</h2>
            <p>
                The information provided on this website and through NMB-HLabSys is for informational and diagnostic support purposes only. It does not constitute medical advice. Always consult a qualified healthcare professional for medical decisions.
            </p>

            <h2>5. Links to Third Parties</h2>
            <p>
                Our site may contain links to external websites. We are not responsible for the content or privacy practices of those sites.
            </p>

            <h2>6. Governing Law</h2>
            <p>
                All matters relating to this website and the use of NMB-HLabSys are governed by the laws of the Republic of South Africa.
            </p>

            <h2>7. Contact</h2>
            <p>
                For legal inquiries, please contact us at:<br>
                <strong>Email:</strong> legal@nmblab.co.za<br>
                <strong>Phone:</strong> +27 41 123 4567<br>
                <strong>Address:</strong> 123 Haematology Lane, Gqeberha, 6001
            </p>
        </div>
    </div>
</div>