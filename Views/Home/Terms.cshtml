@{
    ViewData["Title"] = "Terms of Service";
    Layout = "~/Views/Shared/_PublicLayout.cshtml";
}

@section Styles {
    <style>
        .legal-page {
            padding: 6rem 0 3rem;
            background: var(--bg-soft);
        }

        .legal-header {
            text-align: center;
            margin-bottom: 2.5rem;
        }

            .legal-header h1 {
                font-size: 2.8rem;
                font-weight: 800;
                color: var(--primary-dark);
                letter-spacing: -0.02em;
            }

        .last-updated {
            color: var(--text-muted);
            font-size: 0.9rem;
            margin-top: 0.3rem;
        }

        .legal-body {
            max-width: 820px;
            margin: 0 auto;
            background: #fff;
            padding: 2.5rem 3rem;
            border-radius: var(--radius-card);
            box-shadow: var(--shadow-md);
        }

            .legal-body h2 {
                font-size: 1.4rem;
                font-weight: 700;
                color: var(--primary-dark);
                margin-top: 1.8rem;
                margin-bottom: 0.8rem;
                padding-bottom: 0.3rem;
                border-bottom: 1px solid #E8EDF5;
            }

            .legal-body p {
                color: var(--text-muted);
                line-height: 1.8;
                margin-bottom: 1rem;
            }

            .legal-body ul {
                margin: 0.5rem 0 1.2rem 1.5rem;
            }

                .legal-body ul li {
                    color: var(--text-muted);
                    line-height: 1.7;
                    margin-bottom: 0.4rem;
                }

            .legal-body a {
                color: var(--primary-bright);
                text-decoration: none;
            }

                .legal-body a:hover {
                    text-decoration: underline;
                }

        @@media (max-width: 768px) {
            .legal-body {
                padding: 1.8rem;
            }

            .legal-header h1 {
                font-size: 2rem;
            }
        }
    </style>
}

<div class="legal-page">
    <div class="container">
        <div class="legal-header">
            <h1>Terms of Service</h1>
            <p class="last-updated">Last Updated: 1 July 2025</p>
        </div>

