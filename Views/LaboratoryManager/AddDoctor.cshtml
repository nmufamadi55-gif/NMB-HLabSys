@using NMB_HLabSys.Models.ViewModels
@model RegisterDoctorViewModel
@{
    Layout = "~/Views/Shared/_ManagerLayout.cshtml";
    ViewData["Title"] = "Register Doctor";
}

<div class="page-header">
    <div>
        <h2>Register Doctor</h2>
        <p>Add a new doctor to the system</p>
    </div>
    <a asp-action="Staff" class="btn btn-outline">
        <i class="fas fa-arrow-left"></i> Back
    </a>
</div>

@if (!ViewData.ModelState.IsValid && ViewData.ModelState.Values.Any(v => v.Errors.Any()))
{
    <div class="alert alert-danger">
        <i class="fas fa-exclamation-circle"></i>
        <div>
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <div>@error.ErrorMessage</div>
            }
        </div>
    </div>
}

<div class="alert alert-info">
    <i class="fas fa-envelope"></i>
    <div>
        Login credentials are auto-generated and emailed to the doctor. They'll be required to change their password on first login.
    </div>
</div>

<form method="post" asp-action="AddDoctor">
    @Html.AntiForgeryToken()

    <div class="card">
        <div class="card-header">
            <h3><i class="fas fa-user-md"></i> Personal Information</h3>
        </div>

        <div class="form-row-2">
            <div class="form-group">
                <label>First Name <span class="required">*</span></label>
                <input asp-for="Name" class="form-control" placeholder="e.g., Sarah" />
                <span asp-validation-for="Name" class="validation-message"></span>
            </div>
            <div class="form-group">
                <label>Surname <span class="required">*</span></label>
                <input asp-for="Surname" class="form-control" placeholder="e.g., Johnson" />
                <span asp-validation-for="Surname" class="validation-message"></span>
            </div>
        </div>

        <div class="form-row-2">
            <div class="form-group">
                <label>HPCSA Number <span class="required">*</span></label>
                <input asp-for="HPCSANumber" class="form-control" placeholder="e.g., MP1234567"
                       maxlength="20" minlength="5" pattern="[A-Za-z0-9]{5,20}"
                       title="HPCSA number must be 5 to 20 alphanumeric characters." />
                <span asp-validation-for="HPCSANumber" class="validation-message"></span>
            </div>
            <div class="form-group">
                <label>Email Address <span class="required">*</span></label>
                <input asp-for="Email" type="email" class="form-control"
                       placeholder="doctor@nmblab.co.za" />
                <span asp-validation-for="Email" class="validation-message"></span>
            </div>
        </div>

        <div class="form-group">
            <label>Contact Number <span class="required">*</span></label>
            <!-- type="tel", exactly 10 digits, blocks non-numbers -->
            <input asp-for="ContactNumber" type="tel" class="form-control"
                   placeholder="0821234567" maxlength="10" minlength="10"
                   pattern="[0-9]{10}" title="Please enter a 10-digit phone number"
                   oninput="this.value = this.value.replace(/\D/g,'').slice(0, 10)" />
            <span asp-validation-for="ContactNumber" class="validation-message"></span>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h3><i class="fas fa-briefcase"></i> Practice Information</h3>
        </div>

        <div class="form-group">
            <label>Practice Name</label>
            <input asp-for="PracticeName" class="form-control"
                   placeholder="e.g., Summerstrand Medical Centre" />
        </div>

        <div class="form-group">
            <label>Practice Address</label>
            <textarea asp-for="PracticeAddress" rows="2" class="form-control"
                      placeholder="Street, suburb, city, postal code"></textarea>
        </div>

        <div class="form-group" style="margin:0;">
            <label>Specialization</label>
            <input asp-for="Specialization" class="form-control"
                   placeholder="e.g., Haematology, Internal Medicine" />
        </div>
    </div>

    <div class="form-actions">
        <button type="submit" class="btn btn-primary">
            <i class="fas fa-user-plus"></i> Register Doctor
        </button>
        <a asp-action="Staff" class="btn btn-outline">Cancel</a>
    </div>
</form>