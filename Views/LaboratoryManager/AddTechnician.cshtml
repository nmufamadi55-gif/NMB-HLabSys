@using NMB_HLabSys.Models.ViewModels
@model AddTechnicianViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Add Technician";
    ViewData["RoleSubtitle"] = "Laboratory Manager";
    ViewData["UserGreeting"] = "Add a new lab technician";
    ViewData["UserInitials"] = "LM";
}

@section SidebarMenu {
 ... same ...
 }

<style>... form styles ...</style>

<div class="form-card">
    <h3><i class="fas fa-user-plus"></i> Add Technician</h3>
    <form method="post" action="@Url.Action("AddTechnician")">
        @Html.AntiForgeryToken()
        <div class="row-2col">
            <div class="form-group">
                <label>Name <span style="color:red;">*</span></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" style="color:#DC2626; font-size:0.7rem;"></span>
            </div>
            <div class="form-group">
                <label>Surname <span style="color:red;">*</span></label>
                <input asp-for="Surname" class="form-control" />
                <span asp-validation-for="Surname" style="color:#DC2626; font-size:0.7rem;"></span>
            </div>
        </div>
        <div class="row-2col">
            <div class="form-group">
                <label>SA ID Number <span style="color:red;">*</span></label>
                <input asp-for="SAIDNumber" class="form-control" maxlength="13" />
                <span asp-validation-for="SAIDNumber" style="color:#DC2626; font-size:0.7rem;"></span>
            </div>
            <div class="form-group">
                <label>Employee Number <span style="color:red;">*</span></label>
                <input asp-for="EmployeeNumber" class="form-control" />
                <span asp-validation-for="EmployeeNumber" style="color:#DC2626; font-size:0.7rem;"></span>
            </div>
        </div>
        <div class="row-2col">
            <div class="form-group">
                <label>Email Address <span style="color:red;">*</span></label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" style="color:#DC2626; font-size:0.7rem;"></span>
            </div>
            <div class="form-group">
                <label>Contact Number <span style="color:red;">*</span></label>
                <input asp-for="ContactNumber" class="form-control" />
                <span asp-validation-for="ContactNumber" style="color:#DC2626; font-size:0.7rem;"></span>
            </div>
        </div>
        <div class="row-2col">
            <div class="form-group">
                <label>Specialization</label>
                <input asp-for="Specialization" class="form-control" />
            </div>
            <div class="form-group">
                <label>Qualification</label>
                <input asp-for="Qualification" class="form-control" />
            </div>
        </div>
        <div class="form-group">
            <label>Years of Experience</label>
            <input asp-for="YearsOfExperience" class="form-control" type="number" />
        </div>
        <div class="form-group">
            <label>Assign Test Types <span style="color:red;">*</span></label>
            <select asp-for="SelectedTestTypeIDs" asp-items="Model.AvailableTestTypes" class="form-control" multiple size="4"></select>
            <small style="color:#5A6E7A;">Hold Ctrl to select multiple</small>
            <span asp-validation-for="SelectedTestTypeIDs" style="color:#DC2626; font-size:0.7rem;"></span>
        </div>
        <div style="display:flex; gap:1rem; margin-top:1.5rem;">
            <button type="submit" class="btn-primary"><i class="fas fa-save"></i> Add Technician</button>
            <button type="button" class="btn-outline" onclick="history.back()">Cancel</button>
        </div>
    </form>
</div>