@using NMB_HLabSys.Models.ViewModels
@model AddTechnicianViewModel
@{
    Layout = "~/Views/Shared/_ManagerLayout.cshtml";
    ViewData["Title"] = "Add Technician";
}

<style>
    .test-picker {
        max-height: 320px;
        overflow-y: auto;
        border: 1px solid var(--gray-200);
        border-radius: var(--radius-md);
        padding: 0.5rem;
        background: var(--gray-50);
    }

    .test-picker-search {
        position: relative;
        margin-bottom: 0.75rem;
    }

        .test-picker-search input {
            width: 100%;
            padding-left: 2rem;
        }

        .test-picker-search i {
            position: absolute;
            left: 0.75rem;
            top: 50%;
            transform: translateY(-50%);
            color: var(--gray-400);
            font-size: 0.85rem;
        }

    .test-item {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        padding: 0.5rem 0.7rem;
        border-radius: var(--radius-sm);
        cursor: pointer;
        transition: background 0.1s;
        margin-bottom: 1px;
    }

        .test-item:hover {
            background: white;
        }

        .test-item input[type="checkbox"] {
            width: 16px;
            height: 16px;
            accent-color: var(--brand-700);
            cursor: pointer;
            flex-shrink: 0;
        }

        .test-item label {
            margin: 0;
            font-size: 0.85rem;
            color: var(--gray-900);
            cursor: pointer;
            flex: 1;
        }

    .selection-counter {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.2rem 0.7rem;
        background: var(--brand-50);
        color: var(--brand-700);
        font-size: 0.72rem;
        font-weight: 600;
        border-radius: var(--radius-pill);
    }

    .empty-tests {
        padding: 2rem 1rem;
        text-align: center;
        color: var(--gray-500);
        font-size: 0.85rem;
    }
</style>

<div class="page-header">
    <div>
        <h2>Add Lab Technician</h2>
        <p>Register a new technician and assign test types</p>
    </div>
    <a asp-action="Staff" class="btn btn-outline">
        <i class="fas fa-arrow-left"></i> Back
    </a>
</div>

@if (!ViewData.ModelState.IsValid && ViewData.ModelState.Values.Any(v => v.Errors.Any()))
{
    <div class="alert alert-danger">
        <i class="fas fa-exclamation-circle"></i>
        <div>
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <div>@error.ErrorMessage</div>
            }
        </div>
    </div>
}

<div class="alert alert-info">
    <i class="fas fa-envelope"></i>
    <div>
        Login credentials are auto-generated and emailed to the technician. They'll be required to change their password on first login.
    </div>
</div>

<form method="post" asp-action="AddTechnician">
    @Html.AntiForgeryToken()

    <div class="card">
        <div class="card-header">
            <h3><i class="fas fa-user"></i> Personal Information</h3>
        </div>

        <div class="form-row-2">
            <div class="form-group">
                <label>First Name <span class="required">*</span></label>
                <input asp-for="Name" class="form-control" placeholder="e.g., Thandiwe" />
                <span asp-validation-for="Name" class="validation-message"></span>
            </div>
            <div class="form-group">
                <label>Surname <span class="required">*</span></label>
                <input asp-for="Surname" class="form-control" placeholder="e.g., Mkhize" />
                <span asp-validation-for="Surname" class="validation-message"></span>
            </div>
        </div>

        <div class="form-row-2">
            <div class="form-group">
                <label>SA ID Number <span class="required">*</span></label>
                <!-- Exactly 13 digits, blocks non-numbers -->
                <input asp-for="SAIDNumber" class="form-control"
                       maxlength="13" minlength="13" pattern="[0-9]{13}"
                       placeholder="13-digit ID number" inputmode="numeric"
                       title="SA ID must be exactly 13 numbers"
                       oninput="this.value = this.value.replace(/\D/g,'').slice(0, 13)" />
                <span asp-validation-for="SAIDNumber" class="validation-message"></span>
            </div>
            <div class="form-group">
                <label>Employee Number <span class="required">*</span></label>
                <input asp-for="EmployeeNumber" class="form-control" placeholder="e.g., T2025001" maxlength="50" />
                <span asp-validation-for="EmployeeNumber" class="validation-message"></span>
            </div>
        </div>

        <div class="form-row-2">
            <div class="form-group">
                <label>Email Address <span class="required">*</span></label>
                <input asp-for="Email" type="email" class="form-control" placeholder="tech@nmblab.co.za" maxlength="255" />
                <span asp-validation-for="Email" class="validation-message"></span>
            </div>
            <div class="form-group">
                <label>Contact Number <span class="required">*</span></label>
                <!-- Exactly 10 digits, blocks non-numbers -->
                <input asp-for="ContactNumber" type="tel" class="form-control"
                       placeholder="0821234567" maxlength="10" minlength="10"
                       pattern="[0-9]{10}" title="Please enter a 10-digit phone number"
                       oninput="this.value = this.value.replace(/\D/g,'').slice(0, 10)" />
                <span asp-validation-for="ContactNumber" class="validation-message"></span>
            </div>
        </div>

    <div class="card">
        <div class="card-header">
            <h3><i class="fas fa-graduation-cap"></i> Professional Details</h3>
        </div>

        <div class="form-row-2">
            <div class="form-group">
                <label>Specialization</label>
                <input asp-for="Specialization" class="form-control"
                       placeholder="e.g., Haematology" />
            </div>
            <div class="form-group">
                <label>Qualification</label>
                <input asp-for="Qualification" class="form-control"
                       placeholder="e.g., BSc Medical Laboratory Science" />
            </div>
        </div>

        <div class="form-group">
            <label>Years of Experience</label>
            <input asp-for="YearsOfExperience" type="number" min="0" max="50" class="form-control" />
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h3>
                <i class="fas fa-vial"></i> Test Type Assignment
                <span class="selection-counter" id="selectionCounter">
                    <i class="fas fa-check-circle"></i>
                    <span id="selectionCount">0</span> selected
                </span>
            </h3>
        </div>
        <p class="text-muted text-sm" style="margin:0 0 0.75rem;">
            At least one test type must be assigned. You can modify this later from the technician's profile.
        </p>

        @if (Model.AvailableTestTypes != null && Model.AvailableTestTypes.Any())
        {
            <div class="test-picker-search">
                <i class="fas fa-search"></i>
                <input type="text" id="testSearch" class="form-control"
                       placeholder="Filter tests..." />
            </div>
            <div class="test-picker" id="testPicker">
                @foreach (var test in Model.AvailableTestTypes)
                {
                    var isSelected = Model.SelectedTestTypeIDs != null &&
                                     Model.SelectedTestTypeIDs.Contains(int.Parse(test.Value));
                    <div class="test-item" data-name="@test.Text?.ToLower()">
                        <input type="checkbox"
                               name="SelectedTestTypeIDs"
                               value="@test.Value"
                               id="test_@test.Value"
                        @(isSelected ? "checked" : "") />
                        <label for="test_@test.Value">@test.Text</label>
                    </div>
                }
            </div>
            <span asp-validation-for="SelectedTestTypeIDs" class="validation-message"></span>
        }
        else
        {
            <div class="empty-tests">
                <i class="fas fa-info-circle"></i> No test types exist yet.
                <a asp-action="CreateTestType">Create one first</a>.
            </div>
        }
    </div>

    <div class="form-actions">
        <button type="submit" class="btn btn-primary">
            <i class="fas fa-user-plus"></i> Add Technician
        </button>
        <a asp-action="Staff" class="btn btn-outline">Cancel</a>
    </div>
</form>

@section Scripts {
    <script>
        (function () {
            const picker = document.getElementById('testPicker');
            if (!picker) return;

            const checkboxes = picker.querySelectorAll('input[type="checkbox"]');
            const counter = document.getElementById('selectionCount');

            function updateCount() {
                const n = Array.from(checkboxes).filter(cb => cb.checked).length;
                counter.textContent = n;
            }

            checkboxes.forEach(cb => cb.addEventListener('change', updateCount));
            updateCount();

            // Search filter
            const search = document.getElementById('testSearch');
            search?.addEventListener('input', function () {
                const term = this.value.toLowerCase().trim();
                picker.querySelectorAll('.test-item').forEach(item => {
                    const name = item.dataset.name || '';
                    item.style.display = (!term || name.includes(term)) ? '' : 'none';
                });
            });
        })();
    </script>
}