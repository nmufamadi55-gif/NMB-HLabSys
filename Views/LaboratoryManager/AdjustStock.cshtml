@using NMB_HLabSys.Models.ViewModels
@model AdjustStockViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Adjust Stock";
    ViewData["RoleSubtitle"] = "Laboratory Manager";
    ViewData["UserGreeting"] = "Manually adjust stock levels";
    ViewData["UserInitials"] = "LM";
}

@section SidebarMenu {
 ... same ...
 }

<style>... form styles ...</style>

<div class="form-card">
    <h3><i class="fas fa-balance-scale"></i> Adjust Stock for @Model.ConsumableName</h3>
    <form method="post" action="@Url.Action("AdjustStock")">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="ConsumableID" />
        <div class="form-group">
            <label>Current Quantity</label>
            <input class="form-control" value="@Model.CurrentQuantity" disabled />
        </div>
        <div class="form-group">
            <label>Adjustment Type <span style="color:red;">*</span></label>
            <select asp-for="AdjustmentType" class="form-control">
                <option value="increase">Increase</option>
                <option value="decrease">Decrease</option>
                <option value="set">Set to exact value</option>
            </select>
        </div>
        <div class="form-group">
            <label>Adjustment Amount <span style="color:red;">*</span></label>
            <input asp-for="AdjustmentAmount" class="form-control" type="number" />
            <span asp-validation-for="AdjustmentAmount" style="color:#DC2626; font-size:0.7rem;"></span>
        </div>
        <div class="form-group">
            <label>Reason for Adjustment</label>
            <input asp-for="Reason" class="form-control" placeholder="e.g., Damaged, Return, Manual count" />
        </div>
        <div style="display:flex; gap:1rem; margin-top:1.5rem;">
            <button type="submit" class="btn-primary"><i class="fas fa-save"></i> Apply Adjustment</button>
            <button type="button" class="btn-outline" onclick="history.back()">Cancel</button>
        </div>
    </form>
</div>