@using NMB_HLabSys.Models.ViewModels
@model AdjustStockViewModel
@{
    Layout = "~/Views/Shared/_ManagerLayout.cshtml";
    ViewData["Title"] = "Adjust Stock";
}

<style>
    .adjust-type-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 0.6rem;
        margin-bottom: 1.25rem;
    }
    @@media (max-width: 640px) { .adjust-type-grid { grid-template-columns: 1fr; } }

    .type-option {
        position: relative;
        padding: 0.85rem 0.9rem;
        border: 2px solid var(--gray-200);
        border-radius: var(--radius-md);
        cursor: pointer;
        transition: all 0.15s;
        background: white;
    }
    .type-option:hover { border-color: var(--brand-500); }
    .type-option input { position: absolute; opacity: 0; pointer-events: none; }
    .type-option.selected {
        border-color: var(--brand-700);
        background: var(--brand-50);
    }
    .type-option .title {
        font-weight: 600;
        font-size: 0.85rem;
        color: var(--gray-900);
        display: flex;
        align-items: center;
        gap: 0.4rem;
        margin-bottom: 0.15rem;
    }
    .type-option .desc {
        font-size: 0.72rem;
        color: var(--gray-500);
    }

    .preview-box {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1rem 1.25rem;
        background: linear-gradient(135deg, var(--brand-50) 0%, #f5f9ff 100%);
        border: 1px solid var(--brand-500);
        border-radius: var(--radius-md);
        margin: 1rem 0 1.5rem;
    }
    .preview-box .label {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--gray-500);
        font-weight: 600;
    }
    .preview-box .values {
        display: flex;
        align-items: center;
        gap: 1rem;
        font-variant-numeric: tabular-nums;
    }
    .preview-box .current { font-size: 1.1rem; color: var(--gray-500); }
    .preview-box .arrow { color: var(--gray-400); }
    .preview-box .new-value { font-size: 1.5rem; font-weight: 700; color: var(--brand-900); }
    .preview-box.warn { background: var(--danger-bg); border-color: var(--danger-fg); }
    .preview-box.warn .new-value { color: var(--danger-fg); }
</style>

<div class="page-header">
    <div>
        <h2>Adjust Stock</h2>
        <p>@Model.ConsumableName</p>
    </div>
    <a asp-action="Stock" class="btn btn-outline">
        <i class="fas fa-arrow-left"></i> Back
    </a>
</div>

@if (!ViewData.ModelState.IsValid && ViewData.ModelState.Values.Any(v => v.Errors.Any()))
{
    <div class="alert alert-danger">
        <i class="fas fa-exclamation-circle"></i>
        <div>
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <div>@error.ErrorMessage</div>
            }
        </div>
    </div>
}

<form method="post" asp-action="AdjustStock">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="ConsumableID" />
    <input type="hidden" asp-for="ConsumableName" />
    <input type="hidden" id="CurrentQuantityHidden" value="@Model.CurrentQuantity" />

    <div class="card">
        <div class="card-header">
            <h3><i class="fas fa-scale-balanced"></i> Adjustment Type</h3>
        </div>

        <div class="adjust-type-grid">
            <label class="type-option" data-value="increase">
                <input type="radio" asp-for="AdjustmentType" value="increase" />
                <div class="title"><i class="fas fa-plus"></i> Increase</div>
                <div class="desc">Add to stock</div>
            </label>
            <label class="type-option" data-value="decrease">
                <input type="radio" asp-for="AdjustmentType" value="decrease" />
                <div class="title"><i class="fas fa-minus"></i> Decrease</div>
                <div class="desc">Remove from stock</div>
            </label>
            <label class="type-option" data-value="set">
                <input type="radio" asp-for="AdjustmentType" value="set" />
                <div class="title"><i class="fas fa-equals"></i> Set</div>
                <div class="desc">Replace with exact value</div>
            </label>
        </div>
        <span asp-validation-for="AdjustmentType" class="validation-message"></span>
    </div>

    <div class="card">
        <div class="card-header">
            <h3><i class="fas fa-calculator"></i> Adjustment</h3>
        </div>

        <div class="form-group">
            <label>Amount <span class="required">*</span></label>
            <input asp-for="AdjustmentAmount" type="number" min="1" class="form-control"
                   placeholder="e.g., 25" id="adjustAmount" />
            <span asp-validation-for="AdjustmentAmount" class="validation-message"></span>
        </div>

        <div class="preview-box" id="previewBox">
            <div>
                <div class="label">New Quantity on Hand</div>
                <div class="values">
                    <span class="current" id="previewCurrent">@Model.CurrentQuantity</span>
                    <i class="fas fa-arrow-right arrow"></i>
                    <span class="new-value" id="previewNew">@Model.CurrentQuantity</span>
                </div>
            </div>
        </div>

        <div class="form-group">
            <label>Reason for Adjustment</label>
            <input asp-for="Reason" class="form-control"
                   placeholder="e.g., Manual recount, Damaged in transit, Return to supplier" />
            <small class="text-muted text-xs">Recorded in the audit log for traceability.</small>
        </div>
    </div>

    <div class="form-actions">
        <button type="submit" class="btn btn-primary">
            <i class="fas fa-check"></i> Apply Adjustment
        </button>
        <a asp-action="Stock" class="btn btn-outline">Cancel</a>
    </div>
</form>

@section Scripts {
<script>
    (function () {
        const current = parseInt(document.getElementById('CurrentQuantityHidden').value, 10) || 0;
        const amountInput = document.getElementById('adjustAmount');
        const typeRadios = document.querySelectorAll('input[name="AdjustmentType"]');
        const typeLabels = document.querySelectorAll('.type-option');
        const previewNew = document.getElementById('previewNew');
        const previewBox = document.getElementById('previewBox');

        function recalc() {
            const selected = document.querySelector('input[name="AdjustmentType"]:checked');
            const type = selected ? selected.value : null;
            const amount = parseInt(amountInput.value, 10) || 0;
            let next = current;

            if (type === 'increase') next = current + amount;
            else if (type === 'decrease') next = Math.max(0, current - amount);
            else if (type === 'set') next = amount;

            previewNew.textContent = next;
            previewBox.classList.toggle('warn', next < 0 || (type === 'decrease' && amount > current));
        }

        typeRadios.forEach(radio => {
            radio.addEventListener('change', function () {
                typeLabels.forEach(l => l.classList.remove('selected'));
                if (this.checked) this.closest('.type-option').classList.add('selected');
                recalc();
            });
        });

        amountInput.addEventListener('input', recalc);

        // Preselect "increase" for convenience if none selected
        if (!document.querySelector('input[name="AdjustmentType"]:checked')) {
            const first = typeRadios[0];
            if (first) {
                first.checked = true;
                first.dispatchEvent(new Event('change'));
            }
        }
        recalc();
    })();
</script>
}