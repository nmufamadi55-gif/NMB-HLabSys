@using NMB_HLabSys.Models.ViewModels
@model CreateTestCategoryViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Create Test Category";
    ViewData["RoleSubtitle"] = "Laboratory Manager";
    ViewData["UserGreeting"] = "Add a new test category";
    ViewData["UserInitials"] = "LM";
}

@section SidebarMenu {
 ... same as EditTestType ...
 }

<style>
    .form-card {
        background: white;
        border-radius: 16px;
        padding: 1.5rem;
        border: 1px solid #E2E8F0;
    }

    .form-group {
        margin-bottom: 1.2rem;
    }

        .form-group label {
            font-size: 0.85rem;
            font-weight: 600;
            display: block;
            margin-bottom: 0.4rem;
            color: #032C7D;
        }

    .form-control {
        width: 100%;
        padding: 0.6rem 0.8rem;
        border: 1px solid #E2E8F0;
        border-radius: 12px;
        font-size: 0.9rem;
    }

    .btn-primary {
        background: #0841C9;
        color: white;
        border: none;
        padding: 0.6rem 1.4rem;
        border-radius: 40px;
        font-weight: 600;
        cursor: pointer;
    }

    .btn-outline {
        background: transparent;
        border: 1px solid #E2E8F0;
        padding: 0.6rem 1.4rem;
        border-radius: 40px;
        cursor: pointer;
    }
</style>

<div class="form-card">
    <h3><i class="fas fa-tag"></i> Create Test Category</h3>
    <form method="post" action="@Url.Action("CreateCategory")">
        @Html.AntiForgeryToken()
        <div class="form-group">
            <label>Category Name <span style="color:red;">*</span></label>
            <input asp-for="CategoryName" class="form-control" placeholder="e.g., Full Blood Count" />
            <span asp-validation-for="CategoryName" style="color:#DC2626; font-size:0.7rem;"></span>
        </div>
        <div class="form-group">
            <label>Description</label>
            <textarea asp-for="Description" class="form-control" rows="3" placeholder="Brief description"></textarea>
        </div>
        <div style="display:flex; gap:1rem; margin-top:1.5rem;">
            <button type="submit" class="btn-primary"><i class="fas fa-save"></i> Create</button>
            <button type="button" class="btn-outline" onclick="history.back()">Cancel</button>
        </div>
    </form>
</div>