@using NMB_HLabSys.Models.ViewModels
@model CreateTestCategoryViewModel
@{
    Layout = "~/Views/Shared/_ManagerLayout.cshtml";
    ViewData["Title"] = "New Test Category";
}

<div class="page-header">
    <div>
        <h2>New Test Category</h2>
        <p>Organise tests into a category</p>
    </div>
    <a asp-action="TestCatalogue" class="btn btn-outline">
        <i class="fas fa-arrow-left"></i> Back
    </a>
</div>

@if (!ViewData.ModelState.IsValid && ViewData.ModelState.Values.Any(v => v.Errors.Any()))
{
    <div class="alert alert-danger">
        <i class="fas fa-exclamation-circle"></i>
        <div>
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <div>@error.ErrorMessage</div>
            }
        </div>
    </div>
}

<form method="post" asp-action="CreateCategory">
    @Html.AntiForgeryToken()

    <div class="card">
        <div class="card-header">
            <h3><i class="fas fa-tag"></i> Category Details</h3>
        </div>

        <div class="form-group">
            <label>Category Name <span class="required">*</span></label>
            <input asp-for="CategoryName" class="form-control"
                   placeholder="e.g., Full Blood Count, Coagulation Studies" />
            <small class="text-muted text-xs">Must be unique across all categories.</small>
            <span asp-validation-for="CategoryName" class="validation-message"></span>
        </div>

        <div class="form-group" style="margin:0;">
            <label>Description</label>
            <textarea asp-for="Description" rows="3" class="form-control"
                      placeholder="Briefly describe what tests belong in this category."></textarea>
            <span asp-validation-for="Description" class="validation-message"></span>
        </div>
    </div>

    <div class="form-actions">
        <button type="submit" class="btn btn-primary">
            <i class="fas fa-save"></i> Create Category
        </button>
        <a asp-action="TestCatalogue" class="btn btn-outline">Cancel</a>
    </div>
</form>