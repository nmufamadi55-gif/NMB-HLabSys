@using NMB_HLabSys.Models.ViewModels
@model CreateConsumableViewModel
@{
    Layout = "~/Views/Shared/_ManagerLayout.cshtml";
    ViewData["Title"] = "New Consumable";
}

<div class="page-header">
    <div>
        <h2>New Consumable</h2>
        <p>Add a consumable stock item to inventory</p>
    </div>
    <a asp-action="Stock" class="btn btn-outline">
        <i class="fas fa-arrow-left"></i> Back
    </a>
</div>

@if (!ViewData.ModelState.IsValid && ViewData.ModelState.Values.Any(v => v.Errors.Any()))
{
    <div class="alert alert-danger">
        <i class="fas fa-exclamation-circle"></i>
        <div>
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <div>@error.ErrorMessage</div>
            }
        </div>
    </div>
}

<form method="post" asp-action="CreateConsumable">
    @Html.AntiForgeryToken()

    <div class="card">
        <div class="card-header">
            <h3><i class="fas fa-box"></i> Consumable Details</h3>
        </div>

        <div class="form-row-2">
            <div class="form-group">
                <label>Consumable Name <span class="required">*</span></label>
                <input asp-for="ConsumableName" class="form-control" placeholder="e.g., EDTA Collection Tubes" />
                <span asp-validation-for="ConsumableName" class="validation-message"></span>
            </div>
            <div class="form-group">
                <label>Supplier <span class="required">*</span></label>
                <select asp-for="SupplierID" asp-items="Model.AvailableSuppliers" class="form-control">
                    <option value="">— Select Supplier —</option>
                </select>
                <span asp-validation-for="SupplierID" class="validation-message"></span>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h3><i class="fas fa-cubes"></i> Stock Levels</h3>
        </div>

        <div class="form-row-2">
            <div class="form-group">
                <label>Reorder Level <span class="required">*</span></label>
                <input asp-for="ReorderLevel" type="number" min="0" class="form-control" />
                <small class="text-muted text-xs">Order will be triggered when stock falls to this level.</small>
                <span asp-validation-for="ReorderLevel" class="validation-message"></span>
            </div>
            <div class="form-group">
                <label>Initial Quantity on Hand <span class="required">*</span></label>
                <input asp-for="QuantityOnHand" type="number" min="0" class="form-control" />
                <span asp-validation-for="QuantityOnHand" class="validation-message"></span>
            </div>
        </div>

        <div class="form-row-2">
            <div class="form-group">
                <label>Unit of Measure</label>
                <input asp-for="UnitOfMeasure" class="form-control" placeholder="e.g., Box, Pack, Each" />
                <span asp-validation-for="UnitOfMeasure" class="validation-message"></span>
            </div>
            <div class="form-group">
                <label>Minimum Stock Level</label>
                <input asp-for="MinimumStockLevel" type="number" min="0" class="form-control" />
                <span asp-validation-for="MinimumStockLevel" class="validation-message"></span>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h3><i class="fas fa-coins"></i> Pricing &amp; Storage</h3>
        </div>

        <div class="form-row-2">
            <div class="form-group">
                <label>Unit Price (R)</label>
                <input asp-for="UnitPrice" type="number" step="0.01" min="0" class="form-control" placeholder="0.00" />
                <span asp-validation-for="UnitPrice" class="validation-message"></span>
            </div>
            <div class="form-group">
                <label>Storage Location</label>
                <input asp-for="StorageLocation" class="form-control" placeholder="e.g., Fridge A · Shelf 3" />
                <span asp-validation-for="StorageLocation" class="validation-message"></span>
            </div>
        </div>
    </div>

    <div class="form-actions">
        <button type="submit" class="btn btn-primary">
            <i class="fas fa-save"></i> Create Consumable
        </button>
        <a asp-action="Stock" class="btn btn-outline">Cancel</a>
    </div>
</form>