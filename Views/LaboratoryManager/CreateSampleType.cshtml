@using NMB_HLabSys.Models.ViewModels
@model CreateSampleTypeViewModel
@{
    Layout = "~/Views/Shared/_ManagerLayout.cshtml";
    ViewData["Title"] = "New Sample Type";
}

<div class="page-header">
    <div>
        <h2>New Sample Type</h2>
        <p>Define a type of sample collected for testing</p>
    </div>
    <a asp-action="TestCatalogue" class="btn btn-outline">
        <i class="fas fa-arrow-left"></i> Back
    </a>
</div>

@if (!ViewData.ModelState.IsValid && ViewData.ModelState.Values.Any(v => v.Errors.Any()))
{
    <div class="alert alert-danger">
        <i class="fas fa-exclamation-circle"></i>
        <div>
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <div>@error.ErrorMessage</div>
            }
        </div>
    </div>
}

<form method="post" asp-action="CreateSampleType">
    @Html.AntiForgeryToken()

    <div class="card">
        <div class="card-header">
            <h3><i class="fas fa-flask"></i> Sample Type Details</h3>
        </div>

        <div class="form-group">
            <label>Sample Type Name <span class="required">*</span></label>
            <input asp-for="SampleTypeName" class="form-control"
                   placeholder="e.g., Whole Blood, Plasma, Bone Marrow" />
            <small class="text-muted text-xs">Must be unique across all sample types.</small>
            <span asp-validation-for="SampleTypeName" class="validation-message"></span>
        </div>

        <div class="form-group">
            <label>Description</label>
            <textarea asp-for="Description" rows="2" class="form-control"
                      placeholder="Brief description of the sample type"></textarea>
            <span asp-validation-for="Description" class="validation-message"></span>
        </div>

        <div class="form-row-2">
            <div class="form-group">
                <label>Collection Tube Type</label>
                <input asp-for="CollectionTubeType" class="form-control"
                       placeholder="e.g., EDTA (Lavender Top), Citrate (Blue Top)" />
                <span asp-validation-for="CollectionTubeType" class="validation-message"></span>
            </div>
            <div class="form-group">
                <label>Storage Requirements</label>
                <input asp-for="StorageRequirements" class="form-control"
                       placeholder="e.g., Refrigerate at 2–8°C, Room temperature" />
                <span asp-validation-for="StorageRequirements" class="validation-message"></span>
            </div>
        </div>
    </div>

    <div class="form-actions">
        <button type="submit" class="btn btn-primary">
            <i class="fas fa-save"></i> Create Sample Type
        </button>
        <a asp-action="TestCatalogue" class="btn btn-outline">Cancel</a>
    </div>
</form>