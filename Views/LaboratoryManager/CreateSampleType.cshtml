@using NMB_HLabSys.Models.ViewModels
@model CreateSampleTypeViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Create Sample Type";
    ViewData["RoleSubtitle"] = "Laboratory Manager";
    ViewData["UserGreeting"] = "Add a new sample type";
    ViewData["UserInitials"] = "LM";
}

@section SidebarMenu {
 ... same ...
 }

<style>... same ...</style>

<div class="form-card">
    <h3><i class="fas fa-flask"></i> Create Sample Type</h3>
    <form method="post" action="@Url.Action("CreateSampleType")">
        @Html.AntiForgeryToken()
        <div class="form-group">
            <label>Sample Type Name <span style="color:red;">*</span></label>
            <input asp-for="SampleTypeName" class="form-control" placeholder="e.g., Whole Blood" />
            <span asp-validation-for="SampleTypeName" style="color:#DC2626; font-size:0.7rem;"></span>
        </div>
        <div class="form-group">
            <label>Description</label>
            <textarea asp-for="Description" class="form-control" rows="2" placeholder="Description"></textarea>
        </div>
        <div class="form-group">
            <label>Collection Tube Type</label>
            <input asp-for="CollectionTubeType" class="form-control" placeholder="e.g., EDTA Tube" />
        </div>
        <div class="form-group">
            <label>Storage Requirements</label>
            <input asp-for="StorageRequirements" class="form-control" placeholder="e.g., Refrigerate" />
        </div>
        <div style="display:flex; gap:1rem; margin-top:1.5rem;">
            <button type="submit" class="btn-primary"><i class="fas fa-save"></i> Create</button>
            <button type="button" class="btn-outline" onclick="history.back()">Cancel</button>
        </div>
    </form>
</div>