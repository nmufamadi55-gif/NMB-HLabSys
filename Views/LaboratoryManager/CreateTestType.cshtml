@using NMB_HLabSys.Models.ViewModels
@model CreateTestTypeViewModel
@{
    Layout = "~/Views/Shared/_ManagerLayout.cshtml";
    ViewData["Title"] = "New Test Type";
}

<style>
    .consumable-row {
        display: grid;
        grid-template-columns: 28px 1fr 90px;
        align-items: center;
        gap: 0.75rem;
        padding: 0.55rem 0.8rem;
        border: 1px solid var(--gray-200);
        border-radius: var(--radius-sm);
        margin-bottom: 0.4rem;
        background: var(--gray-50);
    }

        .consumable-row input[type="checkbox"] {
            width: 18px;
            height: 18px;
            accent-color: var(--brand-700);
            cursor: pointer;
        }

        .consumable-row .name {
            font-size: 0.85rem;
            color: var(--gray-900);
        }

        .consumable-row .unit {
            font-size: 0.72rem;
            color: var(--gray-500);
        }

        .consumable-row .qty {
            padding: 0.35rem 0.55rem;
            border: 1px solid var(--gray-200);
            border-radius: 6px;
            font-size: 0.85rem;
            width: 100%;
        }

    .section-title {
        font-size: 0.8rem;
        font-weight: 600;
        color: var(--gray-700);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin: 1.5rem 0 0.75rem;
        padding-bottom: 0.4rem;
        border-bottom: 1px solid var(--gray-200);
    }
</style>

<div class="page-header">
    <div>
        <h2>New Test Type</h2>
        <p>Add a test to the catalogue</p>
    </div>
    <a asp-action="TestCatalogue" class="btn btn-outline">
        <i class="fas fa-arrow-left"></i> Back
    </a>
</div>

@if (!ViewData.ModelState.IsValid && ViewData.ModelState.Values.Any(v => v.Errors.Any()))
{
    <div class="alert alert-danger">
        <i class="fas fa-exclamation-circle"></i>
        <div>
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <div>@error.ErrorMessage</div>
            }
        </div>
    </div>
}

<form method="post" asp-action="CreateTestType">
    @Html.AntiForgeryToken()

    <div class="card">
        <div class="card-header">
            <h3><i class="fas fa-info-circle"></i> Test Details</h3>
        </div>

        <div class="form-group">
            <label>Test Name <span class="required">*</span></label>
            <input asp-for="TestName" class="form-control" placeholder="e.g., Haemoglobin" />
            <span asp-validation-for="TestName" class="validation-message"></span>
        </div>

        <div class="form-row-2">
            <div class="form-group">
                <label>Category <span class="required">*</span></label>
                <select asp-for="CategoryID" asp-items="Model.AvailableCategories" class="form-control">
                    <option value="">— Select Category —</option>
                </select>
                <span asp-validation-for="CategoryID" class="validation-message"></span>
            </div>
            <div class="form-group">
                <label>Sample Type <span class="required">*</span></label>
                <select asp-for="SampleTypeID" asp-items="Model.AvailableSampleTypes" class="form-control">
                    <option value="">— Select Sample Type —</option>
                </select>
                <span asp-validation-for="SampleTypeID" class="validation-message"></span>
            </div>
        </div>

        <div class="form-row-2">
            <div class="form-group">
                <label>Unit of Measurement</label>
                <input asp-for="UnitOfMeasurement" class="form-control" placeholder="e.g., g/dL" />
            </div>
            <div class="form-group">
                <label>Turnaround Time (minutes) <span class="required">*</span></label>
                <input asp-for="TurnaroundTimeMinutes" type="number" min="5" max="1440" class="form-control" placeholder="e.g., 60" />
                <span asp-validation-for="TurnaroundTimeMinutes" class="validation-message"></span>
            </div>
        </div>

        <div class="form-row-2">
            <div class="form-group">
                <label>Normal Range — Min</label>
                <input asp-for="NormalRangeMin" type="number" step="0.01" class="form-control" placeholder="e.g., 12.0" />
            </div>
            <div class="form-group">
                <label>Normal Range — Max</label>
                <input asp-for="NormalRangeMax" type="number" step="0.01" class="form-control" placeholder="e.g., 16.0" />
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h3><i class="fas fa-boxes-stacked"></i> Consumables Required</h3>
        </div>
        <p class="text-muted text-sm" style="margin:0 0 0.75rem;">
            Tick the consumables this test uses and enter the quantity needed per test.
        </p>

        @if (Model.Consumables != null && Model.Consumables.Any())
        {
            for (int i = 0; i < Model.Consumables.Count; i++)
            {
                <div class="consumable-row">
                    <input type="hidden" asp-for="Consumables[i].ConsumableID" />
                    <input type="hidden" asp-for="Consumables[i].ConsumableName" />
                    <input type="hidden" asp-for="Consumables[i].UnitOfMeasure" />

                    <input asp-for="Consumables[i].IsSelected"
                           type="checkbox"
                           id="cons_@i"
                           class="consumable-checkbox" />

                    <label for="cons_@i" style="margin:0; cursor:pointer;">
                        <div class="name">@Model.Consumables[i].ConsumableName</div>
                        @if (!string.IsNullOrWhiteSpace(Model.Consumables[i].UnitOfMeasure))
                        {
                            <div class="unit">@Model.Consumables[i].UnitOfMeasure</div>
                        }
                    </label>

                    <input asp-for="Consumables[i].QuantityRequired"
                           type="number" min="1"
                           class="qty consumable-qty"
                           placeholder="Qty" />
                </div>
            }
        }
        else
        {
            <div class="alert alert-info">
                <i class="fas fa-info-circle"></i>
                <div>
                    No consumables exist yet.
                    <a asp-action="CreateConsumable">Add one first</a>.
                </div>
            </div>
        }
    </div>

    <div class="form-actions">
        <button type="submit" class="btn btn-primary">
            <i class="fas fa-save"></i> Create Test Type
        </button>
        <a asp-action="TestCatalogue" class="btn btn-outline">Cancel</a>
    </div>
</form>

@section Scripts {
    <script>
        document.querySelectorAll('.consumable-checkbox').forEach(function (cb) {
            const qty = cb.closest('.consumable-row').querySelector('.consumable-qty');
            const sync = () => { qty.disabled = !cb.checked; };
            cb.addEventListener('change', sync);
            sync();
        });
    </script>
}