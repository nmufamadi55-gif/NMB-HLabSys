@model NMB_HLabSys.Models.ViewModels.CreateTestTypeViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Create Test Type";
    ViewData["RoleSubtitle"] = "Laboratory Manager";
    ViewData["UserGreeting"] = "Add a new test to the catalogue";
    ViewData["UserInitials"] = "LM";
}
@section SidebarMenu {
 ... same as TestCatalogue ...
 }

<style>
    .form-card {
        background: white;
        border-radius: 16px;
        padding: 1.5rem;
        border: 1px solid #E2E8F0;
    }

    .form-group {
        margin-bottom: 1.2rem;
    }

        .form-group label {
            font-size: 0.85rem;
            font-weight: 600;
            display: block;
            margin-bottom: 0.4rem;
            color: #032C7D;
        }

    .form-control {
        width: 100%;
        padding: 0.6rem 0.8rem;
        border: 1px solid #E2E8F0;
        border-radius: 12px;
        font-size: 0.9rem;
    }

        .form-control:focus {
            outline: none;
            border-color: #0841C9;
            box-shadow: 0 0 0 3px rgba(8,65,201,0.1);
        }

    .row-2col {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
    }

    .btn-primary {
        background: #0841C9;
        color: white;
        border: none;
        padding: 0.6rem 1.4rem;
        border-radius: 40px;
        font-weight: 600;
        cursor: pointer;
    }

        .btn-primary:hover {
            background: #032C7D;
        }

    .btn-outline {
        background: transparent;
        border: 1px solid #E2E8F0;
        padding: 0.6rem 1.4rem;
        border-radius: 40px;
        cursor: pointer;
    }
</style>

<div class="form-card">
    <h3><i class="fas fa-plus-circle"></i> Create New Test Type</h3>
    <form method="post" action="@Url.Action("CreateTestType")">
        @Html.AntiForgeryToken()
        <div class="form-group">
            <label>Test Name <span style="color:red;">*</span></label>
            <input asp-for="TestName" class="form-control" placeholder="Enter test name" />
            <span asp-validation-for="TestName" style="color:#DC2626; font-size:0.7rem;"></span>
        </div>
        <div class="row-2col">
            <div class="form-group">
                <label>Category <span style="color:red;">*</span></label>
                <select asp-for="CategoryID" asp-items="Model.AvailableCategories" class="form-control">
                    <option value="">-- Select Category --</option>
                </select>
                <span asp-validation-for="CategoryID" style="color:#DC2626; font-size:0.7rem;"></span>
            </div>
            <div class="form-group">
                <label>Sample Type <span style="color:red;">*</span></label>
                <select asp-for="SampleTypeID" asp-items="Model.AvailableSampleTypes" class="form-control">
                    <option value="">-- Select Sample Type --</option>
                </select>
                <span asp-validation-for="SampleTypeID" style="color:#DC2626; font-size:0.7rem;"></span>
            </div>
        </div>
        <div class="form-group">
            <label>Unit of Measurement</label>
            <input asp-for="UnitOfMeasurement" class="form-control" placeholder="e.g., µL, g/dL" />
        </div>
        <div class="row-2col">
            <div class="form-group">
                <label>Normal Range Min</label>
                <input asp-for="NormalRangeMin" class="form-control" placeholder="Minimum value" />
            </div>
            <div class="form-group">
                <label>Normal Range Max</label>
                <input asp-for="NormalRangeMax" class="form-control" placeholder="Maximum value" />
            </div>
        </div>
        <div class="form-group">
            <label>Turnaround Time (minutes) <span style="color:red;">*</span></label>
            <input asp-for="TurnaroundTimeMinutes" class="form-control" placeholder="e.g., 60" />
            <span asp-validation-for="TurnaroundTimeMinutes" style="color:#DC2626; font-size:0.7rem;"></span>
        </div>
        <div class="form-group">
            <label>Assign Technicians <span style="color:red;">*</span></label>
            <select asp-for="SelectedTechnicianIDs" asp-items="Model.AvailableTechnicians" class="form-control" multiple size="4">
            </select>
            <small style="color:#5A6E7A;">Hold Ctrl to select multiple</small>
            <span asp-validation-for="SelectedTechnicianIDs" style="color:#DC2626; font-size:0.7rem;"></span>
        </div>
        <div class="form-group">
            <label>Consumables Used</label>
            @if (Model.AvailableConsumables != null)
            {
                foreach (var c in Model.AvailableConsumables)
                {
                    <div style="display:flex; align-items:center; gap:1rem; margin-bottom:0.3rem;">
                        <input type="checkbox" name="ConsumableQuantities[@c.Value].Key" value="@c.Value" />
                        <span>@c.Text</span>
                        <input type="number" name="ConsumableQuantities[@c.Value].Value" class="form-control" style="width:80px;" placeholder="Qty" />
                    </div>
                }
            }
        </div>
        <div style="display:flex; gap:1rem; margin-top:1.5rem;">
            <button type="submit" class="btn-primary"><i class="fas fa-save"></i> Create</button>
            <button type="button" class="btn-outline" onclick="history.back()">Cancel</button>
        </div>
    </form>
</div>