@using NMB_HLabSys.Models.ViewModels
@model EditTestCategoryViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Edit Test Category";
    ViewData["RoleSubtitle"] = "Laboratory Manager";
    ViewData["UserGreeting"] = "Update category details";
    ViewData["UserInitials"] = "LM";
}

@section SidebarMenu {
 ... same ...
 }

<style>... same styles ...</style>

<div class="form-card">
    <h3><i class="fas fa-edit"></i> Edit Category</h3>
    <form method="post" action="@Url.Action("EditCategory")">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="CategoryID" />
        <div class="form-group">
            <label>Category Name <span style="color:red;">*</span></label>
            <input asp-for="CategoryName" class="form-control" />
            <span asp-validation-for="CategoryName" style="color:#DC2626; font-size:0.7rem;"></span>
        </div>
        <div class="form-group">
            <label>Description</label>
            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
        </div>
        <div class="form-group">
            <label>Active</label>
            <input asp-for="IsActive" type="checkbox" />
        </div>
        <div style="display:flex; gap:1rem; margin-top:1.5rem;">
            <button type="submit" class="btn-primary"><i class="fas fa-save"></i> Update</button>
            <button type="button" class="btn-outline" onclick="history.back()">Cancel</button>
        </div>
    </form>
</div>