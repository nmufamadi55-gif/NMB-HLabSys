@using NMB_HLabSys.Models.ViewModels
@model EditConsumableViewModel
@{
    Layout = "~/Views/Shared/_ManagerLayout.cshtml";
    ViewData["Title"] = "Edit Consumable";
}

<div class="page-header">
    <div>
        <h2>Edit Consumable</h2>
        <p>Update details for @Model.ConsumableName</p>
    </div>
    <a asp-action="Stock" class="btn btn-outline">
        <i class="fas fa-arrow-left"></i> Back
    </a>
</div>

@if (!ViewData.ModelState.IsValid && ViewData.ModelState.Values.Any(v => v.Errors.Any()))
{
    <div class="alert alert-danger">
        <i class="fas fa-exclamation-circle"></i>
        <div>
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <div>@error.ErrorMessage</div>
            }
        </div>
    </div>
}

<form method="post" asp-action="EditConsumable">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="ConsumableID" />

    <div class="card">
        <div class="card-header">
            <h3><i class="fas fa-box"></i> Consumable Details</h3>
        </div>

        <div class="form-row-2">
            <div class="form-group">
                <label>Consumable Name <span class="required">*</span></label>
                <input asp-for="ConsumableName" class="form-control" />
                <span asp-validation-for="ConsumableName" class="validation-message"></span>
            </div>
            <div class="form-group">
                <label>Supplier <span class="required">*</span></label>
                <select asp-for="SupplierID" asp-items="Model.AvailableSuppliers" class="form-control"></select>
                <span asp-validation-for="SupplierID" class="validation-message"></span>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h3><i class="fas fa-cubes"></i> Stock Levels</h3>
        </div>

        <div class="alert alert-info">
            <i class="fas fa-info-circle"></i>
            <div>
                To change <strong>Quantity on Hand</strong>, use
                <a asp-action="AdjustStock" asp-route-id="@Model.ConsumableID">Adjust Stock</a>
                so the change is logged.
            </div>
        </div>

        <div class="form-row-2">
            <div class="form-group">
                <label>Reorder Level <span class="required">*</span></label>
                <input asp-for="ReorderLevel" type="number" min="0" class="form-control" />
                <span asp-validation-for="ReorderLevel" class="validation-message"></span>
            </div>
            <div class="form-group">
                <label>Current Quantity on Hand</label>
                <input asp-for="QuantityOnHand" type="number" class="form-control" readonly />
                <span asp-validation-for="QuantityOnHand" class="validation-message"></span>
            </div>
        </div>

        <div class="form-row-2">
            <div class="form-group">
                <label>Unit of Measure</label>
                <input asp-for="UnitOfMeasure" class="form-control" />
                <span asp-validation-for="UnitOfMeasure" class="validation-message"></span>
            </div>
            <div class="form-group">
                <label>Minimum Stock Level</label>
                <input asp-for="MinimumStockLevel" type="number" min="0" class="form-control" />
                <span asp-validation-for="MinimumStockLevel" class="validation-message"></span>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h3><i class="fas fa-coins"></i> Pricing &amp; Storage</h3>
        </div>

        <div class="form-row-2">
            <div class="form-group">
                <label>Unit Price (R)</label>
                <input asp-for="UnitPrice" type="number" step="0.01" min="0" class="form-control" />
                <span asp-validation-for="UnitPrice" class="validation-message"></span>
            </div>
            <div class="form-group">
                <label>Storage Location</label>
                <input asp-for="StorageLocation" class="form-control" />
                <span asp-validation-for="StorageLocation" class="validation-message"></span>
            </div>
        </div>

        <div class="form-group">
            <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer; margin: 0;">
                <input asp-for="IsActive" type="checkbox" style="width: 16px; height: 16px; accent-color: var(--brand-700);" />
                <span>Active (unchecking archives this consumable)</span>
            </label>
        </div>
    </div>

    <div class="form-actions">
        <button type="submit" class="btn btn-primary">
            <i class="fas fa-save"></i> Save Changes
        </button>
        <a asp-action="Stock" class="btn btn-outline">Cancel</a>
    </div>
</form>