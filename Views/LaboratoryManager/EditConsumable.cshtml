@using NMB_HLabSys.Models.ViewModels
@model EditConsumableViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Edit Consumable";
    ViewData["RoleSubtitle"] = "Laboratory Manager";
    ViewData["UserGreeting"] = "Update consumable details";
    ViewData["UserInitials"] = "LM";
}

@section SidebarMenu {
 ... same ...
 }

<style>... form styles ...</style>

<div class="form-card">
    <h3><i class="fas fa-edit"></i> Edit Consumable</h3>
    <form method="post" action="@Url.Action("EditConsumable")">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="ConsumableID" />
        <div class="form-group">
            <label>Consumable Name <span style="color:red;">*</span></label>
            <input asp-for="ConsumableName" class="form-control" />
            <span asp-validation-for="ConsumableName" style="color:#DC2626; font-size:0.7rem;"></span>
        </div>
        <div class="form-group">
            <label>Supplier <span style="color:red;">*</span></label>
            <select asp-for="SupplierID" asp-items="Model.AvailableSuppliers" class="form-control"></select>
            <span asp-validation-for="SupplierID" style="color:#DC2626; font-size:0.7rem;"></span>
        </div>
        <div class="row-2col">
            <div class="form-group">
                <label>Reorder Level <span style="color:red;">*</span></label>
                <input asp-for="ReorderLevel" class="form-control" type="number" />
                <span asp-validation-for="ReorderLevel" style="color:#DC2626; font-size:0.7rem;"></span>
            </div>
            <div class="form-group">
                <label>Quantity on Hand <span style="color:red;">*</span></label>
                <input asp-for="QuantityOnHand" class="form-control" type="number" />
                <span asp-validation-for="QuantityOnHand" style="color:#DC2626; font-size:0.7rem;"></span>
            </div>
        </div>
        <div class="row-2col">
            <div class="form-group">
                <label>Unit of Measure</label>
                <input asp-for="UnitOfMeasure" class="form-control" />
            </div>
            <div class="form-group">
                <label>Unit Price</label>
                <input asp-for="UnitPrice" class="form-control" />
            </div>
        </div>
        <div class="form-group">
            <label>Storage Location</label>
            <input asp-for="StorageLocation" class="form-control" />
        </div>
        <div class="form-group">
            <label>Active</label>
            <input asp-for="IsActive" type="checkbox" />
        </div>
        <div style="display:flex; gap:1rem; margin-top:1.5rem;">
            <button type="submit" class="btn-primary"><i class="fas fa-save"></i> Update</button>
            <button type="button" class="btn-outline" onclick="history.back()">Cancel</button>
        </div>
    </form>
</div>