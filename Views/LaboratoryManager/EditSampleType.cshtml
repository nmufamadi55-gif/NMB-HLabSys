@using NMB_HLabSys.Models.ViewModels
@model EditSampleTypeViewModel
@{
    Layout = "~/Views/Shared/_ManagerLayout.cshtml";
    ViewData["Title"] = "Edit Sample Type";
}

<div class="page-header">
    <div>
        <h2>Edit Sample Type</h2>
        <p>@Model.SampleTypeName</p>
    </div>
    <a asp-action="TestCatalogue" class="btn btn-outline">
        <i class="fas fa-arrow-left"></i> Back
    </a>
</div>

@if (!ViewData.ModelState.IsValid && ViewData.ModelState.Values.Any(v => v.Errors.Any()))
{
    <div class="alert alert-danger">
        <i class="fas fa-exclamation-circle"></i>
        <div>
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <div>@error.ErrorMessage</div>
            }
        </div>
    </div>
}

<form method="post" asp-action="EditSampleType">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="SampleTypeID" />

    <div class="card">
        <div class="card-header">
            <h3><i class="fas fa-flask"></i> Sample Type Details</h3>
        </div>

        <div class="form-group">
            <label>Sample Type Name <span class="required">*</span></label>
            <input asp-for="SampleTypeName" class="form-control" />
            <span asp-validation-for="SampleTypeName" class="validation-message"></span>
        </div>

        <div class="form-group">
            <label>Description</label>
            <textarea asp-for="Description" rows="2" class="form-control"></textarea>
        </div>

        <div class="form-row-2">
            <div class="form-group">
                <label>Collection Tube Type</label>
                <input asp-for="CollectionTubeType" class="form-control" />
            </div>
            <div class="form-group">
                <label>Storage Requirements</label>
                <input asp-for="StorageRequirements" class="form-control" />
            </div>
        </div>

        <div class="form-group" style="margin:0;">
            <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer; margin: 0;">
                <input asp-for="IsActive" type="checkbox"
                       style="width: 16px; height: 16px; accent-color: var(--brand-700);" />
                <span>Active (unchecking archives this sample type)</span>
            </label>
        </div>
    </div>

    <div class="form-actions">
        <button type="submit" class="btn btn-primary">
            <i class="fas fa-save"></i> Save Changes
        </button>
        <a asp-action="TestCatalogue" class="btn btn-outline">Cancel</a>
    </div>
</form>