@using NMB_HLabSys.Models.ViewModels
@model EditSupplierViewModel
@{
    Layout = "~/Views/Shared/_ManagerLayout.cshtml";
    ViewData["Title"] = "Edit Supplier";
}

<div class="page-header">
    <div>
        <h2>Edit Supplier</h2>
        <p>Update @Model.SupplierName</p>
    </div>
    <a asp-action="Suppliers" class="btn btn-outline">
        <i class="fas fa-arrow-left"></i> Back
    </a>
</div>

@if (!ViewData.ModelState.IsValid && ViewData.ModelState.Values.Any(v => v.Errors.Any()))
{
    <div class="alert alert-danger">
        <i class="fas fa-exclamation-circle"></i>
        <div>
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <div>@error.ErrorMessage</div>
            }
        </div>
    </div>
}

<form method="post" asp-action="EditSupplier">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="SupplierID" />

    <div class="card">
        <div class="card-header">
            <h3><i class="fas fa-building"></i> Supplier Details</h3>
        </div>

        <div class="form-group">
            <label>Supplier Name <span class="required">*</span></label>
            <input asp-for="SupplierName" class="form-control" />
            <span asp-validation-for="SupplierName" class="validation-message"></span>
        </div>

        <div class="form-row-2">
            <div class="form-group">
                <label>Contact Person <span class="required">*</span></label>
                <input asp-for="ContactPerson" class="form-control" />
                <span asp-validation-for="ContactPerson" class="validation-message"></span>
            </div>
            <div class="form-group">
                <label>Email Address <span class="required">*</span></label>
                <input asp-for="EmailAddress" type="email" class="form-control" />
                <span asp-validation-for="EmailAddress" class="validation-message"></span>
            </div>
        </div>

        <div class="form-row-2">
            <div class="form-group">
                <label>Phone Number</label>
                <input asp-for="PhoneNumber" class="form-control" />
            </div>
            <div class="form-group">
                <label>Address</label>
                <input asp-for="Address" class="form-control" />
            </div>
        </div>

        <div class="form-group" style="margin-top: 0.5rem; display: flex; flex-direction: column; gap: 0.6rem;">
            <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer; margin: 0;">
                <input asp-for="IsPreferred" type="checkbox"
                       style="width: 16px; height: 16px; accent-color: var(--brand-700);" />
                <span>Preferred supplier</span>
            </label>
            <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer; margin: 0;">
                <input asp-for="IsActive" type="checkbox"
                       style="width: 16px; height: 16px; accent-color: var(--brand-700);" />
                <span>Active (unchecking archives this supplier)</span>
            </label>
        </div>
    </div>

    <div class="form-actions">
        <button type="submit" class="btn btn-primary">
            <i class="fas fa-save"></i> Save Changes
        </button>
        <a asp-action="Suppliers" class="btn btn-outline">Cancel</a>
    </div>
</form>