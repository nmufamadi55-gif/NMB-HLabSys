@using NMB_HLabSys.Models.ViewModels
@model EditTestTypeViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Edit Test Type";
    ViewData["RoleSubtitle"] = "Laboratory Manager";
    ViewData["UserGreeting"] = "Update test details";
    ViewData["UserInitials"] = "LM";
}

@section SidebarMenu {
    <li><a href="@Url.Action("Index", "LaboratoryManager")"><i class="fas fa-chart-pie"></i> <span>Dashboard</span></a></li>
    <li><a href="@Url.Action("TestCatalogue", "LaboratoryManager")" class="active"><i class="fas fa-vial"></i> <span>Test Catalogue</span></a></li>
    <li><a href="@Url.Action("Stock", "LaboratoryManager")"><i class="fas fa-boxes"></i> <span>Stock Management</span></a></li>
    <li><a href="@Url.Action("Suppliers", "LaboratoryManager")"><i class="fas fa-truck"></i> <span>Suppliers</span></a></li>
    <li><a href="@Url.Action("Orders", "LaboratoryManager")"><i class="fas fa-shopping-cart"></i> <span>Purchase Orders</span></a></li>
    <li><a href="@Url.Action("Staff", "LaboratoryManager")"><i class="fas fa-user-md"></i> <span>Staff Management</span></a></li>
    <li><a href="@Url.Action("Reports", "LaboratoryManager")"><i class="fas fa-file-alt"></i> <span>Reports</span></a></li>
    <li><a href="@Url.Action("Index", "Profile")"><i class="fas fa-user-circle"></i> <span>My Profile</span></a></li>
}

<style>
    .form-card {
        background: white;
        border-radius: 16px;
        padding: 1.5rem;
        border: 1px solid #E2E8F0;
    }

    .form-group {
        margin-bottom: 1.2rem;
    }

        .form-group label {
            font-size: 0.85rem;
            font-weight: 600;
            display: block;
            margin-bottom: 0.4rem;
            color: #032C7D;
        }

    .form-control {
        width: 100%;
        padding: 0.6rem 0.8rem;
        border: 1px solid #E2E8F0;
        border-radius: 12px;
        font-size: 0.9rem;
    }

        .form-control:focus {
            outline: none;
            border-color: #0841C9;
            box-shadow: 0 0 0 3px rgba(8,65,201,0.1);
        }

    .row-2col {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
    }

    .btn-primary {
        background: #0841C9;
        color: white;
        border: none;
        padding: 0.6rem 1.4rem;
        border-radius: 40px;
        font-weight: 600;
        cursor: pointer;
    }

        .btn-primary:hover {
            background: #032C7D;
        }

    .btn-outline {
        background: transparent;
        border: 1px solid #E2E8F0;
        padding: 0.6rem 1.4rem;
        border-radius: 40px;
        cursor: pointer;
    }
</style>

<div class="form-card">
    <h3><i class="fas fa-edit"></i> Edit Test Type</h3>
    <form method="post" action="@Url.Action("EditTestType")">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="TestID" />
        <div class="form-group">
            <label>Test Name <span style="color:red;">*</span></label>
            <input asp-for="TestName" class="form-control" />
            <span asp-validation-for="TestName" style="color:#DC2626; font-size:0.7rem;"></span>
        </div>
        <div class="row-2col">
            <div class="form-group">
                <label>Category <span style="color:red;">*</span></label>
                <select asp-for="CategoryID" asp-items="Model.AvailableCategories" class="form-control"></select>
                <span asp-validation-for="CategoryID" style="color:#DC2626; font-size:0.7rem;"></span>
            </div>
            <div class="form-group">
                <label>Sample Type <span style="color:red;">*</span></label>
                <select asp-for="SampleTypeID" asp-items="Model.AvailableSampleTypes" class="form-control"></select>
                <span asp-validation-for="SampleTypeID" style="color:#DC2626; font-size:0.7rem;"></span>
            </div>
        </div>
        <div class="form-group">
            <label>Unit of Measurement</label>
            <input asp-for="UnitOfMeasurement" class="form-control" />
        </div>
        <div class="row-2col">
            <div class="form-group">
                <label>Normal Range Min</label>
                <input asp-for="NormalRangeMin" class="form-control" />
            </div>
            <div class="form-group">
                <label>Normal Range Max</label>
                <input asp-for="NormalRangeMax" class="form-control" />
            </div>
        </div>
        <div class="form-group">
            <label>Turnaround Time (minutes) <span style="color:red;">*</span></label>
            <input asp-for="TurnaroundTimeMinutes" class="form-control" />
            <span asp-validation-for="TurnaroundTimeMinutes" style="color:#DC2626; font-size:0.7rem;"></span>
        </div>
        <div class="form-group">
            <label>Active</label>
            <input asp-for="IsActive" type="checkbox" />
        </div>
        <div class="form-group">
            <label>Assign Technicians <span style="color:red;">*</span></label>
            <select asp-for="SelectedTechnicianIDs" asp-items="Model.AvailableTechnicians" class="form-control" multiple size="4"></select>
            <small style="color:#5A6E7A;">Hold Ctrl to select multiple</small>
            <span asp-validation-for="SelectedTechnicianIDs" style="color:#DC2626; font-size:0.7rem;"></span>
        </div>
        <div class="form-group">
            <label>Consumables Used</label>
            @if (Model.AvailableConsumables != null)
            {
                foreach (var c in Model.AvailableConsumables)
                {
                    var quantity = Model.ConsumableQuantities != null && Model.ConsumableQuantities.ContainsKey(int.Parse(c.Value))
                    ? Model.ConsumableQuantities[int.Parse(c.Value)]
                    : 0;
                    <div style="display:flex; align-items:center; gap:1rem; margin-bottom:0.3rem;">
                        <input type="checkbox" name="ConsumableQuantities[@c.Value].Key" value="@c.Value" @(quantity > 0 ? "checked" : "") />
                        <span>@c.Text</span>
                        <input type="number" name="ConsumableQuantities[@c.Value].Value" class="form-control" style="width:80px;" value="@quantity" placeholder="Qty" />
                    </div>
                }
            }
        </div>
        <div style="display:flex; gap:1rem; margin-top:1.5rem;">
            <button type="submit" class="btn-primary"><i class="fas fa-save"></i> Update</button>
            <button type="button" class="btn-outline" onclick="history.back()">Cancel</button>
        </div>
    </form>
</div>