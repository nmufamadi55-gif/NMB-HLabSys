@using NMB_HLabSys.Models.ViewModels
@model DashboardViewModel
@{
    Layout = "~/Views/Shared/_ManagerLayout.cshtml";
    ViewData["Title"] = "Dashboard";
}

<style>
    .dash-2col {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
        margin-bottom: 1rem;
    }

    @@media (max-width: 900px) {
        .dash-2col {
            grid-template-columns: 1fr;
        }
    }

    .quick-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-bottom: 1.25rem;
    }

    .activity-list {
        display: flex;
        flex-direction: column;
    }

    .activity-item {
        display: flex;
        gap: 0.75rem;
        padding: 0.7rem 0;
        border-bottom: 1px solid var(--gray-100);
    }

        .activity-item:last-child {
            border-bottom: none;
        }

    .activity-icon {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: var(--brand-50);
        color: var(--brand-700);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.75rem;
        flex-shrink: 0;
    }

    .activity-title {
        font-size: 0.8rem;
        font-weight: 600;
        color: var(--gray-900);
        margin: 0 0 0.15rem;
    }

    .activity-time {
        font-size: 0.7rem;
        color: var(--gray-500);
    }

    .stock-row {
        display: grid;
        grid-template-columns: 1fr auto auto;
        gap: 0.75rem;
        align-items: center;
        padding: 0.65rem 0;
        border-bottom: 1px solid var(--gray-100);
        font-size: 0.8rem;
    }

        .stock-row:last-child {
            border-bottom: none;
        }

    .stock-name {
        font-weight: 500;
        color: var(--gray-900);
    }

    .stock-qty {
        font-size: 0.75rem;
        color: var(--gray-500);
        white-space: nowrap;
    }

    .summary-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
        gap: 1rem;
    }

    .summary-item .val {
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--brand-900);
        line-height: 1.1;
    }

    .summary-item .lbl {
        font-size: 0.7rem;
        color: var(--gray-500);
        text-transform: uppercase;
        letter-spacing: 0.04em;
        margin-top: 0.2rem;
    }
</style>

<!-- Quick actions -->
<div class="quick-actions">
    <a asp-action="CreateTestType" class="btn btn-primary"><i class="fas fa-plus"></i> New Test</a>
    <a asp-action="CreateConsumable" class="btn btn-outline"><i class="fas fa-plus"></i> New Consumable</a>
    <a asp-action="CreateOrder" class="btn btn-outline"><i class="fas fa-plus"></i> New Order</a>
    <a asp-action="AddTechnician" class="btn btn-outline"><i class="fas fa-user-plus"></i> Add Technician</a>
</div>

<!-- KPI cards -->
<div class="stats-grid">
    <a asp-action="TestCatalogue" class="stat-card" style="text-decoration:none;">
        <div class="stat-info">
            <h3>@Model.TotalTestTypes</h3>
            <p>Test Types</p>
        </div>
        <div class="stat-icon"><i class="fas fa-vial"></i></div>
    </a>
    <a asp-action="Stock" class="stat-card" style="text-decoration:none;">
        <div class="stat-info">
            <h3>@Model.TotalConsumables</h3>
            <p>Consumables</p>
        </div>
        <div class="stat-icon"><i class="fas fa-boxes-stacked"></i></div>
    </a>
    <a asp-action="Orders" class="stat-card" style="text-decoration:none;">
        <div class="stat-info">
            <h3>@Model.PendingOrders</h3>
            <p>Pending Orders</p>
        </div>
        <div class="stat-icon"><i class="fas fa-clipboard-list"></i></div>
    </a>
    <a asp-action="Staff" class="stat-card" style="text-decoration:none;">
        <div class="stat-info">
            <h3>@(Model.TotalTechnicians + Model.TotalDoctors)</h3>
            <p>Staff Members</p>
        </div>
        <div class="stat-icon"><i class="fas fa-users-gear"></i></div>
    </a>
</div>

<!-- Low stock + Recent activity -->
<div class="dash-2col">
    <div class="card">
        <div class="card-header">
            <h3><i class="fas fa-exclamation-triangle"></i> Low Stock Alerts</h3>
            <a asp-action="Stock" class="btn btn-sm btn-outline">View All</a>
        </div>
        @if (Model.LowStockAlerts != null && Model.LowStockAlerts.Any())
        {
            @foreach (var alert in Model.LowStockAlerts.Take(6))
            {
                <div class="stock-row">
                    <span class="stock-name">@alert.ConsumableName</span>
                    <span class="badge @(alert.AlertLevel == "Critical" ? "badge-danger" : "badge-warning")">
                        @alert.AlertLevel
                    </span>
                    <span class="stock-qty">@alert.QuantityOnHand / @alert.ReorderLevel</span>
                </div>
            }
        }
        else
        {
            <div class="empty-state" style="padding: 2rem 1rem;">
                <i class="fas fa-check-circle" style="color: var(--success-fg);"></i>
                <h3>All Stock Healthy</h3>
                <p>No items are below reorder level.</p>
            </div>
        }
    </div>

    <div class="card">
        <div class="card-header">
            <h3><i class="fas fa-history"></i> Recent Activity</h3>
        </div>
        @if (Model.RecentActivities != null && Model.RecentActivities.Any())
        {
            <div class="activity-list">
                @foreach (var activity in Model.RecentActivities.Take(6))
                {
                    <div class="activity-item">
                        <div class="activity-icon"><i class="fas fa-circle-info"></i></div>
                        <div>
                            <div class="activity-title">@activity.ActivityType</div>
                            <div class="activity-time">
                                @activity.Description · @activity.ActivityDate.ToString("dd MMM HH:mm")
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-state" style="padding: 2rem 1rem;">
                <i class="fas fa-inbox"></i>
                <h3>No Activity Yet</h3>
                <p>Recent actions will appear here.</p>
            </div>
        }
    </div>
</div>

<!-- This month summary -->
<div class="card">
    <div class="card-header">
        <h3><i class="fas fa-chart-line"></i> This Month</h3>
    </div>
    <div class="summary-grid">
        <div class="summary-item">
            <div class="val">@Model.Statistics.TestsPerformedThisMonth</div>
            <div class="lbl">Tests Completed</div>
        </div>
        <div class="summary-item">
            <div class="val">@Model.Statistics.OrdersProcessedThisMonth</div>
            <div class="lbl">Orders Processed</div>
        </div>
        <div class="summary-item">
            <div class="val">R@Model.Statistics.TotalStockValue.ToString("N0")</div>
            <div class="lbl">Stock Value</div>
        </div>
        <div class="summary-item">
            <div class="val">@Model.Statistics.ActiveTechnicians</div>
            <div class="lbl">Active Technicians</div>
        </div>
    </div>
</div>