@using NMB_HLabSys.Models.ViewModels
@model OrderDetailViewModel
@{
    Layout = "~/Views/Shared/_ManagerLayout.cshtml";
    ViewData["Title"] = $"Order {Model.OrderNumber}";
}

<style>
    .order-header-card {
        background: linear-gradient(135deg, var(--brand-900) 0%, var(--brand-700) 100%);
        color: white;
        border-radius: var(--radius-lg);
        padding: 1.5rem 1.75rem;
        margin-bottom: 1rem;
    }
    .order-header-card h2 {
        margin: 0;
        font-size: 1.4rem;
        font-weight: 700;
        letter-spacing: -0.02em;
    }
    .order-header-card .meta {
        display: flex; flex-wrap: wrap; gap: 1.5rem;
        margin-top: 0.75rem; font-size: 0.82rem; opacity: 0.9;
    }
    .order-header-card .meta strong { font-weight: 600; }
    .order-header-card .actions {
        display: flex; gap: 0.5rem; flex-wrap: wrap; margin-top: 1.25rem;
    }
    .order-header-card .btn {
        background: rgba(255,255,255,0.15);
        color: white;
        border: none;
    }
    .order-header-card .btn:hover {
        background: rgba(255,255,255,0.25);
        color: white;
    }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1.25rem 1.5rem;
    }
    .info-item .label {
        font-size: 0.7rem;
        font-weight: 600;
        color: var(--gray-500);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 0.25rem;
        display: block;
    }
    .info-item .value { font-size: 0.9rem; color: var(--gray-900); }

    .item-status { font-variant-numeric: tabular-nums; }
    .progress-bar-mini {
        display: inline-block;
        height: 4px;
        width: 60px;
        background: var(--gray-200);
        border-radius: 2px;
        overflow: hidden;
        vertical-align: middle;
        margin-right: 0.5rem;
    }
    .progress-bar-mini span {
        display: block;
        height: 100%;
        background: var(--brand-700);
    }

    .cancel-order-card {
        border-color: var(--danger-bg);
        background: #FEF7F7;
    }
    .cancel-order-card .card-header h3 { color: var(--danger-fg); }
    .cancel-order-card .card-header h3 i { color: var(--danger-fg); }
</style>

@* ─── Header card ─── *@
<div class="order-header-card">
    <div style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:1rem;">
        <div>
            <h2>@Model.OrderNumber</h2>
            <div class="meta">
                <span><strong>Supplier:</strong> @Model.SupplierName</span>
                <span><strong>Placed:</strong> @Model.OrderDate.ToString("dd MMM yyyy")</span>
                @if (Model.ExpectedDeliveryDate.HasValue)
                {
                    <span><strong>Expected:</strong> @Model.ExpectedDeliveryDate.Value.ToString("dd MMM yyyy")</span>
                }
                <span><strong>Total:</strong> R@((Model.TotalAmount ?? 0).ToString("N2"))</span>
            </div>
        </div>
        <div>
            @{
                var statusBadge = Model.Status switch
                {
                    "Complete" => "badge-success",
                    "Cancelled" => "badge-danger",
                    "Partially complete" => "badge-info",
                    _ => "badge-warning"
                };
            }
            <span class="badge @statusBadge" style="font-size: 0.8rem; padding: 0.35rem 0.9rem;">
                @Model.Status
            </span>
        </div>
    </div>
    <div class="actions">
        <a asp-action="Orders" class="btn">
            <i class="fas fa-arrow-left"></i> Back to Orders
        </a>
    </div>
</div>

@* ─── Order info ─── *@
<div class="card">
    <div class="card-header">
        <h3><i class="fas fa-info-circle"></i> Order Information</h3>
    </div>
    <div class="info-grid">
        <div class="info-item">
            <span class="label">Supplier Contact</span>
            <div class="value">@Model.SupplierContact</div>
        </div>
        <div class="info-item">
            <span class="label">Supplier Email</span>
            <div class="value">
                @if (!string.IsNullOrWhiteSpace(Model.SupplierEmail))
                {
                    <a href="mailto:@Model.SupplierEmail">@Model.SupplierEmail</a>
                }
                else
                {
                    <span class="text-muted">—</span>
                }
            </div>
        </div>
        @if (Model.DateCompleted.HasValue)
        {
            <div class="info-item">
                <span class="label">Completed On</span>
                <div class="value">@Model.DateCompleted.Value.ToString("dd MMM yyyy HH:mm")</div>
            </div>
        }
        @if (Model.DateCancelled.HasValue)
        {
            <div class="info-item">
                <span class="label">Cancelled On</span>
                <div class="value" style="color: var(--danger-fg);">
                    @Model.DateCancelled.Value.ToString("dd MMM yyyy HH:mm")
                </div>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(Model.CancellationReason))
        {
            <div class="info-item" style="grid-column: 1 / -1;">
                <span class="label">Cancellation Reason</span>
                <div class="value" style="color: var(--danger-fg);">@Model.CancellationReason</div>
            </div>
        }
    </div>
</div>

@* ─── Items ─── *@
<div class="card">
    <div class="card-header">
        <h3><i class="fas fa-list"></i> Order Items (@Model.Items.Count)</h3>
    </div>
    <div class="table-container">
        <table>
            <thead>
                <tr>
                    <th>Consumable</th>
                    <th style="text-align:right;">Ordered</th>
                    <th style="text-align:right;">Received</th>
                    <th style="text-align:right;">Unit Price</th>
                    <th style="text-align:right;">Line Total</th>
                    <th>Status</th>
                    <th style="text-align:right;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items != null && Model.Items.Any())
                {
                    @foreach (var item in Model.Items)
                    {
                        var itemBadge = item.Status switch
                        {
                            "Received" => "badge-success",
                            "Cancelled" => "badge-danger",
                            _ => "badge-warning"
                        };
                        var progressPct = item.QuantityOrdered > 0
                            ? (int)Math.Round((double)item.QuantityReceived / item.QuantityOrdered * 100)
                            : 0;

                        <tr>
                            <td><strong>@item.ConsumableName</strong></td>
                            <td style="text-align:right;" class="item-status">@item.QuantityOrdered</td>
                            <td style="text-align:right;" class="item-status">
                                <span class="progress-bar-mini"><span style="width:@(progressPct)%;"></span></span>
                                @item.QuantityReceived
                            </td>
                            <td style="text-align:right;" class="text-sm">
                                R@((item.UnitPrice ?? 0).ToString("N2"))
                            </td>
                            <td style="text-align:right;" class="text-sm">
                                R@(((item.UnitPrice ?? 0) * item.QuantityOrdered).ToString("N2"))
                            </td>
                            <td>
                                <span class="badge @itemBadge">@item.Status</span>
                            </td>
                            <td style="text-align:right; white-space:nowrap;">
                                @if (item.Status != "Received" && item.Status != "Cancelled" && Model.CanReceive)
                                {
                                    <form id="receive_@item.OrderItemID"
                                          asp-action="ReceiveOrderItem" method="post"
                                          style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="orderItemId" value="@item.OrderItemID" />
                                    </form>
                                    <button type="button" class="btn btn-sm btn-success"
                                            onclick="receiveItem('@item.OrderItemID', '@item.ConsumableName', @item.QuantityOrdered)">
                                        <i class="fas fa-check"></i> Receive
                                    </button>
                                }
                                @if (item.Status != "Received" && item.Status != "Cancelled" && Model.CanCancel)
                                {
                                    <button type="button" class="btn btn-sm btn-outline"
                                            style="color: var(--danger-fg); border-color: var(--danger-bg);"
                                            onclick="cancelItem('@item.OrderItemID', '@item.ConsumableName')">
                                        <i class="fas fa-times"></i>
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7">
                            <div class="empty-state">
                                <i class="fas fa-inbox"></i>
                                <h3>No Items</h3>
                                <p>This order has no items.</p>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@* ─── Cancel entire order ─── *@
@if (Model.CanCancel)
{
    <div class="card cancel-order-card">
        <div class="card-header">
            <h3><i class="fas fa-ban"></i> Cancel Entire Order</h3>
        </div>
        <p class="text-sm text-muted" style="margin-top:0;">
            Any items already received will remain in stock. Only outstanding items will be cancelled.
        </p>

        <form method="post" asp-action="CancelOrder" id="cancelOrderForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="OrderID" value="@Model.OrderID" />
            <input type="hidden" name="OrderNumber" value="@Model.OrderNumber" />

            <div class="form-group">
                <label>Cancellation Reason <span class="required">*</span></label>
                <textarea name="CancellationReason" required rows="2" class="form-control"
                          placeholder="Why is this order being cancelled?"></textarea>
            </div>

            <div class="form-group">
                <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer; margin: 0;">
                    <input type="checkbox" name="NotifySupplier" value="true" checked
                           style="width: 16px; height: 16px; accent-color: var(--brand-700);" />
                    <span>Email the supplier about this cancellation</span>
                </label>
                <input type="hidden" name="NotifySupplier" value="false" />
            </div>

            <button type="button" class="btn btn-danger" onclick="submitCancelOrder()">
                <i class="fas fa-ban"></i> Cancel Order
            </button>
        </form>
    </div>
}

@* ─── Cancel-item modal ─── *@
<div id="cancelItemModal" class="modal-overlay" style="display:none;">
    <div class="modal" role="dialog" aria-modal="true">
        <div class="modal-header">
            <h3>Cancel Item</h3>
        </div>
        <div class="modal-body">
            <p id="cancelItemMessage" style="margin-bottom: 1rem;"></p>
            <form method="post" asp-action="CancelOrderItem" id="cancelItemForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="orderItemId" id="cancelItemId" />
                <div class="form-group">
                    <label>Reason <span class="required">*</span></label>
                    <input type="text" name="reason" required class="form-control"
                           placeholder="Why is this item being cancelled?" />
                </div>
            </form>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-outline" onclick="closeCancelModal()">Back</button>
            <button type="submit" form="cancelItemForm" class="btn btn-danger">
                Confirm Cancel
            </button>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // ─── Receive single item ───
    window.receiveItem = async function (itemId, name, qty) {
        const ok = await confirmModal({
            title: 'Receive Item',
            message: `Mark "${name}" (qty ${qty}) as received? Stock on hand will be updated automatically.`,
            okText: 'Receive',
            danger: false
        });
        if (ok) document.getElementById(`receive_${itemId}`).submit();
    };

    // ─── Cancel single item ───
    window.cancelItem = function (itemId, name) {
        document.getElementById('cancelItemId').value = itemId;
        document.getElementById('cancelItemMessage').textContent =
            `Cancel "${name}"? Enter a reason below. The supplier will not be notified for a single item.`;
        const modal = document.getElementById('cancelItemModal');
        modal.style.display = 'flex';
    };

    window.closeCancelModal = function () {
        document.getElementById('cancelItemModal').style.display = 'none';
    };

    // Close modal on overlay click
    document.getElementById('cancelItemModal')?.addEventListener('click', function (e) {
        if (e.target === this) closeCancelModal();
    });

    // ─── Cancel entire order ───
    window.submitCancelOrder = async function () {
        const reasonField = document.querySelector('textarea[name="CancellationReason"]');
        if (!reasonField.value.trim()) {
            toast('A cancellation reason is required.', 'warning');
            reasonField.focus();
            return;
        }

        const ok = await confirmModal({
            title: 'Cancel Order',
            message: 'Cancel this order? Any received items will remain in stock.',
            okText: 'Cancel Order'
        });
        if (ok) document.getElementById('cancelOrderForm').submit();
    };
</script>
}