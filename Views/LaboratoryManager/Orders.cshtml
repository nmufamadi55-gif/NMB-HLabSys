@using NMB_HLabSys.Models.ViewModels
@model OrderIndexViewModel
@{
    Layout = "~/Views/Shared/_ManagerLayout.cshtml";
    ViewData["Title"] = "Purchase Orders";
}

<style>
    .tab-panel {
        display: none;
    }

        .tab-panel.active {
            display: block;
        }

    .status-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        padding: 0.2rem 0.65rem;
        border-radius: var(--radius-pill);
        font-size: 0.7rem;
        font-weight: 600;
    }

    .stat-card .stat-info h3 {
        font-variant-numeric: tabular-nums;
    }
</style>

<div class="page-header">
    <div>
        <h2>Purchase Orders</h2>
        <p>Track consumable orders and deliveries</p>
    </div>
    <div class="page-header-actions">
        <a asp-action="CreateOrder" class="btn btn-primary">
            <i class="fas fa-plus"></i> New Order
        </a>
    </div>
</div>

<!-- KPI cards -->
<div class="stats-grid">
    <div class="stat-card">
        <div class="stat-info">
            <h3>@Model.Statistics.TotalOrders</h3>
            <p>Total Orders</p>
        </div>
        <div class="stat-icon"><i class="fas fa-clipboard-list"></i></div>
    </div>
    <div class="stat-card">
        <div class="stat-info">
            <h3 style="color: var(--warning-fg);">@Model.Statistics.PendingOrders</h3>
            <p>Pending</p>
        </div>
        <div class="stat-icon" style="background: var(--warning-bg); color: var(--warning-fg);">
            <i class="fas fa-clock"></i>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-info">
            <h3 style="color: var(--success-fg);">@Model.Statistics.CompletedOrders</h3>
            <p>Completed</p>
        </div>
        <div class="stat-icon" style="background: var(--success-bg); color: var(--success-fg);">
            <i class="fas fa-check-circle"></i>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-info">
            <h3 style="color: var(--danger-fg);">@Model.Statistics.CancelledOrders</h3>
            <p>Cancelled</p>
        </div>
        <div class="stat-icon" style="background: var(--danger-bg); color: var(--danger-fg);">
            <i class="fas fa-ban"></i>
        </div>
    </div>
</div>

<!-- Tabs -->
<div class="tab-nav">
    <button type="button" class="tab-item active" data-tab="all">
        All (@Model.Statistics.TotalOrders)
    </button>
    <button type="button" class="tab-item" data-tab="pending">
        Pending (@Model.Statistics.PendingOrders)
    </button>
    <button type="button" class="tab-item" data-tab="completed">
        Completed (@Model.Statistics.CompletedOrders)
    </button>
    <button type="button" class="tab-item" data-tab="cancelled">
        Cancelled (@Model.Statistics.CancelledOrders)
    </button>
</div>

@* ─── All Orders ─── *@
<div class="tab-panel active" data-panel="all">
    <div class="card">
        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>Order #</th>
                        <th>Supplier</th>
                        <th>Date</th>
                        <th style="text-align:center;">Items</th>
                        <th>Status</th>
                        <th style="text-align:right;">Total</th>
                        <th style="text-align:right;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Orders != null && Model.Orders.Any())
                    {
                        @foreach (var o in Model.Orders)
                        {
                            <tr data-href="@Url.Action("OrderDetails", new { id = o.OrderID })" style="cursor:pointer;">
                                <td><strong>@o.OrderNumber</strong></td>
                                <td>@o.SupplierName</td>
                                <td class="text-sm">@o.OrderDate.ToString("dd MMM yyyy")</td>
                                <td style="text-align:center;">
                                    <span class="text-bold">@o.ItemsReceived</span> / @o.TotalItems
                                </td>
                                <td>
                                    @{
                                        var badge = o.Status switch
                                        {
                                            "Complete" => "badge-success",
                                            "Cancelled" => "badge-danger",
                                            "Partially complete" => "badge-info",
                                            _ => "badge-warning"
                                        };
                                    }
                                    <span class="badge @badge">@o.Status</span>
                                </td>
                                <td style="text-align:right;" class="text-sm">
                                    R@(o.TotalAmount?.ToString("N2") ?? "0.00")
                                </td>
                                <td style="text-align:right;" onclick="event.stopPropagation();">
                                    <a asp-action="OrderDetails" asp-route-id="@o.OrderID"
                                       class="btn btn-sm btn-outline">
                                        <i class="fas fa-eye"></i> View
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7">
                                <div class="empty-state">
                                    <i class="fas fa-clipboard-list"></i>
                                    <h3>No Orders Yet</h3>
                                    <p>Create your first purchase order.</p>
                                    <a asp-action="CreateOrder" class="btn btn-primary">
                                        <i class="fas fa-plus"></i> New Order
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@* ─── Pending ─── *@
<div class="tab-panel" data-panel="pending">
    <div class="card">
        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>Order #</th>
                        <th>Supplier</th>
                        <th>Date</th>
                        <th style="text-align:center;">Items</th>
                        <th>Status</th>
                        <th style="text-align:right;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.PendingOrders != null && Model.PendingOrders.Any())
                    {
                        @foreach (var o in Model.PendingOrders)
                        {
                            var badge = o.Status == "Partially complete" ? "badge-info" : "badge-warning";
                            <tr>
                                <td><strong>@o.OrderNumber</strong></td>
                                <td>@o.SupplierName</td>
                                <td class="text-sm">@o.OrderDate.ToString("dd MMM yyyy")</td>
                                <td style="text-align:center;">
                                    <span class="text-bold">@o.ItemsReceived</span> / @o.TotalItems
                                </td>
                                <td><span class="badge @badge">@o.Status</span></td>
                                <td style="text-align:right;">
                                    <a asp-action="OrderDetails" asp-route-id="@o.OrderID"
                                       class="btn btn-sm btn-outline">
                                        <i class="fas fa-eye"></i> View
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6">
                                <div class="empty-state">
                                    <i class="fas fa-check-circle" style="color: var(--success-fg);"></i>
                                    <h3>All Caught Up</h3>
                                    <p>No pending orders right now.</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@* ─── Completed ─── *@
<div class="tab-panel" data-panel="completed">
    <div class="card">
        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>Order #</th>
                        <th>Supplier</th>
                        <th>Date</th>
                        <th style="text-align:center;">Items</th>
                        <th style="text-align:right;">Total</th>
                        <th style="text-align:right;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.CompletedOrders != null && Model.CompletedOrders.Any())
                    {
                        @foreach (var o in Model.CompletedOrders.Where(x => x.Status == "Complete"))
                        {
                            <tr>
                                <td><strong>@o.OrderNumber</strong></td>
                                <td>@o.SupplierName</td>
                                <td class="text-sm">@o.OrderDate.ToString("dd MMM yyyy")</td>
                                <td style="text-align:center;">@o.TotalItems</td>
                                <td style="text-align:right;" class="text-sm">
                                    R@(o.TotalAmount?.ToString("N2") ?? "0.00")
                                </td>
                                <td style="text-align:right;">
                                    <a asp-action="OrderDetails" asp-route-id="@o.OrderID"
                                       class="btn btn-sm btn-outline">
                                        <i class="fas fa-eye"></i> View
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6">
                                <div class="empty-state">
                                    <i class="fas fa-inbox"></i>
                                    <h3>No Completed Orders</h3>
                                    <p>Orders appear here once all items are received.</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@* ─── Cancelled ─── *@
<div class="tab-panel" data-panel="cancelled">
    <div class="card">
        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>Order #</th>
                        <th>Supplier</th>
                        <th>Date</th>
                        <th style="text-align:center;">Items</th>
                        <th style="text-align:right;">Total</th>
                        <th style="text-align:right;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var cancelled = Model.Orders?
                            .Where(o => string.Equals(o.Status, "Cancelled", StringComparison.OrdinalIgnoreCase))
                            .ToList() ?? new List<OrderListViewModel>();
                    }
                    @if (cancelled.Any())
                    {
                        @foreach (var o in cancelled)
                        {
                            <tr>
                                <td><strong>@o.OrderNumber</strong></td>
                                <td>@o.SupplierName</td>
                                <td class="text-sm">@o.OrderDate.ToString("dd MMM yyyy")</td>
                                <td style="text-align:center;">@o.TotalItems</td>
                                <td style="text-align:right;" class="text-sm">
                                    R@(o.TotalAmount?.ToString("N2") ?? "0.00")
                                </td>
                                <td style="text-align:right;">
                                    <a asp-action="OrderDetails" asp-route-id="@o.OrderID"
                                       class="btn btn-sm btn-outline">
                                        <i class="fas fa-eye"></i> View
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6">
                                <div class="empty-state">
                                    <i class="fas fa-ban"></i>
                                    <h3>No Cancelled Orders</h3>
                                    <p>Cancelled orders would appear here.</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            document.querySelectorAll('.tab-item').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    const target = this.dataset.tab;
                    document.querySelectorAll('.tab-item').forEach(b => b.classList.remove('active'));
                    document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
                    this.classList.add('active');
                    document.querySelector(`.tab-panel[data-panel="${target}"]`).classList.add('active');
                });
            });

            // Row click → details (but skip if clicking a button/link)
            document.querySelectorAll('[data-href]').forEach(row => {
                row.addEventListener('click', function (e) {
                    if (!e.target.closest('a, button, input, form')) {
                        window.location = this.dataset.href;
                    }
                });
            });
        })();
    </script>
}