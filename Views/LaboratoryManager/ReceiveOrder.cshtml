@* @{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Receive Order";
    ViewData["RoleSubtitle"] = "Manager Portal";

    var mgrName = ViewBag.ManagerName as string;
    var initials = "AA";
    if (!string.IsNullOrEmpty(mgrName))
    {
        var parts = mgrName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        initials = string.Concat(parts.Select(p => p[0]));
    }
    ViewData["UserGreeting"] = $"Manager: {mgrName ?? "Amanda Adams"}";
    ViewData["UserInitials"] = initials;
}

@model NMB_HLabSys.Models.ViewModels.ReceiveOrderViewModel
@using NMB_HLabSys.Models.ViewModels

@section SidebarMenu {
    <li><a href="@Url.Action("Dashboard", "Manager")">Overview</a></li>
    <li><a href="@Url.Action("TestCatalogue", "Manager")">Test Catalogue</a></li>
    <li><a href="@Url.Action("StockManagement", "Manager")" class="active">Stock and Orders</a></li>
    <li><a href="@Url.Action("StaffManagement", "Manager")">Staff Management</a></li>
    <li><a href="@Url.Action("Reports", "Manager")">Reports</a></li>
    <li><a href="@Url.Action("Settings", "Manager")">Settings</a></li>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<div class="card-modern" style="max-width: 800px; margin: 0 auto;">
    <div class="card-header-flex">
        <h3>Receive Order: @Model.OrderNumber</h3>
        <a href="@Url.Action("ViewOrder", "Manager")" class="btn-outline-lab">Back to Orders</a>
    </div>

    <div class="order-summary">
        <div class="summary-item">
            <span class="summary-label">Supplier</span>
            <span class="summary-value">@Model.SupplierName</span>
        </div>
        <div class="summary-item">
            <span class="summary-label">Order Number</span>
            <span class="summary-value">@Model.OrderNumber</span>
        </div>
    </div>

    <form asp-action="ReceiveOrder" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="OrderID" />
        <input type="hidden" asp-for="OrderNumber" />
        <input type="hidden" asp-for="SupplierName" />

        <div class="form-group" style="margin-bottom: 1.5rem;">
            <label>
                <input type="checkbox" id="receiveAll" onchange="toggleAllItems()" /> Receive All Items
            </label>
            <small class="text-muted">Check this to receive all items in this order</small>
        </div>

        @if (Model.Items != null && Model.Items.Any())
        {
            <div class="table-container">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Receive</th>
                            <th>Item</th>
                            <th>Quantity Ordered</th>
                            <th>Quantity Received</th>
                            <th>Remaining</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.Items.Count; i++)
                        {
                            var item = Model.Items[i];
                            <tr>
                                <td>
                                    <input type="checkbox" name="Items[@i].IsSelected" value="true"
                                    @(item.IsSelected ? "checked" : "")
                                           data-order-item-id="@item.OrderItemID"
                                           class="item-checkbox"
                                           onchange="updateItemSelection(@i)" />
                                    <input type="hidden" name="Items[@i].OrderItemID" value="@item.OrderItemID" />
                                    <input type="hidden" name="Items[@i].ConsumableID" value="@item.ConsumableID" />
                                    <input type="hidden" name="Items[@i].ConsumableName" value="@item.ConsumableName" />
                                    <input type="hidden" name="Items[@i].QuantityOrdered" value="@item.QuantityOrdered" />
                                    <input type="hidden" name="Items[@i].QuantityReceived" value="@item.QuantityReceived" />
                                </td>
                                <td>@item.ConsumableName</td>
                                <td>@item.QuantityOrdered</td>
                                <td>@item.QuantityReceived</td>
                                <td>@item.QuantityRemaining</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="form-actions">
                <a href="@Url.Action("ViewOrder", "Manager")" class="btn-outline-lab">Cancel</a>
                <button type="submit" class="btn-sm-lab">Confirm Receipt</button>
            </div>
        }
        else
        {
            <p style="color: #5A6E7A; text-align:center; padding: 1rem;">No items in this order</p>
            <a href="@Url.Action("ViewOrder", "Manager")" class="btn-outline-lab">Back to Orders</a>
        }
    </form>
</div>

<script>
    function toggleAllItems() {
        var receiveAll = document.getElementById('receiveAll').checked;
        var checkboxes = document.querySelectorAll('.item-checkbox');
        checkboxes.forEach(function(cb) {
            cb.checked = receiveAll;
        });
    }

    function updateItemSelection(index) {
        var checkboxes = document.querySelectorAll('.item-checkbox');
        var allChecked = true;
        checkboxes.forEach(function(cb) {
            if (!cb.checked) {
                allChecked = false;
            }
        });
        document.getElementById('receiveAll').checked = allChecked;
    }
</script>

<style>
    .card-modern {
        background: white;
        border-radius: 16px;
        padding: 1.5rem;
        margin-bottom: 1.5rem;
        border: 1px solid #E2E8F0;
        box-shadow: 0 2px 8px rgba(0,0,0,0.04);
    }

    .card-header-flex {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid #E2E8F0;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

        .card-header-flex h3 {
            color: #032C7D;
            margin: 0;
            font-size: 1.2rem;
        }

    .order-summary {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
        padding: 1rem;
        background: #F8FAFE;
        border-radius: 10px;
        margin-bottom: 1.5rem;
        border: 1px solid #E2E8F0;
    }

    .summary-item {
        display: flex;
        flex-direction: column;
    }

    .summary-label {
        font-size: 0.7rem;
        color: #5A6E7A;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .summary-value {
        font-size: 0.9rem;
        font-weight: 500;
        color: #032C7D;
        margin-top: 0.1rem;
    }

    .table-container {
        overflow-x: auto;
    }

    .data-table {
        width: 100%;
        border-collapse: collapse;
    }

        .data-table th, .data-table td {
            padding: 0.6rem 0.4rem;
            text-align: left;
            border-bottom: 1px solid #E2E8F0;
            font-size: 0.8rem;
        }

        .data-table th {
            background: #F8FAFE;
            font-weight: 600;
            color: #5A6E7A;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .data-table td:first-child {
            text-align: center;
        }

        .data-table input[type="checkbox"] {
            width: 18px;
            height: 18px;
            cursor: pointer;
            accent-color: #0841C9;
        }

    .form-group {
        margin-bottom: 0.8rem;
    }

        .form-group label {
            display: block;
            font-size: 0.85rem;
            font-weight: 500;
            color: #032C7D;
        }

    .text-muted {
        color: #5A6E7A;
        font-size: 0.7rem;
        display: block;
        margin-top: 0.2rem;
    }

    .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 1rem;
        margin-top: 1.5rem;
        padding-top: 1.5rem;
        border-top: 1px solid #E2E8F0;
    }

    .btn-sm-lab {
        background: linear-gradient(135deg, #0841C9, #1D97F1);
        color: white;
        border: none;
        padding: 0.6rem 1.5rem;
        border-radius: 30px;
        cursor: pointer;
        font-size: 0.85rem;
        font-family: 'Inter', sans-serif;
        transition: all 0.2s;
    }

        .btn-sm-lab:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(8,65,201,0.3);
        }

    .btn-outline-lab {
        background: transparent;
        color: #032C7D;
        border: 1px solid #E2E8F0;
        padding: 0.6rem 1.5rem;
        border-radius: 30px;
        cursor: pointer;
        font-size: 0.85rem;
        font-family: 'Inter', sans-serif;
        transition: all 0.2s;
        text-decoration: none;
        display: inline-block;
    }

        .btn-outline-lab:hover {
            background: #F8FAFE;
            text-decoration: none;
            color: #032C7D;
        }

    .alert {
        padding: 0.8rem 1rem;
        border-radius: 10px;
        font-size: 0.85rem;
        margin-bottom: 1.2rem;
    }

    .alert-danger {
        background: #FEE2E2;
        color: #991B1B;
        border-left: 4px solid #EF4444;
    }

    @@media (max-width: 768px) {
        .order-summary {
            grid-template-columns: 1fr;
        }

        .card-header-flex {
            flex-direction: column;
            align-items: flex-start;
        }

        .form-actions {
            flex-direction: column;
        }

            .form-actions button, .form-actions a {
                width: 100%;
                justify-content: center;
                text-align: center;
            }
    }
</style> *@