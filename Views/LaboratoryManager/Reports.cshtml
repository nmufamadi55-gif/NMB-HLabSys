@using NMB_HLabSys.Models.ViewModels
@model ReportFilterViewModel
@{
    Layout = "~/Views/Shared/_ManagerLayout.cshtml";
    ViewData["Title"] = "Reports";
}

<style>
    .report-hero {
        background: linear-gradient(135deg, var(--brand-900) 0%, var(--brand-700) 100%);
        color: white;
        border-radius: var(--radius-lg);
        padding: 1.5rem 1.75rem;
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
        gap: 1.5rem;
        flex-wrap: wrap;
    }

    .report-hero-icon {
        width: 56px;
        height: 56px;
        border-radius: var(--radius-md);
        background: rgba(255,255,255,0.15);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        flex-shrink: 0;
    }

    .report-hero-text {
        flex: 1;
        min-width: 220px;
    }

        .report-hero-text h2 {
            margin: 0 0 0.2rem;
            font-size: 1.3rem;
            font-weight: 700;
        }

        .report-hero-text p {
            margin: 0;
            font-size: 0.85rem;
            opacity: 0.85;
        }

    .charts-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    @@media (max-width: 900px) {
        .charts-grid {
            grid-template-columns: 1fr;
        }
    }

    .chart-card {
        background: white;
        border: 1px solid var(--gray-200);
        border-radius: var(--radius-lg);
        padding: 1.25rem;
    }

        .chart-card h3 {
            margin: 0 0 1rem;
            font-size: 0.9rem;
            font-weight: 600;
            color: var(--gray-900);
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

            .chart-card h3 i {
                color: var(--brand-700);
            }

    .chart-wrap {
        position: relative;
        height: 260px;
    }

    .report-card {
        background: white;
        border: 1px solid var(--gray-200);
        border-radius: var(--radius-lg);
        padding: 1.5rem;
        position: relative;
        display: flex;
        flex-direction: column;
    }

        .report-card .report-icon {
            width: 42px;
            height: 42px;
            border-radius: var(--radius-md);
            background: var(--brand-50);
            color: var(--brand-700);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
            margin-bottom: 0.85rem;
        }

        .report-card h3 {
            margin: 0 0 0.35rem;
            font-size: 1rem;
            font-weight: 600;
            color: var(--gray-900);
        }

        .report-card p {
            margin: 0 0 1.25rem;
            font-size: 0.82rem;
            color: var(--gray-500);
            line-height: 1.45;
        }

        .report-card.coming-soon {
            opacity: 0.65;
        }

            .report-card.coming-soon::after {
                content: 'Coming Soon';
                position: absolute;
                top: 1rem;
                right: 1rem;
                font-size: 0.65rem;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 0.08em;
                padding: 0.2rem 0.6rem;
                background: var(--warning-bg);
                color: var(--warning-fg);
                border-radius: var(--radius-pill);
            }

    .report-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 1rem;
    }
</style>

<div class="report-hero">
    <div class="report-hero-icon"><i class="fas fa-chart-line"></i></div>
    <div class="report-hero-text">
        <h2>Reports &amp; Analytics</h2>
        <p>Live stats and downloadable PDF reports for lab operations</p>
    </div>
</div>

@if (!ViewData.ModelState.IsValid && ViewData.ModelState.Values.Any(v => v.Errors.Any()))
{
    <div class="alert alert-danger">
        <i class="fas fa-exclamation-circle"></i>
        <div>
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <div>@error.ErrorMessage</div>
            }
        </div>
    </div>
}

<!-- ═══════════════════════════════════════════════════════ -->
<!-- LIVE CHARTS                                             -->
<!-- ═══════════════════════════════════════════════════════ -->
<div class="charts-grid">
    <div class="chart-card">
        <h3><i class="fas fa-vial"></i> Tests Completed — Last 6 Months</h3>
        <div class="chart-wrap">
            <canvas id="testsChart"></canvas>
        </div>
    </div>

    <div class="chart-card">
        <h3><i class="fas fa-clipboard-list"></i> Orders Placed — Last 6 Months</h3>
        <div class="chart-wrap">
            <canvas id="ordersChart"></canvas>
        </div>
    </div>

    <div class="chart-card">
        <h3><i class="fas fa-tags"></i> Tests by Category</h3>
        <div class="chart-wrap">
            <canvas id="categoryChart"></canvas>
        </div>
    </div>

    <div class="chart-card">
        <h3><i class="fas fa-boxes-stacked"></i> Stock Status</h3>
        <div class="chart-wrap">
            <canvas id="stockChart"></canvas>
        </div>
    </div>
</div>

<!-- ═══════════════════════════════════════════════════════ -->
<!-- PDF REPORTS                                            -->
<!-- ═══════════════════════════════════════════════════════ -->
<h3 style="font-size: 1rem; font-weight: 600; margin: 0 0 1rem;">PDF Reports</h3>

<div class="report-grid">
    <div class="report-card">
        <div class="report-icon"><i class="fas fa-vial"></i></div>
        <h3>Tests by Category</h3>
        <p>Total completed tests grouped by category for a chosen date range.</p>
        <form method="post" asp-action="GenerateCategoryReport" style="margin-top:auto;">
            @Html.AntiForgeryToken()
            <div class="form-row-2">
                <div class="form-group">
                    <label>Start <span class="required">*</span></label>
                    <input asp-for="StartDate" type="date" class="form-control" required />
                </div>
                <div class="form-group">
                    <label>End <span class="required">*</span></label>
                    <input asp-for="EndDate" type="date" class="form-control" required />
                </div>
            </div>
            <button type="submit" class="btn btn-primary" style="width: 100%;">
                <i class="fas fa-file-pdf"></i> Generate PDF
            </button>
        </form>
    </div>

    <div class="report-card coming-soon">
        <div class="report-icon"><i class="fas fa-boxes-stacked"></i></div>
        <h3>Stock Report</h3>
        <p>Inventory snapshot with current levels, values and low-stock indicators.</p>
        <button type="button" class="btn btn-outline" disabled style="margin-top:auto;">
            <i class="fas fa-file-pdf"></i> Generate PDF
        </button>
    </div>

    <div class="report-card coming-soon">
        <div class="report-icon"><i class="fas fa-users-gear"></i></div>
        <h3>Staff Performance</h3>
        <p>Tests completed per technician, grouped by category over a date range.</p>
        <button type="button" class="btn btn-outline" disabled style="margin-top:auto;">
            <i class="fas fa-file-pdf"></i> Generate PDF
        </button>
    </div>

    <div class="report-card coming-soon">
        <div class="report-icon"><i class="fas fa-clipboard-list"></i></div>
        <h3>Purchase Orders</h3>
        <p>Summary of orders placed, fulfilled and cancelled in a date range.</p>
        <button type="button" class="btn btn-outline" disabled style="margin-top:auto;">
            <i class="fas fa-file-pdf"></i> Generate PDF
        </button>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        (function () {
            fetch('@Url.Action("ChartData", "LaboratoryManager")')
                .then(r => r.json())
                .then(data => {
                    const brandBlue = '#0841C9';
                    const brandBlueAlpha = 'rgba(8, 65, 201, 0.15)';
                    const palette = ['#0841C9', '#1D97F1', '#F59E0B', '#10B981', '#EF4444',
                        '#8B5CF6', '#EC4899', '#06B6D4'];

                    const gridOpts = {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: {
                            y: { beginAtZero: true, ticks: { precision: 0, color: '#64748B' }, grid: { color: '#E2E8F0' } },
                            x: { ticks: { color: '#64748B' }, grid: { display: false } }
                        }
                    };

                    // ─── Tests per month (line) ───
                    new Chart(document.getElementById('testsChart'), {
                        type: 'line',
                        data: {
                            labels: data.monthlyLabels,
                            datasets: [{
                                data: data.testsCompletedByMonth,
                                borderColor: brandBlue,
                                backgroundColor: brandBlueAlpha,
                                fill: true,
                                tension: 0.3,
                                pointBackgroundColor: brandBlue,
                                pointRadius: 4
                            }]
                        },
                        options: gridOpts
                    });

                    // ─── Orders per month (bar) ───
                    new Chart(document.getElementById('ordersChart'), {
                        type: 'bar',
                        data: {
                            labels: data.monthlyLabels,
                            datasets: [{
                                data: data.ordersByMonth,
                                backgroundColor: '#1D97F1',
                                borderRadius: 6
                            }]
                        },
                        options: gridOpts
                    });

                    // ─── Tests by category (doughnut) ───
                    new Chart(document.getElementById('categoryChart'), {
                        type: 'doughnut',
                        data: {
                            labels: data.testsByCategory.map(x => x.label),
                            datasets: [{
                                data: data.testsByCategory.map(x => x.value),
                                backgroundColor: palette,
                                borderWidth: 2,
                                borderColor: 'white'
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: {
                                    position: 'right',
                                    labels: { font: { size: 11 }, color: '#334155', padding: 10, boxWidth: 12 }
                                }
                            }
                        }
                    });

                    // ─── Stock status (pie) ───
                    const stockColors = {
                        'Critical': '#EF4444',
                        'Low': '#F59E0B',
                        'Near Reorder': '#3B82F6',
                        'Normal': '#10B981'
                    };
                    new Chart(document.getElementById('stockChart'), {
                        type: 'pie',
                        data: {
                            labels: data.stockByStatus.map(x => x.label),
                            datasets: [{
                                data: data.stockByStatus.map(x => x.value),
                                backgroundColor: data.stockByStatus.map(x => stockColors[x.label] || '#94A3B8'),
                                borderWidth: 2,
                                borderColor: 'white'
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: {
                                    position: 'right',
                                    labels: { font: { size: 11 }, color: '#334155', padding: 10, boxWidth: 12 }
                                }
                            }
                        }
                    });
                })
                .catch(err => console.error('Chart data failed to load', err));
        })();
    </script>
}