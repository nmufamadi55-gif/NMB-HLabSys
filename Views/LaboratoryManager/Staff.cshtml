@using NMB_HLabSys.Models.ViewModels
@model StaffManagementIndexViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Staff Management";
    ViewData["RoleSubtitle"] = "Laboratory Manager";
    ViewData["UserGreeting"] = "Manage lab staff";
    ViewData["UserInitials"] = "LM";
}

@section SidebarMenu {
    <li><a href="@Url.Action("Index", "LaboratoryManager")"><i class="fas fa-chart-pie"></i> <span>Dashboard</span></a></li>
    <li><a href="@Url.Action("TestCatalogue", "LaboratoryManager")"><i class="fas fa-vial"></i> <span>Test Catalogue</span></a></li>
    <li><a href="@Url.Action("Stock", "LaboratoryManager")"><i class="fas fa-boxes"></i> <span>Stock Management</span></a></li>
    <li><a href="@Url.Action("Suppliers", "LaboratoryManager")"><i class="fas fa-truck"></i> <span>Suppliers</span></a></li>
    <li><a href="@Url.Action("Orders", "LaboratoryManager")"><i class="fas fa-shopping-cart"></i> <span>Purchase Orders</span></a></li>
    <li><a href="@Url.Action("Staff", "LaboratoryManager")" class="active"><i class="fas fa-user-md"></i> <span>Staff Management</span></a></li>
    <li><a href="@Url.Action("Reports", "LaboratoryManager")"><i class="fas fa-file-alt"></i> <span>Reports</span></a></li>
    <li><a href="@Url.Action("Index", "Profile")"><i class="fas fa-user-circle"></i> <span>My Profile</span></a></li>
}

<style>... table styles, stat boxes ...</style>

<div class="stats-grid">
    <div class="stat-box"><h4>@Model.Statistics.TotalTechnicians</h4><p>Technicians</p></div>
    <div class="stat-box"><h4>@Model.Statistics.ActiveTechnicians</h4><p>Active Technicians</p></div>
    <div class="stat-box"><h4>@Model.Statistics.TotalDoctors</h4><p>Doctors</p></div>
    <div class="stat-box"><h4>@Model.Statistics.ActiveDoctors</h4><p>Active Doctors</p></div>
</div>

<div class="card">
    <div class="card-header">
        <h3><i class="fas fa-user-md"></i> Lab Technicians</h3>
        <div>
            <button class="btn-sm" onclick="location.href='@Url.Action("AddTechnician")'"><i class="fas fa-plus"></i> Add Technician</button>
        </div>
    </div>
    <div class="table-container">
        <table>
            <thead><tr><th>Name</th><th>Employee #</th><th>SA ID</th><th>Specialization</th><th>Assigned Tests</th><th>Status</th><th>Actions</th></tr></thead>
            <tbody>
                @foreach (var t in Model.Technicians)
                {
                    <tr>
                        <td><strong>@t.FullName</strong></td>
                        <td>@t.EmployeeNumber</td>
                        <td>@t.SAIDNumber</td>
                        <td>@t.Specialization</td>
                        <td>@t.AssignedTestsCount</td>
                        <td><span class="badge @(t.IsActive ? "badge-success" : "badge-danger")">@(t.IsActive ? "Active" : "Inactive")</span></td>
                        <td>
                            <button class="btn-outline-sm" onclick="location.href='@Url.Action("TechnicianProfile", new { id = t.TechnicianID })'"><i class="fas fa-user"></i></button>
                            <button class="btn-outline-sm" onclick="location.href='@Url.Action("EditTechnician", new { id = t.TechnicianID })'"><i class="fas fa-edit"></i></button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h3><i class="fas fa-user-md"></i> Doctors</h3>
        <div>
            <button class="btn-sm" onclick="location.href='@Url.Action("AddDoctor")'"><i class="fas fa-plus"></i> Add Doctor</button>
        </div>
    </div>
    <div class="table-container">
        <table>
            <thead><tr><th>Name</th><th>HPCSA</th><th>Email</th><th>Practice</th><th>Verified</th><th>Actions</th></tr></thead>
            <tbody>
                @foreach (var d in Model.Doctors)
                {
                    <tr>
                        <td><strong>@d.FullName</strong></td>
                        <td>@d.HPCSANumber</td>
                        <td>@d.Email</td>
                        <td>@d.PracticeName</td>
                        <td><span class="badge @(d.IsVerified ? "badge-success" : "badge-warning")">@(d.IsVerified ? "Verified" : "Pending")</span></td>
                        <td>
                            <button class="btn-outline-sm" onclick="location.href='@Url.Action("EditDoctor", new { id = d.DoctorID })'"><i class="fas fa-edit"></i></button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>