@using NMB_HLabSys.Models.ViewModels
@model StaffManagementIndexViewModel
@{
    Layout = "~/Views/Shared/_ManagerLayout.cshtml";
    ViewData["Title"] = "Staff Management";
}

<style>
    .tab-panel {
        display: none;
    }

        .tab-panel.active {
            display: block;
        }

    .staff-cell {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .staff-avatar {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: var(--brand-gradient);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.75rem;
        font-weight: 700;
        flex-shrink: 0;
    }

    .staff-info {
        display: flex;
        flex-direction: column;
        gap: 0.1rem;
    }

    .staff-name {
        font-weight: 600;
        color: var(--gray-900);
        font-size: 0.85rem;
    }

    .staff-sub {
        font-size: 0.72rem;
        color: var(--gray-500);
    }

    .filter-bar {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        align-items: center;
        padding: 0.75rem 1rem;
        background: white;
        border: 1px solid var(--gray-200);
        border-radius: var(--radius-md);
        margin-bottom: 1rem;
    }

        .filter-bar .search {
            flex: 1;
            min-width: 220px;
            max-width: 360px;
            position: relative;
        }

            .filter-bar .search input {
                width: 100%;
                padding-left: 2rem;
            }

            .filter-bar .search i {
                position: absolute;
                left: 0.75rem;
                top: 50%;
                transform: translateY(-50%);
                color: var(--gray-400);
                font-size: 0.85rem;
            }

    .row-actions {
        display: flex;
        gap: 0.35rem;
        justify-content: flex-end;
    }
</style>

<div class="page-header">
    <div>
        <h2>Staff Management</h2>
        <p>Manage lab technicians and doctors</p>
    </div>
    <div class="page-header-actions">
        <a asp-action="AddTechnician" class="btn btn-primary">
            <i class="fas fa-user-plus"></i> Add Technician
        </a>
        <a asp-action="AddDoctor" class="btn btn-outline">
            <i class="fas fa-user-md"></i> Add Doctor
        </a>
    </div>
</div>

<!-- KPIs -->
<div class="stats-grid">
    <div class="stat-card">
        <div class="stat-info">
            <h3>@Model.Statistics.TotalTechnicians</h3>
            <p>Total Technicians</p>
        </div>
        <div class="stat-icon"><i class="fas fa-flask"></i></div>
    </div>
    <div class="stat-card">
        <div class="stat-info">
            <h3 style="color: var(--success-fg);">@Model.Statistics.ActiveTechnicians</h3>
            <p>Active Technicians</p>
        </div>
        <div class="stat-icon" style="background: var(--success-bg); color: var(--success-fg);">
            <i class="fas fa-user-check"></i>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-info">
            <h3>@Model.Statistics.TotalDoctors</h3>
            <p>Total Doctors</p>
        </div>
        <div class="stat-icon"><i class="fas fa-user-md"></i></div>
    </div>
    <div class="stat-card">
        <div class="stat-info">
            <h3 style="color: var(--success-fg);">@Model.Statistics.ActiveDoctors</h3>
            <p>Verified Doctors</p>
        </div>
        <div class="stat-icon" style="background: var(--success-bg); color: var(--success-fg);">
            <i class="fas fa-certificate"></i>
        </div>
    </div>
</div>

<!-- Tabs -->
<div class="tab-nav">
    <button type="button" class="tab-item active" data-tab="tech">
        Technicians (@(Model.Technicians?.Count ?? 0))
    </button>
    <button type="button" class="tab-item" data-tab="doctors">
        Doctors (@(Model.Doctors?.Count ?? 0))
    </button>
</div>

@* ─── Technicians ─── *@
<div class="tab-panel active" data-panel="tech">
    <div class="filter-bar">
        <div class="search">
            <i class="fas fa-search"></i>
            <input type="text" id="techSearch" class="form-control"
                   placeholder="Search name, employee # or email..." />
        </div>
    </div>

    <div class="card">
        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Employee #</th>
                        <th>SA ID</th>
                        <th>Specialization</th>
                        <th style="text-align:center;">Assigned Tests</th>
                        <th>Status</th>
                        <th style="text-align:right;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Technicians != null && Model.Technicians.Any())
                    {
                        @foreach (var t in Model.Technicians)
                        {
                            var initials = string.Concat(
                                (t.FullName ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries)
                                    .Take(2).Select(p => p.Length > 0 ? p[0].ToString() : "")
                            ).ToUpper();

                            <tr class="tech-row"
                                data-name="@t.FullName?.ToLower()"
                                data-emp="@t.EmployeeNumber?.ToLower()"
                                data-email="@t.Email?.ToLower()">
                                <td>
                                    <div class="staff-cell">
                                        <div class="staff-avatar">@(string.IsNullOrEmpty(initials) ? "T" : initials)</div>
                                        <div class="staff-info">
                                            <span class="staff-name">@t.FullName</span>
                                            <span class="staff-sub">@t.Email</span>
                                        </div>
                                    </div>
                                </td>
                                <td class="text-sm">@t.EmployeeNumber</td>
                                <td class="text-sm text-muted">@t.SAIDNumber</td>
                                <td class="text-sm">@t.Specialization</td>
                                <td style="text-align:center;">
                                    @if (t.AssignedTestsCount > 0)
                                    {
                                        <span class="badge badge-info">@t.AssignedTestsCount</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-danger" title="No tests assigned">0</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge @(t.IsActive ? "badge-success" : "badge-muted")">
                                        @(t.IsActive ? "Active" : "Inactive")
                                    </span>
                                </td>
                                <td>
                                    <div class="row-actions">
                                        <a asp-action="TechnicianProfile" asp-route-id="@t.TechnicianID"
                                           class="btn-icon" title="View Profile">
                                            <i class="fas fa-user"></i>
                                        </a>
                                        <a asp-action="EditTechnician" asp-route-id="@t.TechnicianID"
                                           class="btn-icon" title="Edit">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <button type="button" class="btn-icon" title="Deactivate"
                                                style="color: var(--danger-fg);"
                                                onclick="confirmDeleteTech('@t.TechnicianID', '@t.FullName')">
                                            <i class="fas fa-user-slash"></i>
                                        </button>
                                        <form id="delTech_@t.TechnicianID"
                                              asp-action="DeleteTechnician" method="post"
                                              style="display:none;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@t.TechnicianID" />
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7">
                                <div class="empty-state">
                                    <i class="fas fa-flask"></i>
                                    <h3>No Technicians Yet</h3>
                                    <p>Add your first lab technician.</p>
                                    <a asp-action="AddTechnician" class="btn btn-primary">
                                        <i class="fas fa-user-plus"></i> Add Technician
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@* ─── Doctors ─── *@
<div class="tab-panel" data-panel="doctors">
    <div class="filter-bar">
        <div class="search">
            <i class="fas fa-search"></i>
            <input type="text" id="doctorSearch" class="form-control"
                   placeholder="Search name, HPCSA # or email..." />
        </div>
    </div>

    <div class="card">
        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>HPCSA #</th>
                        <th>Email</th>
                        <th>Practice</th>
                        <th>Verification</th>
                        <th style="text-align:right;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Doctors != null && Model.Doctors.Any())
                    {
                        @foreach (var d in Model.Doctors)
                        {
                            var initials = string.Concat(
                                (d.FullName ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries)
                                    .Take(2).Select(p => p.Length > 0 ? p[0].ToString() : "")
                            ).ToUpper();

                            <tr class="doctor-row"
                                data-name="@d.FullName?.ToLower()"
                                data-hpcsa="@d.HPCSANumber?.ToLower()"
                                data-email="@d.Email?.ToLower()">
                                <td>
                                    <div class="staff-cell">
                                        <div class="staff-avatar" style="background: linear-gradient(135deg, #0EA5E9, #06B6D4);">
                                            @(string.IsNullOrEmpty(initials) ? "DR" : initials)
                                        </div>
                                        <div class="staff-info">
                                            <span class="staff-name">@d.FullName</span>
                                            <span class="staff-sub">@d.Specialization</span>
                                        </div>
                                    </div>
                                </td>
                                <td class="text-sm">@d.HPCSANumber</td>
                                <td class="text-sm">
                                    <a href="mailto:@d.Email">@d.Email</a>
                                </td>
                                <td class="text-sm">@d.PracticeName</td>
                                <td>
                                    <span class="badge @(d.IsVerified ? "badge-success" : "badge-warning")">
                                        @(d.IsVerified ? "Verified" : "Pending")
                                    </span>
                                </td>
                                <td>
                                    <div class="row-actions">
                                        <a asp-action="EditDoctor" asp-route-id="@d.DoctorID"
                                           class="btn-icon" title="Edit">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <button type="button" class="btn-icon" title="Deactivate"
                                                style="color: var(--danger-fg);"
                                                onclick="confirmDeleteDoctor('@d.DoctorID', '@d.FullName')">
                                            <i class="fas fa-user-slash"></i>
                                        </button>
                                        <form id="delDoctor_@d.DoctorID"
                                              asp-action="DeleteDoctor" method="post"
                                              style="display:none;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@d.DoctorID" />
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6">
                                <div class="empty-state">
                                    <i class="fas fa-user-md"></i>
                                    <h3>No Doctors Yet</h3>
                                    <p>Add your first doctor.</p>
                                    <a asp-action="AddDoctor" class="btn btn-primary">
                                        <i class="fas fa-user-plus"></i> Add Doctor
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Tabs
        document.querySelectorAll('.tab-item').forEach(btn => {
            btn.addEventListener('click', function () {
                const target = this.dataset.tab;
                document.querySelectorAll('.tab-item').forEach(b => b.classList.remove('active'));
                document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
                this.classList.add('active');
                document.querySelector(`.tab-panel[data-panel="${target}"]`).classList.add('active');
            });
        });

        // Technician search
        const techSearch = document.getElementById('techSearch');
        const techRows = Array.from(document.querySelectorAll('.tech-row'));
        techSearch?.addEventListener('input', function () {
            const term = this.value.toLowerCase().trim();
            techRows.forEach(r => {
                const n = r.dataset.name || '';
                const e = r.dataset.emp || '';
                const m = r.dataset.email || '';
                r.style.display = (!term || n.includes(term) || e.includes(term) || m.includes(term)) ? '' : 'none';
            });
        });

        // Doctor search
        const docSearch = document.getElementById('doctorSearch');
        const docRows = Array.from(document.querySelectorAll('.doctor-row'));
        docSearch?.addEventListener('input', function () {
            const term = this.value.toLowerCase().trim();
            docRows.forEach(r => {
                const n = r.dataset.name || '';
                const h = r.dataset.hpcsa || '';
                const m = r.dataset.email || '';
                r.style.display = (!term || n.includes(term) || h.includes(term) || m.includes(term)) ? '' : 'none';
            });
        });

        // Confirm deletes
        window.confirmDeleteTech = async function (id, name) {
            const ok = await confirmModal({
                title: 'Deactivate Technician',
                message: `Deactivate "${name}"? They will no longer be able to log in or perform tests.`,
                okText: 'Deactivate'
            });
            if (ok) document.getElementById(`delTech_${id}`).submit();
        };
        window.confirmDeleteDoctor = async function (id, name) {
            const ok = await confirmModal({
                title: 'Deactivate Doctor',
                message: `Deactivate "${name}"? They will no longer be able to submit test requests.`,
                okText: 'Deactivate'
            });
            if (ok) document.getElementById(`delDoctor_${id}`).submit();
        };
    </script>
}