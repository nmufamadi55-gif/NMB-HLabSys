@using NMB_HLabSys.Models.ViewModels
@model StockManagementIndexViewModel
@{
    Layout = "~/Views/Shared/_ManagerLayout.cshtml";
    ViewData["Title"] = "Stock Management";
}

<style>
    .filter-bar {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        align-items: center;
        padding: 0.75rem 1rem;
        background: white;
        border: 1px solid var(--gray-200);
        border-radius: var(--radius-md);
        margin-bottom: 1rem;
    }

        .filter-bar .search {
            flex: 1;
            min-width: 200px;
            max-width: 340px;
            position: relative;
        }

            .filter-bar .search input {
                width: 100%;
                padding-left: 2rem;
            }

            .filter-bar .search i {
                position: absolute;
                left: 0.75rem;
                top: 50%;
                transform: translateY(-50%);
                color: var(--gray-400);
                font-size: 0.85rem;
            }

    .filter-chip {
        padding: 0.35rem 0.85rem;
        border-radius: var(--radius-pill);
        background: var(--gray-100);
        color: var(--gray-700);
        font-size: 0.75rem;
        font-weight: 500;
        border: none;
        cursor: pointer;
        transition: all 0.15s;
    }

        .filter-chip:hover {
            background: var(--brand-50);
            color: var(--brand-700);
        }

        .filter-chip.active {
            background: var(--brand-gradient);
            color: white;
        }

    .stock-qty {
        font-variant-numeric: tabular-nums;
        font-weight: 600;
    }

        .stock-qty.critical {
            color: var(--danger-fg);
        }

        .stock-qty.low {
            color: var(--warning-fg);
        }

        .stock-qty.normal {
            color: var(--gray-900);
        }

    .row-actions {
        display: flex;
        gap: 0.35rem;
        justify-content: flex-end;
    }
</style>

<div class="page-header">
    <div>
        <h2>Stock Management</h2>
        <p>Track consumable inventory and stock levels</p>
    </div>
    <div class="page-header-actions">
        <a asp-action="CreateConsumable" class="btn btn-primary">
            <i class="fas fa-plus"></i> New Consumable
        </a>
    </div>
</div>

<!-- KPI cards -->
<div class="stats-grid">
    <div class="stat-card">
        <div class="stat-info">
            <h3>@(Model.Consumables?.Count ?? 0)</h3>
            <p>Total Items</p>
        </div>
        <div class="stat-icon"><i class="fas fa-boxes-stacked"></i></div>
    </div>
    <div class="stat-card">
        <div class="stat-info">
            <h3 style="color: var(--danger-fg);">@Model.LowStockSummary.CriticalCount</h3>
            <p>Critical (Out of Stock)</p>
        </div>
        <div class="stat-icon" style="background: var(--danger-bg); color: var(--danger-fg);">
            <i class="fas fa-triangle-exclamation"></i>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-info">
            <h3 style="color: var(--warning-fg);">@Model.LowStockSummary.WarningCount</h3>
            <p>At or Below Reorder</p>
        </div>
        <div class="stat-icon" style="background: var(--warning-bg); color: var(--warning-fg);">
            <i class="fas fa-circle-exclamation"></i>
        </div>
    </div>
</div>

<!-- Filter bar -->
<div class="filter-bar">
    <div class="search">
        <i class="fas fa-search"></i>
        <input type="text" id="stockSearch" class="form-control" placeholder="Search consumable or supplier..." />
    </div>
    <button type="button" class="filter-chip active" data-status="all">All</button>
    <button type="button" class="filter-chip" data-status="Critical">Critical</button>
    <button type="button" class="filter-chip" data-status="Low">Low</button>
    <button type="button" class="filter-chip" data-status="Warning">Near Reorder</button>
    <button type="button" class="filter-chip" data-status="Normal">Normal</button>
</div>

<div class="card">
    <div class="table-container">
        <table id="stockTable">
            <thead>
                <tr>
                    <th>Consumable</th>
                    <th>Supplier</th>
                    <th style="text-align:right;">On Hand</th>
                    <th style="text-align:right;">Reorder Level</th>
                    <th>Status</th>
                    <th>Unit</th>
                    <th style="text-align:right;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Consumables != null && Model.Consumables.Any())
                {
                    @foreach (var item in Model.Consumables)
                    {
                        var statusKey = item.StockStatus; // Critical | Low | Warning/Near Reorder | Normal
                        var displayStatus = statusKey == "Warning" ? "Near Reorder" : statusKey;
                        var badgeClass = statusKey == "Critical" ? "badge-danger"
                                       : statusKey == "Low" ? "badge-warning"
                                       : statusKey == "Warning" ? "badge-info"
                                       : "badge-success";
                        var qtyClass = statusKey == "Critical" ? "critical"
                                     : statusKey == "Low" ? "low"
                                     : "normal";

                        <tr class="stock-row"
                            data-name="@item.ConsumableName?.ToLower()"
                            data-supplier="@item.SupplierName?.ToLower()"
                            data-status="@statusKey">
                            <td>
                                <strong>@item.ConsumableName</strong>
                                @if (!string.IsNullOrWhiteSpace(item.StorageLocation))
                                {
                                    <div class="text-xs text-muted">@item.StorageLocation</div>
                                }
                            </td>
                            <td class="text-sm">@item.SupplierName</td>
                            <td style="text-align:right;">
                                <span class="stock-qty @qtyClass">@item.QuantityOnHand</span>
                            </td>
                            <td style="text-align:right;" class="text-sm text-muted">@item.ReorderLevel</td>
                            <td>
                                <span class="badge @badgeClass">@displayStatus</span>
                            </td>
                            <td class="text-sm">@item.UnitOfMeasure</td>
                            <td>
                                <div class="row-actions">
                                    <a asp-action="AdjustStock" asp-route-id="@item.ConsumableID"
                                       class="btn-icon" title="Adjust Stock">
                                        <i class="fas fa-scale-balanced"></i>
                                    </a>
                                    <a asp-action="EditConsumable" asp-route-id="@item.ConsumableID"
                                       class="btn-icon" title="Edit">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <button type="button" class="btn-icon"
                                            title="Delete"
                                            style="color: var(--danger-fg);"
                                            onclick="confirmDeleteConsumable('@item.ConsumableID', '@item.ConsumableName')">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                    <form id="delCons_@item.ConsumableID"
                                          asp-action="DeleteConsumable" method="post"
                                          style="display:none;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.ConsumableID" />
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7">
                            <div class="empty-state">
                                <i class="fas fa-boxes-stacked"></i>
                                <h3>No Consumables Yet</h3>
                                <p>Add your first consumable to start tracking inventory.</p>
                                <a asp-action="CreateConsumable" class="btn btn-primary">
                                    <i class="fas fa-plus"></i> New Consumable
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <div id="noResults" class="empty-state" style="display:none;">
            <i class="fas fa-search"></i>
            <h3>No Matches</h3>
            <p>Try adjusting your search or filter.</p>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const searchInput = document.getElementById('stockSearch');
            const chips = document.querySelectorAll('.filter-chip');
            const rows = Array.from(document.querySelectorAll('.stock-row'));
            const noResults = document.getElementById('noResults');
            let activeStatus = 'all';

            function applyFilters() {
                const term = (searchInput.value || '').toLowerCase().trim();
                let visible = 0;

                rows.forEach(row => {
                    const name = row.dataset.name || '';
                    const supplier = row.dataset.supplier || '';
                    const status = row.dataset.status || '';

                    const matchesSearch = !term || name.includes(term) || supplier.includes(term);
                    const matchesStatus = activeStatus === 'all' || status === activeStatus;

                    const show = matchesSearch && matchesStatus;
                    row.style.display = show ? '' : 'none';
                    if (show) visible++;
                });

                noResults.style.display = (visible === 0 && rows.length > 0) ? '' : 'none';
            }

            searchInput.addEventListener('input', applyFilters);
            chips.forEach(chip => {
                chip.addEventListener('click', function () {
                    chips.forEach(c => c.classList.remove('active'));
                    this.classList.add('active');
                    activeStatus = this.dataset.status;
                    applyFilters();
                });
            });

            window.confirmDeleteConsumable = async function (id, name) {
                const ok = await confirmModal({
                    title: 'Delete Consumable',
                    message: `Delete "${name}"? This only succeeds if it isn't used by any test or live order.`,
                    okText: 'Delete'
                });
                if (ok) document.getElementById(`delCons_${id}`).submit();
            };
        })();
    </script>
}