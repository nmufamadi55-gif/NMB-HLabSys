@using NMB_HLabSys.Models.ViewModels
@model StockManagementIndexViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Stock Management";
    ViewData["RoleSubtitle"] = "Laboratory Manager";
    ViewData["UserGreeting"] = "Manage consumable inventory";
    ViewData["UserInitials"] = "LM";
}

@section SidebarMenu {
    <li><a href="@Url.Action("Index", "LaboratoryManager")"><i class="fas fa-chart-pie"></i> <span>Dashboard</span></a></li>
    <li><a href="@Url.Action("TestCatalogue", "LaboratoryManager")"><i class="fas fa-vial"></i> <span>Test Catalogue</span></a></li>
    <li><a href="@Url.Action("Stock", "LaboratoryManager")" class="active"><i class="fas fa-boxes"></i> <span>Stock Management</span></a></li>
    <li><a href="@Url.Action("Suppliers", "LaboratoryManager")"><i class="fas fa-truck"></i> <span>Suppliers</span></a></li>
    <li><a href="@Url.Action("Orders", "LaboratoryManager")"><i class="fas fa-shopping-cart"></i> <span>Purchase Orders</span></a></li>
    <li><a href="@Url.Action("Staff", "LaboratoryManager")"><i class="fas fa-user-md"></i> <span>Staff Management</span></a></li>
    <li><a href="@Url.Action("Reports", "LaboratoryManager")"><i class="fas fa-file-alt"></i> <span>Reports</span></a></li>
    <li><a href="@Url.Action("Index", "Profile")"><i class="fas fa-user-circle"></i> <span>My Profile</span></a></li>
}

<style>
    .card {
        background: white;
        border-radius: 16px;
        padding: 1rem;
        margin-bottom: 1rem;
        border: 1px solid #E2E8F0;
    }

    .card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 0.8rem;
        flex-wrap: wrap;
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    th, td {
        padding: 0.5rem 0.3rem;
        text-align: left;
        border-bottom: 1px solid #E2E8F0;
        font-size: 0.8rem;
    }

    th {
        background: #F8FAFE;
        font-weight: 600;
        color: #5A6E7A;
    }

    .btn-sm {
        background: #0841C9;
        color: white;
        border: none;
        padding: 0.3rem 0.8rem;
        border-radius: 30px;
        cursor: pointer;
        font-size: 0.7rem;
    }

        .btn-sm:hover {
            background: #032C7D;
        }

    .btn-outline-sm {
        background: transparent;
        border: 1px solid #E2E8F0;
        padding: 0.3rem 0.8rem;
        border-radius: 30px;
        cursor: pointer;
        font-size: 0.7rem;
    }

    .btn-success-sm {
        background: #10B981;
        color: white;
        border: none;
        padding: 0.3rem 0.8rem;
        border-radius: 30px;
        cursor: pointer;
        font-size: 0.7rem;
    }

    .badge {
        display: inline-block;
        padding: 0.15rem 0.5rem;
        border-radius: 30px;
        font-size: 0.7rem;
        font-weight: 600;
    }

    .badge-success {
        background: #D4EDDA;
        color: #155724;
    }

    .badge-danger {
        background: #F8D7DA;
        color: #721C24;
    }

    .badge-warning {
        background: #FFF3CD;
        color: #856404;
    }

    .badge-info {
        background: #CDE8FF;
        color: #004085;
    }

    .action-bar {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
        margin-bottom: 1rem;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        gap: 1rem;
        margin-bottom: 1rem;
    }

    .stat-box {
        background: white;
        border-radius: 16px;
        padding: 0.8rem;
        border: 1px solid #E2E8F0;
        text-align: center;
    }

        .stat-box h4 {
            font-size: 1.4rem;
            margin: 0;
            color: #032C7D;
        }

        .stat-box p {
            margin: 0;
            font-size: 0.7rem;
            color: #5A6E7A;
        }
</style>

<div class="stats-grid">
    <div class="stat-box"><h4>@Model.Consumables.Count</h4><p>Total Consumables</p></div>
    <div class="stat-box"><h4 style="color:#DC2626;">@Model.LowStockSummary.CriticalCount</h4><p>Critical Stock</p></div>
    <div class="stat-box"><h4 style="color:#D97706;">@Model.LowStockSummary.WarningCount</h4><p>Warning Level</p></div>
</div>

<div class="card">
    <div class="card-header">
        <h3><i class="fas fa-boxes"></i> Consumable Inventory</h3>
        <div>
            <button class="btn-sm" onclick="location.href='@Url.Action("CreateConsumable")'"><i class="fas fa-plus"></i> Add Consumable</button>
        </div>
    </div>
    <div class="table-container">
        <table>
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Supplier</th>
                    <th>Qty On Hand</th>
                    <th>Reorder Level</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Consumables)
                {
                    var statusClass = item.StockStatus == "Critical" ? "badge-danger" :
                    item.StockStatus == "Low" ? "badge-warning" :
                    item.StockStatus == "Warning" ? "badge-info" : "badge-success";
                    <tr>
                        <td><strong>@item.ConsumableName</strong></td>
                        <td>@item.SupplierName</td>
                        <td>@item.QuantityOnHand</td>
                        <td>@item.ReorderLevel</td>
                        <td><span class="badge @statusClass">@item.StockStatus</span></td>
                        <td>
                            <button class="btn-outline-sm" onclick="location.href='@Url.Action("EditConsumable", new { id = item.ConsumableID })'"><i class="fas fa-edit"></i></button>
                            <button class="btn-outline-sm" onclick="location.href='@Url.Action("AdjustStock", new { id = item.ConsumableID })'"><i class="fas fa-balance-scale"></i></button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>