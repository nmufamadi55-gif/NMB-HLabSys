@using NMB_HLabSys.Models.ViewModels
@model SupplierDetailsViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Supplier Details";
    ViewData["RoleSubtitle"] = "Laboratory Manager";
    ViewData["UserGreeting"] = "Supplier information";
    ViewData["UserInitials"] = "LM";
}

@section SidebarMenu {
    <li><a href="@Url.Action("Index", "LaboratoryManager")"><i class="fas fa-chart-pie"></i> <span>Dashboard</span></a></li>
    <li><a href="@Url.Action("TestCatalogue", "LaboratoryManager")"><i class="fas fa-vial"></i> <span>Test Catalogue</span></a></li>
    <li><a href="@Url.Action("Stock", "LaboratoryManager")"><i class="fas fa-boxes"></i> <span>Stock Management</span></a></li>
    <li><a href="@Url.Action("Suppliers", "LaboratoryManager")" class="active"><i class="fas fa-truck"></i> <span>Suppliers</span></a></li>
    <li><a href="@Url.Action("Orders", "LaboratoryManager")"><i class="fas fa-shopping-cart"></i> <span>Purchase Orders</span></a></li>
    <li><a href="@Url.Action("Staff", "LaboratoryManager")"><i class="fas fa-user-md"></i> <span>Staff Management</span></a></li>
    <li><a href="@Url.Action("Reports", "LaboratoryManager")"><i class="fas fa-file-alt"></i> <span>Reports</span></a></li>
}

<style>
    .page-header {
        background: linear-gradient(135deg, #032C7D 0%, #0841C9 100%);
        border-radius: 20px;
        padding: 1.2rem 1.8rem;
        margin-bottom: 1.5rem;
        color: white;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
    }

        .page-header h2 {
            font-size: 1.3rem;
            margin: 0;
            color: white;
        }

        .page-header p {
            font-size: 0.8rem;
            margin: 0.2rem 0 0 0;
            opacity: 0.9;
        }

        .page-header .breadcrumb-back {
            background: rgba(255,255,255,0.2);
            color: white;
            padding: 0.3rem 0.9rem;
            border-radius: 40px;
            text-decoration: none;
            font-size: 0.75rem;
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
        }

            .page-header .breadcrumb-back:hover {
                background: rgba(255,255,255,0.3);
            }

    .card {
        background: white;
        border-radius: 16px;
        padding: 1.5rem;
        border: 1px solid #E2E8F0;
        margin-bottom: 1rem;
    }

        .card h3 {
            font-size: 1rem;
            color: #032C7D;
            margin: 0 0 1rem 0;
            font-weight: 600;
            padding-bottom: 0.5rem;
            border-bottom: 1px solid #E2E8F0;
        }

    .info-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.8rem 1.5rem;
    }

    .info-item {
        padding: 0.5rem 0;
    }

    .info-label {
        font-size: 0.75rem;
        font-weight: 600;
        color: #5A6E7A;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        display: block;
    }

    .info-value {
        font-size: 0.9rem;
        color: #1A2C3A;
        margin-top: 0.15rem;
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    th, td {
        padding: 0.7rem 0.5rem;
        text-align: left;
        border-bottom: 1px solid #E2E8F0;
        font-size: 0.8rem;
    }

    th {
        background: #F8FAFE;
        font-weight: 600;
        color: #5A6E7A;
        text-transform: uppercase;
        font-size: 0.7rem;
        letter-spacing: 0.03em;
    }

    tr:hover {
        background: #F8FAFE;
    }

    .btn-sm {
        background: linear-gradient(135deg, #0841C9, #1D97F1);
        color: white;
        border: none;
        padding: 0.5rem 1.2rem;
        border-radius: 40px;
        cursor: pointer;
        font-size: 0.8rem;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
    }

        .btn-sm:hover {
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(8,65,201,0.25);
            color: white;
        }

    .badge {
        display: inline-block;
        padding: 0.2rem 0.6rem;
        border-radius: 40px;
        font-size: 0.7rem;
        font-weight: 600;
    }

    .badge-success {
        background: #D4EDDA;
        color: #155724;
    }

    .badge-danger {
        background: #F8D7DA;
        color: #721C24;
    }

    @@media (max-width: 768px) {
        .info-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="page-header">
    <div>
        <h2><i class="fas fa-truck"></i> @Model.SupplierName</h2>
        <p>Supplier details and consumables</p>
    </div>
    <div style="display:flex; gap:0.5rem; flex-wrap:wrap;">
        <a href="@Url.Action("EditSupplier", new { id = Model.SupplierID })" class="breadcrumb-back">
            <i class="fas fa-edit"></i> Edit Supplier
        </a>
        <a href="@Url.Action("Suppliers")" class="breadcrumb-back">
            <i class="fas fa-arrow-left"></i> Back to Suppliers
        </a>
    </div>
</div>

<div class="card">
    <h3><i class="fas fa-info-circle"></i> Supplier Information</h3>
    <div class="info-grid">
        <div class="info-item"><span class="info-label">Contact Person</span><span class="info-value">@Model.ContactPerson</span></div>
        <div class="info-item"><span class="info-label">Email</span><span class="info-value">@Model.EmailAddress</span></div>
        <div class="info-item"><span class="info-label">Phone</span><span class="info-value">@Model.PhoneNumber</span></div>
        <div class="info-item"><span class="info-label">Address</span><span class="info-value">@Model.Address</span></div>
        <div class="info-item"><span class="info-label">Preferred</span><span class="info-value">@(Model.IsPreferred ? "Yes ⭐" : "No")</span></div>
        <div class="info-item">
            <span class="info-label">Active</span><span class="info-value">
                <span class="badge @(Model.IsActive ? "badge-success" : "badge-danger")">@(Model.IsActive ? "Active" : "Inactive")</span>
            </span>
        </div>
        <div class="info-item"><span class="info-label">Total Consumables</span><span class="info-value">@Model.ConsumableCount</span></div>
        <div class="info-item"><span class="info-label">Created</span><span class="info-value">@Model.CreatedAt.ToString("dd MMM yyyy")</span></div>
    </div>
</div>

<div class="card">
    <h3><i class="fas fa-boxes"></i> Consumables Supplied</h3>
    @if (Model.Consumables != null && Model.Consumables.Any())
    {
        <table>
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Qty On Hand</th>
                    <th>Reorder Level</th>
                    <th>Unit</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model.Consumables)
                {
                    <tr>
                        <td>@c.ConsumableName</td>
                        <td>@c.QuantityOnHand</td>
                        <td>@c.ReorderLevel</td>
                        <td>@c.UnitOfMeasure</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p style="color:#5A6E7A; font-size:0.85rem;">No consumables supplied by this supplier yet.</p>
    }
</div>