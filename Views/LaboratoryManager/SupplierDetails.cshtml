@using NMB_HLabSys.Models.ViewModels
@model SupplierDetailsViewModel
@{
    Layout = "~/Views/Shared/_ManagerLayout.cshtml";
    ViewData["Title"] = "Supplier Details";
}

<style>
    .info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 1.25rem 1.5rem;
    }

    .info-item .label {
        font-size: 0.7rem;
        font-weight: 600;
        color: var(--gray-500);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 0.25rem;
        display: block;
    }

    .info-item .value {
        font-size: 0.9rem;
        color: var(--gray-900);
    }

        .info-item .value a {
            color: var(--brand-700);
        }
</style>

<div class="page-header">
    <div>
        <h2>@Model.SupplierName</h2>
        <p>
            Supplier details
            @if (Model.IsPreferred)
            {
                <span class="badge badge-success" style="margin-left: 0.5rem;">
                    <i class="fas fa-star"></i> Preferred
                </span>
            }
            @if (!Model.IsActive)
            {
                <span class="badge badge-muted" style="margin-left: 0.5rem;">Inactive</span>
            }
        </p>
    </div>
    <div class="page-header-actions">
        <a asp-action="EditSupplier" asp-route-id="@Model.SupplierID" class="btn btn-primary">
            <i class="fas fa-edit"></i> Edit
        </a>
        <a asp-action="Suppliers" class="btn btn-outline">
            <i class="fas fa-arrow-left"></i> Back
        </a>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h3><i class="fas fa-address-card"></i> Contact Information</h3>
    </div>
    <div class="info-grid">
        <div class="info-item">
            <span class="label">Contact Person</span>
            <div class="value">@Model.ContactPerson</div>
        </div>
        <div class="info-item">
            <span class="label">Email</span>
            <div class="value">
                <a href="mailto:@Model.EmailAddress">@Model.EmailAddress</a>
            </div>
        </div>
        <div class="info-item">
            <span class="label">Phone</span>
            <div class="value">@Model.PhoneNumber</div>
        </div>
        <div class="info-item" style="grid-column: 1 / -1;">
            <span class="label">Address</span>
            <div class="value">@Model.Address</div>
        </div>
        <div class="info-item">
            <span class="label">Added On</span>
            <div class="value">@Model.CreatedAt.ToString("dd MMM yyyy")</div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h3><i class="fas fa-boxes-stacked"></i> Consumables Supplied (@Model.ConsumableCount)</h3>
    </div>

    @if (Model.Consumables != null && Model.Consumables.Any())
    {
        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>Consumable</th>
                        <th style="text-align:right;">On Hand</th>
                        <th style="text-align:right;">Reorder Level</th>
                        <th>Unit</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model.Consumables)
                    {
                        var isCritical = c.QuantityOnHand <= 0;
                        var isLow = !isCritical && c.QuantityOnHand <= c.ReorderLevel;

                        <tr>
                            <td><strong>@c.ConsumableName</strong></td>
                            <td style="text-align:right; font-variant-numeric: tabular-nums;">
                                <span style="font-weight:600; color: @(isCritical ? "var(--danger-fg)" : isLow ? "var(--warning-fg)" : "var(--gray-900)");">
                                    @c.QuantityOnHand
                                </span>
                            </td>
                            <td style="text-align:right;" class="text-sm text-muted">@c.ReorderLevel</td>
                            <td class="text-sm">@c.UnitOfMeasure</td>
                            <td>
                                @if (isCritical)
                                {
                                    <span class="badge badge-danger">Critical</span>
                                }
                                else if (isLow)
                                {
                                    <span class="badge badge-warning">Low</span>
                                }
                                else
                                {
                                    <span class="badge badge-success">Normal</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">
            <i class="fas fa-boxes-stacked"></i>
            <h3>No Consumables</h3>
            <p>This supplier has no consumables linked yet.</p>
            <a asp-action="CreateConsumable" class="btn btn-primary">
                <i class="fas fa-plus"></i> Add Consumable
            </a>
        </div>
    }
</div>