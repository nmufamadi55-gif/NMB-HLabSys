@using NMB_HLabSys.Models.ViewModels
@model List<SupplierViewModel>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Suppliers";
    ViewData["RoleSubtitle"] = "Laboratory Manager";
    ViewData["UserGreeting"] = "Manage suppliers";
    ViewData["UserInitials"] = "LM";
}

@section SidebarMenu {
    <li><a href="@Url.Action("Index", "LaboratoryManager")"><i class="fas fa-chart-pie"></i> <span>Dashboard</span></a></li>
    <li><a href="@Url.Action("TestCatalogue", "LaboratoryManager")"><i class="fas fa-vial"></i> <span>Test Catalogue</span></a></li>
    <li><a href="@Url.Action("Stock", "LaboratoryManager")"><i class="fas fa-boxes"></i> <span>Stock Management</span></a></li>
    <li><a href="@Url.Action("Suppliers", "LaboratoryManager")" class="active"><i class="fas fa-truck"></i> <span>Suppliers</span></a></li>
    <li><a href="@Url.Action("Orders", "LaboratoryManager")"><i class="fas fa-shopping-cart"></i> <span>Purchase Orders</span></a></li>
    <li><a href="@Url.Action("Staff", "LaboratoryManager")"><i class="fas fa-user-md"></i> <span>Staff Management</span></a></li>
    <li><a href="@Url.Action("Reports", "LaboratoryManager")"><i class="fas fa-file-alt"></i> <span>Reports</span></a></li>
}

<style>
    .page-header {
        background: linear-gradient(135deg, #032C7D 0%, #0841C9 100%);
        border-radius: 20px;
        padding: 1.2rem 1.8rem;
        margin-bottom: 1.5rem;
        color: white;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
    }

        .page-header h2 {
            font-size: 1.3rem;
            margin: 0;
            color: white;
        }

        .page-header p {
            font-size: 0.8rem;
            margin: 0.2rem 0 0 0;
            opacity: 0.9;
        }

    .card {
        background: white;
        border-radius: 16px;
        padding: 1rem;
        margin-bottom: 1rem;
        border: 1px solid #E2E8F0;
    }

    .card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 0.8rem;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

        .card-header h3 {
            font-size: 1rem;
            margin: 0;
            color: #032C7D;
            font-weight: 600;
        }

    .table-container {
        overflow-x: auto;
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    th, td {
        padding: 0.7rem 0.5rem;
        text-align: left;
        border-bottom: 1px solid #E2E8F0;
        font-size: 0.8rem;
    }

    th {
        background: #F8FAFE;
        font-weight: 600;
        color: #5A6E7A;
        text-transform: uppercase;
        font-size: 0.7rem;
        letter-spacing: 0.03em;
    }

    tr:hover {
        background: #F8FAFE;
    }

    .btn-sm {
        background: linear-gradient(135deg, #0841C9, #1D97F1);
        color: white;
        border: none;
        padding: 0.4rem 1rem;
        border-radius: 40px;
        cursor: pointer;
        font-size: 0.75rem;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
    }

        .btn-sm:hover {
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(8,65,201,0.25);
            color: white;
        }

    .btn-outline-sm {
        background: transparent;
        border: 1px solid #E2E8F0;
        padding: 0.4rem 0.8rem;
        border-radius: 40px;
        cursor: pointer;
        font-size: 0.75rem;
        text-decoration: none;
        color: #5A6E7A;
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
    }

        .btn-outline-sm:hover {
            border-color: #0841C9;
            color: #0841C9;
            background: rgba(8,65,201,0.02);
        }

    .badge {
        display: inline-block;
        padding: 0.2rem 0.6rem;
        border-radius: 40px;
        font-size: 0.7rem;
        font-weight: 600;
    }

    .badge-success {
        background: #D4EDDA;
        color: #155724;
    }

    .badge-warning {
        background: #FFF3CD;
        color: #856404;
    }
</style>

<div class="page-header">
    <div>
        <h2><i class="fas fa-truck"></i> Suppliers</h2>
        <p>Manage your supplier directory</p>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h3><i class="fas fa-list"></i> All Suppliers</h3>
        <a href="@Url.Action("CreateSupplier")" class="btn-sm"><i class="fas fa-plus"></i> Add Supplier</a>
    </div>
    <div class="table-container">
        <table>
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Contact Person</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Consumables</th>
                    <th>Preferred</th>
                    <th style="text-align:right;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var s in Model)
                    {
                        <tr>
                            <td><strong>@s.SupplierName</strong></td>
                            <td>@s.ContactPerson</td>
                            <td>@s.EmailAddress</td>
                            <td>@s.PhoneNumber</td>
                            <td>@s.ConsumableCount</td>
                            <td>
                                @if (s.IsPreferred)
                                {
                                    <span class="badge badge-success">⭐ Preferred</span>
                                }
                            </td>
                            <td style="text-align:right;">
                                <a href="@Url.Action("SupplierDetails", new { id = s.SupplierID })" class="btn-outline-sm"><i class="fas fa-info-circle"></i> Details</a>
                                <a href="@Url.Action("EditSupplier", new { id = s.SupplierID })" class="btn-outline-sm"><i class="fas fa-edit"></i> Edit</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" style="text-align:center; padding:2rem; color:#5A6E7A;">
                            <i class="fas fa-inbox" style="font-size:2rem; opacity:0.4;"></i>
                            <p style="margin-top:0.5rem;">No suppliers found. Add your first supplier!</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>