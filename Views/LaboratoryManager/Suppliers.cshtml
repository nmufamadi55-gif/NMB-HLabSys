@using NMB_HLabSys.Models.ViewModels
@model List<SupplierViewModel>
@{
    Layout = "~/Views/Shared/_ManagerLayout.cshtml";
    ViewData["Title"] = "Suppliers";
}

<style>
    .filter-bar {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        align-items: center;
        padding: 0.75rem 1rem;
        background: white;
        border: 1px solid var(--gray-200);
        border-radius: var(--radius-md);
        margin-bottom: 1rem;
    }

        .filter-bar .search {
            flex: 1;
            min-width: 220px;
            max-width: 360px;
            position: relative;
        }

            .filter-bar .search input {
                width: 100%;
                padding-left: 2rem;
            }

            .filter-bar .search i {
                position: absolute;
                left: 0.75rem;
                top: 50%;
                transform: translateY(-50%);
                color: var(--gray-400);
                font-size: 0.85rem;
            }

    .filter-chip {
        padding: 0.35rem 0.85rem;
        border-radius: var(--radius-pill);
        background: var(--gray-100);
        color: var(--gray-700);
        font-size: 0.75rem;
        font-weight: 500;
        border: none;
        cursor: pointer;
        transition: all 0.15s;
    }

        .filter-chip:hover {
            background: var(--brand-50);
            color: var(--brand-700);
        }

        .filter-chip.active {
            background: var(--brand-gradient);
            color: white;
        }

    .supplier-cell {
        display: flex;
        flex-direction: column;
        gap: 0.1rem;
    }

    .supplier-name {
        font-weight: 600;
        color: var(--gray-900);
        font-size: 0.85rem;
    }

    .supplier-sub {
        font-size: 0.72rem;
        color: var(--gray-500);
    }

    .row-actions {
        display: flex;
        gap: 0.35rem;
        justify-content: flex-end;
    }
</style>

<div class="page-header">
    <div>
        <h2>Suppliers</h2>
        <p>Manage the supplier directory</p>
    </div>
    <div class="page-header-actions">
        <a asp-action="CreateSupplier" class="btn btn-primary">
            <i class="fas fa-plus"></i> New Supplier
        </a>
    </div>
</div>

<div class="filter-bar">
    <div class="search">
        <i class="fas fa-search"></i>
        <input type="text" id="supplierSearch" class="form-control"
               placeholder="Search name, contact person or email..." />
    </div>
    <button type="button" class="filter-chip active" data-filter="all">All</button>
    <button type="button" class="filter-chip" data-filter="preferred">Preferred</button>
    <button type="button" class="filter-chip" data-filter="inactive">Inactive</button>
</div>

<div class="card">
    <div class="table-container">
        <table id="supplierTable">
            <thead>
                <tr>
                    <th>Supplier</th>
                    <th>Contact Person</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th style="text-align:center;">Consumables</th>
                    <th>Status</th>
                    <th style="text-align:right;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var s in Model)
                    {
                        var statusKey = !s.IsActive ? "inactive" : s.IsPreferred ? "preferred" : "normal";
                        <tr class="supplier-row"
                            data-name="@s.SupplierName?.ToLower()"
                            data-contact="@s.ContactPerson?.ToLower()"
                            data-email="@s.EmailAddress?.ToLower()"
                            data-flag="@statusKey">
                            <td>
                                <div class="supplier-cell">
                                    <span class="supplier-name">
                                        @s.SupplierName
                                        @if (s.IsPreferred)
                                        {
                                            <i class="fas fa-star" style="color:#F59E0B; font-size:0.7rem; margin-left:0.25rem;" title="Preferred"></i>
                                        }
                                    </span>
                                    @if (!string.IsNullOrWhiteSpace(s.Address))
                                    {
                                        <span class="supplier-sub">@s.Address</span>
                                    }
                                </div>
                            </td>
                            <td class="text-sm">@s.ContactPerson</td>
                            <td class="text-sm">
                                <a href="mailto:@s.EmailAddress">@s.EmailAddress</a>
                            </td>
                            <td class="text-sm">@s.PhoneNumber</td>
                            <td style="text-align:center;">
                                <span class="badge badge-muted">@s.ConsumableCount</span>
                            </td>
                            <td>
                                @if (!s.IsActive)
                                {
                                    <span class="badge badge-muted">Inactive</span>
                                }
                                else if (s.IsPreferred)
                                {
                                    <span class="badge badge-success">Preferred</span>
                                }
                                else
                                {
                                    <span class="badge badge-info">Active</span>
                                }
                            </td>
                            <td>
                                <div class="row-actions">
                                    <a asp-action="SupplierDetails" asp-route-id="@s.SupplierID"
                                       class="btn-icon" title="View Details">
                                        <i class="fas fa-info-circle"></i>
                                    </a>
                                    <a asp-action="EditSupplier" asp-route-id="@s.SupplierID"
                                       class="btn-icon" title="Edit">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <button type="button" class="btn-icon" title="Delete"
                                            style="color: var(--danger-fg);"
                                            onclick="confirmDeleteSupplier('@s.SupplierID', '@s.SupplierName')">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                    <form id="delSupplier_@s.SupplierID"
                                          asp-action="DeleteSupplier" method="post"
                                          style="display:none;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@s.SupplierID" />
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7">
                            <div class="empty-state">
                                <i class="fas fa-truck-field"></i>
                                <h3>No Suppliers Yet</h3>
                                <p>Add your first supplier to start ordering consumables.</p>
                                <a asp-action="CreateSupplier" class="btn btn-primary">
                                    <i class="fas fa-plus"></i> New Supplier
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <div id="noSupplierResults" class="empty-state" style="display:none;">
            <i class="fas fa-search"></i>
            <h3>No Matches</h3>
            <p>Try adjusting your search or filter.</p>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const searchInput = document.getElementById('supplierSearch');
            const chips = document.querySelectorAll('.filter-chip');
            const rows = Array.from(document.querySelectorAll('.supplier-row'));
            const noResults = document.getElementById('noSupplierResults');
            let activeFilter = 'all';

            function applyFilters() {
                const term = (searchInput.value || '').toLowerCase().trim();
                let visible = 0;

                rows.forEach(row => {
                    const n = row.dataset.name || '';
                    const c = row.dataset.contact || '';
                    const e = row.dataset.email || '';
                    const flag = row.dataset.flag || 'normal';

                    const matchesSearch = !term || n.includes(term) || c.includes(term) || e.includes(term);
                    let matchesFilter = true;
                    if (activeFilter === 'preferred') matchesFilter = flag === 'preferred';
                    else if (activeFilter === 'inactive') matchesFilter = flag === 'inactive';

                    const show = matchesSearch && matchesFilter;
                    row.style.display = show ? '' : 'none';
                    if (show) visible++;
                });

                noResults.style.display = (visible === 0 && rows.length > 0) ? '' : 'none';
            }

            searchInput.addEventListener('input', applyFilters);
            chips.forEach(chip => {
                chip.addEventListener('click', function () {
                    chips.forEach(c => c.classList.remove('active'));
                    this.classList.add('active');
                    activeFilter = this.dataset.filter;
                    applyFilters();
                });
            });

            window.confirmDeleteSupplier = async function (id, name) {
                const ok = await confirmModal({
                    title: 'Delete Supplier',
                    message: `Delete "${name}"? This only succeeds if it has no active consumables or live orders.`,
                    okText: 'Delete'
                });
                if (ok) document.getElementById(`delSupplier_${id}`).submit();
            };
        })();
    </script>
}