@using NMB_HLabSys.Models.ViewModels
@model TechnicianProfileViewModel
@{
    Layout = "~/Views/Shared/_ManagerLayout.cshtml";
    ViewData["Title"] = "Technician Profile";
}

<style>
    .profile-hero {
        background: linear-gradient(135deg, var(--brand-900) 0%, var(--brand-700) 100%);
        color: white;
        border-radius: var(--radius-lg);
        padding: 1.5rem 1.75rem;
        margin-bottom: 1rem;
        display: flex;
        align-items: center;
        gap: 1.25rem;
        flex-wrap: wrap;
    }

    .profile-avatar {
        width: 64px;
        height: 64px;
        border-radius: 50%;
        background: rgba(255,255,255,0.2);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        font-weight: 700;
        flex-shrink: 0;
    }

    .profile-hero-text {
        flex: 1;
        min-width: 200px;
    }

        .profile-hero-text h2 {
            margin: 0 0 0.25rem;
            font-size: 1.4rem;
            font-weight: 700;
            letter-spacing: -0.02em;
        }

        .profile-hero-text .subtitle {
            font-size: 0.85rem;
            opacity: 0.85;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            flex-wrap: wrap;
        }

    .profile-hero-actions {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
    }

        .profile-hero-actions .btn {
            background: rgba(255,255,255,0.15);
            color: white;
            border: none;
        }

            .profile-hero-actions .btn:hover {
                background: rgba(255,255,255,0.25);
                color: white;
            }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1.25rem 1.5rem;
    }

    .info-item .label {
        font-size: 0.7rem;
        font-weight: 600;
        color: var(--gray-500);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 0.25rem;
        display: block;
    }

    .info-item .value {
        font-size: 0.9rem;
        color: var(--gray-900);
    }
</style>

@{
    var initials = string.Concat(
        (Model.FullName ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Take(2).Select(p => p.Length > 0 ? p[0].ToString() : "")
    ).ToUpper();
}

<div class="profile-hero">
    <div class="profile-avatar">@(string.IsNullOrEmpty(initials) ? "T" : initials)</div>
    <div class="profile-hero-text">
        <h2>@Model.FullName</h2>
        <div class="subtitle">
            <span><i class="fas fa-id-badge"></i> @Model.EmployeeNumber</span>
            <span>·</span>
            <span>@Model.Specialization</span>
            @if (Model.IsActive)
            {
                <span class="badge badge-success">Active</span>
            }
            else
            {
                <span class="badge badge-muted">Inactive</span>
            }
        </div>
    </div>
    <div class="profile-hero-actions">
        <a asp-action="EditTechnician" asp-route-id="@Model.TechnicianID" class="btn">
            <i class="fas fa-edit"></i> Edit
        </a>
        <a asp-action="Staff" class="btn">
            <i class="fas fa-arrow-left"></i> Back to Staff
        </a>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h3><i class="fas fa-id-card"></i> Personal Information</h3>
    </div>
    <div class="info-grid">
        <div class="info-item">
            <span class="label">SA ID Number</span>
            <div class="value">@Model.SAIDNumber</div>
        </div>
        <div class="info-item">
            <span class="label">Email</span>
            <div class="value">
                <a href="mailto:@Model.Email">@Model.Email</a>
            </div>
        </div>
        <div class="info-item">
            <span class="label">Contact Number</span>
            <div class="value">@Model.ContactNumber</div>
        </div>
        <div class="info-item">
            <span class="label">Hire Date</span>
            <div class="value">@Model.HireDate.ToString("dd MMM yyyy")</div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h3><i class="fas fa-graduation-cap"></i> Professional Details</h3>
    </div>
    <div class="info-grid">
        <div class="info-item">
            <span class="label">Specialization</span>
            <div class="value">@Model.Specialization</div>
        </div>
        <div class="info-item">
            <span class="label">Qualification</span>
            <div class="value">@Model.Qualification</div>
        </div>
        <div class="info-item">
            <span class="label">Years of Experience</span>
            <div class="value">@Model.YearsOfExperience years</div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h3>
            <i class="fas fa-vial"></i> Assigned Test Types
            <span class="badge badge-info">@(Model.AssignedTests?.Count ?? 0)</span>
        </h3>
    </div>

    @if (Model.AssignedTests != null && Model.AssignedTests.Any())
    {
        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>Test Name</th>
                        <th>Category</th>
                        <th>Assigned</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var test in Model.AssignedTests)
                    {
                        <tr>
                            <td><strong>@test.TestName</strong></td>
                            <td class="text-sm">@test.CategoryName</td>
                            <td class="text-sm text-muted">@test.AssignedDate.ToString("dd MMM yyyy")</td>
                            <td>
                                <span class="badge @(test.IsActive ? "badge-success" : "badge-muted")">
                                    @(test.IsActive ? "Active" : "Archived")
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">
            <i class="fas fa-vial"></i>
            <h3>No Tests Assigned</h3>
            <p>This technician cannot perform any tests yet.</p>
            <a asp-action="EditTechnician" asp-route-id="@Model.TechnicianID" class="btn btn-primary">
                <i class="fas fa-edit"></i> Assign Tests
            </a>
        </div>
    }
</div>