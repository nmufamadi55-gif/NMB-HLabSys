@using NMB_HLabSys.Models.ViewModels
@model TechnicianProfileViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Technician Profile";
    ViewData["RoleSubtitle"] = "Laboratory Manager";
    ViewData["UserGreeting"] = "Technician details";
    ViewData["UserInitials"] = "LM";
}

@section SidebarMenu {
    <li><a href="@Url.Action("Index", "LaboratoryManager")"><i class="fas fa-chart-pie"></i> <span>Dashboard</span></a></li>
    <li><a href="@Url.Action("TestCatalogue", "LaboratoryManager")"><i class="fas fa-vial"></i> <span>Test Catalogue</span></a></li>
    <li><a href="@Url.Action("Stock", "LaboratoryManager")"><i class="fas fa-boxes"></i> <span>Stock Management</span></a></li>
    <li><a href="@Url.Action("Suppliers", "LaboratoryManager")"><i class="fas fa-truck"></i> <span>Suppliers</span></a></li>
    <li><a href="@Url.Action("Orders", "LaboratoryManager")"><i class="fas fa-shopping-cart"></i> <span>Purchase Orders</span></a></li>
    <li><a href="@Url.Action("Staff", "LaboratoryManager")" class="active"><i class="fas fa-user-md"></i> <span>Staff Management</span></a></li>
    <li><a href="@Url.Action("Reports", "LaboratoryManager")"><i class="fas fa-file-alt"></i> <span>Reports</span></a></li>
}

<style>
    .page-header {
        background: linear-gradient(135deg, #032C7D 0%, #0841C9 100%);
        border-radius: 20px;
        padding: 1.2rem 1.8rem;
        margin-bottom: 1.5rem;
        color: white;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
    }

        .page-header h2 {
            font-size: 1.3rem;
            margin: 0;
            color: white;
        }

        .page-header p {
            font-size: 0.8rem;
            margin: 0.2rem 0 0 0;
            opacity: 0.9;
        }

        .page-header .breadcrumb-back {
            background: rgba(255,255,255,0.2);
            color: white;
            padding: 0.3rem 0.9rem;
            border-radius: 40px;
            text-decoration: none;
            font-size: 0.75rem;
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
        }

            .page-header .breadcrumb-back:hover {
                background: rgba(255,255,255,0.3);
            }

    .card {
        background: white;
        border-radius: 16px;
        padding: 1.5rem;
        border: 1px solid #E2E8F0;
        margin-bottom: 1rem;
    }

        .card h3 {
            font-size: 1rem;
            color: #032C7D;
            margin: 0 0 1rem 0;
            font-weight: 600;
            padding-bottom: 0.5rem;
            border-bottom: 1px solid #E2E8F0;
        }

    .info-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.8rem 1.5rem;
    }

    .info-item {
        padding: 0.5rem 0;
    }

    .info-label {
        font-size: 0.75rem;
        font-weight: 600;
        color: #5A6E7A;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        display: block;
    }

    .info-value {
        font-size: 0.9rem;
        color: #1A2C3A;
        margin-top: 0.15rem;
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    th, td {
        padding: 0.7rem 0.5rem;
        text-align: left;
        border-bottom: 1px solid #E2E8F0;
        font-size: 0.8rem;
    }

    th {
        background: #F8FAFE;
        font-weight: 600;
        color: #5A6E7A;
        text-transform: uppercase;
        font-size: 0.7rem;
        letter-spacing: 0.03em;
    }

    tr:hover {
        background: #F8FAFE;
    }

    .badge {
        display: inline-block;
        padding: 0.2rem 0.6rem;
        border-radius: 40px;
        font-size: 0.7rem;
        font-weight: 600;
    }

    .badge-success {
        background: #D4EDDA;
        color: #155724;
    }

    .badge-danger {
        background: #F8D7DA;
        color: #721C24;
    }

    @@media (max-width: 768px) {
        .info-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="page-header">
    <div>
        <h2><i class="fas fa-user-circle"></i> @Model.FullName</h2>
        <p>Technician profile and test assignments</p>
    </div>
    <div style="display:flex; gap:0.5rem; flex-wrap:wrap;">
        <a href="@Url.Action("EditTechnician", new { id = Model.TechnicianID })" class="breadcrumb-back">
            <i class="fas fa-edit"></i> Edit
        </a>
        <a href="@Url.Action("Staff")" class="breadcrumb-back">
            <i class="fas fa-arrow-left"></i> Back to Staff
        </a>
    </div>
</div>

<div class="card">
    <h3><i class="fas fa-id-card"></i> Personal Information</h3>
    <div class="info-grid">
        <div class="info-item"><span class="info-label">Employee #</span><span class="info-value">@Model.EmployeeNumber</span></div>
        <div class="info-item"><span class="info-label">SA ID</span><span class="info-value">@Model.SAIDNumber</span></div>
        <div class="info-item"><span class="info-label">Email</span><span class="info-value">@Model.Email</span></div>
        <div class="info-item"><span class="info-label">Phone</span><span class="info-value">@Model.ContactNumber</span></div>
    </div>
</div>

<div class="card">
    <h3><i class="fas fa-graduation-cap"></i> Professional Details</h3>
    <div class="info-grid">
        <div class="info-item"><span class="info-label">Specialization</span><span class="info-value">@Model.Specialization</span></div>
        <div class="info-item"><span class="info-label">Qualification</span><span class="info-value">@Model.Qualification</span></div>
        <div class="info-item"><span class="info-label">Experience</span><span class="info-value">@Model.YearsOfExperience years</span></div>
        <div class="info-item"><span class="info-label">Hire Date</span><span class="info-value">@Model.HireDate.ToString("dd MMM yyyy")</span></div>
        <div class="info-item">
            <span class="info-label">Status</span>
            <span class="info-value">
                <span class="badge @(Model.IsActive ? "badge-success" : "badge-danger")">@(Model.IsActive ? "Active" : "Inactive")</span>
            </span>
        </div>
    </div>
</div>

<div class="card">
    <h3><i class="fas fa-vial"></i> Assigned Test Types</h3>
    @if (Model.AssignedTests != null && Model.AssignedTests.Any())
    {
        <table>
            <thead>
                <tr>
                    <th>Test Name</th>
                    <th>Category</th>
                    <th>Assigned Date</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var test in Model.AssignedTests)
                {
                    <tr>
                        <td>@test.TestName</td>
                        <td>@test.CategoryName</td>
                        <td>@test.AssignedDate.ToString("dd MMM yyyy")</td>
                        <td><span class="badge @(test.IsActive ? "badge-success" : "badge-danger")">@(test.IsActive ? "Active" : "Inactive")</span></td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p style="color:#5A6E7A; font-size:0.85rem;">No test types assigned yet.</p>
    }
</div>