@using NMB_HLabSys.Models.ViewModels
@model TestCatalogueIndexViewModel
@{
    Layout = "~/Views/Shared/_ManagerLayout.cshtml";
    ViewData["Title"] = "Test Catalogue";
}

<style>
    .tab-panel {
        display: none;
    }

        .tab-panel.active {
            display: block;
        }

    .chip-list {
        display: flex;
        flex-wrap: wrap;
        gap: 0.25rem;
    }

    .chip {
        display: inline-flex;
        align-items: center;
        padding: 0.15rem 0.55rem;
        background: var(--brand-50);
        color: var(--brand-700);
        font-size: 0.7rem;
        font-weight: 500;
        border-radius: var(--radius-pill);
    }
</style>

<div class="page-header">
    <div>
        <h2>Test Catalogue</h2>
        <p>Manage test types, categories and sample types</p>
    </div>
    <div class="page-header-actions">
        <a asp-action="CreateTestType" class="btn btn-primary">
            <i class="fas fa-plus"></i> New Test
        </a>
        <a asp-action="CreateCategory" class="btn btn-outline">
            <i class="fas fa-tag"></i> New Category
        </a>
        <a asp-action="CreateSampleType" class="btn btn-outline">
            <i class="fas fa-flask"></i> New Sample Type
        </a>
    </div>
</div>

<div class="tab-nav">
    <button type="button" class="tab-item active" data-tab="tests">
        Test Types (@(Model.TestTypes?.Count ?? 0))
    </button>
    <button type="button" class="tab-item" data-tab="categories">
        Categories (@(Model.Categories?.Count ?? 0))
    </button>
    <button type="button" class="tab-item" data-tab="samples">
        Sample Types (@(Model.SampleTypes?.Count ?? 0))
    </button>
</div>

<!-- ─── Test Types ─── -->
<div class="tab-panel active" data-panel="tests">
    <div class="card">
        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>Test Name</th>
                        <th>Category</th>
                        <th>Sample Type</th>
                        <th>Turnaround</th>
                        <th>Technicians</th>
                        <th>Consumables</th>
                        <th>Status</th>
                        <th style="text-align:right;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.TestTypes != null && Model.TestTypes.Any())
                    {
                        @foreach (var test in Model.TestTypes)
                        {
                            <tr>
                                <td><strong>@test.TestName</strong></td>
                                <td>@test.CategoryName</td>
                                <td>@test.SampleTypeName</td>
                                <td>@test.TurnaroundTimeMinutes min</td>
                                <td>
                                    @if (test.AssignedTechnicians != null && test.AssignedTechnicians.Any())
                                    {
                                        <div class="chip-list">
                                            @foreach (var t in test.AssignedTechnicians.Take(2))
                                            {
                                                <span class="chip">@t</span>
                                            }
                                            @if (test.AssignedTechnicians.Count > 2)
                                            {
                                                <span class="chip">+@(test.AssignedTechnicians.Count - 2)</span>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted text-xs">—</span>
                                    }
                                </td>
                                <td>
                                    <span class="text-sm">@(test.Consumables?.Count ?? 0) linked</span>
                                </td>
                                <td>
                                    <span class="badge @(test.IsActive ? "badge-success" : "badge-muted")">
                                        @(test.IsActive ? "Active" : "Archived")
                                    </span>
                                </td>
                                <td style="text-align:right; white-space:nowrap;">
                                    <a asp-action="EditTestType" asp-route-id="@test.TestID"
                                       class="btn btn-sm btn-outline">
                                        <i class="fas fa-edit"></i> Edit
                                    </a>
                                    <button type="button"
                                            class="btn btn-sm btn-outline"
                                            style="color: var(--danger-fg);"
                                            onclick="confirmDeleteTest('@test.TestID', '@test.TestName')">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                    <form id="deleteTest_@test.TestID"
                                          asp-action="DeleteTestType" method="post"
                                          style="display:none;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@test.TestID" />
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8">
                                <div class="empty-state">
                                    <i class="fas fa-vial"></i>
                                    <h3>No Test Types Yet</h3>
                                    <p>Add your first test to the catalogue.</p>
                                    <a asp-action="CreateTestType" class="btn btn-primary">
                                        <i class="fas fa-plus"></i> New Test
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ─── Categories ─── -->
<div class="tab-panel" data-panel="categories">
    <div class="card">
        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>Category Name</th>
                        <th>Description</th>
                        <th>Tests</th>
                        <th>Status</th>
                        <th style="text-align:right;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Categories != null && Model.Categories.Any())
                    {
                        @foreach (var cat in Model.Categories)
                        {
                            <tr>
                                <td><strong>@cat.CategoryName</strong></td>
                                <td class="text-sm text-muted">@cat.Description</td>
                                <td>@cat.TestCount</td>
                                <td>
                                    <span class="badge @(cat.IsActive ? "badge-success" : "badge-muted")">
                                        @(cat.IsActive ? "Active" : "Archived")
                                    </span>
                                </td>
                                <td style="text-align:right; white-space:nowrap;">
                                    <a asp-action="EditCategory" asp-route-id="@cat.CategoryID"
                                       class="btn btn-sm btn-outline">
                                        <i class="fas fa-edit"></i> Edit
                                    </a>
                                    <button type="button" class="btn btn-sm btn-outline"
                                            style="color: var(--danger-fg);"
                                            onclick="confirmDeleteCategory('@cat.CategoryID', '@cat.CategoryName')">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                    <form id="deleteCat_@cat.CategoryID"
                                          asp-action="DeleteCategory" method="post"
                                          style="display:none;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@cat.CategoryID" />
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5">
                                <div class="empty-state">
                                    <i class="fas fa-tag"></i>
                                    <h3>No Categories</h3>
                                    <p>Create your first test category.</p>
                                    <a asp-action="CreateCategory" class="btn btn-primary">
                                        <i class="fas fa-plus"></i> New Category
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ─── Sample Types ─── -->
<div class="tab-panel" data-panel="samples">
    <div class="card">
        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>Sample Type</th>
                        <th>Description</th>
                        <th>Collection Tube</th>
                        <th>Storage</th>
                        <th style="text-align:right;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.SampleTypes != null && Model.SampleTypes.Any())
                    {
                        @foreach (var st in Model.SampleTypes)
                        {
                            <tr>
                                <td><strong>@st.SampleTypeName</strong></td>
                                <td class="text-sm text-muted">@st.Description</td>
                                <td>@st.CollectionTubeType</td>
                                <td class="text-sm">@st.StorageRequirements</td>
                                <td style="text-align:right; white-space:nowrap;">
                                    <a asp-action="EditSampleType" asp-route-id="@st.SampleTypeID"
                                       class="btn btn-sm btn-outline">
                                        <i class="fas fa-edit"></i> Edit
                                    </a>
                                    <button type="button" class="btn btn-sm btn-outline"
                                            style="color: var(--danger-fg);"
                                            onclick="confirmDeleteSample('@st.SampleTypeID', '@st.SampleTypeName')">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                    <form id="deleteSample_@st.SampleTypeID"
                                          asp-action="DeleteSampleType" method="post"
                                          style="display:none;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@st.SampleTypeID" />
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5">
                                <div class="empty-state">
                                    <i class="fas fa-flask"></i>
                                    <h3>No Sample Types</h3>
                                    <p>Add your first sample type.</p>
                                    <a asp-action="CreateSampleType" class="btn btn-primary">
                                        <i class="fas fa-plus"></i> New Sample Type
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Tab switching
        document.querySelectorAll('.tab-item').forEach(function (btn) {
            btn.addEventListener('click', function () {
                const target = this.dataset.tab;
                document.querySelectorAll('.tab-item').forEach(b => b.classList.remove('active'));
                document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
                this.classList.add('active');
                document.querySelector(`.tab-panel[data-panel="${target}"]`).classList.add('active');
            });
        });

        // Confirm-delete helpers (uses the global confirmModal from manager.js)
        async function confirmDeleteTest(id, name) {
            const ok = await confirmModal({
                title: 'Archive Test Type',
                message: `Archive "${name}"? It will no longer appear in the catalogue.`,
                okText: 'Archive'
            });
            if (ok) document.getElementById(`deleteTest_${id}`).submit();
        }
        async function confirmDeleteCategory(id, name) {
            const ok = await confirmModal({
                title: 'Delete Category',
                message: `Delete category "${name}"? This only succeeds if it has no active tests.`,
                okText: 'Delete'
            });
            if (ok) document.getElementById(`deleteCat_${id}`).submit();
        }
        async function confirmDeleteSample(id, name) {
            const ok = await confirmModal({
                title: 'Delete Sample Type',
                message: `Delete "${name}"? This only succeeds if it's not in use by any active test.`,
                okText: 'Delete'
            });
            if (ok) document.getElementById(`deleteSample_${id}`).submit();
        }
    </script>
}