@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Create Order";
    ViewData["RoleSubtitle"] = "Manager Portal";

    var mgrName = ViewBag.ManagerName as string;
    var initials = "AA";
    if (!string.IsNullOrEmpty(mgrName))
    {
        var parts = mgrName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        initials = string.Concat(parts.Select(p => p[0]));
    }
    ViewData["UserGreeting"] = $"Manager: {mgrName ?? "Amanda Adams"}";
    ViewData["UserInitials"] = initials;
}

@model NMB_HLabSys.Models.ViewModels.CreateOrderViewModel
@using NMB_HLabSys.Models.ViewModels

@section SidebarMenu {
    <li><a href="@Url.Action("Dashboard", "Manager")">Overview</a></li>
    <li><a href="@Url.Action("TestCatalogue", "Manager")">Test Catalogue</a></li>
    <li><a href="@Url.Action("StockManagement", "Manager")" class="active">Stock and Orders</a></li>
    <li><a href="@Url.Action("StaffManagement", "Manager")">Staff Management</a></li>
    <li><a href="@Url.Action("Reports", "Manager")">Reports</a></li>
    <li><a href="@Url.Action("Settings", "Manager")">Settings</a></li>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<div class="card-modern" style="max-width: 800px; margin: 0 auto;">
    <div class="card-header-flex">
        <h3>Create New Order</h3>
        <a href="@Url.Action("ViewOrder", "Manager")" class="btn-outline-lab">Back to Orders</a>
    </div>

    <form asp-action="CreateOrder" method="post">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <div class="grid-2col">
            <div class="form-group">
                <label asp-for="SupplierID">Supplier <span class="required">*</span></label>
                <select asp-for="SupplierID" class="form-control" required>
                    <option value="">-- Select Supplier --</option>
                    @if (Model.AvailableSuppliers != null)
                    {
                        foreach (var supplier in Model.AvailableSuppliers)
                        {
                            <option value="@supplier.Value">@supplier.Text</option>
                        }
                    }
                </select>
                <span asp-validation-for="SupplierID" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ExpectedDeliveryDate">Expected Delivery Date</label>
                <input asp-for="ExpectedDeliveryDate" class="form-control" type="date" />
                <span asp-validation-for="ExpectedDeliveryDate" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group">
            <label>Items to Order</label>
            <div class="table-container">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Select</th>
                            <th>Item</th>
                            <th>Current Stock</th>
                            <th>Reorder Level</th>
                            <th>Suggested Quantity</th>
                            <th>Quantity to Order</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Items != null && Model.Items.Any())
                        {
                            for (int i = 0; i < Model.Items.Count; i++)
                            {
                                var item = Model.Items[i];
                                <tr>
                                    <td>
                                        <input type="checkbox" name="Items[@i].IsSelected" value="true"
                                        @(item.IsSelected ? "checked" : "")
                                               onchange="updateSuggestedQuantity(@i)" />
                                        <input type="hidden" name="Items[@i].ConsumableID" value="@item.ConsumableID" />
                                        <input type="hidden" name="Items[@i].ConsumableName" value="@item.ConsumableName" />
                                        <input type="hidden" name="Items[@i].CurrentStock" value="@item.CurrentStock" />
                                        <input type="hidden" name="Items[@i].ReorderLevel" value="@item.ReorderLevel" />
                                        <input type="hidden" name="Items[@i].SuggestedQuantity" value="@item.SuggestedQuantity" />
                                    </td>
                                    <td>@item.ConsumableName</td>
                                    <td>@item.CurrentStock</td>
                                    <td>@item.ReorderLevel</td>
                                    <td>@item.SuggestedQuantity</td>
                                    <td>
                                        <input type="number" name="Items[@i].QuantityToOrder"
                                               class="form-control quantity-input"
                                               min="1" max="9999"
                                               value="@(item.QuantityToOrder > 0 ? item.QuantityToOrder : item.SuggestedQuantity)"
                                               data-index="@i"
                                               style="width:100px; display:inline-block;" />
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" style="text-align:center; color:#5A6E7A;">No items available to order</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <small class="text-muted">Select items to order and specify quantities. Items near or below reorder level are suggested.</small>
        </div>

        <div class="form-actions">
            <a href="@Url.Action("ViewOrder", "Manager")" class="btn-outline-lab">Cancel</a>
            <button type="submit" class="btn-sm-lab">Create Order</button>
        </div>
    </form>
</div>

<script>
    function updateSuggestedQuantity(index) {
        var checkbox = document.querySelector('input[name="Items[' + index + '].IsSelected"]');
        var qtyInput = document.querySelector('input[name="Items[' + index + '].QuantityToOrder"]');

        if (checkbox.checked) {
            // If checked, populate the suggested quantity if empty
            var suggested = qtyInput.getAttribute('data-suggested') || qtyInput.value;
            if (!qtyInput.value || qtyInput.value === '0') {
                qtyInput.value = suggested || '10';
            }
        } else {
            // If unchecked, clear the quantity
            qtyInput.value = '';
        }
    }

    // Set data-suggested attribute on load
    document.addEventListener('DOMContentLoaded', function() {
        var inputs = document.querySelectorAll('.quantity-input');
        inputs.forEach(function(input) {
            var index = input.getAttribute('data-index');
            var checkbox = document.querySelector('input[name="Items[' + index + '].IsSelected"]');
            var suggested = document.querySelector('input[name="Items[' + index + '].SuggestedQuantity"]');
            if (suggested) {
                input.setAttribute('data-suggested', suggested.value);
            }
            if (checkbox && checkbox.checked && input.value === '') {
                input.value = suggested ? suggested.value : '10';
            }
        });
    });
</script>

<style>
    .card-modern {
        background: white;
        border-radius: 16px;
        padding: 1.5rem;
        margin-bottom: 1.5rem;
        border: 1px solid #E2E8F0;
        box-shadow: 0 2px 8px rgba(0,0,0,0.04);
    }

    .card-header-flex {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid #E2E8F0;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

        .card-header-flex h3 {
            color: #032C7D;
            margin: 0;
            font-size: 1.2rem;
        }

    .grid-2col {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
    }

    .form-group {
        margin-bottom: 0.8rem;
    }

        .form-group label {
            display: block;
            font-size: 0.8rem;
            font-weight: 500;
            color: #032C7D;
            margin-bottom: 0.3rem;
        }

    .required {
        color: #E26D5C;
    }

    .form-control {
        width: 100%;
        padding: 0.6rem 0.8rem;
        border: 1px solid #E2E8F0;
        border-radius: 10px;
        font-size: 0.85rem;
        font-family: 'Inter', sans-serif;
        transition: all 0.2s;
        background: white;
    }

        .form-control:focus {
            outline: none;
            border-color: #0841C9;
            box-shadow: 0 0 0 3px rgba(8,65,201,0.1);
        }

        .form-control.quantity-input {
            width: 100px;
            text-align: center;
        }

    .text-danger {
        color: #991B1B;
        font-size: 0.75rem;
        display: block;
        margin-top: 0.2rem;
    }

    .text-muted {
        color: #5A6E7A;
        font-size: 0.7rem;
        display: block;
        margin-top: 0.2rem;
    }

    .validation-summary {
        background: #FEE2E2;
        color: #991B1B;
        padding: 0.8rem;
        border-radius: 10px;
        font-size: 0.85rem;
        margin-bottom: 1.2rem;
        border-left: 4px solid #EF4444;
    }

    .table-container {
        overflow-x: auto;
    }

    .data-table {
        width: 100%;
        border-collapse: collapse;
    }

        .data-table th, .data-table td {
            padding: 0.6rem 0.4rem;
            text-align: left;
            border-bottom: 1px solid #E2E8F0;
            font-size: 0.8rem;
        }

        .data-table th {
            background: #F8FAFE;
            font-weight: 600;
            color: #5A6E7A;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .data-table td:first-child {
            text-align: center;
        }

        .data-table input[type="checkbox"] {
            width: 18px;
            height: 18px;
            cursor: pointer;
            accent-color: #0841C9;
        }

    .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 1rem;
        margin-top: 1.5rem;
        padding-top: 1.5rem;
        border-top: 1px solid #E2E8F0;
    }

    .btn-sm-lab {
        background: linear-gradient(135deg, #0841C9, #1D97F1);
        color: white;
        border: none;
        padding: 0.6rem 1.5rem;
        border-radius: 30px;
        cursor: pointer;
        font-size: 0.85rem;
        font-family: 'Inter', sans-serif;
        transition: all 0.2s;
    }

        .btn-sm-lab:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(8,65,201,0.3);
        }

    .btn-outline-lab {
        background: transparent;
        color: #032C7D;
        border: 1px solid #E2E8F0;
        padding: 0.6rem 1.5rem;
        border-radius: 30px;
        cursor: pointer;
        font-size: 0.85rem;
        font-family: 'Inter', sans-serif;
        transition: all 0.2s;
        text-decoration: none;
        display: inline-block;
    }

        .btn-outline-lab:hover {
            background: #F8FAFE;
            text-decoration: none;
            color: #032C7D;
        }

    .alert {
        padding: 0.8rem 1rem;
        border-radius: 10px;
        font-size: 0.85rem;
        margin-bottom: 1.2rem;
    }

    .alert-danger {
        background: #FEE2E2;
        color: #991B1B;
        border-left: 4px solid #EF4444;
    }

    @@media (max-width: 768px) {
        .grid-2col {
            grid-template-columns: 1fr;
        }

        .card-header-flex {
            flex-direction: column;
            align-items: flex-start;
        }

        .form-actions {
            flex-direction: column;
        }

            .form-actions button, .form-actions a {
                width: 100%;
                justify-content: center;
                text-align: center;
            }

        .data-table input[type="checkbox"] {
            width: 16px;
            height: 16px;
        }
    }
</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}