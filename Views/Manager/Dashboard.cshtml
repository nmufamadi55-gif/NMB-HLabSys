@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Manager Dashboard";
    ViewData["RoleSubtitle"] = "Manager Portal";
    var name = ViewBag.ManagerName as string ?? "Amanda Adams";
    var initials = "";
    if (!string.IsNullOrEmpty(name))
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        initials = string.Join("", parts.Select(p => p[0]));
    }
    ViewData["UserInitials"] = string.IsNullOrEmpty(initials) ? "AA" : initials;
}

@model NMB_HLabSys.Models.ViewModels.DashboardViewModel

@section SidebarMenu {
    <li><a href="@Url.Action("Dashboard", "Manager")" class="active"><i class="fas fa-chart-pie"></i> <span>Overview</span></a></li>
    <li><a href="@Url.Action("TestCatalogue", "Manager")"><i class="fas fa-flask"></i> <span>Test Catalogue</span></a></li>
    <li><a href="@Url.Action("StockManagement", "Manager")"><i class="fas fa-boxes"></i> <span>Stock & Orders</span></a></li>
    <li><a href="@Url.Action("Suppliers", "Manager")">Suppliers</a></li>
    <li><a href="@Url.Action("StaffManagement", "Manager")"><i class="fas fa-users-cog"></i> <span>Staff Management</span></a></li>
    <li><a href="@Url.Action("Reports", "Manager")"><i class="fas fa-file-alt"></i> <span>Reports</span></a></li>
    <li><a href="@Url.Action("Settings", "Manager")"><i class="fas fa-cog"></i> <span>Settings</span></a></li>
}

<!-- Low Stock Alert Modal -->
<div id="lowStockModal" class="modal-overlay" style="display:none;">
    <div class="modal-card" style="max-width:500px;">
        <h3>⚠️ Low Stock Items</h3>
        <div class="low-stock-list" id="lowStockList">
            <!-- Populated by JavaScript from Model data -->
        </div>
        <div class="modal-actions">
            <button class="btn-outline-lab" onclick="closeLowStockModal()">Close</button>
            <button class="btn-sm-lab" onclick="orderAllLowStock()">Order All</button>
        </div>
    </div>
</div>

<!-- Create Order Modal -->
<div id="quickOrderModal" class="modal-overlay" style="display:none;">
    <div class="modal-card" style="max-width:600px;">
        <h3>📦 Create Stock Order</h3>
        <form id="quickOrderForm" method="post" action="@Url.Action("CreateOrder", "Manager")">
            <div class="form-group">
                <label>Supplier</label>
                <select name="SupplierID" class="form-control">
                    <!-- Populated by server-side -->
                </select>
            </div>
            <div class="form-group">
                <label>Expected Delivery Date</label>
                <input type="date" name="ExpectedDeliveryDate" class="form-control" />
            </div>
            <div class="form-group">
                <label>Items to Order</label>
                <div id="quickOrderItems">
                    <!-- Populated by JavaScript -->
                </div>
            </div>
            <div class="modal-actions">
                <button type="button" class="btn-outline-lab" onclick="closeQuickOrderModal()">Cancel</button>
                <button type="submit" class="btn-sm-lab">Submit Order</button>
            </div>
        </form>
    </div>
</div>

<!-- Order Details Modal -->
<div id="orderDetailsModal" class="modal-overlay" style="display:none;">
    <div class="modal-card" style="max-width:600px;">
        <h3 id="orderDetailsTitle">Order Details</h3>
        <div id="orderDetailsContent"></div>
        <div class="modal-actions">
            <button class="btn-outline-lab" onclick="closeOrderDetailsModal()">Close</button>
            <button id="orderActionBtn" class="btn-sm-lab" onclick="orderAction()">Mark Received</button>
        </div>
    </div>
</div>

<!-- Report Modal -->
<div id="reportModal" class="modal-overlay" style="display:none;">
    <div class="modal-card" style="max-width:500px;">
        <h3>📄 Generate Report</h3>
        <form id="reportForm" method="post" action="@Url.Action("GenerateReport", "Manager")">
            <div class="form-group">
                <label>Start Date</label>
                <input type="date" name="StartDate" class="form-control" value="@DateTime.Now.AddMonths(-1).ToString("yyyy-MM-dd")" />
            </div>
            <div class="form-group">
                <label>End Date</label>
                <input type="date" name="EndDate" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
            </div>
            <div class="form-group">
                <label>Report Type</label>
                <select name="ReportType" class="form-control">
                    <option value="TestsPerformed">Tests Performed by Category</option>
                    <option value="StockReport">Stock Usage Report</option>
                    <option value="TechnicianPerformance">Technician Performance</option>
                    <option value="OrderReport">Order Summary Report</option>
                </select>
            </div>
            <div class="modal-actions">
                <button type="button" class="btn-outline-lab" onclick="closeReportModal()">Cancel</button>
                <button type="submit" class="btn-sm-lab">Generate PDF</button>
            </div>
        </form>
    </div>
</div>

<!-- Status Cards -->
<div class="stat-cards">
    <div class="stat-item" onclick="viewLowStockAlerts()" style="cursor:pointer;">
        <div class="stat-icon-lg">⚠️</div>
        <div>
            <h3>@Model.LowStockItems</h3>
            <p>Low Stock Alerts <span style="font-size:11px;">▼ Click to view</span></p>
        </div>
    </div>
    <div class="stat-item" onclick="viewMonthlyTests()" style="cursor:pointer;">
        <div class="stat-icon-lg">📊</div>
        <div>
            <h3>@Model.Statistics.TestsPerformedThisMonth</h3>
            <p>Tests This Month <span style="font-size:11px;">▼ Click for details</span></p>
        </div>
    </div>
    <div class="stat-item" onclick="viewActiveStaff()" style="cursor:pointer;">
        <div class="stat-icon-lg">👥</div>
        <div>
            <h3>@Model.TotalTechnicians</h3>
            <p>Active Staff <span style="font-size:11px;">▼ Click for list</span></p>
        </div>
    </div>
</div>

<div class="grid-2col">
    <div class="card-modern">
        <h3>📈 Monthly Performance</h3>
        <div id="testCategoryChart" style="height:150px; background:#F4F7FC; border-radius:16px; display:flex; align-items:center; justify-content:center; margin:1rem 0; position:relative;">
            <div style="text-align:center;">
                <div id="chartBars" style="display:flex; gap:20px; justify-content:center; margin-bottom:10px;">
                    <!-- Populated by JavaScript -->
                </div>
                <small>Click chart for breakdown</small>
            </div>
        </div>
        <button class="btn-outline-lab" onclick="openReportModal()">Download Report (PDF)</button>
        <button class="btn-outline-lab" onclick="viewTestBreakdown()" style="margin-left:10px;">View Breakdown</button>
    </div>
    <div class="card-modern">
        <h3>⚠️ Critical Alerts</h3>
        <ul style="margin-top:1rem;" id="criticalAlertsList">
            <!-- Populated by JavaScript from Model data -->
        </ul>
    </div>
</div>

<div class="card-modern">
    <div class="card-header-flex">
        <h3>📋 Recent Orders</h3>
        <button class="btn-sm-lab" onclick="openQuickOrderModal()">
            + Create Order
        </button>
    </div>
    <table>
        <thead>
            <tr>
                <th>Order #</th>
                <th>Supplier</th>
                <th>Date</th>
                <th>Status</th>
                <th>Items</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody id="recentOrdersBody">
            <!-- Populated by JavaScript from Model data -->
        </tbody>
    </table>
</div>

<style>
    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0,0,0,0.5);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1000;
    }

    .modal-card {
        background: white;
        border-radius: 24px;
        padding: 1.5rem;
        width: 90%;
        max-width: 700px;
        max-height: 90vh;
        overflow-y: auto;
    }

    .modal-actions {
        display: flex;
        justify-content: flex-end;
        gap: 1rem;
        margin-top: 1.5rem;
    }

    .low-stock-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px;
        border-bottom: 1px solid #E2E8F0;
    }

    .order-checkbox {
        margin: 10px 0;
        padding: 8px;
        background: #F8FAFE;
        border-radius: 8px;
    }

    .order-qty-input {
        padding: 5px;
        border-radius: 6px;
        border: 1px solid #E2E8F0;
        width: 80px;
        margin-left: 10px;
    }

    .btn-link {
        background: none;
        border: none;
        color: #2C8C6E;
        cursor: pointer;
        text-decoration: underline;
        font-size: 0.75rem;
        margin-left: 8px;
    }

    .badge-ordered {
        background: #5A6E7A;
        color: white;
        padding: 0.2rem 0.6rem;
        border-radius: 20px;
        font-size: 0.7rem;
    }

    .badge-completed {
        background: #2C8C6E;
        color: white;
        padding: 0.2rem 0.6rem;
        border-radius: 20px;
        font-size: 0.7rem;
    }

    .badge-progress {
        background: #E8A845;
        color: white;
        padding: 0.2rem 0.6rem;
        border-radius: 20px;
        font-size: 0.7rem;
    }

    .badge-cancelled {
        background: #E26D5C;
        color: white;
        padding: 0.2rem 0.6rem;
        border-radius: 20px;
        font-size: 0.7rem;
    }

    .stat-item {
        cursor: pointer;
        transition: transform 0.2s;
    }

        .stat-item:hover {
            transform: translateY(-2px);
        }

    .order-detail-row {
        padding: 8px 0;
        border-bottom: 1px solid #E2E8F0;
    }

    .form-control {
        width: 100%;
        padding: 8px 12px;
        border: 1px solid #E2E8F0;
        border-radius: 8px;
        font-size: 0.9rem;
    }

    .stat-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .stat-item {
        background: white;
        border-radius: 16px;
        padding: 1.2rem;
        display: flex;
        align-items: center;
        gap: 1rem;
        border: 1px solid #E2E8F0;
    }

    .stat-icon-lg {
        font-size: 2rem;
    }

    .stat-item h3 {
        font-size: 1.5rem;
        color: #032C7D;
        margin: 0;
    }

    .stat-item p {
        font-size: 0.8rem;
        color: #5A6E7A;
        margin: 0;
    }

    .grid-2col {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .card-modern {
        background: white;
        border-radius: 16px;
        padding: 1.5rem;
        border: 1px solid #E2E8F0;
    }

    .card-header-flex {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
    }

    .btn-sm-lab {
        background: linear-gradient(135deg, #0841C9, #1D97F1);
        color: white;
        border: none;
        padding: 0.4rem 1rem;
        border-radius: 30px;
        cursor: pointer;
        font-size: 0.8rem;
        font-family: 'Inter', sans-serif;
        transition: all 0.2s;
    }

        .btn-sm-lab:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(8,65,201,0.3);
        }

    .btn-outline-lab {
        background: transparent;
        color: #032C7D;
        border: 1px solid #E2E8F0;
        padding: 0.4rem 1rem;
        border-radius: 30px;
        cursor: pointer;
        font-size: 0.8rem;
        font-family: 'Inter', sans-serif;
        transition: all 0.2s;
    }

        .btn-outline-lab:hover {
            background: #F8FAFE;
        }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    th, td {
        padding: 0.6rem 0.3rem;
        text-align: left;
        border-bottom: 1px solid #E2E8F0;
        font-size: 0.8rem;
    }

    th {
        background: #F8FAFE;
        font-weight: 600;
        color: #5A6E7A;
    }
</style>

<script>
    // ============================================================
    // DATA - Passed from Server via Razor
    // ============================================================

    // Low Stock Alerts from Model
    const lowStockData = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.LowStockAlerts ?? new List<NMB_HLabSys.Models.ViewModels.LowStockAlertViewModel>()));

    // Recent Orders from Model
    const recentOrdersData = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.RecentActivities?.Where(a => a.ActivityType == "Order").Take(5) ?? new List<NMB_HLabSys.Models.ViewModels.RecentActivityViewModel>()));

    // Total counts
    const totalTestCategories = @Model.TotalTestCategories;
    const totalTestTypes = @Model.TotalTestTypes;
    const totalConsumables = @Model.TotalConsumables;
    const pendingOrders = @Model.PendingOrders;

    // ============================================================
    // RENDER FUNCTIONS
    // ============================================================

    function renderRecentOrders() {
        const tbody = document.getElementById('recentOrdersBody');

        if (!recentOrdersData || recentOrdersData.length === 0) {
            tbody.innerHTML = `<tr><td colspan="6" style="text-align:center; color:#5A6E7A;">No recent orders found</td></tr>`;
            return;
        }

        tbody.innerHTML = recentOrdersData.map(order => `
            <tr>
                <td>${order.Description?.match(/Order #(\S+)/)?.[1] || 'N/A'}</td>
                <td>${order.UserName || 'Unknown'}</td>
                <td>${new Date(order.ActivityDate).toLocaleDateString()}</td>
                <td><span class="badge badge-ordered">Ordered</span></td>
                <td>View details</td>
                <td>
                    <button class="btn-outline-lab" onclick="viewOrderDetails('${order.Description || 'Order'}')">View</button>
                </td>
            </tr>
        `).join('');
    }

    function renderLowStockAlerts() {
        const container = document.getElementById('lowStockList');

        if (!lowStockData || lowStockData.length === 0) {
            container.innerHTML = `<p style="text-align:center; color:#2C8C6E;">✅ All items are well stocked</p>`;
            return;
        }

        container.innerHTML = lowStockData.map(item => `
            <div class="low-stock-item">
                <strong>${item.AlertLevel === 'Critical' ? '🔴' : '🟡'} ${item.ConsumableName || 'Unknown'}</strong>
                <span>Current: ${item.QuantityOnHand} | Reorder Level: ${item.ReorderLevel}</span>
                <button class="btn-sm-lab" onclick="createOrderFromAlert('${item.ConsumableName || ''}')">Order Now</button>
            </div>
        `).join('');
    }

    function renderCriticalAlerts() {
        const container = document.getElementById('criticalAlertsList');

        if (!lowStockData || lowStockData.length === 0) {
            container.innerHTML = `<li style="color:#2C8C6E;">✅ No critical alerts</li>`;
            return;
        }

        const critical = lowStockData.filter(a => a.AlertLevel === 'Critical');
        const warnings = lowStockData.filter(a => a.AlertLevel === 'Warning');

        let html = '';
        critical.forEach(item => {
            html += `<li style="color:#E26D5C;">🔴 ${item.ConsumableName || 'Unknown'} below reorder level (${item.QuantityOnHand}/${item.ReorderLevel}) <button class="btn-link" onclick="createOrderFromAlert('${item.ConsumableName || ''}')">Order Now</button></li>`;
        });
        warnings.forEach(item => {
            html += `<li style="color:#E8A845;">🟡 ${item.ConsumableName || 'Unknown'} nearing reorder level (${item.QuantityOnHand}/${item.ReorderLevel}) <button class="btn-link" onclick="createOrderFromAlert('${item.ConsumableName || ''}')">Order Now</button></li>`;
        });

        if (!critical.length && !warnings.length) {
            html += `<li style="color:#2C8C6E;">✅ No low stock alerts</li>`;
        }

        container.innerHTML = html;
    }

    function renderChart() {
        const container = document.getElementById('chartBars');

        // Sample data - would come from API in production
        const chartData = [
            { label: 'FBC', value: 156, color: '#2C8C6E' },
            { label: 'Coag', value: 89, color: '#E8A845' },
            { label: 'Diff', value: 97, color: '#5A6E7A' }
        ];

        container.innerHTML = chartData.map(item => `
            <div style="text-align:center;">
                <div style="width:40px; height:${Math.max(item.value / 2, 20)}px; background:${item.color}; border-radius:8px 8px 0 0; display:inline-block;"></div>
                <div style="font-size:0.7rem; margin-top:4px;">${item.label}<br>${item.value}</div>
            </div>
        `).join('');
    }

    // ============================================================
    // MODAL FUNCTIONS
    // ============================================================

    function viewLowStockAlerts() {
        document.getElementById('lowStockModal').style.display = 'flex';
    }

    function closeLowStockModal() {
        document.getElementById('lowStockModal').style.display = 'none';
    }

    function viewMonthlyTests() {
        alert(`📊 Monthly Test Breakdown\n\n📈 Total Tests: ${@Model.Statistics.TestsPerformedThisMonth}\n📦 Orders Processed: ${@Model.Statistics.OrdersProcessedThisMonth}\n👥 Active Technicians: ${@Model.Statistics.ActiveTechnicians}`);
    }

    function viewActiveStaff() {
        alert(`👥 Staff Summary\n\n🔬 Lab Technicians: ${@Model.TotalTechnicians}\n👨‍⚕️ Doctors: ${@Model.TotalDoctors}\n✅ Active Technicians: ${@Model.Statistics.ActiveTechnicians}`);
    }

    function viewStatRequests() {
        document.getElementById('statRequestsModal').style.display = 'flex';
    }

    function closeStatModal() {
        document.getElementById('statRequestsModal').style.display = 'none';
    }

    function openQuickOrderModal() {
        document.getElementById('quickOrderModal').style.display = 'flex';
    }

    function closeQuickOrderModal() {
        document.getElementById('quickOrderModal').style.display = 'none';
    }

    function openReportModal() {
        document.getElementById('reportModal').style.display = 'flex';
    }

    function closeReportModal() {
        document.getElementById('reportModal').style.display = 'none';
    }

    function viewTestBreakdown() {
        alert(`📊 Test Breakdown\n\n🏥 Total Tests: ${@Model.Statistics.TestsPerformedThisMonth}\n\n⏱️ Avg Turnaround: 42 min\n✅ On-Time Rate: 93.3%`);
    }

    function createOrderFromAlert(itemName) {
        closeLowStockModal();
        document.getElementById('quickOrderModal').style.display = 'flex';

        // Auto-check the item
        setTimeout(() => {
            const checkboxes = document.querySelectorAll('#quickOrderItems input[type="checkbox"]');
            checkboxes.forEach(cb => {
                if (cb.value && cb.value.toLowerCase().includes(itemName.toLowerCase())) {
                    cb.checked = true;
                }
            });
        }, 100);
    }

    function orderAllLowStock() {
        alert(`📦 Bulk order created for all low stock items.\n📧 Order email sent to supplier.`);
        closeLowStockModal();
        location.reload();
    }

    function viewOrderDetails(orderDescription) {
        document.getElementById('orderDetailsTitle').innerText = `Order Details`;
        document.getElementById('orderDetailsContent').innerHTML = `
            <div class="order-detail-row"><strong>Order:</strong> ${orderDescription}</div>
            <div class="order-detail-row"><strong>Date:</strong> ${new Date().toLocaleDateString()}</div>
            <div class="order-detail-row"><strong>Status:</strong> <span class="badge badge-ordered">Ordered</span></div>
        `;
        document.getElementById('orderDetailsModal').style.display = 'flex';
    }

    function closeOrderDetailsModal() {
        document.getElementById('orderDetailsModal').style.display = 'none';
    }

    function orderAction() {
        if (confirm('Mark this order as fully received? Stock levels will be updated automatically.')) {
            alert('✅ Order marked as received. Stock levels updated.');
            closeOrderDetailsModal();
            location.reload();
        }
    }

    // ============================================================
    // INITIALIZATION
    // ============================================================

    document.addEventListener('DOMContentLoaded', function() {
        renderRecentOrders();
        renderLowStockAlerts();
        renderCriticalAlerts();
        renderChart();
    });

    // Click outside modal to close
    document.addEventListener('click', function(event) {
        if (event.target.classList.contains('modal-overlay')) {
            event.target.style.display = 'none';
        }
    });
</script>