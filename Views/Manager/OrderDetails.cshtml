@* @{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Order Details";
    ViewData["RoleSubtitle"] = "Manager Portal";

    var mgrName = ViewBag.ManagerName as string;
    var initials = "AA";
    if (!string.IsNullOrEmpty(mgrName))
    {
        var parts = mgrName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        initials = string.Concat(parts.Select(p => p[0]));
    }
    ViewData["UserGreeting"] = $"Manager: {mgrName ?? "Amanda Adams"}";
    ViewData["UserInitials"] = initials;
}

@model NMB_HLabSys.Models.ViewModels.OrderDetailViewModel
@using NMB_HLabSys.Models.ViewModels

@section SidebarMenu {
    <li><a href="@Url.Action("Dashboard", "Manager")">Overview</a></li>
    <li><a href="@Url.Action("TestCatalogue", "Manager")">Test Catalogue</a></li>
    <li><a href="@Url.Action("StockManagement", "Manager")" class="active">Stock and Orders</a></li>
    <li><a href="@Url.Action("StaffManagement", "Manager")">Staff Management</a></li>
    <li><a href="@Url.Action("Reports", "Manager")">Reports</a></li>
    <li><a href="@Url.Action("Settings", "Manager")">Settings</a></li>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<div class="order-details-container">
    <div class="card-modern">
        <div class="card-header-flex">
            <h3>Order Details: @Model.OrderNumber</h3>
            <div>
                <a href="@Url.Action("ViewOrder", "Manager")" class="btn-outline-lab">Back to Orders</a>
                @if (Model.CanReceive)
                {
                    <a href="@Url.Action("ReceiveOrder", "Manager", new { id = Model.OrderID })" class="btn-sm-lab" style="margin-left:0.5rem;">Receive Order</a>
                }
                @if (Model.CanCancel)
                {
                    <button class="btn-outline-lab" onclick="cancelOrder('@Model.OrderNumber', @Model.OrderID)" style="margin-left:0.5rem;">Cancel Order</button>
                }
            </div>
        </div>

        <div class="order-info-grid">
            <div class="order-info-item">
                <span class="info-label">Order Number</span>
                <span class="info-value">@Model.OrderNumber</span>
            </div>
            <div class="order-info-item">
                <span class="info-label">Supplier</span>
                <span class="info-value">@Model.SupplierName</span>
            </div>
            <div class="order-info-item">
                <span class="info-label">Contact</span>
                <span class="info-value">@Model.SupplierContact</span>
            </div>
            <div class="order-info-item">
                <span class="info-label">Email</span>
                <span class="info-value">@Model.SupplierEmail</span>
            </div>
            <div class="order-info-item">
                <span class="info-label">Order Date</span>
                <span class="info-value">@Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</span>
            </div>
            <div class="order-info-item">
                <span class="info-label">Expected Delivery</span>
                <span class="info-value">@(Model.ExpectedDeliveryDate?.ToString("dd/MM/yyyy") ?? "Not specified")</span>
            </div>
            <div class="order-info-item">
                <span class="info-label">Status</span>
                <span class="info-value">
                    <span class="badge @(Model.StatusColor == "success" ? "badge-completed" : Model.StatusColor == "warning" ? "badge-progress" : Model.StatusColor == "danger" ? "badge-critical" : "badge-ordered")">
                        @Model.Status
                    </span>
                </span>
            </div>
            <div class="order-info-item">
                <span class="info-label">Total Amount</span>
                <span class="info-value">R@(Model.TotalAmount?.ToString("N2") ?? "0.00")</span>
            </div>
            <div class="order-info-item">
                <span class="info-label">Created By</span>
                <span class="info-value">@Model.CreatedBy</span>
            </div>
            @if (!string.IsNullOrEmpty(Model.CancellationReason))
            {
                <div class="order-info-item full-width">
                    <span class="info-label">Cancellation Reason</span>
                    <span class="info-value">@Model.CancellationReason</span>
                </div>
            }
            @if (Model.DateCompleted.HasValue)
            {
                <div class="order-info-item">
                    <span class="info-label">Completed Date</span>
                    <span class="info-value">@Model.DateCompleted.Value.ToString("dd/MM/yyyy HH:mm")</span>
                </div>
            }
            @if (Model.DateCancelled.HasValue)
            {
                <div class="order-info-item">
                    <span class="info-label">Cancelled Date</span>
                    <span class="info-value">@Model.DateCancelled.Value.ToString("dd/MM/yyyy HH:mm")</span>
                </div>
            }
        </div>
    </div>

    <div class="card-modern">
        <div class="card-header-flex">
            <h3>Order Items</h3>
        </div>
        @if (Model.Items != null && Model.Items.Any())
        {
            <div class="table-container">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Item</th>
                            <th>Quantity Ordered</th>
                            <th>Quantity Received</th>
                            <th>Remaining</th>
                            <th>Unit Price</th>
                            <th>Total Price</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>@item.ConsumableName</td>
                                <td>@item.QuantityOrdered</td>
                                <td>@item.QuantityReceived</td>
                                <td>@item.RemainingQuantity</td>
                                <td>R@(item.UnitPrice?.ToString("N2") ?? "0.00")</td>
                                <td>R@(item.TotalPrice?.ToString("N2") ?? "0.00")</td>
                                <td>
                                    <span class="badge @(item.StatusColor == "success" ? "badge-completed" : item.StatusColor == "warning" ? "badge-progress" : item.StatusColor == "danger" ? "badge-critical" : "badge-ordered")">
                                        @item.Status
                                    </span>
                                    @if (!string.IsNullOrEmpty(item.CancellationReason))
                                    {
                                        <div style="font-size:0.65rem; color:#E26D5C; margin-top:0.2rem;">Reason: @item.CancellationReason</div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p style="color: #5A6E7A; text-align:center; padding: 1rem;">No items in this order</p>
        }
    </div>
</div>

<script>
    function cancelOrder(orderNumber, orderId) {
        if (confirm('Are you sure you want to cancel order ' + orderNumber + '?')) {
            var reason = prompt('Please provide reason for cancellation:');
            if (reason) {
                alert('Order ' + orderNumber + ' cancelled.\nReason: ' + reason);
                window.location.href = '@Url.Action("ViewOrder", "Manager")';
            }
        }
    }
</script>

<style>
    .order-details-container {
        max-width: 1000px;
        margin: 0 auto;
    }

    .card-modern {
        background: white;
        border-radius: 16px;
        padding: 1.5rem;
        margin-bottom: 1.5rem;
        border: 1px solid #E2E8F0;
        box-shadow: 0 2px 8px rgba(0,0,0,0.04);
    }

    .card-header-flex {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
        padding-bottom: 0.8rem;
        border-bottom: 1px solid #E2E8F0;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

        .card-header-flex h3 {
            color: #032C7D;
            margin: 0;
            font-size: 1.1rem;
        }

    .order-info-grid {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 0.8rem;
    }

    .order-info-item {
        padding: 0.5rem 0;
        border-bottom: 1px solid #F0F4F8;
    }

        .order-info-item.full-width {
            grid-column: 1 / -1;
        }

    .info-label {
        display: block;
        font-size: 0.7rem;
        color: #5A6E7A;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .info-value {
        display: block;
        font-size: 0.9rem;
        font-weight: 500;
        color: #032C7D;
        margin-top: 0.1rem;
    }

    .table-container {
        overflow-x: auto;
    }

    .data-table {
        width: 100%;
        border-collapse: collapse;
    }

        .data-table th, .data-table td {
            padding: 0.6rem 0.4rem;
            text-align: left;
            border-bottom: 1px solid #E2E8F0;
            font-size: 0.8rem;
        }

        .data-table th {
            background: #F8FAFE;
            font-weight: 600;
            color: #5A6E7A;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

    .badge-completed {
        background: #2C8C6E;
        color: white;
        padding: 0.2rem 0.6rem;
        border-radius: 20px;
        font-size: 0.65rem;
        font-weight: 600;
    }

    .badge-progress {
        background: #E8A845;
        color: white;
        padding: 0.2rem 0.6rem;
        border-radius: 20px;
        font-size: 0.65rem;
        font-weight: 600;
    }

    .badge-critical {
        background: #E26D5C;
        color: white;
        padding: 0.2rem 0.6rem;
        border-radius: 20px;
        font-size: 0.65rem;
        font-weight: 600;
    }

    .badge-ordered {
        background: #5A6E7A;
        color: white;
        padding: 0.2rem 0.6rem;
        border-radius: 20px;
        font-size: 0.65rem;
        font-weight: 600;
    }

    .btn-sm-lab {
        background: linear-gradient(135deg, #0841C9, #1D97F1);
        color: white;
        border: none;
        padding: 0.4rem 1rem;
        border-radius: 30px;
        cursor: pointer;
        font-size: 0.8rem;
        font-family: 'Inter', sans-serif;
        transition: all 0.2s;
        text-decoration: none;
        display: inline-block;
    }

        .btn-sm-lab:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(8,65,201,0.3);
            color: white;
        }

    .btn-outline-lab {
        background: transparent;
        color: #032C7D;
        border: 1px solid #E2E8F0;
        padding: 0.4rem 1rem;
        border-radius: 30px;
        cursor: pointer;
        font-size: 0.8rem;
        font-family: 'Inter', sans-serif;
        transition: all 0.2s;
        text-decoration: none;
        display: inline-block;
    }

        .btn-outline-lab:hover {
            background: #F8FAFE;
            text-decoration: none;
            color: #032C7D;
        }

    .alert {
        padding: 0.8rem 1rem;
        border-radius: 10px;
        font-size: 0.85rem;
        margin-bottom: 1.2rem;
    }

    .alert-success {
        background: #D1FAE5;
        color: #065F46;
        border-left: 4px solid #10B981;
    }

    .alert-danger {
        background: #FEE2E2;
        color: #991B1B;
        border-left: 4px solid #EF4444;
    }

    @@media (max-width: 768px) {
        .order-info-grid {
            grid-template-columns: 1fr 1fr;
        }

        .card-header-flex {
            flex-direction: column;
            align-items: flex-start;
        }
    }

    @@media (max-width: 480px) {
        .order-info-grid {
            grid-template-columns: 1fr;
        }
    }
</style> *@