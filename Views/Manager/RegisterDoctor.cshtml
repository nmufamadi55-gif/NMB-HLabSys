@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Register Doctor";
}

@section SidebarMenu {
    <li><a href="@Url.Action("Dashboard", "Manager")">📈 Overview</a></li>
    <li><a href="@Url.Action("TestCatalogue", "Manager")">📚 Test Catalogue</a></li>
    <li><a href="@Url.Action("StockManagement", "Manager")" class="active">📦 Stock & Orders</a></li>
    <li><a href="@Url.Action("StaffManagement", "Manager")">👥 Staff Management</a></li>
}

<div class="card-modern">
    <h3>👨‍⚕️ Register New Doctor</h3>

    <div class="grid-2col">
        <div class="form-group">
            <label>First Name</label>
            <input type="text" class="form-control" />
        </div>

        <div class="form-group">
            <label>Surname</label>
            <input type="text" class="form-control" />
        </div>
    </div>

    <div class="form-group">
        <label>HPCSA Number</label>
        <input type="text" class="form-control" />
    </div>

    <button class="btn-sm-lab">✅ Register Doctor</button>
</div>