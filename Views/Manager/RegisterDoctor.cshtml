@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Manager Dashboard"; // Change per view
    ViewData["RoleSubtitle"] = "Manager Portal";

    var mgrName = ViewBag.ManagerName as string;
    var initials = "AA";
    if (!string.IsNullOrEmpty(mgrName))
    {
        var parts = mgrName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        initials = string.Concat(parts.Select(p => p[0]));
    }
    ViewData["UserGreeting"] = $"📊 {mgrName ?? "Amanda Adams"} (Lab Manager)";
    ViewData["UserInitials"] = initials;
}

@model NMB_HLabSys.Models.ViewModels.RegisterDoctorViewModel

@section SidebarMenu {
    <li><a href="@Url.Action("Dashboard", "Manager")"><i class="fas fa-chart-pie"></i> <span>Overview</span></a></li>
    <li><a href="@Url.Action("TestCatalogue", "Manager")"><i class="fas fa-flask"></i> <span>Test Catalogue</span></a></li>
    <li><a href="@Url.Action("StockManagement", "Manager")"><i class="fas fa-boxes"></i> <span>Stock & Orders</span></a></li>
    <li><a href="@Url.Action("StaffManagement", "Manager")" class="active"><i class="fas fa-users-cog"></i> <span>Staff Management</span></a></li>
    <li><a href="@Url.Action("Reports", "Manager")"><i class="fas fa-file-alt"></i> <span>Reports</span></a></li>
    <li><a href="@Url.Action("Settings", "Manager")"><i class="fas fa-cog"></i> <span>Settings</span></a></li>
}

<div class="container">
    <div class="card-modern" style="max-width: 700px; margin: 0 auto;">
        <div class="card-header-flex">
            <h3><i class="fas fa-user-md"></i> Register New Doctor</h3>
            <a href="@Url.Action("StaffManagement", "Manager")" class="btn-outline-lab">
                <i class="fas fa-arrow-left"></i> Back to Staff
            </a>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">
                <i class="fas fa-check-circle"></i> @TempData["Success"]
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">
                <i class="fas fa-exclamation-circle"></i> @TempData["Error"]
            </div>
        }

        <form asp-action="RegisterDoctor" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

            <div class="grid-2col">
                <div class="form-group">
                    <label asp-for="Name">Name <span class="required">*</span></label>
                    <div class="input-with-icon">
                        <i class="fas fa-user"></i>
                        <input asp-for="Name" class="form-control" placeholder="Enter first name" />
                    </div>
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Surname">Surname <span class="required">*</span></label>
                    <div class="input-with-icon">
                        <i class="fas fa-user"></i>
                        <input asp-for="Surname" class="form-control" placeholder="Enter surname" />
                    </div>
                    <span asp-validation-for="Surname" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="HPCSANumber">HPCSA Number <span class="required">*</span></label>
                <div class="input-with-icon">
                    <i class="fas fa-id-card"></i>
                    <input asp-for="HPCSANumber" class="form-control" placeholder="e.g., HPCSA001" />
                </div>
                <span asp-validation-for="HPCSANumber" class="text-danger"></span>
                <small class="text-muted">Unique HPCSA registration number</small>
            </div>

            <div class="form-group">
                <label asp-for="Email">Email Address <span class="required">*</span></label>
                <div class="input-with-icon">
                    <i class="fas fa-envelope"></i>
                    <input asp-for="Email" class="form-control" placeholder="doctor@practice.com" type="email" />
                </div>
                <span asp-validation-for="Email" class="text-danger"></span>
                <small class="text-muted">This will be the doctor's login username</small>
            </div>

            <div class="form-group">
                <label asp-for="ContactNumber">Contact Number <span class="required">*</span></label>
                <div class="input-with-icon">
                    <i class="fas fa-phone"></i>
                    <input asp-for="ContactNumber" class="form-control" placeholder="0825551234" />
                </div>
                <span asp-validation-for="ContactNumber" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="PracticeName">Practice Name</label>
                <div class="input-with-icon">
                    <i class="fas fa-building"></i>
                    <input asp-for="PracticeName" class="form-control" placeholder="e.g., Johnson Medical Practice" />
                </div>
                <span asp-validation-for="PracticeName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="PracticeAddress">Practice Address</label>
                <div class="input-with-icon">
                    <i class="fas fa-map-marker-alt"></i>
                    <textarea asp-for="PracticeAddress" class="form-control" rows="2" placeholder="123 Medical Street, Port Elizabeth"></textarea>
                </div>
                <span asp-validation-for="PracticeAddress" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Specialization">Specialization</label>
                <div class="input-with-icon">
                    <i class="fas fa-stethoscope"></i>
                    <input asp-for="Specialization" class="form-control" placeholder="e.g., Haematology, Internal Medicine" />
                </div>
                <span asp-validation-for="Specialization" class="text-danger"></span>
            </div>

            <div class="form-actions">
                <button type="reset" class="btn-outline-lab">
                    <i class="fas fa-undo"></i> Clear
                </button>
                <button type="submit" class="btn-sm-lab">
                    <i class="fas fa-save"></i> Register Doctor
                </button>
            </div>
        </form>
    </div>
</div>

<style>
    .container {
        max-width: 800px;
        margin: 0 auto;
    }

    .card-modern {
        background: white;
        border-radius: 16px;
        padding: 1.5rem;
        border: 1px solid #E2E8F0;
        box-shadow: 0 2px 8px rgba(0,0,0,0.04);
    }

    .card-header-flex {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid #E2E8F0;
    }

        .card-header-flex h3 {
            color: #032C7D;
            margin: 0;
            font-size: 1.2rem;
        }

    .grid-2col {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
    }

    .form-group {
        margin-bottom: 1.2rem;
    }

        .form-group label {
            display: block;
            font-size: 0.8rem;
            font-weight: 500;
            color: #032C7D;
            margin-bottom: 0.3rem;
        }

    .required {
        color: #E26D5C;
    }

    .input-with-icon {
        position: relative;
    }

        .input-with-icon i {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: #5A6E7A;
            font-size: 0.9rem;
        }

        .input-with-icon input,
        .input-with-icon textarea {
            width: 100%;
            padding: 0.7rem 0.7rem 0.7rem 2.5rem;
            border: 1px solid #E2E8F0;
            border-radius: 10px;
            font-size: 0.9rem;
            font-family: 'Inter', sans-serif;
            transition: all 0.2s;
            background: white;
        }

            .input-with-icon input:focus,
            .input-with-icon textarea:focus {
                outline: none;
                border-color: #0841C9;
                box-shadow: 0 0 0 3px rgba(8,65,201,0.1);
            }

        .input-with-icon textarea {
            padding-top: 0.7rem;
            resize: vertical;
        }

    .text-danger {
        color: #991B1B;
        font-size: 0.75rem;
        display: block;
        margin-top: 0.2rem;
    }

    .text-muted {
        color: #5A6E7A;
        font-size: 0.7rem;
        display: block;
        margin-top: 0.2rem;
    }

    .validation-summary {
        background: #FEE2E2;
        color: #991B1B;
        padding: 0.8rem;
        border-radius: 10px;
        font-size: 0.85rem;
        margin-bottom: 1.2rem;
        border-left: 4px solid #EF4444;
    }

    .alert {
        padding: 0.8rem 1rem;
        border-radius: 10px;
        font-size: 0.85rem;
        margin-bottom: 1.2rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .alert-success {
        background: #D1FAE5;
        color: #065F46;
        border-left: 4px solid #10B981;
    }

    .alert-danger {
        background: #FEE2E2;
        color: #991B1B;
        border-left: 4px solid #EF4444;
    }

    .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 1rem;
        margin-top: 1.5rem;
        padding-top: 1.5rem;
        border-top: 1px solid #E2E8F0;
    }

    .btn-sm-lab {
        background: linear-gradient(135deg, #0841C9, #1D97F1);
        color: white;
        border: none;
        padding: 0.6rem 1.5rem;
        border-radius: 30px;
        cursor: pointer;
        font-size: 0.85rem;
        font-family: 'Inter', sans-serif;
        transition: all 0.2s;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

        .btn-sm-lab:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(8,65,201,0.3);
        }

    .btn-outline-lab {
        background: transparent;
        color: #032C7D;
        border: 1px solid #E2E8F0;
        padding: 0.6rem 1.5rem;
        border-radius: 30px;
        cursor: pointer;
        font-size: 0.85rem;
        font-family: 'Inter', sans-serif;
        transition: all 0.2s;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        text-decoration: none;
    }

        .btn-outline-lab:hover {
            background: #F8FAFE;
            text-decoration: none;
        }

    /* Sidebar styles to match your existing */
    .nav-links a {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 0.7rem 1.2rem;
        margin: 0 0.8rem;
        color: #1A2C3A;
        text-decoration: none;
        font-weight: 500;
        font-size: 0.85rem;
        transition: all 0.2s ease;
        border-radius: 12px;
    }

        .nav-links a i {
            width: 20px;
            text-align: center;
            color: #5A6E7A;
        }

        .nav-links a:hover {
            background: #F1F5F9;
            color: #0841C9;
        }

        .nav-links a.active {
            background: linear-gradient(135deg, #0841C9, #1D97F1);
            color: white;
            box-shadow: 0 2px 8px rgba(8,65,201,0.25);
        }

            .nav-links a.active i {
                color: white;
            }

    @@media (max-width: 600px) {
        .grid-2col

    {
        grid-template-columns: 1fr;
    }

    .form-actions {
        flex-direction: column;
    }

        .form-actions button {
            width: 100%;
            justify-content: center;
        }

    }
</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}