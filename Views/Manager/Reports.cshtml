@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Reports & Analytics";
    ViewData["RoleSubtitle"] = "Manager Portal";
    ViewData["UserGreeting"] = "📊 Amanda Adams";
    ViewData["UserInitials"] = "AA";
}

@section SidebarMenu {
    <li><a href="@Url.Action("Dashboard", "Manager")">📈 Overview</a></li>
    <li><a href="@Url.Action("TestCatalogue", "Manager")">📚 Test Catalogue</a></li>
    <li><a href="@Url.Action("StockManagement", "Manager")">📦 Stock & Orders</a></li>
    <li><a href="@Url.Action("StaffManagement", "Manager")">👥 Staff Management</a></li>
    <li><a href="@Url.Action("Reports", "Manager")" class="active">📑 Reports</a></li>
}

<div class="stat-cards">
    <div class="stat-item"><div class="stat-icon-lg">🧪</div><div><h3>1,240</h3><p>Total Tests</p></div></div>
    <div class="stat-item"><div class="stat-icon-lg">⏱️</div><div><h3>42 min</h3><p>Avg Turnaround</p></div></div>
    <div class="stat-item"><div class="stat-icon-lg">📉</div><div><h3>12%</h3><p>Stock Usage Increase</p></div></div>
</div>

<div class="grid-2col">
    <div class="card-modern">
        <h3>📊 Monthly Test Summary</h3>
        <div style="height:220px; background:#F4F7FC; border-radius:16px; display:flex; align-items:center; justify-content:center; margin-top:1rem;">
            📈 [Analytics Graph Placeholder]
        </div>
    </div>

    <div class="card-modern">
        <h3>📄 Export Reports</h3>
        <ul style="margin-top:1rem;">
            <li>Monthly Test Report</li>
            <li>Technician Performance Report</li>
            <li>Inventory Usage Report</li>
            <li>Doctor Activity Report</li>
        </ul>

        <button class="btn-sm-lab" style="margin-top:1rem;">Download PDF</button>
    </div>
</div>