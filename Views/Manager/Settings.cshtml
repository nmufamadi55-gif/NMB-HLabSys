@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "System Settings";
    ViewData["RoleSubtitle"] = "Manager Portal";
    ViewData["UserGreeting"] = "📊 Amanda Adams";
    ViewData["UserInitials"] = "AA";
}

@section SidebarMenu {
    <li><a href="@Url.Action("Dashboard", "Manager")">📈 Overview</a></li>
    <li><a href="@Url.Action("Settings", "Manager")" class="active">⚙️ Settings</a></li>
}

<div class="card-modern">
    <h3>⚙️ Laboratory Settings</h3>

    <div class="grid-2col" style="margin-top:1rem;">
        <div class="form-group">
            <label>Default Reorder Threshold</label>
            <input type="number" class="form-control" value="50">
        </div>

        <div class="form-group">
            <label>Notification Email</label>
            <input type="email" class="form-control" value="admin@nmblab.com">
        </div>
    </div>

    <div class="form-group">
        <label><input type="checkbox" checked> Enable Low Stock Alerts</label>
    </div>

    <div class="form-group">
        <label><input type="checkbox" checked> Enable Email Notifications</label>
    </div>

    <button class="btn-sm-lab">Save Settings</button>
</div>
