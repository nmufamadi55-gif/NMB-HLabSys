<!-- Add New Technician Form (Collapsible) -->
<div class="card-modern">
    <div class="card-header-flex">
        <h3>➕ Quick Add: New Lab Technician</h3>
        <button class="btn-outline-lab" onclick="toggleAddForm()">Show/Hide Form</button>
    </div>
    <div id="addTechnicianForm" style="display:none; margin-top:1rem;">
        <div class="grid-2col">
            <div class="form-group">
                <label>First Name</label>
                <input type="text" class="form-control" placeholder="Enter first name" style="width:100%; padding:10px; border-radius:12px; border:1px solid #E2E8F0;">
            </div>
            <div class="form-group">
                <label>Surname</label>
                <input type="text" class="form-control" placeholder="Enter surname" style="width:100%; padding:10px; border-radius:12px; border:1px solid #E2E8F0;">
            </div>
        </div>
        <div class="grid-2col">
            <div class="form-group">
                <label>SA ID Number</label>
                <input type="text" class="form-control" placeholder="13-digit ID" style="width:100%; padding:10px; border-radius:12px; border:1px solid #E2E8F0;">
            </div>
            <div class="form-group">
                <label>Employee Number</label>
                <input type="text" class="form-control" placeholder="Auto-generated or manual" style="width:100%; padding:10px; border-radius:12px; border:1px solid #E2E8F0;">
            </div>
        </div>
        <div class="grid-2col">
            <div class="form-group">
                <label>Email Address</label>
                <input type="email" class="form-control" placeholder="technician@nmblab.com" style="width:100%; padding:10px; border-radius:12px; border:1px solid #E2E8F0;">
            </div>
            <div class="form-group">
                <label>Contact Number</label>
                <input type="text" class="form-control" placeholder="0821234567" style="width:100%; padding:10px; border-radius:12px; border:1px solid #E2E8F0;">
            </div>
        </div>
        <div class="form-group">
            <label>Assign Test Types</label>
            <select multiple style="width:100%; padding:10px; border-radius:12px; border:1px solid #E2E8F0; height:100px;">
                <option>Full Blood Count</option>
                <option>Coagulation Studies</option>
                <option>Differential Count</option>
                <option>Peripheral Blood Film</option>
                <option>Flow Cytometry</option>
            </select>
            <small style="color:#5A6E7A;">Hold Ctrl to select multiple</small>
        </div>
        <div class="form-group">
            <label><input type="checkbox"> Send auto-generated password via email</label>
        </div>
        <button class="btn-sm-lab" onclick="showDemoAlert('New technician registered! Email sent with credentials.')">Register Technician</button>
    </div>
</div>

