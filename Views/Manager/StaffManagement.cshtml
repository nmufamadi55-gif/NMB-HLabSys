</div>

<style>
    .data-table th {
        background: #F8FAFE;
        font-weight: 600;
        font-size: 0.8rem;
    }

    .form-control:focus {
        outline: none;
        border-color: var(--medical-teal);
        box-shadow: 0 0 0 2px rgba(26,109,115,0.1);
    }
</style>

<script>
    function toggleAddForm() {
        var form = document.getElementById('addTechnicianForm');
        if (form.style.display === 'none') {
            form.style.display = 'block';
        } else {
            form.style.display = 'none';
        }
    }

    function showDemoAlert(message) {
        alert('🔔 ' + message + ' (Demo: Backend integration coming Semester 2)');
    }
</script>