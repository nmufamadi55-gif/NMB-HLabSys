@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Staff Management";
    ViewData["RoleSubtitle"] = "Manager Portal";

    var mgrName = ViewBag.ManagerName as string;
    var initials = "AA";
    if (!string.IsNullOrEmpty(mgrName))
    {
        var parts = mgrName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        initials = string.Concat(parts.Select(p => p[0]));
    }
    ViewData["UserGreeting"] = $"📊 {mgrName ?? "Amanda Adams"} (Lab Manager)";
    ViewData["UserInitials"] = initials;
}

@model NMB_HLabSys.Models.ViewModels.StaffManagementIndexViewModel

@section SidebarMenu {
    <li><a href="@Url.Action("Dashboard", "Manager")"><i class="fas fa-chart-pie"></i> <span>Overview</span></a></li>
    <li><a href="@Url.Action("TestCatalogue", "Manager")"><i class="fas fa-flask"></i> <span>Test Catalogue</span></a></li>
    <li><a href="@Url.Action("StockManagement", "Manager")"><i class="fas fa-boxes"></i> <span>Stock & Orders</span></a></li>
    <li><a href="@Url.Action("Suppliers", "Manager")">Suppliers</a></li>
    <li><a href="@Url.Action("StaffManagement", "Manager")" class="active"><i class="fas fa-users-cog"></i> <span>Staff Management</span></a></li>
    <li><a href="@Url.Action("Reports", "Manager")"><i class="fas fa-file-alt"></i> <span>Reports</span></a></li>
    <li><a href="@Url.Action("Settings", "Manager")"><i class="fas fa-cog"></i> <span>Settings</span></a></li>
}

<div class="stat-cards">
    <div class="stat-item">
        <div class="stat-icon-lg">👥</div>
        <div>
            <h3>@Model.Statistics.TotalTechnicians + @Model.Statistics.TotalDoctors</h3>
            <p>Total Staff</p>
        </div>
    </div>
    <div class="stat-item">
        <div class="stat-icon-lg">🔬</div>
        <div>
            <h3>@Model.Statistics.ActiveTechnicians</h3>
            <p>Lab Technicians</p>
        </div>
    </div>
    <div class="stat-item">
        <div class="stat-icon-lg">👨‍⚕️</div>
        <div>
            <h3>@Model.Statistics.ActiveDoctors</h3>
            <p>Doctors Registered</p>
        </div>
    </div>
    <div class="stat-item">
        <div class="stat-icon-lg">📋</div>
        <div>
            <h3>@Model.Statistics.PendingVerificationDoctors</h3>
            <p>Pending Verification</p>
        </div>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        <i class="fas fa-check-circle"></i> @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        <i class="fas fa-exclamation-circle"></i> @TempData["Error"]
    </div>
}

<!-- Lab Technicians Section -->
<div class="card-modern">
    <div class="card-header-flex">
        <h3>🔬 Lab Technicians</h3>
        <div>
            <a href="@Url.Action("AddTechnician", "Manager")" class="btn-sm-lab" style="margin-right:0.5rem;">
                <i class="fas fa-user-plus"></i> Add Technician
            </a>
            <button class="btn-outline-lab" onclick="bulkImportTechnicians()">
                <i class="fas fa-file-import"></i> Import CSV
            </button>
        </div>
    </div>
    <div class="table-container">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Employee #</th>
                    <th>SA ID Number</th>
                    <th>Contact</th>
                    <th>Email</th>
                    <th>Status</th>
                    <th>Assigned Tests</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Technicians != null && Model.Technicians.Any())
                {
                    foreach (var tech in Model.Technicians)
                    {
                        <tr>
                            <td><strong>@tech.FullName</strong></td>
                            <td>@tech.EmployeeNumber</td>
                            <td>@tech.SAIDNumber</td>
                            <td>@tech.ContactNumber</td>
                            <td>@tech.Email</td>
                            <td>
                                <span class="badge @(tech.IsActive ? "badge-completed" : "badge-progress")">
                                    @tech.Status
                                </span>
                            </td>
                            <td>@tech.AssignedTestsCount assigned</td>
                            <td>
                                <a href="@Url.Action("EditTechnician", "Manager", new { id = tech.TechnicianID })" class="btn-outline-lab" style="margin-right:0.3rem;">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <a href="@Url.Action("TechnicianProfile", "Manager", new { id = tech.TechnicianID })" class="btn-outline-lab" style="margin-right:0.3rem;">
                                    <i class="fas fa-user"></i>
                                </a>
                                <button class="btn-outline-lab" onclick="resetPassword('@tech.FullName', '@tech.Email')">
                                    <i class="fas fa-key"></i>
                                </button>
                                @if (tech.IsActive)
                                {
                                    <button class="btn-outline-lab" onclick="deactivateTechnician('@tech.FullName', @tech.TechnicianID)">
                                        <i class="fas fa-user-slash"></i>
                                    </button>
                                }
                                else
                                {
                                    <button class="btn-sm-lab" onclick="activateTechnician('@tech.FullName', @tech.TechnicianID)">
                                        <i class="fas fa-user-check"></i>
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" style="text-align:center; color:#5A6E7A;">No technicians registered</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Registered Doctors Section -->
<div class="card-modern">
    <div class="card-header-flex">
        <h3>👨‍⚕️ Registered Doctors</h3>
        <div>
            <a href="@Url.Action("RegisterDoctor", "Manager")" class="btn-sm-lab" style="margin-right:0.5rem;">
                <i class="fas fa-user-plus"></i> Register Doctor
            </a>
            <button class="btn-outline-lab" onclick="sendBulkEmail()">
                <i class="fas fa-envelope"></i> Email All
            </button>
        </div>
    </div>
    <div class="table-container">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>HPCSA #</th>
                    <th>Email</th>
                    <th>Practice</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Doctors != null && Model.Doctors.Any())
                {
                    foreach (var doc in Model.Doctors)
                    {
                        <tr>
                            <td><strong>@doc.FullName</strong></td>
                            <td>@doc.HPCSANumber</td>
                            <td>@doc.Email</td>
                            <td>@doc.PracticeName</td>
                            <td>
                                <span class="badge @(doc.IsVerified ? "badge-completed" : "badge-progress")">
                                    @doc.Status
                                </span>
                            </td>
                            <td>
                                <a href="@Url.Action("EditDoctor", "Manager", new { id = doc.DoctorID })" class="btn-outline-lab" style="margin-right:0.3rem;">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <button class="btn-outline-lab" onclick="resetDoctorPassword('@doc.FullName', '@doc.Email')">
                                    <i class="fas fa-key"></i>
                                </button>
                                @if (!doc.IsVerified)
                                {
                                    <button class="btn-sm-lab" onclick="approveDoctor('@doc.FullName', @doc.DoctorID)">
                                        <i class="fas fa-check"></i> Approve
                                    </button>
                                    <button class="btn-outline-lab" onclick="rejectDoctor('@doc.FullName', @doc.DoctorID)">
                                        <i class="fas fa-times"></i>
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" style="text-align:center; color:#5A6E7A;">No doctors registered</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Add New Technician Form (Collapsible) -->
<div class="card-modern">
    <div class="card-header-flex">
        <h3>➕ Quick Add: New Lab Technician</h3>
        <button class="btn-outline-lab" onclick="toggleAddForm()">
            <i class="fas fa-chevron-down"></i> Show/Hide
        </button>
    </div>
    <div id="addTechnicianForm" style="display:none; margin-top:1rem;">
        <form method="post" action="@Url.Action("AddTechnician", "Manager")">
            @Html.AntiForgeryToken()
            <div class="grid-2col">
                <div class="form-group">
                    <label>First Name <span class="required">*</span></label>
                    <input type="text" name="Name" class="form-control" placeholder="Enter first name" required />
                </div>
                <div class="form-group">
                    <label>Surname <span class="required">*</span></label>
                    <input type="text" name="Surname" class="form-control" placeholder="Enter surname" required />
                </div>
            </div>
            <div class="grid-2col">
                <div class="form-group">
                    <label>SA ID Number <span class="required">*</span></label>
                    <input type="text" name="SAIDNumber" class="form-control" placeholder="13-digit ID" required maxlength="13" pattern="\d{13}" />
                </div>
                <div class="form-group">
                    <label>Employee Number <span class="required">*</span></label>
                    <input type="text" name="EmployeeNumber" class="form-control" placeholder="Employee number" required />
                </div>
            </div>
            <div class="grid-2col">
                <div class="form-group">
                    <label>Email Address <span class="required">*</span></label>
                    <input type="email" name="Email" class="form-control" placeholder="technician@nmblab.com" required />
                </div>
                <div class="form-group">
                    <label>Contact Number <span class="required">*</span></label>
                    <input type="text" name="ContactNumber" class="form-control" placeholder="0821234567" required />
                </div>
            </div>
            <div class="grid-2col">
                <div class="form-group">
                    <label>Specialization</label>
                    <input type="text" name="Specialization" class="form-control" placeholder="e.g., Haematology" />
                </div>
                <div class="form-group">
                    <label>Qualification</label>
                    <input type="text" name="Qualification" class="form-control" placeholder="e.g., BSc Medical Lab Science" />
                </div>
            </div>
            <div class="form-group">
                <label>Assign Test Types</label>
                <select name="SelectedTestTypeIDs" multiple style="width:100%; padding:10px; border-radius:12px; border:1px solid #E2E8F0; height:100px;">
                    @if (ViewBag.AvailableTestTypes != null)
                    {
                        foreach (var test in ViewBag.AvailableTestTypes as List<SelectListItem>)
                        {
                            <option value="@test.Value">@test.Text</option>
                        }
                    }
                </select>
                <small class="text-muted">Hold Ctrl to select multiple</small>
            </div>
            <div class="form-group" style="margin-top:1rem;">
                <label>
                    <input type="checkbox" checked /> Send auto-generated password via email
                </label>
            </div>
            <button type="submit" class="btn-sm-lab">
                <i class="fas fa-save"></i> Register Technician
            </button>
        </form>
    </div>
</div>

<style>
    .stat-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .stat-item {
        background: white;
        border-radius: 16px;
        padding: 1.2rem;
        display: flex;
        align-items: center;
        gap: 1rem;
        border: 1px solid #E2E8F0;
    }

    .stat-icon-lg {
        font-size: 2rem;
    }

    .stat-item h3 {
        font-size: 1.5rem;
        color: #032C7D;
        margin: 0;
    }

    .stat-item p {
        font-size: 0.8rem;
        color: #5A6E7A;
        margin: 0;
    }

    .card-modern {
        background: white;
        border-radius: 16px;
        padding: 1.5rem;
        margin-bottom: 1.5rem;
        border: 1px solid #E2E8F0;
        box-shadow: 0 2px 8px rgba(0,0,0,0.04);
    }

    .card-header-flex {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

        .card-header-flex h3 {
            color: #032C7D;
            margin: 0;
            font-size: 1.1rem;
        }

    .table-container {
        overflow-x: auto;
    }

    .data-table {
        width: 100%;
        border-collapse: collapse;
    }

        .data-table th, .data-table td {
            padding: 0.6rem 0.4rem;
            text-align: left;
            border-bottom: 1px solid #E2E8F0;
            font-size: 0.8rem;
        }

        .data-table th {
            background: #F8FAFE;
            font-weight: 600;
            color: #5A6E7A;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

    .badge-completed {
        background: #2C8C6E;
        color: white;
        padding: 0.2rem 0.6rem;
        border-radius: 20px;
        font-size: 0.65rem;
        font-weight: 600;
    }

    .badge-progress {
        background: #E8A845;
        color: white;
        padding: 0.2rem 0.6rem;
        border-radius: 20px;
        font-size: 0.65rem;
        font-weight: 600;
    }

    .grid-2col {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
    }

    .form-group {
        margin-bottom: 0.8rem;
    }

        .form-group label {
            display: block;
            font-size: 0.8rem;
            font-weight: 500;
            color: #032C7D;
            margin-bottom: 0.3rem;
        }

    .required {
        color: #E26D5C;
    }

    .form-control {
        width: 100%;
        padding: 0.6rem 0.8rem;
        border: 1px solid #E2E8F0;
        border-radius: 10px;
        font-size: 0.85rem;
        font-family: 'Inter', sans-serif;
        transition: all 0.2s;
    }

        .form-control:focus {
            outline: none;
            border-color: #0841C9;
            box-shadow: 0 0 0 3px rgba(8,65,201,0.1);
        }

    .text-muted {
        color: #5A6E7A;
        font-size: 0.7rem;
        display: block;
        margin-top: 0.2rem;
    }

    .btn-sm-lab {
        background: linear-gradient(135deg, #0841C9, #1D97F1);
        color: white;
        border: none;
        padding: 0.4rem 1rem;
        border-radius: 30px;
        cursor: pointer;
        font-size: 0.8rem;
        font-family: 'Inter', sans-serif;
        transition: all 0.2s;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        text-decoration: none;
    }

        .btn-sm-lab:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(8,65,201,0.3);
            text-decoration: none;
            color: white;
        }

    .btn-outline-lab {
        background: transparent;
        color: #032C7D;
        border: 1px solid #E2E8F0;
        padding: 0.4rem 1rem;
        border-radius: 30px;
        cursor: pointer;
        font-size: 0.8rem;
        font-family: 'Inter', sans-serif;
        transition: all 0.2s;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        text-decoration: none;
    }

        .btn-outline-lab:hover {
            background: #F8FAFE;
            text-decoration: none;
            color: #032C7D;
        }

    .alert {
        padding: 0.8rem 1rem;
        border-radius: 10px;
        font-size: 0.85rem;
        margin-bottom: 1.2rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .alert-success {
        background: #D1FAE5;
        color: #065F46;
        border-left: 4px solid #10B981;
    }

    .alert-danger {
        background: #FEE2E2;
        color: #991B1B;
        border-left: 4px solid #EF4444;
    }

    @@media (max-width: 768px) {
        .grid-2col

    {
        grid-template-columns: 1fr;
    }

    .stat-cards {
        grid-template-columns: 1fr 1fr;
    }

    }

    @@media (max-width: 480px) {
        .stat-cards

    {
        grid-template-columns: 1fr;
    }

    .card-header-flex {
        flex-direction: column;
        align-items: flex-start;
    }

    }
</style>

<script>
    // ========== TECHNICIAN FUNCTIONS ==========
    function resetPassword(name, email) {
        if (confirm(`Reset password for ${name}? A new auto-generated password will be emailed to ${email}.`)) {
            alert(`🔑 Password reset email sent to ${email}\n\nUser must change password at first login.`);
        }
    }

    function activateTechnician(name, id) {
        if (confirm(`Activate technician: ${name}?`)) {
            alert(`✅ Technician "${name}" has been activated.`);
            location.reload();
        }
    }

    function deactivateTechnician(name, id) {
        if (confirm(`Deactivate technician: ${name}? This will prevent them from logging in.`)) {
            alert(`🔴 Technician "${name}" has been deactivated.`);
            location.reload();
        }
    }

    function bulkImportTechnicians() {
        alert(`📂 Bulk Import Technicians\n\nPlease select a CSV file with the following columns:\n- First Name\n- Surname\n- SA ID Number\n- Employee Number\n- Email\n- Contact Number\n- Test Types (comma-separated)`);
    }

    // ========== DOCTOR FUNCTIONS ==========
    function resetDoctorPassword(name, email) {
        if (confirm(`Reset password for ${name}? A new auto-generated password will be emailed to ${email}.`)) {
            alert(`🔑 Password reset email sent to ${email}\n\nUser must change password at first login.`);
        }
    }

    function approveDoctor(name, id) {
        if (confirm(`Approve doctor registration: ${name}?`)) {
            alert(`✅ Doctor "${name}" has been approved.\n📧 Approval email sent with login credentials.`);
            location.reload();
        }
    }

    function rejectDoctor(name, id) {
        if (confirm(`Reject doctor registration: ${name}?`)) {
            let reason = prompt('Please provide rejection reason:');
            if (reason) {
                alert(`❌ Doctor "${name}" registration rejected.\n📧 Notification email sent with reason: ${reason}`);
                location.reload();
            }
        }
    }

    function sendBulkEmail() {
        let subject = prompt('Email Subject:');
        let message = prompt('Email Message:');
        if (subject && message) {
            alert(`📧 Bulk email sent to all doctors.\n\nSubject: ${subject}`);
        }
    }

    // ========== UI HELPERS ==========
    function toggleAddForm() {
        var form = document.getElementById('addTechnicianForm');
        if (form) {
            form.style.display = form.style.display === 'none' ? 'block' : 'none';
        }
    }
</script>