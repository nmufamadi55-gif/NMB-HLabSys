<script>
    let currentStockItem = null;
    let currentStockId = null;
    let currentStockValue = 0;

    // ========== STOCK ADJUSTMENT FUNCTIONS ==========
    function openStockModal(itemName, itemId, currentQty) {
        currentStockItem = itemName;
        currentStockId = itemId;
        currentStockValue = currentQty;

        document.getElementById('stockModalTitle').innerText = 'Adjust Stock: ' + itemName;
        document.getElementById('stockConsumable').value = itemName;
        document.getElementById('stockCurrentQty').value = currentQty;
        document.getElementById('adjustmentAmount').value = '';
        document.getElementById('adjustmentReason').value = '';
        document.getElementById('stockModal').style.display = 'flex';
    }

    function toggleAdjustmentInput() {
        let type = document.getElementById('adjustmentType').value;
        let label = document.getElementById('adjustmentLabel');
        if (type === 'ManualIncrease') label.innerText = 'Amount to Increase (+)';
        else if (type === 'ManualDecrease') label.innerText = 'Amount to Decrease (-)';
        else label.innerText = 'New Quantity (=)';
    }

    function closeStockModal() {
        document.getElementById('stockModal').style.display = 'none';
    }

    function saveStockAdjustment() {
        let type = document.getElementById('adjustmentType').value;
        let amount = parseInt(document.getElementById('adjustmentAmount').value);
        let reason = document.getElementById('adjustmentReason').value || 'Manual adjustment';
        let newQty = currentStockValue;

        if (isNaN(amount) || amount <= 0) {
            alert('Please enter a valid amount');
            return;
        }

        if (type === 'ManualIncrease') newQty = currentStockValue + amount;
        else if (type === 'ManualDecrease') newQty = Math.max(0, currentStockValue - amount);
        else if (type === 'ManualSet') newQty = amount;

        // Update the displayed quantity
        const qtySpan = document.getElementById('qty-' + currentStockId);
        if (qtySpan) qtySpan.innerText = newQty;

        alert(`✅ Stock adjusted: ${currentStockItem}\nOld: ${currentStockValue} → New: ${newQty}\nReason: ${reason}`);
        closeStockModal();

        // Reload to reflect changes
        location.reload();
    }

