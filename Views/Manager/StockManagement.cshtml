@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Stock Management";
    ViewData["RoleSubtitle"] = "Manager Portal";

    var mgrName = ViewBag.ManagerName as string;
    var initials = "AA";
    if (!string.IsNullOrEmpty(mgrName))
    {
        var parts = mgrName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        initials = string.Concat(parts.Select(p => p[0]));
    }
    ViewData["UserGreeting"] = $"📊 {mgrName ?? "Amanda Adams"} (Lab Manager)";
    ViewData["UserInitials"] = initials;
}

@model NMB_HLabSys.Models.ViewModels.StockManagementIndexViewModel

@section SidebarMenu {
    <li><a href="@Url.Action("Dashboard", "Manager")"><i class="fas fa-chart-pie"></i> <span>Overview</span></a></li>
    <li><a href="@Url.Action("TestCatalogue", "Manager")"><i class="fas fa-flask"></i> <span>Test Catalogue</span></a></li>
    <li><a href="@Url.Action("StockManagement", "Manager")" class="active"><i class="fas fa-boxes"></i> <span>Stock & Orders</span></a></li>
    <li><a href="@Url.Action("Suppliers", "Manager")">Suppliers</a></li>
    <li><a href="@Url.Action("StaffManagement", "Manager")"><i class="fas fa-users-cog"></i> <span>Staff Management</span></a></li>
    <li><a href="@Url.Action("Reports", "Manager")"><i class="fas fa-file-alt"></i> <span>Reports</span></a></li>
    <li><a href="@Url.Action("Settings", "Manager")"><i class="fas fa-cog"></i> <span>Settings</span></a></li>
}

<!-- Stock Adjustment Modal -->
<div id="stockModal" class="modal-overlay" style="display:none;">
    <div class="modal-card" style="max-width:450px;">
        <h3 id="stockModalTitle">Adjust Stock</h3>
        <form id="stockAdjustForm">
            <div class="form-group">
                <label>Consumable</label>
                <input type="text" id="stockConsumable" class="form-control" readonly>
            </div>
            <div class="form-group">
                <label>Current Quantity</label>
                <input type="text" id="stockCurrentQty" class="form-control" readonly>
            </div>
            <div class="form-group">
                <label>Adjustment Type</label>
                <select id="adjustmentType" class="form-control" onchange="toggleAdjustmentInput()">
                    <option value="ManualIncrease">+ Increase by</option>
                    <option value="ManualDecrease">- Decrease by</option>
                    <option value="ManualSet">= Set to specific value</option>
                </select>
            </div>
            <div class="form-group">
                <label id="adjustmentLabel">Amount to Increase</label>
                <input type="number" id="adjustmentAmount" class="form-control" placeholder="Enter amount" min="1">
            </div>
            <div class="form-group">
                <label>Reason for Adjustment</label>
                <input type="text" id="adjustmentReason" class="form-control" placeholder="e.g., Physical count correction" />
            </div>
            <div class="modal-actions">
                <button type="button" class="btn-outline-lab" onclick="closeStockModal()">Cancel</button>
                <button type="button" class="btn-sm-lab" onclick="saveStockAdjustment()">Apply Adjustment</button>
            </div>
        </form>
    </div>
</div>

<!-- Create Order Modal -->
<div id="orderModal" class="modal-overlay" style="display:none;">
    <div class="modal-card" style="max-width:650px;">
        <h3>Create Stock Order</h3>
        <form method="post" action="@Url.Action("CreateOrder", "Manager")">
            @Html.AntiForgeryToken()
            <div class="form-group">
                <label>Supplier <span class="required">*</span></label>
                <select name="SupplierID" id="orderSupplier" class="form-control" required>
                    <option value="">-- Select Supplier --</option>
                    @if (Model.Suppliers != null)
                    {
                        foreach (var supplier in Model.Suppliers)
                        {
                            <option value="@supplier.SupplierID">@supplier.SupplierName</option>
                        }
                    }
                </select>
            </div>
            <div class="form-group">
                <label>Expected Delivery Date</label>
                <input type="date" name="ExpectedDeliveryDate" class="form-control" />
            </div>
            <div class="form-group">
                <label>Items to Order</label>
                <div id="orderItems">
                    @if (Model.Consumables != null)
                    {
                        foreach (var item in Model.Consumables.Where(c => c.QuantityOnHand <= c.ReorderLevel * 1.1m))
                        {
                            <div class="order-item">
                                <input type="checkbox" name="Items[@item.ConsumableID].IsSelected" value="true" />
                                <input type="hidden" name="Items[@item.ConsumableID].ConsumableID" value="@item.ConsumableID" />
                                <input type="hidden" name="Items[@item.ConsumableID].ConsumableName" value="@item.ConsumableName" />
                                <input type="hidden" name="Items[@item.ConsumableID].CurrentStock" value="@item.QuantityOnHand" />
                                <input type="hidden" name="Items[@item.ConsumableID].ReorderLevel" value="@item.ReorderLevel" />
                                <input type="hidden" name="Items[@item.ConsumableID].SuggestedQuantity" value="@(Math.Max(item.ReorderLevel * 2 - item.QuantityOnHand, 10))" />

                                <strong>@item.ConsumableName</strong>
                                <span>Current: @item.QuantityOnHand | Reorder: @item.ReorderLevel</span>
                                <input type="number" name="Items[@item.ConsumableID].QuantityToOrder" placeholder="Qty" class="order-qty" min="1" />
                            </div>
                        }
                    }
                </div>
            </div>
            <div class="modal-actions">
                <button type="button" class="btn-outline-lab" onclick="closeOrderModal()">Cancel</button>
                <button type="submit" class="btn-sm-lab">Submit Order & Email Supplier</button>
            </div>
        </form>
    </div>
</div>

<!-- Cancel Order Modal -->
<div id="cancelOrderModal" class="modal-overlay" style="display:none;">
    <div class="modal-card" style="max-width:450px;">
        <h3>Cancel Order</h3>
        <form id="cancelOrderForm">
            <div class="form-group">
                <label>Order ID</label>
                <input type="text" id="cancelOrderId" class="form-control" readonly>
            </div>
            <div class="form-group">
                <label>Reason for Cancellation <span class="required">*</span></label>
                <textarea id="cancelReason" class="form-control" rows="3" placeholder="Please provide reason..."></textarea>
            </div>
            <div class="form-group">
                <label><input type="checkbox" id="notifySupplier" checked> Notify supplier via email</label>
            </div>
            <div class="modal-actions">
                <button type="button" class="btn-outline-lab" onclick="closeCancelOrderModal()">Back</button>
                <button type="button" class="btn-sm-lab" onclick="confirmCancelOrder()">Confirm Cancellation</button>
            </div>
        </form>
    </div>
</div>

<!-- View Supplier Modal -->
<div id="supplierModal" class="modal-overlay" style="display:none;">
    <div class="modal-card" style="max-width:500px;">
        <h3 id="supplierModalTitle">Supplier Details</h3>
        <div class="supplier-detail">
            <p><strong>Name:</strong> <span id="suppDetailName"></span></p>
            <p><strong>Contact Person:</strong> <span id="suppDetailContact"></span></p>
            <p><strong>Email:</strong> <span id="suppDetailEmail"></span></p>
            <p><strong>Phone:</strong> <span id="suppDetailPhone"></span></p>
            <p><strong>Address:</strong> <span id="suppDetailAddress"></span></p>
        </div>
        <div class="modal-actions">
            <button type="button" class="btn-outline-lab" onclick="closeSupplierModal()">Close</button>
            <button type="button" class="btn-sm-lab" onclick="editSupplier()">Edit Supplier</button>
        </div>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        <i class="fas fa-check-circle"></i> @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        <i class="fas fa-exclamation-circle"></i> @TempData["Error"]
    </div>
}

<div class="stat-cards">
    <div class="stat-item">
        <div class="stat-icon-lg">🔴</div>
        <div>
            <h3>@Model.Statistics.ItemsBelowReorder</h3>
            <p>Below Reorder Level</p>
        </div>
    </div>
    <div class="stat-item">
        <div class="stat-icon-lg">📦</div>
        <div>
            <h3>@Model.Statistics.TotalConsumables</h3>
            <p>Total Items</p>
        </div>
    </div>
    <div class="stat-item">
        <div class="stat-icon-lg">✅</div>
        <div>
            <h3>@Model.PendingOrders?.Count ?? 0</h3>
            <p>Pending Orders</p>
        </div>
    </div>
    <div class="stat-item">
        <div class="stat-icon-lg">💰</div>
        <div>
            <h3>R@(Model.Statistics.TotalStockValue.ToString("N0"))</h3>
            <p>Total Stock Value</p>
        </div>
    </div>
</div>

<div class="card-modern">
    <div class="card-header-flex">
        <h3>📦 Current Inventory</h3>
        <div>
            <a href="@Url.Action("CreateConsumable", "Manager")" class="btn-sm-lab" style="margin-right:0.5rem;">
                <i class="fas fa-plus"></i> Add Item
            </a>
            <button class="btn-outline-lab" onclick="openOrderModal()">
                <i class="fas fa-shopping-cart"></i> Create Order
            </button>
        </div>
    </div>
    <div class="table-container">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Consumable</th>
                    <th>Quantity On Hand</th>
                    <th>Reorder Level</th>
                    <th>Supplier</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Consumables != null && Model.Consumables.Any())
                {
                    foreach (var item in Model.Consumables)
                    {
                        <tr>
                            <td><strong>@item.ConsumableName</strong></td>
                            <td><span id="qty-@item.ConsumableID">@item.QuantityOnHand</span></td>
                            <td>@item.ReorderLevel</td>
                            <td>
                                @item.SupplierName
                                <button class="btn-link" onclick="viewSupplier(@item.ConsumableID)">View</button>
                            </td>
                            <td>
                                <span class="badge @(item.StockStatus == "Critical" ? "badge-critical" : item.StockStatus == "Low" ? "badge-low" : item.StockStatus == "Warning" ? "badge-warning" : "badge-completed")">
                                    @item.StockStatus
                                </span>
                            </td>
                            <td>
                                <button class="btn-sm-lab" onclick="openStockModal('@item.ConsumableName', @item.ConsumableID, @item.QuantityOnHand)">
                                    <i class="fas fa-edit"></i>
                                </button>
                                <a href="@Url.Action("EditConsumable", "Manager", new { id = item.ConsumableID })" class="btn-outline-lab" style="margin-right:0.3rem;">
                                    <i class="fas fa-pencil-alt"></i>
                                </a>
                                <button class="btn-outline-lab" onclick="reorderItem('@item.ConsumableName', @item.ConsumableID)">
                                    <i class="fas fa-redo"></i>
                                </button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" style="text-align:center; color:#5A6E7A;">No consumables found</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="grid-2col">
    <div class="card-modern">
        <div class="card-header-flex">
            <h3>📋 Suppliers</h3>
            <button class="btn-outline-lab" onclick="addSupplier()">
                <i class="fas fa-plus"></i> Add Supplier
            </button>
        </div>
        <ul style="margin-top:1rem;">
            @if (Model.Suppliers != null && Model.Suppliers.Any())
            {
                foreach (var supplier in Model.Suppliers)
                {
                    <li style="padding: 8px 0; border-bottom: 1px solid #E2E8F0;">
                        <strong>@supplier.SupplierName</strong>
                        <span style="color:#5A6E7A; font-size:0.8rem;">(@supplier.ContactPerson)</span>
                        <br />
                        <span style="font-size:0.75rem; color:#5A6E7A;">@supplier.EmailAddress</span>
                        <div style="margin-top:4px;">
                            <button class="btn-link" onclick="viewSupplierDetails(@supplier.SupplierID)">View</button>
                            <button class="btn-link" onclick="editSupplierById(@supplier.SupplierID)">Edit</button>
                            <span class="badge badge-supplier">@supplier.ConsumableCount items</span>
                            @if (supplier.IsPreferred)
                            {
                                <span class="badge badge-completed">⭐ Preferred</span>
                            }
                        </div>
                    </li>
                }
            }
            else
            {
                <li style="color:#5A6E7A;">No suppliers found</li>
            }
        </ul>
    </div>
    <div class="card-modern">
        <div class="card-header-flex">
            <h3>📦 Pending Orders</h3>
            <a href="@Url.Action("ViewOrder", "Manager")" class="btn-outline-lab">
                <i class="fas fa-eye"></i> View All
            </a>
        </div>
        <ul style="margin-top:1rem;">
            @if (Model.PendingOrders != null && Model.PendingOrders.Any())
            {
                foreach (var order in Model.PendingOrders.Take(3))
                {
                    <li style="padding: 10px 0; border-bottom: 1px solid #E2E8F0;">
                        <strong>@order.OrderNumber</strong>
                        <span style="font-size:0.8rem;">@order.SupplierName</span>
                        <br />
                        <span class="badge @(order.Status == "PartiallyComplete" ? "badge-progress" : "badge-ordered")">
                            @order.Status
                        </span>
                        <span style="font-size:0.7rem; color:#5A6E7A; margin-left:8px;">
                            @order.ItemsReceived/@order.TotalItems items received
                        </span>
                        <div style="margin-top:4px;">
                            <a href="@Url.Action("OrderDetails", "Manager", new { id = order.OrderID })" class="btn-link">View</a>
                            <button class="btn-link" onclick="markOrderReceived('@order.OrderNumber', @order.OrderID)">Mark Received</button>
                            <button class="btn-link" onclick="cancelOrder('@order.OrderNumber', @order.OrderID)">Cancel</button>
                        </div>
                    </li>
                }
            }
            else
            {
                <li style="color:#5A6E7A;">No pending orders</li>
            }
        </ul>
        <button class="btn-sm-lab" style="margin-top:1rem;" onclick="openOrderModal()">
            <i class="fas fa-plus"></i> Create Order
        </button>
    </div>
</div>

