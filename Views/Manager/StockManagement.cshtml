    let currentCancelOrderId = null;
    let currentCancelOrderNum = null;

    function markOrderReceived(orderNum, orderId) {
        if (confirm(`Mark order ${orderNum} as received? Stock levels will be updated automatically.`)) {
            alert(`✅ Order ${orderNum} marked as received.\n📦 Stock levels updated.\n✅ Order status changed to "Complete".`);
            location.reload();
        }
    }

    function cancelOrder(orderNum, orderId) {
        currentCancelOrderId = orderId;
        currentCancelOrderNum = orderNum;
        document.getElementById('cancelOrderId').value = orderNum;
        document.getElementById('cancelReason').value = '';
        document.getElementById('cancelOrderModal').style.display = 'flex';
    }

    function closeCancelOrderModal() {
        document.getElementById('cancelOrderModal').style.display = 'none';
    }

    function confirmCancelOrder() {
        let reason = document.getElementById('cancelReason').value;
        let notify = document.getElementById('notifySupplier').checked;

        if (!reason) {
            alert('Please provide a reason for cancellation');
            return;
        }

        alert(`❌ Order ${currentCancelOrderNum} cancelled.\n📝 Reason: ${reason}\n📅 Cancellation date: ${new Date().toLocaleDateString()}\n📧 Supplier notified: ${notify ? 'Yes' : 'No'}`);
        closeCancelOrderModal();
        location.reload();
    }

