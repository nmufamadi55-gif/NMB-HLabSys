@using NMB_HLabSys.Models.ViewModels
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Test Catalogue";
    ViewData["RoleSubtitle"] = "Manager Portal";

    var mgrName = ViewBag.ManagerName as string;
    var initials = "AA";
    if (!string.IsNullOrEmpty(mgrName))
    {
        var parts = mgrName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        initials = string.Concat(parts.Select(p => p[0]));
    }
    ViewData["UserGreeting"] = $"Manager: {mgrName ?? "Amanda Adams"}";
    ViewData["UserInitials"] = initials;
}

@model NMB_HLabSys.Models.ViewModels.TestCatalogueIndexViewModel

@section SidebarMenu {
    <li><a href="@Url.Action("Dashboard", "Manager")">Overview</a></li>
    <li><a href="@Url.Action("TestCatalogue", "Manager")" class="active">Test Catalogue</a></li>
    <li><a href="@Url.Action("StockManagement", "Manager")">Stock and Orders</a></li>
    <li><a href="@Url.Action("Suppliers", "Manager")">Suppliers</a></li>
    <li><a href="@Url.Action("StaffManagement", "Manager")">Staff Management</a></li>
    <li><a href="@Url.Action("Reports", "Manager")">Reports</a></li>
    <li><a href="@Url.Action("Settings", "Manager")">Settings</a></li>
}

<!-- Category Modal -->
<div id="categoryModal" class="modal-overlay" style="display:none;">
    <div class="modal-card">
        <h3 id="categoryModalTitle">Add Test Category</h3>
        <form id="categoryForm">
            <div class="form-group">
                <label>Category Name *</label>
                <input type="text" id="catName" class="form-control" placeholder="Enter category name" />
                <span id="catNameError" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label>Description</label>
                <textarea id="catDesc" class="form-control" rows="3" placeholder="Describe the test category"></textarea>
            </div>
            <div class="modal-actions">
                <button type="button" class="btn-outline-lab" onclick="closeCategoryModal()">Cancel</button>
                <button type="button" class="btn-sm-lab" onclick="saveCategory()">Save Category</button>
            </div>
        </form>
    </div>
</div>

<!-- Test Type Modal -->
<div id="testTypeModal" class="modal-overlay" style="display:none;">
    <div class="modal-card" style="max-width:700px;">
        <h3 id="testTypeModalTitle">Add New Test Type</h3>
        <form id="testTypeForm">
            <div class="grid-2col">
                <div class="form-group">
                    <label>Test Name *</label>
                    <input type="text" id="testName" class="form-control" placeholder="Enter test name" />
                </div>
                <div class="form-group">
                    <label>Category *</label>
                    <select id="testCategory" class="form-control">
                        @if (Model.Categories != null)
                        {
                            foreach (var cat in Model.Categories)
                            {
                                <option value="@cat.CategoryID">@cat.CategoryName</option>
                            }
                        }
                    </select>
                </div>
            </div>
            <div class="grid-2col">
                <div class="form-group">
                    <label>Sample Type</label>
                    <select id="sampleType" class="form-control">
                        @if (Model.SampleTypes != null)
                        {
                            foreach (var sample in Model.SampleTypes)
                            {
                                <option value="@sample.SampleTypeID">@sample.SampleTypeName</option>
                            }
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label>Unit of Measurement</label>
                    <input type="text" id="unit" class="form-control" placeholder="e.g., g/dL, x103/uL" />
                </div>
            </div>
            <div class="grid-2col">
                <div class="form-group">
                    <label>Normal Range Minimum</label>
                    <input type="text" id="rangeMin" class="form-control" placeholder="e.g., 12.0" />
                </div>
                <div class="form-group">
                    <label>Normal Range Maximum</label>
                    <input type="text" id="rangeMax" class="form-control" placeholder="e.g., 16.0" />
                </div>
            </div>
            <div class="grid-2col">
                <div class="form-group">
                    <label>Turnaround Time (minutes) *</label>
                    <input type="number" id="tat" class="form-control" placeholder="e.g., 45" />
                </div>
                <div class="form-group">
                    <label>Consumable(s)</label>
                    <select id="consumables" multiple class="form-control" size="3">
                        <option>EDTA Tube</option>
                        <option>Citrate Tube</option>
                        <option>Reagent Kit A</option>
                    </select>
                    <small class="text-muted">Hold Ctrl to select multiple</small>
                </div>
            </div>
            <div class="modal-actions">
                <button type="button" class="btn-outline-lab" onclick="closeTestTypeModal()">Cancel</button>
                <button type="button" class="btn-sm-lab" onclick="saveTestType()">Save Test Type</button>
            </div>
        </form>
    </div>
</div>

<!-- Assign Technicians Modal -->
<div id="assignTechniciansModal" class="modal-overlay" style="display:none;">
    <div class="modal-card" style="max-width:500px;">
        <h3>Assign Technicians to: <span id="assignTestName">Test</span></h3>
        <form id="assignForm">
            <div class="form-group">
                <label>Select Technicians</label>
                <select id="technicianList" multiple class="form-control" size="5">
                    <!-- Populated from ViewBag or Model -->
                    <option>Michael Peters</option>
                    <option>Tech Smith</option>
                    <option>Jane Williams</option>
                    <option>David Ngema</option>
                </select>
                <small class="text-muted">Hold Ctrl to select multiple</small>
            </div>
            <div class="modal-actions">
                <button type="button" class="btn-outline-lab" onclick="closeAssignModal()">Cancel</button>
                <button type="button" class="btn-sm-lab" onclick="saveAssignments()">Save Assignments</button>
            </div>
        </form>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<div class="card-modern">
    <div class="card-header-flex">
        <h3>Test Categories and Types</h3>
        <div>
            <button class="btn-sm-lab" onclick="openCategoryModal()">Add Category</button>
            <button class="btn-outline-lab" onclick="openTestTypeModal()" style="margin-left:0.5rem;">Add Test Type</button>
        </div>
    </div>
    <div class="table-container">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Category</th>
                    <th>Test Name</th>
                    <th>Sample Type</th>
                    <th>Unit</th>
                    <th>Normal Range</th>
                    <th>Turnaround</th>
                    <th>Consumables</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Categories != null && Model.Categories.Any())
                {
                    var firstRow = true;
                    foreach (var category in Model.Categories)
                    {
                        var testTypes = Model.TestTypes?.Where(t => t.CategoryName == category.CategoryName).ToList() ?? new List<TestTypeViewModel>();

                        if (!testTypes.Any())
                        {
                            <tr>
                                <td>
                                    @category.CategoryName
                                    <div class="action-group">
                                        <button class="btn-icon" onclick="editCategory(@category.CategoryID)">Edit</button>
                                        <button class="btn-icon" onclick="deleteCategory(@category.CategoryID)">Delete</button>
                                    </div>
                                </td>
                                <td colspan="7" style="color: #5A6E7A; text-align:center;">No test types in this category</td>
                            </tr>
                        }
                        else
                        {
                            foreach (var test in testTypes)
                            {
                                <tr>
                                    @if (firstRow)
                                    {
                                        <td rowspan="@testTypes.Count">
                                            @category.CategoryName
                                            <div class="action-group">
                                                <button class="btn-icon" onclick="editCategory(@category.CategoryID)">Edit</button>
                                                <button class="btn-icon" onclick="deleteCategory(@category.CategoryID)">Delete</button>
                                            </div>
                                        </td>
                                        firstRow = false;
                                    }
                                    <td>@test.TestName</td>
                                    <td>@test.SampleTypeName</td>
                                    <td>@test.UnitOfMeasurement</td>
                                    <td>@test.NormalRangeDisplay</td>
                                    <td>@test.TurnaroundTimeDisplay</td>
                                    <td>@string.Join(", ", test.Consumables?.Select(c => c.ConsumableName) ?? new List<string>())</td>
                                    <td>
                                        <div class="action-group">
                                            <button class="btn-outline-lab" onclick="editTestType(@test.TestID)">Edit</button>
                                            <button class="btn-outline-lab" onclick="openAssignModal('@test.TestName')">Assign</button>
                                            <button class="btn-sm-lab" onclick="verifyTest('@test.TestName')">Verify</button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        firstRow = true;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" style="text-align:center; color:#5A6E7A;">No test categories found</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<style>
    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0,0,0,0.5);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1000;
    }

    .modal-card {
        background: white;
        border-radius: 16px;
        padding: 1.5rem;
        width: 90%;
        max-width: 700px;
        max-height: 90vh;
        overflow-y: auto;
    }

    .modal-actions {
        display: flex;
        justify-content: flex-end;
        gap: 1rem;
        margin-top: 1.5rem;
        padding-top: 1rem;
        border-top: 1px solid #E2E8F0;
    }

    .action-group {
        display: flex;
        gap: 0.3rem;
        flex-wrap: wrap;
        margin-top: 0.2rem;
    }

    .btn-icon {
        background: none;
        border: none;
        cursor: pointer;
        font-size: 0.75rem;
        color: #5A6E7A;
        padding: 0 0.3rem;
        text-decoration: underline;
    }

        .btn-icon:hover {
            color: #032C7D;
        }

    .card-modern {
        background: white;
        border-radius: 16px;
        padding: 1.5rem;
        margin-bottom: 1.5rem;
        border: 1px solid #E2E8F0;
        box-shadow: 0 2px 8px rgba(0,0,0,0.04);
    }

    .card-header-flex {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

        .card-header-flex h3 {
            color: #032C7D;
            margin: 0;
            font-size: 1.1rem;
        }

    .btn-sm-lab {
        background: linear-gradient(135deg, #0841C9, #1D97F1);
        color: white;
        border: none;
        padding: 0.4rem 1rem;
        border-radius: 30px;
        cursor: pointer;
        font-size: 0.8rem;
        font-family: 'Inter', sans-serif;
        transition: all 0.2s;
    }

        .btn-sm-lab:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(8,65,201,0.3);
        }

    .btn-outline-lab {
        background: transparent;
        color: #032C7D;
        border: 1px solid #E2E8F0;
        padding: 0.4rem 1rem;
        border-radius: 30px;
        cursor: pointer;
        font-size: 0.8rem;
        font-family: 'Inter', sans-serif;
        transition: all 0.2s;
    }

        .btn-outline-lab:hover {
            background: #F8FAFE;
        }

    .table-container {
        overflow-x: auto;
    }

    .data-table {
        width: 100%;
        border-collapse: collapse;
    }

        .data-table th, .data-table td {
            padding: 0.6rem 0.4rem;
            text-align: left;
            border-bottom: 1px solid #E2E8F0;
            font-size: 0.8rem;
        }

        .data-table th {
            background: #F8FAFE;
            font-weight: 600;
            color: #5A6E7A;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

    .form-group {
        margin-bottom: 0.8rem;
    }

        .form-group label {
            display: block;
            font-size: 0.8rem;
            font-weight: 500;
            color: #032C7D;
            margin-bottom: 0.3rem;
        }

    .form-control {
        width: 100%;
        padding: 0.6rem 0.8rem;
        border: 1px solid #E2E8F0;
        border-radius: 10px;
        font-size: 0.85rem;
        font-family: 'Inter', sans-serif;
        transition: all 0.2s;
        background: white;
    }

        .form-control:focus {
            outline: none;
            border-color: #0841C9;
            box-shadow: 0 0 0 3px rgba(8,65,201,0.1);
        }

    .text-danger {
        color: #991B1B;
        font-size: 0.75rem;
        display: block;
        margin-top: 0.2rem;
    }

    .text-muted {
        color: #5A6E7A;
        font-size: 0.7rem;
        display: block;
        margin-top: 0.2rem;
    }

    .grid-2col {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
    }

    .alert {
        padding: 0.8rem 1rem;
        border-radius: 10px;
        font-size: 0.85rem;
        margin-bottom: 1.2rem;
    }

    .alert-success {
        background: #D1FAE5;
        color: #065F46;
        border-left: 4px solid #10B981;
    }

    .alert-danger {
        background: #FEE2E2;
        color: #991B1B;
        border-left: 4px solid #EF4444;
    }

    .alert-warning {
        background: #FEF3C7;
        color: #92400E;
        border-left: 4px solid #F59E0B;
    }

    .alert-info {
        background: #EFF6FF;
        color: #1E40AF;
        border-left: 4px solid #3B82F6;
    }

    @@media (max-width: 768px) {
        .grid-2col {
            grid-template-columns: 1fr;
        }

        .card-header-flex {
            flex-direction: column;
            align-items: flex-start;
        }
    }
</style>

<script>
    // Category Functions
    function openCategoryModal() {
        document.getElementById('categoryModalTitle').innerText = 'Add Test Category';
        document.getElementById('catName').value = '';
        document.getElementById('catDesc').value = '';
        document.getElementById('categoryModal').style.display = 'flex';
    }

    function editCategory(categoryId) {
        document.getElementById('categoryModalTitle').innerText = 'Edit Test Category';
        document.getElementById('catName').value = 'Category Name'; // Would fetch from server
        document.getElementById('catDesc').value = 'Category description'; // Would fetch from server
        document.getElementById('categoryModal').style.display = 'flex';
    }

    function deleteCategory(categoryId) {
        if (confirm('Are you sure you want to delete this category? This will also delete all tests in this category.')) {
            alert('Category deleted successfully');
            location.reload();
        }
    }

    function closeCategoryModal() {
        document.getElementById('categoryModal').style.display = 'none';
    }

    function saveCategory() {
        var name = document.getElementById('catName').value;
        var desc = document.getElementById('catDesc').value;
        if (!name) {
            alert('Please enter a category name');
            return;
        }
        alert('Category "' + name + '" saved successfully');
        closeCategoryModal();
        location.reload();
    }

    // Test Type Functions
    function openTestTypeModal() {
        document.getElementById('testTypeModalTitle').innerText = 'Add New Test Type';
        document.getElementById('testName').value = '';
        document.getElementById('unit').value = '';
        document.getElementById('rangeMin').value = '';
        document.getElementById('rangeMax').value = '';
        document.getElementById('tat').value = '';
        document.getElementById('testTypeModal').style.display = 'flex';
    }

    function editTestType(testId) {
        document.getElementById('testTypeModalTitle').innerText = 'Edit Test Type';
        document.getElementById('testName').value = 'Test Name'; // Would fetch from server
        document.getElementById('testTypeModal').style.display = 'flex';
    }

    function closeTestTypeModal() {
        document.getElementById('testTypeModal').style.display = 'none';
    }

    function saveTestType() {
        var name = document.getElementById('testName').value;
        if (!name) {
            alert('Please enter a test name');
            return;
        }
        alert('Test Type "' + name + '" saved successfully');
        closeTestTypeModal();
        location.reload();
    }

    // Assignment Functions
    function openAssignModal(testName) {
        document.getElementById('assignTestName').innerText = testName;
        document.getElementById('assignTechniciansModal').style.display = 'flex';
    }

    function closeAssignModal() {
        document.getElementById('assignTechniciansModal').style.display = 'none';
    }

    function saveAssignments() {
        var select = document.getElementById('technicianList');
        var selected = Array.from(select.selectedOptions).map(function(opt) { return opt.value; });
        alert(selected.length + ' technician(s) assigned successfully');
        closeAssignModal();
        location.reload();
    }

    // Verify Function
    function verifyTest(testName) {
        alert('Verify Test: ' + testName + '\n\nPlease enter verification notes.');
    }

    // Close modal on outside click
    document.addEventListener('click', function(event) {
        if (event.target.classList.contains('modal-overlay')) {
            event.target.style.display = 'none';
        }
    });
</script>