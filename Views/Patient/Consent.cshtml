@using NMB_HLabSys.ViewModels.PatientViewModels
@model PatientConsentManagementViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Consent Management";
    ViewData["RoleSubtitle"] = "Patient Portal";
    ViewData["UserGreeting"] = $"🩺 {Model.FullName} (ID: {Model.PatientID})";
    ViewData["UserInitials"] = Model.FullName.Substring(0, 1);
}

@section SidebarMenu {
    <li><a href="@Url.Action("Dashboard", "Patient")">📋 My Results</a></li>
    <li><a href="@Url.Action("MedicalHistory", "Patient")">📝 Medical History</a></li>
    <li><a href="@Url.Action("Consent", "Patient")" class="active">🔐 Consent Management</a></li>
    <li><a href="@Url.Action("Trends", "Patient")">📈 Track Trends</a></li>
    <li><a href="@Url.Action("Index", "Profile")"><i class="fas fa-user-circle"></i> <span>My Profile</span></a></li>
}

<style>
    .security-badge {
        display: inline-block;
        padding: 5px 12px;
        border-radius: 20px;
        background: #DCFCE7;
        color: #166534;
        font-size: 0.75rem;
        font-weight: 600;
        margin-right: 8px;
    }

    .doctor-card {
        transition: 0.25s;
    }

        .doctor-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.08);
        }

    .status-pill {
        padding: 5px 12px;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 600;
    }

    .status-active {
        background: #DCFCE7;
        color: #166534;
    }

    .status-revoked {
        background: #FEE2E2;
        color: #991B1B;
    }

    .info-box {
        background: #EFF6FF;
        padding: 1rem;
        border-radius: 16px;
        margin-bottom: 1.5rem;
    }

    .form-group {
        margin-bottom: 1rem;
    }

        .form-group label {
            display: block;
            font-weight: 500;
            margin-bottom: 0.25rem;
            color: #374151;
        }

        .form-group input, .form-group select {
            width: 100%;
            padding: 10px 12px;
            border: 1px solid #D1D5DB;
            border-radius: 12px;
            font-size: 0.875rem;
        }

        .form-group textarea {
            width: 100%;
            padding: 10px 12px;
            border: 1px solid #D1D5DB;
            border-radius: 12px;
            font-size: 0.875rem;
            font-family: inherit;
        }
</style>

<!-- Info -->
<div class="info-box">
    <strong>🔐 About Consent Management</strong>
    <p style="margin-top:10px;">
        You control which healthcare professionals can access your laboratory records.
        Access can be granted, modified, or revoked at any time.
    </p>
    <div style="margin-top:10px;">
        <span class="security-badge">POPIA Compliant</span>
        <span class="security-badge">Secure Sharing</span>
        <span class="security-badge">Encrypted Access</span>
    </div>
</div>

<!-- Access Tables -->
<div class="grid-2col">
    <!-- Doctors With Access -->
    <div class="card-modern doctor-card">
        <div class="card-header-flex">
            <h3>✅ Doctors with Access</h3>
            <button class="btn-sm-lab" onclick="showDemoAlert('Doctor access invitation sent successfully')">
                + Grant Access
            </button>
        </div>

        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>Doctor</th>
                        <th>Email</th>
                        <th>Status</th>
                        <th>Granted</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.ActiveConsents != null && Model.ActiveConsents.Any())
                    {
                        @foreach (var consent in Model.ActiveConsents)
                        {
                            <tr>
                                <td>
                                    <strong>@consent.DoctorName</strong>
                                </td>
                                <td>@consent.DoctorEmail</td>
                                <td>
                                    <span class="status-pill @(consent.IsActive ? "status-active" : "status-revoked")">
                                        @(consent.IsActive ? "Active" : "Revoked")
                                    </span>
                                </td>
                                <td>@consent.GrantedDate.ToString("dd MMM yyyy")</td>
                                <td>
                                    <button class="btn-outline-lab" style="color:red; border-color:red;"
                                            onclick="confirmRevoke('@consent.DoctorName', @consent.ConsentID)">
                                        Revoke
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" style="text-align:center; padding:1rem; color:#9CA3AF;">
                                No active consents
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Grant Access -->
    <div class="card-modern doctor-card">
        <h3>🔐 Grant New Access</h3>

        <div class="form-group">
            <label><strong>Select Doctor</strong></label>
            <select id="doctorSelect">
                @if (Model.AvailableDoctors != null && Model.AvailableDoctors.Any())
                {
                    @foreach (var doctor in Model.AvailableDoctors)
                    {
                        <option value="@doctor.DoctorID">@doctor.FullName - @doctor.Email</option>
                    }
                }
                else
                {
                    <option value="">No doctors available</option>
                }
            </select>
        </div>

        <div class="form-group">
            <label><strong>Select Test Requests to Share</strong></label>
            <div style="border:1px solid #E2E8F0; border-radius:12px; padding:10px; max-height:150px; overflow-y:auto;">
                @if (Model.AvailableTestRequests != null && Model.AvailableTestRequests.Any())
                {
                    @foreach (var request in Model.AvailableTestRequests)
                    {
                        <label style="display:block; padding:4px 0;">
                            <input type="checkbox" name="testRequests" value="@request.TestRequestID">
                            REQ-@request.TestRequestID - @request.RequestDate.ToString("dd MMM yyyy") (@request.Status)
                        </label>
                    }
                }
                else
                {
                    <span style="color:#9CA3AF;">No test requests available</span>
                }
            </div>
        </div>

        <div class="form-group">
            <label><strong>Notes (Optional)</strong></label>
            <textarea id="consentNotes" rows="2" placeholder="Add any notes..."></textarea>
        </div>

        <button class="btn-sm-lab" onclick="grantConsent()">Grant Access</button>
    </div>
</div>

<script>
    function grantConsent() {
        var doctorId = document.getElementById('doctorSelect').value;
        if (!doctorId) {
            alert('Please select a doctor');
            return;
        }
        alert('✅ Access granted successfully');
    }

    function confirmRevoke(doctorName, consentId) {
        if (confirm('Are you sure you want to revoke access from ' + doctorName + '?')) {
            alert('🚫 Access revoked successfully');
        }
    }

    function showDemoAlert(msg) {
        alert('✅ ' + msg);
    }
</script>