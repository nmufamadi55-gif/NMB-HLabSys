@using NMB_HLabSys.ViewModels.PatientViewModels
@model PatientConsentManagementViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Consent Management";
    ViewData["RoleSubtitle"] = "Patient Portal";
    ViewData["UserGreeting"] = $"{Model.FullName} (ID: {Model.PatientID})";
    ViewData["UserInitials"] = Model.FullName.Substring(0, 1);
}

@section SidebarMenu {
    <li><a href="@Url.Action("Dashboard", "Patient")"><i class="fas fa-notes-medical"></i> <span>My Results</span></a></li>
    <li><a href="@Url.Action("Requests", "Patient")"><i class="fas fa-vials"></i> <span>My Requests</span></a></li>
    <li><a href="@Url.Action("MedicalHistory", "Patient")"><i class="fas fa-history"></i> <span>Medical History</span></a></li>
    <li><a href="@Url.Action("Consent", "Patient")" class="active"><i class="fas fa-hand-peace"></i> <span>Consent</span></a></li>
    <li><a href="@Url.Action("Trends", "Patient")"><i class="fas fa-chart-line"></i> <span>Trends</span></a></li>
    <li><a href="@Url.Action("Profile", "Patient")"><i class="fas fa-user-circle"></i> <span>My Profile</span></a></li>
}

<style>
    .profile-card {
        background: white;
        border-radius: 20px;
        border: 1px solid #E2E8F0;
        overflow: hidden;
        margin-bottom: 1.5rem;
    }

    .profile-card-header {
        background: linear-gradient(135deg, #F8FAFE, #FFFFFF);
        padding: 1rem 1.5rem;
        border-bottom: 1px solid #E2E8F0;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .profile-card-header h3 {
            margin: 0;
            color: #032C7D;
            font-size: 1.1rem;
        }

    .profile-card-body {
        padding: 1.5rem;
    }

    .security-badge {
        display: inline-block;
        padding: 5px 12px;
        border-radius: 20px;
        background: #D1FAE5;
        color: #065F46;
        font-size: 0.75rem;
        font-weight: 600;
        margin-right: 8px;
    }

    .info-box {
        background: #EFF6FF;
        padding: 1rem 1.5rem;
        border-radius: 16px;
        margin-bottom: 1.5rem;
        border-left: 4px solid #0841C9;
    }

        .info-box strong {
            color: #032C7D;
        }

    .status-pill {
        padding: 5px 12px;
        border-radius: 20px;
        font-size: 0.7rem;
        font-weight: 600;
    }

    .status-active {
        background: #D1FAE5;
        color: #065F46;
    }

    .status-revoked {
        background: #FEE2E2;
        color: #991B1B;
    }

    .activity-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.85rem;
    }

        .activity-table thead th {
            text-align: left;
            padding: 10px 12px;
            color: #5A6E7A;
            font-size: 0.75rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            border-bottom: 1px solid #E2E8F0;
        }

        .activity-table tbody td {
            padding: 12px;
            color: #1F2937;
            border-bottom: 1px solid #F3F4F6;
            vertical-align: middle;
        }

        .activity-table tbody tr:hover {
            background: #F8FAFE;
        }

    .form-group {
        margin-bottom: 1rem;
    }

        .form-group label {
            display: block;
            font-weight: 600;
            font-size: 0.8rem;
            color: #032C7D;
            margin-bottom: 0.3rem;
        }

        .form-group select, .form-group textarea, .form-group input {
            width: 100%;
            padding: 10px 14px;
            border-radius: 12px;
            border: 1px solid #E2E8F0;
            font-size: 0.85rem;
            font-family: inherit;
        }

            .form-group select:focus, .form-group textarea:focus, .form-group input:focus {
                outline: none;
                border-color: #0841C9;
                box-shadow: 0 0 0 3px rgba(8,65,201,0.1);
            }

    .request-picker {
        border: 1px solid #E2E8F0;
        border-radius: 12px;
        max-height: 320px;
        overflow-y: auto;
        padding: 0.5rem;
        background: #F8FAFE;
    }

    .request-item {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        padding: 10px 12px;
        border-radius: 8px;
        cursor: pointer;
        transition: background 0.15s;
    }

        .request-item:hover {
            background: #EFF6FF;
        }

        .request-item input[type="checkbox"] {
            margin-top: 3px;
            width: 16px;
            height: 16px;
            accent-color: #0841C9;
            cursor: pointer;
        }

    .request-item-info {
        flex: 1;
    }

        .request-item-info strong {
            color: #032C7D;
            font-size: 0.85rem;
        }

        .request-item-info .request-meta {
            font-size: 0.75rem;
            color: #5A6E7A;
            margin-top: 2px;
        }

    .request-status {
        display: inline-block;
        padding: 2px 8px;
        border-radius: 12px;
        font-size: 0.68rem;
        font-weight: 600;
        background: #E0E7FF;
        color: #3730A3;
        margin-left: 6px;
    }

    .btn-primary {
        background: #0841C9;
        color: white;
        border: none;
        padding: 0.5rem 1.2rem;
        border-radius: 30px;
        cursor: pointer;
        font-size: 0.8rem;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        text-decoration: none;
        transition: all 0.2s;
    }

        .btn-primary:hover {
            background: #032C7D;
            color: white;
        }

        .btn-primary:disabled {
            background: #94A3B8;
            cursor: not-allowed;
        }

    .btn-outline {
        background: transparent;
        border: 1px solid #E2E8F0;
        padding: 0.4rem 1rem;
        border-radius: 30px;
        cursor: pointer;
        font-size: 0.75rem;
        color: #032C7D;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        transition: all 0.2s;
    }

        .btn-outline:hover {
            background: #F8FAFE;
            border-color: #0841C9;
            color: #0841C9;
        }

    .btn-danger {
        color: #DC2626;
        border-color: #FCA5A5;
    }

        .btn-danger:hover {
            background: #FEE2E2;
            border-color: #DC2626;
        }

    .alert-success {
        background: #D1FAE5;
        color: #065F46;
        padding: 0.8rem 1rem;
        border-radius: 12px;
        margin-bottom: 1rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.85rem;
    }

    .alert-error {
        background: #FEE2E2;
        color: #991B1B;
        padding: 0.8rem 1rem;
        border-radius: 12px;
        margin-bottom: 1rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.85rem;
    }

    .no-data {
        text-align: center;
        color: #9CA3AF;
        padding: 2rem;
        font-size: 0.85rem;
    }
</style>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert-success"><i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]</div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert-error"><i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]</div>
}

<div class="info-box">
    <strong><i class="fas fa-shield-alt"></i> About Consent Management</strong>
    <p style="margin-top:10px; color: #5A6E7A;">
        You control which healthcare professionals can access your laboratory records.
        When granting access, select the specific test requests you want to share.
    </p>
    <div style="margin-top:10px;">
        <span class="security-badge"><i class="fas fa-lock"></i> POPIA Compliant</span>
        <span class="security-badge"><i class="fas fa-share-alt"></i> Per-Request Sharing</span>
        <span class="security-badge"><i class="fas fa-key"></i> Encrypted Access</span>
    </div>
</div>

<!-- Doctors with Access -->
<div class="profile-card">
    <div class="profile-card-header">
        <h3><i class="fas fa-user-check"></i> Doctors with Access</h3>
    </div>
    <div class="profile-card-body" style="padding: 0;">
        @if (Model.ActiveConsents != null && Model.ActiveConsents.Any())
        {
            <table class="activity-table">
                <thead>
                    <tr>
                        <th>Doctor</th>
                        <th>Email</th>
                        <th>Shared Requests</th>
                        <th>Status</th>
                        <th>Granted</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var consent in Model.ActiveConsents)
                    {
                        <tr>
                            <td><strong>@consent.DoctorName</strong></td>
                            <td>@consent.DoctorEmail</td>
                            <td><span class="status-pill status-active">@consent.SharedRequestCount request(s)</span></td>
                            <td>
                                <span class="status-pill @(consent.IsActive ? "status-active" : "status-revoked")">
                                    @(consent.IsActive ? "Active" : "Revoked")
                                </span>
                            </td>
                            <td>@consent.GrantedDate.ToString("dd MMM yyyy")</td>
                            <td>
                                <button class="btn-outline btn-danger"
                                        onclick="confirmRevoke('@consent.DoctorName', @consent.ConsentID)">
                                    <i class="fas fa-ban"></i> Revoke
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="no-data">
                <i class="fas fa-user-shield" style="font-size: 2rem; display: block; margin-bottom: 0.5rem; opacity: 0.5;"></i>
                No active consents. Grant access below.
            </p>
        }
    </div>
</div>

<!-- Grant New Access -->
<div class="profile-card">
    <div class="profile-card-header">
        <h3><i class="fas fa-plus-circle"></i> Grant New Access</h3>
    </div>
    <div class="profile-card-body">
        @if (Model.AvailableDoctors != null && Model.AvailableDoctors.Any())
        {
            if (Model.AvailableTestRequests == null || !Model.AvailableTestRequests.Any())
            {
                <p class="no-data">
                    <i class="fas fa-inbox" style="font-size: 2rem; display: block; margin-bottom: 0.5rem; opacity: 0.5;"></i>
                    You have no test requests to share yet.
                </p>
            }
            else
            {
                <form id="grantConsentForm">
                    @Html.AntiForgeryToken()

                    <div class="form-group">
                        <label>Select Doctor</label>
                        <select name="doctorId" id="doctorSelect" required>
                            <option value="">-- Select a doctor --</option>
                            @foreach (var doctor in Model.AvailableDoctors)
                            {
                                <option value="@doctor.DoctorID">@doctor.FullName - @doctor.Specialization</option>
                            }
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Select Test Requests to Share <span style="color:#DC2626;">*</span></label>
                        <div class="request-picker">
                            @foreach (var req in Model.AvailableTestRequests)
                            {
                                <label class="request-item">
                                    <input type="checkbox" name="requestIds" value="@req.TestRequestID" />
                                    <div class="request-item-info">
                                        <strong>@req.RequestNumber</strong>
                                        <span class="request-status">@req.Status</span>
                                        <div class="request-meta">
                                            <i class="fas fa-calendar"></i> @req.RequestDate.ToString("dd MMM yyyy")
                                        </div>
                                    </div>
                                </label>
                            }
                        </div>
                        <small style="color:#64748B; display:block; margin-top:6px;">
                            Select at least one request. The doctor will only see the selected requests.
                        </small>
                    </div>

                    <div class="form-group">
                        <label>Notes (Optional)</label>
                        <textarea name="notes" id="notesField" rows="3" placeholder="e.g., Please review my recent results"></textarea>
                    </div>

                    <button type="submit" class="btn-primary" id="grantBtn">
                        <i class="fas fa-check"></i> Grant Access
                    </button>
                </form>
            }
        }
        else
        {
            <p class="no-data">
                <i class="fas fa-user-slash" style="font-size: 2rem; display: block; margin-bottom: 0.5rem; opacity: 0.5;"></i>
                No doctors available to grant access to.
            </p>
        }
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const form = document.getElementById('grantConsentForm');
        if (!form) return;

        form.addEventListener('submit', function (e) {
            e.preventDefault();

            const doctorId = document.getElementById('doctorSelect').value;
            if (!doctorId) {
                alert('Please select a doctor.');
                return;
            }

            const checkedBoxes = form.querySelectorAll('input[name="requestIds"]:checked');
            if (checkedBoxes.length === 0) {
                alert('Please select at least one test request to share.');
                return;
            }

            const formData = new FormData();
            formData.append('doctorId', doctorId);
            formData.append('notes', document.getElementById('notesField').value);
            checkedBoxes.forEach(cb => formData.append('requestIds', cb.value));

            const token = form.querySelector('input[name="__RequestVerificationToken"]').value;
            formData.append('__RequestVerificationToken', token);

            fetch('@Url.Action("GrantConsent", "Patient")', {
                method: 'POST',
                body: formData
            })
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    alert(data.message);
                    location.reload();
                } else {
                    alert('Error: ' + data.message);
                }
            })
            .catch(err => alert('Error: ' + err));
        });
    });

    function confirmRevoke(doctorName, consentId) {
        if (!confirm('Are you sure you want to revoke access from ' + doctorName + '?')) return;

        const formData = new FormData();
        formData.append('consentId', consentId);

        // Get antiforgery token from anywhere on the page
        const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
        if (tokenInput) formData.append('__RequestVerificationToken', tokenInput.value);

        fetch('@Url.Action("RevokeConsent", "Patient")', {
            method: 'POST',
            body: formData
        })
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                alert(data.message);
                location.reload();
            } else {
                alert('Error: ' + data.message);
            }
        })
        .catch(err => alert('Error: ' + err));
    }
</script>