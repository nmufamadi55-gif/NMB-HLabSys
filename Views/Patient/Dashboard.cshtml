@using NMB_HLabSys.ViewModels.PatientViewModels
@model PatientDashboardViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "My Health Portal";
    ViewData["RoleSubtitle"] = "Patient Portal";
    ViewData["UserGreeting"] = $"{Model.FullName} (ID: {Model.SAIDNumber})";
    ViewData["UserInitials"] = Model.FirstName.Substring(0, 1) + Model.LastName.Substring(0, 1);
}

@section SidebarMenu {
    <li><a href="@Url.Action("Dashboard", "Patient")" class="active"><i class="fas fa-notes-medical"></i> <span>My Results</span></a></li>
    <li><a href="@Url.Action("MedicalHistory", "Patient")"><i class="fas fa-history"></i> <span>Medical History</span></a></li>
    <li><a href="@Url.Action("Consent", "Patient")"><i class="fas fa-hand-peace"></i> <span>Consent</span></a></li>
    <li><a href="@Url.Action("Trends", "Patient")"><i class="fas fa-chart-line"></i> <span>Trends</span></a></li>
    <li><a href="@Url.Action("Index", "Profile")"><i class="fas fa-user-circle"></i> <span>My Profile</span></a></li>
}

<style>
    /* ============================================
           DASHBOARD — Glass Morphism
           ============================================ */
    :root {
        --p-navy: #032C7D;
        --p-blue: #0841C9;
        --p-blue-light: #1D97F1;
        --p-grad: linear-gradient(135deg, #0841C9 0%, #1D97F1 100%);
        --p-text: #1A2C3A;
        --p-text-soft: #5A6E7A;
    }

    .page-hero {
        position: relative;
        margin: -1.2rem -1.2rem 2rem -1.2rem;
        padding: 3rem 2.5rem 2.5rem;
        border-radius: 24px;
        overflow: hidden;
        min-height: 260px;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        color: white;
        box-shadow: 0 20px 50px rgba(3, 44, 125, 0.2);
    }

        .page-hero::before {
            content: '';
            position: absolute;
            inset: 0;
            background-image: var(--hero-image);
            background-size: cover;
            background-position: center;
            z-index: 0;
            transition: transform 8s ease-out;
        }

        .page-hero:hover::before {
            transform: scale(1.05);
        }

        .page-hero::after {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient( 135deg, rgba(3, 44, 125, 0.88) 0%, rgba(8, 65, 201, 0.72) 50%, rgba(29, 151, 241, 0.45) 100% );
            z-index: 1;
        }

    .page-hero-content {
        position: relative;
        z-index: 2;
        animation: heroFadeIn 0.8s ease-out;
    }

    @@keyframes heroFadeIn {
        from

    {
        opacity: 0;
        transform: translateY(20px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    .hero-kicker {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(255, 255, 255, 0.18);
        border: 1px solid rgba(255, 255, 255, 0.3);
        backdrop-filter: blur(10px);
        padding: 0.4rem 1rem;
        border-radius: 30px;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        margin-bottom: 1rem;
    }

    .page-hero h1 {
        font-size: 2.3rem;
        font-weight: 800;
        letter-spacing: -0.02em;
        margin-bottom: 0.5rem;
        line-height: 1.15;
    }

    .hero-subtitle {
        font-size: 0.95rem;
        color: rgba(255, 255, 255, 0.9);
        max-width: 640px;
        line-height: 1.55;
        margin: 0;
    }

    .hero-actions {
        margin-top: 1.5rem;
        display: flex;
        gap: 0.75rem;
        flex-wrap: wrap;
    }

    .hero-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.7rem 1.4rem;
        border-radius: 10px;
        font-size: 0.85rem;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.2s;
        font-family: inherit;
        cursor: pointer;
        border: none;
    }

    .hero-btn-primary {
        background: white;
        color: var(--p-blue);
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
    }

        .hero-btn-primary:hover {
            background: rgba(255, 255, 255, 0.95);
            transform: translateY(-2px);
            box-shadow: 0 8px 22px rgba(0, 0, 0, 0.2);
            color: var(--p-navy);
        }

    .hero-btn-secondary {
        background: rgba(255, 255, 255, 0.2);
        border: 1px solid rgba(255, 255, 255, 0.35);
        color: white;
        backdrop-filter: blur(10px);
    }

        .hero-btn-secondary:hover {
            background: rgba(255, 255, 255, 0.3);
            transform: translateY(-2px);
            color: white;
        }

    /* Glass card */
    .glass-card {
        background: rgba(255, 255, 255, 0.75);
        backdrop-filter: blur(18px) saturate(140%);
        -webkit-backdrop-filter: blur(18px) saturate(140%);
        border: 1px solid rgba(255, 255, 255, 0.85);
        border-radius: 20px;
        box-shadow: 0 8px 32px rgba(3, 44, 125, 0.08);
        overflow: hidden;
        margin-bottom: 1.5rem;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        animation: cardFadeIn 0.6s ease-out backwards;
    }

        .glass-card:nth-child(1) {
            animation-delay: 0.1s;
        }

        .glass-card:nth-child(2) {
            animation-delay: 0.2s;
        }

        .glass-card:nth-child(3) {
            animation-delay: 0.3s;
        }

        .glass-card:hover {
            box-shadow: 0 16px 48px rgba(3, 44, 125, 0.14);
            transform: translateY(-2px);
        }

    @@keyframes cardFadeIn {
        from

    {
        opacity: 0;
        transform: translateY(24px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    .glass-card-header {
        padding: 1.2rem 1.6rem;
        border-bottom: 1px solid rgba(226, 232, 240, 0.6);
        background: rgba(248, 250, 254, 0.5);
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        flex-wrap: wrap;
    }

        .glass-card-header h3 {
            margin: 0;
            color: var(--p-navy);
            font-size: 1.05rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 0.6rem;
        }

    .glass-card-body {
        padding: 1.5rem 1.6rem;
    }

    /* Glass stats */
    .glass-stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1rem;
    }

    .glass-stat {
        background: rgba(255, 255, 255, 0.7);
        backdrop-filter: blur(14px);
        border: 1px solid rgba(226, 232, 240, 0.6);
        border-radius: 16px;
        padding: 1.2rem;
        display: flex;
        align-items: center;
        gap: 1rem;
        transition: all 0.25s;
    }

        .glass-stat:hover {
            background: rgba(255, 255, 255, 0.9);
            transform: translateY(-3px);
            box-shadow: 0 8px 24px rgba(8, 65, 201, 0.1);
        }

    .glass-stat-icon {
        width: 48px;
        height: 48px;
        background: var(--p-grad);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 1.2rem;
        flex-shrink: 0;
        box-shadow: 0 6px 16px rgba(8, 65, 201, 0.3);
    }

    .glass-stat h3 {
        margin: 0;
        color: var(--p-navy);
        font-size: 1.6rem;
        font-weight: 700;
        line-height: 1;
    }

    .glass-stat p {
        margin: 0.3rem 0 0;
        color: var(--p-text-soft);
        font-size: 0.78rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }

    /* Health panel */
    .health-panel {
        background: linear-gradient(135deg, #020D2F 0%, #0841C9 100%);
        border-radius: 20px;
        padding: 1.8rem;
        color: white;
        box-shadow: 0 12px 32px rgba(3, 44, 125, 0.25);
        position: relative;
        overflow: hidden;
        margin-bottom: 1.5rem;
        animation: cardFadeIn 0.6s ease-out 0.15s backwards;
    }

        .health-panel::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -20%;
            width: 60%;
            height: 200%;
            background: radial-gradient(circle, rgba(29, 151, 241, 0.25), transparent 70%);
            pointer-events: none;
        }

        .health-panel h3 {
            margin: 0 0 0.6rem;
            font-size: 0.95rem;
            font-weight: 600;
            opacity: 0.9;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            position: relative;
        }

        .health-panel .score {
            font-size: 3rem;
            font-weight: 800;
            margin: 0;
            line-height: 1;
            letter-spacing: -0.02em;
            position: relative;
        }

        .health-panel .status-msg {
            margin: 0.5rem 0 1rem;
            font-size: 0.9rem;
            opacity: 0.92;
            line-height: 1.5;
            position: relative;
        }

        .health-panel .progress-track {
            background: rgba(255, 255, 255, 0.2);
            border-radius: 20px;
            height: 10px;
            overflow: hidden;
            position: relative;
        }

        .health-panel .progress-fill {
            height: 10px;
            background: linear-gradient(90deg, #4ADE80 0%, #16A34A 100%);
            border-radius: 20px;
            transition: width 1.2s cubic-bezier(0.4, 0, 0.2, 1);
        }

    /* Glass table */
    .glass-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.85rem;
    }

        .glass-table thead th {
            text-align: left;
            padding: 0.9rem 1.2rem;
            color: var(--p-text-soft);
            font-size: 0.72rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            border-bottom: 1px solid rgba(226, 232, 240, 0.6);
            background: rgba(248, 250, 254, 0.4);
        }

        .glass-table tbody td {
            padding: 1rem 1.2rem;
            color: var(--p-text);
            border-bottom: 1px solid rgba(243, 244, 246, 0.6);
        }

        .glass-table tbody tr {
            transition: background 0.2s;
        }

            .glass-table tbody tr:hover {
                background: rgba(239, 246, 255, 0.6);
            }

            .glass-table tbody tr.abnormal-row {
                background: rgba(254, 242, 242, 0.7);
            }

                .glass-table tbody tr.abnormal-row:hover {
                    background: rgba(254, 226, 226, 0.8);
                }

    /* Pills */
    .pill {
        display: inline-block;
        padding: 0.28rem 0.8rem;
        border-radius: 20px;
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.02em;
    }

    .pill-normal {
        background: #D1FAE5;
        color: #065F46;
    }

    .pill-warning {
        background: #FEF3C7;
        color: #92400E;
    }

    .pill-danger {
        background: #FEE2E2;
        color: #991B1B;
    }

    /* Buttons */
    .btn-glass {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.55rem 1.1rem;
        border-radius: 30px;
        font-size: 0.78rem;
        font-weight: 600;
        border: 1px solid rgba(226, 232, 240, 0.8);
        background: rgba(255, 255, 255, 0.9);
        color: var(--p-navy);
        cursor: pointer;
        text-decoration: none;
        transition: all 0.2s;
        font-family: inherit;
    }

        .btn-glass:hover {
            border-color: var(--p-blue);
            color: var(--p-blue);
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(8, 65, 201, 0.15);
        }

    .btn-glass-primary {
        background: var(--p-grad);
        color: white;
        border: none;
        box-shadow: 0 4px 14px rgba(8, 65, 201, 0.3);
    }

        .btn-glass-primary:hover {
            background: linear-gradient(135deg, #032C7D 0%, #0841C9 100%);
            color: white;
            transform: translateY(-1px);
            box-shadow: 0 6px 20px rgba(8, 65, 201, 0.4);
        }

    /* Empty state */
    .empty-state {
        text-align: center;
        padding: 3rem 2rem;
        color: var(--p-text-soft);
    }

        .empty-state i {
            font-size: 2.5rem;
            opacity: 0.3;
            margin-bottom: 0.8rem;
            display: block;
        }

        .empty-state p {
            margin: 0;
            font-size: 0.9rem;
        }

    /* History items (for upcoming tests) */
    .history-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.9rem 1.1rem;
        background: rgba(248, 250, 254, 0.7);
        border-radius: 12px;
        margin-bottom: 0.6rem;
        transition: all 0.2s;
        border: 1px solid transparent;
    }

        .history-item:hover {
            background: rgba(239, 246, 255, 0.9);
            border-color: rgba(8, 65, 201, 0.15);
            transform: translateX(4px);
        }

    .history-item-info {
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
    }

    .history-item-name {
        font-weight: 600;
        color: var(--p-text);
        font-size: 0.88rem;
    }

    .history-item-details {
        font-size: 0.75rem;
        color: var(--p-text-soft);
    }

    /* Alerts */
    .glass-alert {
        padding: 0.9rem 1.2rem;
        border-radius: 12px;
        margin-bottom: 1.2rem;
        display: flex;
        align-items: flex-start;
        gap: 0.6rem;
        font-size: 0.85rem;
        animation: cardFadeIn 0.4s ease-out;
    }

    .glass-alert-success {
        background: rgba(220, 252, 231, 0.8);
        color: #166534;
        border-left: 4px solid #059669;
        backdrop-filter: blur(10px);
    }

    .glass-alert-error {
        background: rgba(254, 226, 226, 0.8);
        color: #991B1B;
        border-left: 4px solid #DC2626;
        backdrop-filter: blur(10px);
    }

    /* Grid 2col */
    .glass-grid-2col {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
        gap: 1.5rem;
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .page-hero

    {
        margin: -0.8rem -0.8rem 1.5rem -0.8rem;
        padding: 2rem 1.5rem;
        min-height: 220px;
    }

    .page-hero h1 {
        font-size: 1.6rem;
    }

    .glass-card-body {
        padding: 1.2rem;
    }

    .glass-card-header {
        padding: 1rem 1.2rem;
    }

    .health-panel .score {
        font-size: 2.2rem;
    }

    .glass-grid-2col {
        grid-template-columns: 1fr;
    }

    }
</style>

<!-- PAGE HERO -->
<div class="page-hero" style="--hero-image: url('https://images.unsplash.com/photo-1576091160399-112ba8d25d1d?w=1600&q=80');">
    <div class="page-hero-content">
        <span class="hero-kicker"><i class="fas fa-heartbeat"></i> Health Portal</span>
        <h1>Welcome back, @Model.FirstName</h1>
        <p class="hero-subtitle">Your personal health dashboard — track results, monitor trends, and stay in control of your wellbeing.</p>
        <div class="hero-actions">
            <a href="@Url.Action("Trends", "Patient")" class="hero-btn hero-btn-primary">
                <i class="fas fa-chart-line"></i> View Trends
            </a>
            <a href="@Url.Action("DownloadTestResultsPDF", "Patient")" class="hero-btn hero-btn-secondary">
                <i class="fas fa-download"></i> Download PDF
            </a>
        </div>
    </div>
</div>

<!-- ALERTS -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="glass-alert glass-alert-success">
        <i class="fas fa-check-circle" style="margin-top:2px;"></i>
        <span>@TempData["SuccessMessage"]</span>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="glass-alert glass-alert-error">
        <i class="fas fa-exclamation-circle" style="margin-top:2px;"></i>
        <span>@TempData["ErrorMessage"]</span>
    </div>
}

<!-- STAT CARDS -->
<div class="glass-card">
    <div class="glass-card-header">
        <h3><i class="fas fa-chart-bar"></i> Health Overview</h3>
    </div>
    <div class="glass-card-body">
        <div class="glass-stats-grid">
            <div class="glass-stat">
                <div class="glass-stat-icon"><i class="fas fa-vial"></i></div>
                <div>
                    <h3>@Model.TotalTestRequests</h3>
                    <p>Total Tests</p>
                </div>
            </div>
            <div class="glass-stat">
                <div class="glass-stat-icon"><i class="fas fa-exclamation-triangle"></i></div>
                <div>
                    <h3>@Model.AbnormalResultsCount</h3>
                    <p>Abnormal Results</p>
                </div>
            </div>
            <div class="glass-stat">
                <div class="glass-stat-icon"><i class="fas fa-file-alt"></i></div>
                <div>
                    <h3>@Model.ReportsAvailable</h3>
                    <p>Reports Available</p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- HEALTH SCORE -->
<div class="health-panel">
    <h3><i class="fas fa-heartbeat"></i> Overall Health Status</h3>
    <p class="score">@Model.HealthScore%</p>
    <p class="status-msg">@Model.HealthStatusMessage</p>
    <div class="progress-track">
        <div class="progress-fill" style="width: @Model.HealthScore%;"></div>
    </div>
</div>

<!-- TEST RESULTS -->
<div class="glass-card">
    <div class="glass-card-header">
        <h3><i class="fas fa-notes-medical"></i> Recent Test Results</h3>
        <a href="@Url.Action("DownloadTestResultsPDF", "Patient")" class="btn-glass btn-glass-primary">
            <i class="fas fa-download"></i> Download PDF
        </a>
    </div>
    @if (Model.RecentTestResults != null && Model.RecentTestResults.Any())
    {
        <table class="glass-table">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Test Name</th>
                    <th>Result</th>
                    <th>Normal Range</th>
                    <th>Status</th>
                    <th>Doctor</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var test in Model.RecentTestResults)
                {
                    <tr class="@(test.IsAbnormal ? "abnormal-row" : "")">
                        <td>@test.RequestDate.ToString("dd MMM yyyy")</td>
                        <td><strong>@test.TestName</strong></td>
                        <td>@test.ResultValue</td>
                        <td>@test.NormalRange</td>
                        <td>
                            @{
                                var pillClass = test.Status.ToLower().Contains("normal") ? "pill-normal" :
                                test.Status.ToLower().Contains("abnormal") ? "pill-warning" :
                                test.Status.ToLower().Contains("elevated") ? "pill-warning" :
                                test.Status.ToLower().Contains("pending") ? "pill-danger" :
                                "pill-normal";
                            }
                            <span class="pill @pillClass">@test.Status</span>
                        </td>
                        <td>@test.DoctorName</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="empty-state">
            <i class="fas fa-inbox"></i>
            <p>No test results found</p>
        </div>
    }
</div>

<!-- TRENDS + UPCOMING -->
<div class="glass-grid-2col">
    <div class="glass-card" style="margin-bottom:0;">
        <div class="glass-card-header">
            <h3><i class="fas fa-chart-line"></i> Health Trends</h3>
        </div>
        <div class="glass-card-body">
            <p style="color: var(--p-text-soft); font-size: 0.85rem; margin: 0 0 1rem;">
                Track your test results over time to see how your health is progressing.
            </p>
            <p style="color: var(--p-navy); font-weight: 600; margin: 0 0 1.2rem;">
                Latest trend: <strong>@Model.CholesterolTrend</strong>
            </p>
            <a href="@Url.Action("Trends", "Patient")" class="btn-glass btn-glass-primary">
                <i class="fas fa-chart-line"></i> View Full Trends
            </a>
        </div>
    </div>

    <div class="glass-card" style="margin-bottom:0;">
        <div class="glass-card-header">
            <h3><i class="fas fa-calendar-alt"></i> Upcoming Tests</h3>
        </div>
        <div class="glass-card-body">
            @if (Model.UpcomingTests != null && Model.UpcomingTests.Any())
            {
                @foreach (var test in Model.UpcomingTests)
                {
                    <div class="history-item">
                        <div class="history-item-info">
                            <span class="history-item-name">@test.TestName</span>
                            <span class="history-item-details">@test.RequestDate.ToString("dd MMM yyyy")</span>
                        </div>
                        <i class="fas fa-flask" style="color: var(--p-blue);"></i>
                    </div>
                }
            }
            else
            {
                <div class="empty-state">
                    <i class="fas fa-calendar-check"></i>
                    <p>No upcoming tests</p>
                </div>
            }
        </div>
    </div>
</div>