@using NMB_HLabSys.ViewModels.PatientViewModels
@model PatientDashboardViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "My Health Portal";
    ViewData["RoleSubtitle"] = "Patient Portal";
    ViewData["UserGreeting"] = $"{Model.FullName} (ID: {Model.SAIDNumber})";
    ViewData["UserInitials"] = Model.FirstName.Substring(0, 1) + Model.LastName.Substring(0, 1);
}

@section SidebarMenu {
    <li><a href="@Url.Action("Dashboard", "Patient")" class="active"><i class="fas fa-notes-medical"></i> <span>My Results</span></a></li>
    <li><a href="@Url.Action("MedicalHistory", "Patient")"><i class="fas fa-history"></i> <span>Medical History</span></a></li>
    <li><a href="@Url.Action("Consent", "Patient")"><i class="fas fa-hand-peace"></i> <span>Consent</span></a></li>
    <li><a href="@Url.Action("Trends", "Patient")"><i class="fas fa-chart-line"></i> <span>Trends</span></a></li>
    <li><a href="@Url.Action("Profile", "Patient")"><i class="fas fa-user-circle"></i> <span>My Profile</span></a></li>
}

<style>
    :root {
        --p-teal: #0891B2;
        --p-teal-light: #06B6D4;
        --p-teal-grad: linear-gradient(135deg, #0891B2 0%, #06B6D4 100%);
        --p-navy: #0F172A;
        --p-text: #1E293B;
        --p-text-soft: #64748B;
        --p-text-muted: #94A3B8;
        --p-border: #E2E8F0;
        --p-bg-soft: #F8FAFC;
        --p-danger: #DC2626;
        --p-success: #059669;
        --shadow-sm: 0 1px 3px rgba(15, 23, 42, 0.06), 0 1px 2px rgba(15, 23, 42, 0.04);
        --shadow-md: 0 4px 12px rgba(15, 23, 42, 0.06), 0 2px 6px rgba(15, 23, 42, 0.04);
        --shadow-lg: 0 12px 32px rgba(15, 23, 42, 0.10), 0 4px 12px rgba(15, 23, 42, 0.05);
        --radius: 16px;
    }

    /* ═══ PAGE HERO — image fully visible, text pill at bottom ═══ */
    .page-hero {
        position: relative;
        margin: -1.2rem -1.2rem 2rem -1.2rem;
        height: 340px;
        border-radius: 0 0 24px 24px;
        overflow: hidden;
        display: flex;
        align-items: flex-end;
        padding: 2rem;
        box-shadow: var(--shadow-lg);
    }

        .page-hero::before {
            content: '';
            position: absolute;
            inset: 0;
            background-image: url('https://images.unsplash.com/photo-1666214280557-f1b5022eb634?w=1600&q=85');
            background-size: cover;
            background-position: center;
            z-index: 0;
            transition: transform 12s ease-out;
        }

        .page-hero:hover::before {
            transform: scale(1.04);
        }

        /* Only a soft bottom gradient for text readability — image fully visible above */
        .page-hero::after {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient( to bottom, rgba(15, 23, 42, 0) 0%, rgba(15, 23, 42, 0) 40%, rgba(15, 23, 42, 0.25) 70%, rgba(15, 23, 42, 0.65) 100% );
            z-index: 1;
        }

    /* Glass text pill — small, refined, sits on the image */
    .hero-pill {
        position: relative;
        z-index: 2;
        background: rgba(15, 23, 42, 0.55);
        backdrop-filter: blur(20px) saturate(180%);
        -webkit-backdrop-filter: blur(20px) saturate(180%);
        border: 1px solid rgba(255, 255, 255, 0.15);
        border-radius: 20px;
        padding: 1.4rem 1.8rem;
        color: white;
        max-width: 640px;
        animation: heroFadeIn 0.8s ease-out;
    }

    @@keyframes heroFadeIn {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .hero-pill .hero-kicker {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(6, 182, 212, 0.25);
        border: 1px solid rgba(6, 182, 212, 0.4);
        padding: 0.35rem 0.9rem;
        border-radius: 20px;
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        margin-bottom: 0.8rem;
        color: #67E8F9;
    }

    .hero-pill h1 {
        font-size: 1.8rem;
        font-weight: 800;
        letter-spacing: -0.02em;
        margin: 0 0 0.3rem;
        line-height: 1.15;
    }

    .hero-pill p {
        font-size: 0.88rem;
        color: rgba(255, 255, 255, 0.8);
        margin: 0;
        line-height: 1.5;
    }

    .hero-pill .hero-actions {
        margin-top: 1rem;
        display: flex;
        gap: 0.6rem;
        flex-wrap: wrap;
    }

    .hero-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.55rem 1.1rem;
        border-radius: 10px;
        font-size: 0.8rem;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.2s;
        font-family: inherit;
        cursor: pointer;
        border: none;
    }

    .hero-btn-primary {
        background: var(--p-teal-grad);
        color: white;
        box-shadow: 0 4px 14px rgba(6, 182, 212, 0.4);
    }

        .hero-btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 22px rgba(6, 182, 212, 0.5);
            color: white;
        }

    .hero-btn-secondary {
        background: rgba(255, 255, 255, 0.15);
        border: 1px solid rgba(255, 255, 255, 0.25);
        color: white;
        backdrop-filter: blur(10px);
    }

        .hero-btn-secondary:hover {
            background: rgba(255, 255, 255, 0.25);
            transform: translateY(-2px);
            color: white;
        }

    /* ═══ CLEAN WHITE CARDS ═══ */
    .clean-card {
        background: white;
        border-radius: var(--radius);
        border: 1px solid var(--p-border);
        box-shadow: var(--shadow-sm);
        overflow: hidden;
        margin-bottom: 1.5rem;
        transition: box-shadow 0.3s, transform 0.3s;
        animation: cardFadeIn 0.6s ease-out backwards;
    }

        .clean-card:nth-child(1) {
            animation-delay: 0.05s;
        }

        .clean-card:nth-child(2) {
            animation-delay: 0.15s;
        }

        .clean-card:nth-child(3) {
            animation-delay: 0.25s;
        }

        .clean-card:hover {
            box-shadow: var(--shadow-md);
            transform: translateY(-2px);
        }

    @@keyframes cardFadeIn {
        from {
            opacity: 0;
            transform: translateY(16px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .clean-card-header {
        padding: 1.1rem 1.5rem;
        border-bottom: 1px solid var(--p-border);
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        flex-wrap: wrap;
    }

        .clean-card-header h3 {
            margin: 0;
            color: var(--p-navy);
            font-size: 1rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 0.55rem;
        }

            .clean-card-header h3 i {
                color: var(--p-teal);
                font-size: 0.95rem;
            }

    .clean-card-body {
        padding: 1.5rem;
    }

    /* ═══ STAT CARDS — clean with gradient icon chips ═══ */
    .stats-row {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .stat-card {
        background: white;
        border-radius: var(--radius);
        border: 1px solid var(--p-border);
        box-shadow: var(--shadow-sm);
        padding: 1.3rem;
        display: flex;
        align-items: center;
        gap: 1rem;
        transition: all 0.25s;
        animation: cardFadeIn 0.6s ease-out backwards;
    }

        .stat-card:nth-child(1) {
            animation-delay: 0.1s;
        }

        .stat-card:nth-child(2) {
            animation-delay: 0.2s;
        }

        .stat-card:nth-child(3) {
            animation-delay: 0.3s;
        }

        .stat-card:hover {
            transform: translateY(-3px);
            box-shadow: var(--shadow-lg);
            border-color: rgba(6, 182, 212, 0.3);
        }

    .stat-icon {
        width: 44px;
        height: 44px;
        background: var(--p-teal-grad);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 1.05rem;
        flex-shrink: 0;
        box-shadow: 0 4px 12px rgba(6, 182, 212, 0.3);
    }

        .stat-icon.warning {
            background: linear-gradient(135deg, #F59E0B 0%, #F97316 100%);
            box-shadow: 0 4px 12px rgba(245, 158, 11, 0.3);
        }

        .stat-icon.info {
            background: linear-gradient(135deg, #8B5CF6 0%, #A855F7 100%);
            box-shadow: 0 4px 12px rgba(139, 92, 246, 0.3);
        }

    .stat-content h3 {
        margin: 0;
        color: var(--p-navy);
        font-size: 1.5rem;
        font-weight: 700;
        line-height: 1;
        letter-spacing: -0.02em;
    }

    .stat-content p {
        margin: 0.35rem 0 0;
        color: var(--p-text-soft);
        font-size: 0.72rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.06em;
    }

    /* ═══ HEALTH SCORE — circular ring + trend = 2-column ═══ */
    .health-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.5rem;
        margin-bottom: 1.5rem;
    }

    @@media (max-width: 768px) {
        .health-grid

    {
        grid-template-columns: 1fr;
    }

    }

    .health-ring-card {
        background: white;
        border-radius: var(--radius);
        border: 1px solid var(--p-border);
        box-shadow: var(--shadow-sm);
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        animation: cardFadeIn 0.6s ease-out 0.15s backwards;
    }

        .health-ring-card h3 {
            margin: 0 0 1.2rem;
            color: var(--p-navy);
            font-size: 0.95rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

            .health-ring-card h3 i {
                color: var(--p-teal);
            }

    .ring-wrap {
        position: relative;
        width: 160px;
        height: 160px;
        margin-bottom: 1rem;
    }

        .ring-wrap svg {
            transform: rotate(-90deg);
            width: 100%;
            height: 100%;
        }

    .ring-track {
        fill: none;
        stroke: #E2E8F0;
        stroke-width: 10;
    }

    .ring-fill {
        fill: none;
        stroke: url(#ringGrad);
        stroke-width: 10;
        stroke-linecap: round;
        transition: stroke-dashoffset 1.5s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .ring-center {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

        .ring-center .ring-score {
            font-size: 2.2rem;
            font-weight: 800;
            color: var(--p-navy);
            line-height: 1;
            letter-spacing: -0.02em;
        }

        .ring-center .ring-label {
            font-size: 0.68rem;
            font-weight: 700;
            color: var(--p-text-muted);
            text-transform: uppercase;
            letter-spacing: 0.08em;
            margin-top: 0.3rem;
        }

    .health-status-msg {
        color: var(--p-text-soft);
        font-size: 0.82rem;
        line-height: 1.55;
        margin: 0;
    }

    /* trend card */
    .trend-mini-card {
        background: white;
        border-radius: var(--radius);
        border: 1px solid var(--p-border);
        box-shadow: var(--shadow-sm);
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        animation: cardFadeIn 0.6s ease-out 0.2s backwards;
    }

        .trend-mini-card h3 {
            margin: 0 0 1rem;
            color: var(--p-navy);
            font-size: 0.95rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

            .trend-mini-card h3 i {
                color: var(--p-teal);
            }

        .trend-mini-card p {
            color: var(--p-text-soft);
            font-size: 0.85rem;
            line-height: 1.6;
            margin: 0 0 1.2rem;
        }

    .trend-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        background: rgba(6, 182, 212, 0.1);
        color: var(--p-teal);
        padding: 0.35rem 0.85rem;
        border-radius: 20px;
        font-size: 0.72rem;
        font-weight: 700;
        margin-bottom: 1rem;
    }

    /* ═══ TABLE — clean, subtle ═══ */
    .clean-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.85rem;
    }

        .clean-table thead th {
            text-align: left;
            padding: 0.85rem 1.2rem;
            color: var(--p-text-soft);
            font-size: 0.7rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            background: var(--p-bg-soft);
            border-bottom: 1px solid var(--p-border);
        }

        .clean-table tbody td {
            padding: 0.95rem 1.2rem;
            color: var(--p-text);
            border-bottom: 1px solid #F1F5F9;
        }

        .clean-table tbody tr {
            transition: background 0.15s;
        }

            .clean-table tbody tr:hover {
                background: var(--p-bg-soft);
            }

            .clean-table tbody tr:last-child td {
                border-bottom: none;
            }

            /* Abnormal row — subtle, red dot on the left */
            .clean-table tbody tr.abnormal-row td:first-child {
                position: relative;
                padding-left: 2rem;
            }

                .clean-table tbody tr.abnormal-row td:first-child::before {
                    content: '';
                    position: absolute;
                    left: 0.85rem;
                    top: 50%;
                    transform: translateY(-50%);
                    width: 6px;
                    height: 6px;
                    border-radius: 50%;
                    background: var(--p-danger);
                }

    /* ═══ PILLS ═══ */
    .pill {
        display: inline-block;
        padding: 0.28rem 0.75rem;
        border-radius: 20px;
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 0.02em;
    }

    .pill-normal {
        background: #D1FAE5;
        color: #065F46;
    }

    .pill-warning {
        background: #FEF3C7;
        color: #92400E;
    }

    .pill-danger {
        background: #FEE2E2;
        color: #991B1B;
    }

    /* ═══ BUTTONS ═══ */
    .btn {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.55rem 1.1rem;
        border-radius: 10px;
        font-size: 0.78rem;
        font-weight: 600;
        border: 1px solid var(--p-border);
        background: white;
        color: var(--p-navy);
        cursor: pointer;
        text-decoration: none;
        transition: all 0.2s;
        font-family: inherit;
    }

        .btn:hover {
            border-color: var(--p-teal);
            color: var(--p-teal);
            transform: translateY(-1px);
            box-shadow: var(--shadow-sm);
        }

    .btn-primary {
        background: var(--p-teal-grad);
        color: white;
        border: none;
        box-shadow: 0 4px 14px rgba(6, 182, 212, 0.3);
    }

        .btn-primary:hover {
            color: white;
            box-shadow: 0 6px 20px rgba(6, 182, 212, 0.4);
        }

    /* ═══ EMPTY STATE ═══ */
    .empty-state {
        text-align: center;
        padding: 2.5rem 2rem;
        color: var(--p-text-muted);
    }

        .empty-state i {
            font-size: 2.2rem;
            opacity: 0.4;
            margin-bottom: 0.7rem;
            display: block;
        }

        .empty-state p {
            margin: 0;
            font-size: 0.85rem;
        }

    /* ═══ ALERTS ═══ */
    .alert {
        padding: 0.85rem 1.2rem;
        border-radius: 12px;
        margin-bottom: 1.2rem;
        display: flex;
        align-items: flex-start;
        gap: 0.6rem;
        font-size: 0.85rem;
        animation: cardFadeIn 0.4s ease-out;
    }

    .alert-success {
        background: #DCFCE7;
        color: #166534;
        border-left: 3px solid #059669;
    }

    .alert-error {
        background: #FEE2E2;
        color: #991B1B;
        border-left: 3px solid #DC2626;
    }

    /* ═══ UPCOMING ITEM ═══ */
    .upcoming-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.85rem 1rem;
        background: var(--p-bg-soft);
        border-radius: 10px;
        margin-bottom: 0.6rem;
        border: 1px solid var(--p-border);
        transition: all 0.2s;
    }

        .upcoming-item:last-child {
            margin-bottom: 0;
        }

        .upcoming-item:hover {
            background: white;
            border-color: var(--p-teal);
            transform: translateX(3px);
        }

    .upcoming-info {
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
    }

    .upcoming-name {
        font-weight: 600;
        color: var(--p-navy);
        font-size: 0.88rem;
    }

    .upcoming-date {
        font-size: 0.75rem;
        color: var(--p-text-soft);
    }

    .upcoming-icon {
        color: var(--p-teal);
        font-size: 1rem;
    }

    /* ═══ RESPONSIVE ═══ */
    @@media (max-width: 768px) {
        .page-hero

    {
        margin: -0.8rem -0.8rem 1.5rem -0.8rem;
        height: 280px;
        padding: 1.2rem;
    }

    .hero-pill {
        padding: 1.1rem 1.3rem;
    }

        .hero-pill h1 {
            font-size: 1.4rem;
        }

    .clean-card-body {
        padding: 1.2rem;
    }

    .ring-wrap {
        width: 140px;
        height: 140px;
    }

    .ring-center .ring-score {
        font-size: 1.9rem;
    }

    }
</style>

<!-- ═══ HERO — image fully visible, glass pill at bottom ═══ -->
<div class="page-hero">
    <div class="hero-pill">
        <span class="hero-kicker"><i class="fas fa-heartbeat"></i> Health Portal</span>
        <h1>Welcome back, @Model.FirstName</h1>
        <p>Your personal health dashboard — track results, monitor trends, and stay in control of your wellbeing.</p>
        <div class="hero-actions">
            <a href="@Url.Action("Trends", "Patient")" class="hero-btn hero-btn-primary">
                <i class="fas fa-chart-line"></i> View Trends
            </a>
            <a href="@Url.Action("DownloadTestResultsPDF", "Patient")" class="hero-btn hero-btn-secondary">
                <i class="fas fa-download"></i> Download PDF
            </a>
        </div>
    </div>
</div>

<!-- ═══ ALERTS ═══ -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        <i class="fas fa-check-circle" style="margin-top:2px;"></i>
        <span>@TempData["SuccessMessage"]</span>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-error">
        <i class="fas fa-exclamation-circle" style="margin-top:2px;"></i>
        <span>@TempData["ErrorMessage"]</span>
    </div>
}

<!-- ═══ STAT CARDS ═══ -->
<div class="stats-row">
    <div class="stat-card">
        <div class="stat-icon"><i class="fas fa-vial"></i></div>
        <div class="stat-content">
            <h3>@Model.TotalTestRequests</h3>
            <p>Total Tests</p>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon warning"><i class="fas fa-exclamation-triangle"></i></div>
        <div class="stat-content">
            <h3>@Model.AbnormalResultsCount</h3>
            <p>Abnormal Results</p>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon info"><i class="fas fa-file-alt"></i></div>
        <div class="stat-content">
            <h3>@Model.ReportsAvailable</h3>
            <p>Reports Available</p>
        </div>
    </div>
</div>

<!-- ═══ HEALTH RING + TREND MINI ═══ -->
@{
    var circumference = 2 * Math.PI * 65;   // r=65
    var dashOffset = circumference - (Model.HealthScore / 100.0) * circumference;
}

<div class="health-grid">
    <!-- Circular health ring -->
    <div class="health-ring-card">
        <h3><i class="fas fa-heartbeat"></i> Overall Health Status</h3>
        <div class="ring-wrap">
            <svg viewBox="0 0 160 160">
                <defs>
                    <linearGradient id="ringGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                        <stop offset="0%" stop-color="#0891B2" />
                        <stop offset="100%" stop-color="#06B6D4" />
                    </linearGradient>
                </defs>
                <circle class="ring-track" cx="80" cy="80" r="65"></circle>
                <circle class="ring-fill" cx="80" cy="80" r="65"
                        stroke-dasharray="@circumference.ToString("F2")"
                        stroke-dashoffset="@dashOffset.ToString("F2")"></circle>
            </svg>
            <div class="ring-center">
                <div class="ring-score">@Model.HealthScore%</div>
                <div class="ring-label">Health</div>
            </div>
        </div>
        <p class="health-status-msg">@Model.HealthStatusMessage</p>
    </div>

    <!-- Trend mini card -->
    <div class="trend-mini-card">
        <h3><i class="fas fa-chart-line"></i> Health Trends</h3>
        <div>
            <span class="trend-badge">
                <i class="fas fa-wave-square"></i>
                Latest: @Model.CholesterolTrend
            </span>
            <p>Track your test results over time to see how your health is progressing. View detailed charts for any test type.</p>
        </div>
        <a href="@Url.Action("Trends", "Patient")" class="btn btn-primary">
            <i class="fas fa-chart-line"></i> View Full Trends
        </a>
    </div>
</div>

<!-- ═══ RECENT TEST RESULTS ═══ -->
<div class="clean-card">
    <div class="clean-card-header">
        <h3><i class="fas fa-notes-medical"></i> Recent Test Results</h3>
        <a href="@Url.Action("DownloadTestResultsPDF", "Patient")" class="btn btn-primary">
            <i class="fas fa-download"></i> Download PDF
        </a>
    </div>
    @if (Model.RecentTestResults != null && Model.RecentTestResults.Any())
    {
        <table class="clean-table">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Test Name</th>
                    <th>Result</th>
                    <th>Normal Range</th>
                    <th>Status</th>
                    <th>Doctor</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var test in Model.RecentTestResults)
                {
                    <tr class="@(test.IsAbnormal ? "abnormal-row" : "")">
                        <td>@test.RequestDate.ToString("dd MMM yyyy")</td>
                        <td><strong>@test.TestName</strong></td>
                        <td>@test.ResultValue</td>
                        <td>@test.NormalRange</td>
                        <td>
                            @{
                                var pillClass = test.Status.ToLower().Contains("normal") ? "pill-normal" :
                                test.Status.ToLower().Contains("abnormal") ? "pill-warning" :
                                test.Status.ToLower().Contains("elevated") ? "pill-warning" :
                                test.Status.ToLower().Contains("pending") ? "pill-danger" :
                                "pill-normal";
                            }
                            <span class="pill @pillClass">@test.Status</span>
                        </td>
                        <td>@test.DoctorName</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="empty-state">
            <i class="fas fa-inbox"></i>
            <p>No test results found</p>
        </div>
    }
</div>

<!-- ═══ UPCOMING TESTS ═══ -->
<div class="clean-card">
    <div class="clean-card-header">
        <h3><i class="fas fa-calendar-alt"></i> Upcoming Tests</h3>
    </div>
    <div class="clean-card-body">
        @if (Model.UpcomingTests != null && Model.UpcomingTests.Any())
        {
            @foreach (var test in Model.UpcomingTests)
            {
                <div class="upcoming-item">
                    <div class="upcoming-info">
                        <span class="upcoming-name">@test.TestName</span>
                        <span class="upcoming-date">@test.RequestDate.ToString("dd MMM yyyy")</span>
                    </div>
                    <i class="fas fa-flask upcoming-icon"></i>
                </div>
            }
        }
        else
        {
            <div class="empty-state">
                <i class="fas fa-calendar-check"></i>
                <p>No upcoming tests</p>
            </div>
        }
    </div>
</div>