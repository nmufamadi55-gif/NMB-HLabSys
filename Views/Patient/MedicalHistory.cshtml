@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Medical History";
    ViewData["RoleSubtitle"] = "Patient Portal";
    ViewData["UserGreeting"] = $"🩺 {@ViewBag.PatientName} (ID: {@ViewBag.PatientID})";
    ViewData["UserInitials"] = "TM";

    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
}

@section SidebarMenu {
    <li><a href="@Url.Action("Dashboard", "Patient")" class="active">📋 My Results</a></li>
    <li><a href="@Url.Action("MedicalHistory", "Patient")">📝 Medical History</a></li>
    <li><a href="@Url.Action("Consent", "Patient")">🔐 Consent Management</a></li>
    <li><a href="@Url.Action("Trends", "Patient")">📈 Track Trends</a></li>
    <li><a href="@Url.Action("Index", "Profile")"><i class="fas fa-user-circle"></i> <span>My Profile</span></a></li>
}

<div class="grid-2col">
    <div class="card-modern">
        <div class="card-header-flex">
            <h3>🩺 Chronic Conditions</h3>
            <button class="btn-outline-lab" onclick="showDemoAlert('Add new condition')">+ Add</button>
        </div>
        <ul style="margin-top:1rem;">
            <li>🔹 <strong>Hypertension</strong> - Diagnosed: 2018</li>
            <li>🔹 <strong>Type 2 Diabetes</strong> - Diagnosed: 2021</li>
        </ul>
    </div>
    <div class="card-modern">
        <div class="card-header-flex">
            <h3>⚠️ Allergies</h3>
            <button class="btn-outline-lab" onclick="showDemoAlert('Add new allergy')">+ Add</button>
        </div>
        <ul style="margin-top:1rem;">
            <li>🔸 <strong>Penicillin</strong> - Severe reaction</li>
            <li>🔸 <strong>Dust Mites</strong> - Mild respiratory</li>
        </ul>
    </div>
</div>

<div class="card-modern">
    <div class="card-header-flex">
        <h3>💊 Current Medications</h3>
        <button class="btn-outline-lab" onclick="showDemoAlert('Add medication')">+ Add</button>
    </div>
    <div class="table-container">
        <table>
            <thead>
                <tr>
                    <th>Medication</th>
                    <th>Dosage</th>
                    <th>Frequency</th>
                    <th>Prescribed By</th>
                    <th>Start Date</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>Lisinopril</td>
                    <td>10mg</td>
                    <td>Once daily</td>
                    <td>Dr. Sarah Johnson</td>
                    <td>2024-01-15</td>
                    <td><button class="btn-outline-lab" onclick="showDemoAlert('Update medication details')">Edit</button></td>
                </tr>
                <tr>
                    <td>Metformin</td>
                    <td>500mg</td>
                    <td>Twice daily</td>
                    <td>Dr. Michael Brown</td>
                    <td>2024-03-10</td>
                    <td><button class="btn-outline-lab" onclick="showDemoAlert('Update medication details')">Edit</button></td>
                </tr>
                <tr>
                    <td>Atorvastatin</td>
                    <td>20mg</td>
                    <td>Once daily (evening)</td>
                    <td>Dr. Michael Brown</td>
                    <td>2025-01-05</td>
                    <td><button class="btn-outline-lab" onclick="showDemoAlert('Update medication details')">Edit</button></td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<div class="card-modern">
    <div class="card-header-flex">
        <h3>📋 Past Hospitalizations / Procedures</h3>
        <button class="btn-outline-lab" onclick="showDemoAlert('Add hospitalization record')">+ Add</button>
    </div>
    <ul style="margin-top:1rem;">
        <li>2022-06-15: Routine Appendectomy - St. Mary's Hospital</li>
        <li>2020-11-02: ER Visit for Hypertensive Crisis</li>
    </ul>
</div>

<script>
    function showDemoAlert(msg) {
        alert('🔔 ' + msg + ' (Demo: Backend integration coming Semester 2)');
    }
</script>