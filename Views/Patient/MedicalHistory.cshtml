@using NMB_HLabSys.ViewModels.PatientViewModels
@using NMB_HLabSys.Models
@model PatientMedicalHistoryViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Medical History";
    ViewData["RoleSubtitle"] = "Patient Portal";
    ViewData["UserGreeting"] = $"🩺 {Model.FullName} (ID: {Model.PatientID})";
    ViewData["UserInitials"] = Model.FullName.Substring(0, 1);
}

@section SidebarMenu {
    <li><a href="@Url.Action("Dashboard", "Patient")">📋 My Results</a></li>
    <li><a href="@Url.Action("MedicalHistory", "Patient")" class="active">📝 Medical History</a></li>
    <li><a href="@Url.Action("Consent", "Patient")">🔐 Consent Management</a></li>
    <li><a href="@Url.Action("Trends", "Patient")">📈 Track Trends</a></li>
    <li><a href="@Url.Action("Index", "Profile")"><i class="fas fa-user-circle"></i> <span>My Profile</span></a></li>
}

<style>
    .history-section {
        margin-bottom: 2rem;
    }

        .history-section h3 {
            border-bottom: 2px solid #E5E7EB;
            padding-bottom: 0.5rem;
            margin-bottom: 1rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

    .add-btn {
        background: #4F46E5;
        color: white;
        border: none;
        padding: 6px 16px;
        border-radius: 20px;
        cursor: pointer;
        font-size: 0.875rem;
        font-weight: 600;
    }

        .add-btn:hover {
            background: #4338CA;
        }

    .history-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px 12px;
        background: #F8FAFE;
        border-radius: 12px;
        margin-bottom: 8px;
        transition: 0.2s;
    }

        .history-item:hover {
            background: #EAF2FF;
            transform: translateX(4px);
        }

    .item-info {
        display: flex;
        flex-direction: column;
    }

    .item-name {
        font-weight: 600;
        color: #1F2937;
    }

    .item-details {
        font-size: 0.75rem;
        color: #6B7280;
    }

    .remove-btn {
        background: none;
        border: none;
        color: #DC2626;
        cursor: pointer;
        font-size: 0.875rem;
        padding: 4px 8px;
        border-radius: 8px;
    }

        .remove-btn:hover {
            background: #FEE2E2;
        }

    .status-active {
        background: #DCFCE7;
        color: #166534;
        padding: 2px 10px;
        border-radius: 20px;
        font-size: 0.75rem;
    }

    .severity-mild {
        color: #16A34A;
    }

    .severity-moderate {
        color: #F59E0B;
    }

    .severity-severe {
        color: #DC2626;
    }

    .modal-overlay {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.5);
        z-index: 1000;
        justify-content: center;
        align-items: center;
    }

        .modal-overlay.active {
            display: flex;
        }

    .modal-box {
        background: white;
        padding: 2rem;
        border-radius: 20px;
        max-width: 500px;
        width: 90%;
        max-height: 90vh;
        overflow-y: auto;
    }

    .modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
    }

    .modal-close {
        background: none;
        border: none;
        font-size: 1.5rem;
        cursor: pointer;
    }

    .form-group {
        margin-bottom: 1rem;
    }

        .form-group label {
            display: block;
            font-weight: 500;
            margin-bottom: 0.25rem;
        }

        .form-group input, .form-group select, .form-group textarea {
            width: 100%;
            padding: 10px;
            border-radius: 12px;
            border: 1px solid #D1D5DB;
        }

    .btn-submit {
        background: #4F46E5;
        color: white;
        border: none;
        padding: 10px 24px;
        border-radius: 12px;
        font-weight: 600;
        cursor: pointer;
        width: 100%;
    }

        .btn-submit:hover {
            background: #4338CA;
        }
</style>

<div class="stat-cards">
    <div class="stat-item">
        <div class="stat-icon">🩺</div>
        <div><h3>@Model.Conditions?.Count ?? 0</h3><p>Conditions</p></div>
    </div>
    <div class="stat-item">
        <div class="stat-icon">⚠️</div>
        <div><h3>@Model.Allergies?.Count ?? 0</h3><p>Allergies</p></div>
    </div>
    <div class="stat-item">
        <div class="stat-icon">💊</div>
        <div><h3>@Model.Medications?.Count ?? 0</h3><p>Medications</p></div>
    </div>
</div>

<!-- Conditions -->
<div class="card-modern history-section">
    <h3>
        <span>🩺 Medical Conditions</span>
        <button class="add-btn" onclick="openModal('condition')">+ Add Condition</button>
    </h3>

    @if (Model.Conditions != null && Model.Conditions.Any())
    {
        @foreach (var c in Model.Conditions)
        {
            <div class="history-item">
                <div class="item-info">
                    <span class="item-name">@c.ConditionName</span>
                    <span class="item-details">
                        @c.CategoryName
                        @if (c.DiagnosedDate.HasValue)
                        {
                            <span>• Diagnosed: @c.DiagnosedDate.Value.ToString("dd MMM yyyy")</span>
                        }
                        @if (!string.IsNullOrEmpty(c.Notes))
                        {
                            <span>• @c.Notes</span>
                        }
                    </span>
                </div>
                <div>
                    <span class="status-active">Active</span>
                    <button class="remove-btn" onclick="removeItem('condition', @c.PatientConditionID)">✕</button>
                </div>
            </div>
        }
    }
    else
    {
        <p style="color: #9CA3AF; text-align: center; padding: 2rem;">No medical conditions recorded</p>
    }
</div>

<!-- Allergies -->
<div class="card-modern history-section">
    <h3>
        <span>⚠️ Allergies</span>
        <button class="add-btn" onclick="openModal('allergy')">+ Add Allergy</button>
    </h3>

    @if (Model.Allergies != null && Model.Allergies.Any())
    {
        @foreach (var a in Model.Allergies)
        {
            <div class="history-item">
                <div class="item-info">
                    <span class="item-name">@a.AllergyName</span>
                    <span class="item-details">
                        @a.CategoryName
                        <span class="severity-@(a.Severity?.ToLower() ?? "mild")">• @(a.Severity ?? "Mild")</span>
                        @if (!string.IsNullOrEmpty(a.Notes))
                        {
                            <span>• @a.Notes</span>
                        }
                    </span>
                </div>
                <button class="remove-btn" onclick="removeItem('allergy', @a.PatientAllergyID)">✕</button>
            </div>
        }
    }
    else
    {
        <p style="color: #9CA3AF; text-align: center; padding: 2rem;">No allergies recorded</p>
    }
</div>

<!-- Medications -->
<div class="card-modern history-section">
    <h3>
        <span>💊 Medications</span>
        <button class="add-btn" onclick="openModal('medication')">+ Add Medication</button>
    </h3>

    @if (Model.Medications != null && Model.Medications.Any())
    {
        @foreach (var m in Model.Medications)
        {
            <div class="history-item">
                <div class="item-info">
                    <span class="item-name">@m.MedicationName</span>
                    <span class="item-details">
                        @m.CategoryName
                        @if (!string.IsNullOrEmpty(m.Dosage))
                        {
                            <span>• Dosage: @m.Dosage</span>
                        }
                        @if (!string.IsNullOrEmpty(m.Frequency))
                        {
                            <span>• @m.Frequency</span>
                        }
                    </span>
                </div>
                <div>
                    <span class="status-active">Current</span>
                    <button class="remove-btn" onclick="removeItem('medication', @m.PatientMedicationID)">✕</button>
                </div>
            </div>
        }
    }
    else
    {
        <p style="color: #9CA3AF; text-align: center; padding: 2rem;">No medications recorded</p>
    }
</div>

<!-- Add Modal -->
<div id="addModal" class="modal-overlay">
    <div class="modal-box">
        <div class="modal-header">
            <h3 id="modalTitle">Add Item</h3>
            <button class="modal-close" onclick="closeModal()">✕</button>
        </div>

        <form id="addForm" onsubmit="submitForm(event)">
            <input type="hidden" id="itemType" value="" />

            <div class="form-group">
                <label>Select Item *</label>
                <select id="itemSelect" required>
                    <option value="">-- Select --</option>
                </select>
            </div>

            <div class="form-group" id="severityGroup" style="display:none;">
                <label>Severity</label>
                <select id="severity">
                    <option value="Mild">Mild</option>
                    <option value="Moderate" selected>Moderate</option>
                    <option value="Severe">Severe</option>
                </select>
            </div>

            <div class="form-group" id="dosageGroup" style="display:none;">
                <label>Dosage</label>
                <input type="text" id="dosage" placeholder="e.g., 500mg" />
            </div>

            <div class="form-group" id="frequencyGroup" style="display:none;">
                <label>Frequency</label>
                <input type="text" id="frequency" placeholder="e.g., Twice daily" />
            </div>

            <div class="form-group" id="dateGroup" style="display:none;">
                <label>Diagnosed Date</label>
                <input type="date" id="diagnosedDate" />
            </div>

            <div class="form-group">
                <label>Notes (Optional)</label>
                <textarea id="notes" rows="2" placeholder="Additional notes..."></textarea>
            </div>

            <button type="submit" class="btn-submit">Add Item</button>
        </form>
    </div>
</div>

<script>
    var availableConditions = @Html.Raw(Json.Serialize(Model.AvailableConditions ?? new List<MedicalCondition>()));
    var availableAllergies = @Html.Raw(Json.Serialize(Model.AvailableAllergies ?? new List<Allergy>()));
    var availableMedications = @Html.Raw(Json.Serialize(Model.AvailableMedications ?? new List<Medication>()));

    function openModal(type) {
        document.getElementById('addModal').classList.add('active');
        document.getElementById('itemType').value = type;
        document.getElementById('addForm').reset();

        ['severityGroup', 'dosageGroup', 'frequencyGroup', 'dateGroup'].forEach(id => {
            document.getElementById(id).style.display = 'none';
        });

        var select = document.getElementById('itemSelect');
        select.innerHTML = '<option value="">-- Select --</option>';
        var title = document.getElementById('modalTitle');

        if (type === 'condition') {
            title.textContent = 'Add Medical Condition';
            availableConditions.forEach(c => {
                select.innerHTML += `<option value="${c.conditionID}">${c.conditionName}</option>`;
            });
            document.getElementById('dateGroup').style.display = 'block';
        } else if (type === 'allergy') {
            title.textContent = 'Add Allergy';
            availableAllergies.forEach(a => {
                select.innerHTML += `<option value="${a.allergyID}">${a.allergyName}</option>`;
            });
            document.getElementById('severityGroup').style.display = 'block';
        } else if (type === 'medication') {
            title.textContent = 'Add Medication';
            availableMedications.forEach(m => {
                select.innerHTML += `<option value="${m.medicationID}">${m.medicationName}</option>`;
            });
            document.getElementById('dosageGroup').style.display = 'block';
            document.getElementById('frequencyGroup').style.display = 'block';
        }
    }

    function closeModal() {
        document.getElementById('addModal').classList.remove('active');
    }

    function submitForm(event) {
        event.preventDefault();

        var type = document.getElementById('itemType').value;
        var itemId = document.getElementById('itemSelect').value;
        var notes = document.getElementById('notes').value;

        if (!itemId) { alert('Please select an item'); return; }

        var url = '', body = '';

        if (type === 'condition') {
            url = '@Url.Action("AddCondition", "Patient")';
            body = 'conditionId=' + itemId + '&diagnosedDate=' + (document.getElementById('diagnosedDate').value || '') + '&notes=' + encodeURIComponent(notes);
        } else if (type === 'allergy') {
            url = '@Url.Action("AddAllergy", "Patient")';
            body = 'allergyId=' + itemId + '&severity=' + document.getElementById('severity').value + '&notes=' + encodeURIComponent(notes);
        } else if (type === 'medication') {
            url = '@Url.Action("AddMedication", "Patient")';
            body = 'medicationId=' + itemId + '&dosage=' + encodeURIComponent(document.getElementById('dosage').value) + '&frequency=' + encodeURIComponent(document.getElementById('frequency').value) + '&startDate=&endDate=&notes=' + encodeURIComponent(notes);
        }

        fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: body
        })
        .then(r => r.json())
        .then(data => {
            if (data.success) { alert('✅ ' + data.message); location.reload(); }
            else { alert('❌ ' + data.message); }
        })
        .catch(err => alert('Error: ' + err));
    }

    function removeItem(type, id) {
        if (!confirm('Remove this ' + type + '?')) return;

        var url = '', body = '';

        if (type === 'condition') {
            url = '@Url.Action("RemoveCondition", "Patient")';
            body = 'patientConditionId=' + id;
        } else if (type === 'allergy') {
            url = '@Url.Action("RemoveAllergy", "Patient")';
            body = 'patientAllergyId=' + id;
        } else if (type === 'medication') {
            url = '@Url.Action("RemoveMedication", "Patient")';
            body = 'patientMedicationId=' + id;
        }

        fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: body
        })
        .then(r => r.json())
        .then(data => {
            if (data.success) { alert('✅ ' + data.message); location.reload(); }
            else { alert('❌ ' + data.message); }
        })
        .catch(err => alert('Error: ' + err));
    }
</script>