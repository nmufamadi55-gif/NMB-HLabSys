@using NMB_HLabSys.ViewModels.PatientViewModels
@model PatientMedicalHistoryViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Medical History";
    ViewData["RoleSubtitle"] = "Patient Portal";
    ViewData["UserGreeting"] = $"🩺 {Model.FullName} (ID: {Model.PatientID})";
    ViewData["UserInitials"] = Model.FullName.Substring(0, 1);
}

@section SidebarMenu {
    <li><a href="@Url.Action("Dashboard", "Patient")">📋 My Results</a></li>
    <li><a href="@Url.Action("MedicalHistory", "Patient")" class="active">📝 Medical History</a></li>
    <li><a href="@Url.Action("Consent", "Patient")">🔐 Consent Management</a></li>
    <li><a href="@Url.Action("Trends", "Patient")">📈 Track Trends</a></li>
    <li><a href="@Url.Action("Index", "Profile")"><i class="fas fa-user-circle"></i> <span>My Profile</span></a></li>
}

<style>
    .history-section {
        margin-bottom: 2rem;
    }

        .history-section h3 {
            border-bottom: 2px solid #E5E7EB;
            padding-bottom: 0.5rem;
            margin-bottom: 1rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

    .add-btn {
        background: #4F46E5;
        color: white;
        border: none;
        padding: 6px 16px;
        border-radius: 20px;
        cursor: pointer;
        font-size: 0.875rem;
        font-weight: 600;
    }

        .add-btn:hover {
            background: #4338CA;
        }

    .history-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px 12px;
        background: #F8FAFE;
        border-radius: 12px;
        margin-bottom: 8px;
        transition: 0.2s;
    }

        .history-item:hover {
            background: #EAF2FF;
            transform: translateX(4px);
        }

    .item-info {
        display: flex;
        flex-direction: column;
    }

    .item-name {
        font-weight: 600;
        color: #1F2937;
    }

    .item-details {
        font-size: 0.75rem;
        color: #6B7280;
    }

    .remove-btn {
        background: none;
        border: none;
        color: #DC2626;
        cursor: pointer;
        font-size: 0.875rem;
        padding: 4px 8px;
        border-radius: 8px;
        transition: 0.2s;
    }

        .remove-btn:hover {
            background: #FEE2E2;
        }

    .status-active {
        background: #DCFCE7;
        color: #166534;
        padding: 2px 10px;
        border-radius: 20px;
        font-size: 0.75rem;
    }

    .status-inactive {
        background: #FEE2E2;
        color: #991B1B;
        padding: 2px 10px;
        border-radius: 20px;
        font-size: 0.75rem;
    }

    .severity-mild {
        color: #16A34A;
    }

    .severity-moderate {
        color: #F59E0B;
    }

    .severity-severe {
        color: #DC2626;
    }
</style>

<!-- Summary Cards -->
<div class="stat-cards">
    <div class="stat-item">
        <div class="stat-icon">🩺</div>
        <div>
            <h3>@Model.Conditions?.Count ?? 0</h3>
            <p>Conditions</p>
        </div>
    </div>
    <div class="stat-item">
        <div class="stat-icon">⚠️</div>
        <div>
            <h3>@Model.Allergies?.Count ?? 0</h3>
            <p>Allergies</p>
        </div>
    </div>
    <div class="stat-item">
        <div class="stat-icon">💊</div>
        <div>
            <h3>@Model.Medications?.Where(m => m.IsCurrent).Count() ?? 0</h3>
            <p>Active Medications</p>
        </div>
    </div>
</div>

<!-- Medical Conditions -->
<div class="card-modern history-section">
    <h3>
        <span>🩺 Medical Conditions</span>
        <button class="add-btn" onclick="openModal('condition')">+ Add Condition</button>
    </h3>

    @if (Model.Conditions != null && Model.Conditions.Any())
    {
        @foreach (var condition in Model.Conditions)
        {
            <div class="history-item">
                <div class="item-info">
                    <span class="item-name">@condition.ConditionName</span>
                    <span class="item-details">
                        @condition.CategoryName
                        @if (condition.DiagnosedDate.HasValue)
                        {
                            <span>• Diagnosed: @condition.DiagnosedDate.Value.ToString("dd MMM yyyy")</span>
                        }
                        @if (!string.IsNullOrEmpty(condition.Notes))
                        {
                            <span>• @condition.Notes</span>
                        }
                    </span>
                </div>
                <div>
                    <span class="@(condition.IsActive ? "status-active" : "status-inactive")">
                        @(condition.IsActive ? "Active" : "Inactive")
                    </span>
                    <button class="remove-btn" onclick="removeItem('condition', @condition.PatientConditionID)">✕</button>
                </div>
            </div>
        }
    }
    else
    {
        <p style="color: #9CA3AF; text-align: center; padding: 2rem;">No medical conditions recorded</p>
    }
</div>

<!-- Allergies -->
<div class="card-modern history-section">
    <h3>
        <span>⚠️ Allergies</span>
        <button class="add-btn" onclick="openModal('allergy')">+ Add Allergy</button>
    </h3>

    @if (Model.Allergies != null && Model.Allergies.Any())
    {
        @foreach (var allergy in Model.Allergies)
        {
            <div class="history-item">
                <div class="item-info">
                    <span class="item-name">@allergy.AllergyName</span>
                    <span class="item-details">
                        @allergy.CategoryName
                        <span class="severity-@(allergy.Severity?.ToLower() ?? "mild")">
                            • @(allergy.Severity ?? "Mild")
                        </span>
                        @if (!string.IsNullOrEmpty(allergy.Notes))
                        {
                            <span>• @allergy.Notes</span>
                        }
                    </span>
                </div>
                <button class="remove-btn" onclick="removeItem('allergy', @allergy.PatientAllergyID)">✕</button>
            </div>
        }
    }
    else
    {
        <p style="color: #9CA3AF; text-align: center; padding: 2rem;">No allergies recorded</p>
    }
</div>

<!-- Medications -->
<div class="card-modern history-section">
    <h3>
        <span>💊 Medications</span>
        <button class="add-btn" onclick="openModal('medication')">+ Add Medication</button>
    </h3>

    @if (Model.Medications != null && Model.Medications.Any())
    {
        @foreach (var medication in Model.Medications)
        {
            <div class="history-item">
                <div class="item-info">
                    <span class="item-name">@medication.MedicationName</span>
                    <span class="item-details">
                        @medication.CategoryName
                        @if (!string.IsNullOrEmpty(medication.Dosage))
                        {
                            <span>• Dosage: @medication.Dosage</span>
                        }
                        @if (!string.IsNullOrEmpty(medication.Frequency))
                        {
                            <span>• @medication.Frequency</span>
                        }
                        @if (medication.StartDate.HasValue)
                        {
                            <span>• Started: @medication.StartDate.Value.ToString("dd MMM yyyy")</span>
                        }
                        @if (!medication.IsCurrent && medication.EndDate.HasValue)
                        {
                            <span>• Ended: @medication.EndDate.Value.ToString("dd MMM yyyy")</span>
                        }
                    </span>
                </div>
                <div>
                    <span class="@(medication.IsCurrent ? "status-active" : "status-inactive")">
                        @(medication.IsCurrent ? "Current" : "Discontinued")
                    </span>
                    <button class="remove-btn" onclick="removeItem('medication', @medication.PatientMedicationID)">✕</button>
                </div>
            </div>
        }
    }
    else
    {
        <p style="color: #9CA3AF; text-align: center; padding: 2rem;">No medications recorded</p>
    }
</div>

<script>
    function openModal(type) {
        alert('Add ' + type + ' form will open here');
    }

    function removeItem(type, id) {
        if (confirm('Are you sure you want to remove this ' + type + '?')) {
            alert(type + ' removed successfully');
        }
    }
</script>

