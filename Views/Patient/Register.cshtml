@using NMB_HLabSys.ViewModels.PatientViewModels
@model PatientRegistrationViewModel

@{
    Layout = null;
    ViewData["Title"] = "Patient Registration";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NMBHDL - Patient Registration</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --accent-grad: linear-gradient(135deg, #2563EB 0%, #06B6D4 100%);
            --text-primary: #0F172A;
            --text-secondary: #475569;
            --border: #E2E8F0;
            --danger: #DC2626;
            --danger-bg: #FEF2F2;
            --success: #059669;
            --success-bg: #DCFCE7;
        }

        html, body {
            height: 100%;
            font-family: 'Inter', sans-serif;
            overflow: hidden;
        }

        .register-video {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            z-index: 0;
        }

        .register-overlay {
            position: fixed;
            inset: 0;
            background: linear-gradient( 135deg, rgba(15, 23, 42, 0.78) 0%, rgba(15, 23, 42, 0.6) 50%, rgba(37, 99, 235, 0.5) 100% );
            z-index: 1;
        }

        .register-wrap {
            position: relative;
            z-index: 2;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem;
        }

        .register-split {
            display: grid;
            grid-template-columns: 1fr 1.15fr;
            width: 100%;
            max-width: 1080px;
            height: 88vh;
            max-height: 780px;
            border-radius: 28px;
            overflow: hidden;
            background: rgba(255, 255, 255, 0.98);
            box-shadow: 0 30px 80px rgba(0, 0, 0, 0.45);
            animation: cardIn 0.5s ease-out;
        }

        @@keyframes cardIn {
            from {
                opacity: 0;
                transform: translateY(20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* Left panel */
        .register-visual {
            position: relative;
            background-image: url('https://images.unsplash.com/photo-1576091160399-112ba8d25d1d?w=1000&q=80');
            background-size: cover;
            background-position: center;
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
            padding: 2.5rem;
            color: white;
        }

            .register-visual::before {
                content: '';
                position: absolute;
                inset: 0;
                background: linear-gradient( to top, rgba(15, 23, 42, 0.94) 0%, rgba(37, 99, 235, 0.6) 55%, rgba(6, 182, 212, 0.3) 100% );
            }

        .visual-content {
            position: relative;
            z-index: 1;
        }

        .visual-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: rgba(255, 255, 255, 0.18);
            border: 1px solid rgba(255, 255, 255, 0.35);
            backdrop-filter: blur(10px);
            padding: 0.4rem 0.9rem;
            border-radius: 30px;
            font-size: 0.7rem;
            font-weight: 600;
            letter-spacing: 0.05em;
            text-transform: uppercase;
            margin-bottom: 1.2rem;
        }

        .visual-content h2 {
            font-size: 2rem;
            font-weight: 800;
            line-height: 1.15;
            letter-spacing: -0.02em;
            margin-bottom: 0.8rem;
        }

        .visual-content p {
            font-size: 0.9rem;
            line-height: 1.6;
            color: rgba(255, 255, 255, 0.9);
            max-width: 320px;
        }

        .visual-logo {
            position: absolute;
            top: 2rem;
            left: 2.5rem;
            display: flex;
            align-items: center;
            gap: 10px;
            z-index: 1;
            color: white;
            font-weight: 700;
            font-size: 1.05rem;
        }

            .visual-logo i {
                width: 36px;
                height: 36px;
                background: rgba(255, 255, 255, 0.2);
                backdrop-filter: blur(10px);
                border: 1px solid rgba(255, 255, 255, 0.3);
                border-radius: 10px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 0.95rem;
            }

        /* Right panel */
        .register-form-panel {
            padding: 2.5rem 2.8rem;
            display: flex;
            flex-direction: column;
            overflow-y: auto;
            position: relative;
        }

            .register-form-panel::-webkit-scrollbar {
                width: 6px;
            }

            .register-form-panel::-webkit-scrollbar-thumb {
                background: #CBD5E1;
                border-radius: 3px;
            }

        .back-home {
            position: absolute;
            top: 1.5rem;
            right: 1.8rem;
            color: var(--text-secondary);
            text-decoration: none;
            font-size: 0.78rem;
            font-weight: 500;
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
            transition: 0.2s;
            z-index: 1;
        }

            .back-home:hover {
                color: #2563EB;
            }

        .form-head {
            margin-bottom: 1.6rem;
        }

            .form-head h1 {
                font-size: 1.7rem;
                font-weight: 800;
                color: var(--text-primary);
                letter-spacing: -0.02em;
                margin-bottom: 0.4rem;
            }

            .form-head p {
                color: var(--text-secondary);
                font-size: 0.88rem;
                line-height: 1.5;
            }

        .form-group {
            margin-bottom: 0.95rem;
        }

            .form-group label {
                display: block;
                font-weight: 600;
                font-size: 0.8rem;
                color: #334155;
                margin-bottom: 0.35rem;
            }

        .required {
            color: #DC2626;
        }

        .input-wrap {
            position: relative;
        }

            .input-wrap > i.input-icon {
                position: absolute;
                left: 14px;
                top: 50%;
                transform: translateY(-50%);
                color: #94A3B8;
                font-size: 0.85rem;
                pointer-events: none;
                z-index: 2;
            }

            .input-wrap input {
                width: 100%;
                padding: 0.75rem 1rem 0.75rem 2.6rem;
                border: 1.5px solid var(--border);
                border-radius: 10px;
                font-size: 0.9rem;
                font-family: inherit;
                background: #F8FAFC;
                transition: 0.2s;
            }

                .input-wrap input:focus {
                    outline: none;
                    background: white;
                    border-color: #2563EB;
                    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
                }

                /* ─── Invalid input styling (server-side) ─── */
                .input-wrap input.input-validation-error,
                .input-wrap input.is-invalid {
                    border-color: var(--danger) !important;
                    background: var(--danger-bg) !important;
                }

                    .input-wrap input.input-validation-error:focus,
                    .input-wrap input.is-invalid:focus {
                        box-shadow: 0 0 0 3px rgba(220, 38, 38, 0.15) !important;
                    }

                /* ─── Invalid input styling (client-side) ─── */
                .input-wrap input.error {
                    border-color: #DC2626;
                    background: #FEF2F2;
                }

            .input-wrap.password-wrap input {
                padding-right: 3rem;
            }

        .password-toggle {
            position: absolute;
            right: 10px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            color: #64748B;
            cursor: pointer;
            font-size: 0.95rem;
            padding: 0.4rem;
            transition: 0.2s;
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 2;
            line-height: 1;
        }

            .password-toggle:hover {
                color: #2563EB;
            }

            .password-toggle i {
                position: static;
                transform: none;
                left: auto;
                top: auto;
                pointer-events: none;
            }

        /* ─── Inline error messages (under each field) ─── */
        .field-error {
            color: #DC2626;
            font-size: 0.72rem;
            margin-top: 0.3rem;
            display: none;
        }

            .field-error.show {
                display: block;
                animation: errorFadeIn 0.2s ease-out;
            }

                .field-error.show::before,
                .field-error:not(:empty):not(.show)::before {
                    content: '\f06a';
                    font-family: 'Font Awesome 6 Free';
                    font-weight: 900;
                    margin-right: 0.3rem;
                    font-size: 0.7rem;
                }

            /* Server-side errors (written by Razor) must show */
            .field-error:not(:empty):not(.show) {
                display: block;
            }

        @@keyframes errorFadeIn {
            from {
                opacity: 0;
                transform: translateY(-4px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
        }

        .alert {
            padding: 0.75rem 1rem;
            border-radius: 10px;
            font-size: 0.82rem;
            margin-bottom: 1rem;
            display: flex;
            align-items: flex-start;
            gap: 0.5rem;
            border-left: 4px solid;
        }

        .alert-success {
            background: #DCFCE7;
            color: #166534;
            border-color: #059669;
        }

        .alert-error {
            background: #FEE2E2;
            color: #991B1B;
            border-color: #DC2626;
        }

        .password-hints {
            font-size: 0.72rem;
            color: #64748B;
            margin-top: 0.35rem;
            line-height: 1.9;
        }

            .password-hints > div {
                display: flex;
                align-items: center;
                gap: 0.4rem;
                transition: color 0.2s;
            }

                .password-hints > div i {
                    font-size: 0.5rem;
                    color: #CBD5E1;
                    transition: color 0.2s;
                }

                .password-hints > div.met {
                    color: #10B981;
                }

                    .password-hints > div.met i {
                        color: #10B981;
                    }

        .input-wrap input.auto-filled {
            background: #ECFDF5;
            border-color: #10B981;
            color: #065F46;
            font-weight: 600;
        }

        .dob-badge {
            display: none;
            font-size: 0.68rem;
            color: #059669;
            font-weight: 600;
            margin-top: 0.25rem;
        }

            .dob-badge.visible {
                display: block;
            }

        .btn-register {
            width: 100%;
            padding: 0.9rem;
            background: var(--accent-grad);
            color: white;
            border: none;
            border-radius: 10px;
            font-size: 0.95rem;
            font-weight: 600;
            cursor: pointer;
            transition: 0.2s;
            font-family: inherit;
            box-shadow: 0 8px 22px rgba(37, 99, 235, 0.35);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            margin-top: 1rem;
        }

            .btn-register:hover {
                transform: translateY(-1px);
                box-shadow: 0 12px 28px rgba(37, 99, 235, 0.45);
            }

            .btn-register:disabled {
                opacity: 0.6;
                cursor: not-allowed;
                transform: none;
            }

        .form-footer {
            margin-top: 1.3rem;
            padding-top: 1.2rem;
            border-top: 1px solid var(--border);
            text-align: center;
            font-size: 0.85rem;
            color: var(--text-secondary);
        }

            .form-footer a {
                color: #2563EB;
                text-decoration: none;
                font-weight: 600;
            }

                .form-footer a:hover {
                    text-decoration: underline;
                }

        @@media (max-width: 900px) {
            html, body {
                overflow: auto;
            }

            .register-split {
                grid-template-columns: 1fr;
                height: auto;
                max-height: none;
            }

            .register-visual {
                min-height: 220px;
                padding: 2rem;
            }

            .visual-logo {
                position: static;
                margin-bottom: 1.5rem;
            }

            .visual-content h2 {
                font-size: 1.5rem;
            }

            .register-form-panel {
                padding: 2rem;
            }
        }

        @@media (max-width: 480px) {
            .register-wrap {
                padding: 1rem;
            }

            .register-form-panel {
                padding: 1.8rem 1.5rem;
            }

            .form-head h1 {
                font-size: 1.4rem;
            }

            .form-row {
                grid-template-columns: 1fr;
                gap: 0;
            }
        }
    </style>
</head>
<body>

    <!-- Video background -->
    <video autoplay muted loop playsinline class="register-video">
        <source src="~/videos/262188_medium.mp4" type="video/mp4">
    </video>
    <div class="register-overlay"></div>

    <!-- Split screen -->
    <div class="register-wrap">
        <div class="register-split">

            <!-- Left: picture panel -->
            <div class="register-visual">
                <div class="visual-logo">
                    <i class="fas fa-microscope"></i>
                    <span>NMBHDL</span>
                </div>

                <div class="visual-content">
                    <div class="visual-badge">
                        <i class="fas fa-heartbeat"></i> Patient Portal
                    </div>
                    <h2>Your health, in your hands.</h2>
                    <p>Create your account to view verified results, track your health trends, and share securely with your doctor.</p>
                </div>
            </div>

            <!-- Right: form -->
            <div class="register-form-panel">
                <a href="@Url.Action("Index", "Home")" class="back-home">
                    <i class="fas fa-arrow-left"></i> Back to Home
                </a>

                <div class="form-head">
                    <h1>Create your account</h1>
                    <p>Join the patient portal in under a minute.</p>
                </div>

                @* ─── Success / general error banners ─── *@
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success">
                        <i class="fas fa-check-circle" style="margin-top:2px;"></i>
                        <span>@TempData["SuccessMessage"]</span>
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-error">
                        <i class="fas fa-exclamation-circle" style="margin-top:2px;"></i>
                        <span>@TempData["ErrorMessage"]</span>
                    </div>
                }

                @{
                    // Only show general model errors (no field key) at the top.
                    // Field-specific errors appear inline under each field instead.
                    var generalErrors = ViewData.ModelState
                    .Where(kvp => string.IsNullOrEmpty(kvp.Key))
                    .SelectMany(kvp => kvp.Value.Errors)
                    .Select(e => e.ErrorMessage)
                    .Where(m => !string.IsNullOrEmpty(m))
                    .ToList();
                }
                @if (generalErrors.Any())
                {
                    <div class="alert alert-error">
                        <i class="fas fa-exclamation-circle" style="margin-top:2px;"></i>
                        <div>
                            @foreach (var error in generalErrors)
                            {
                                <div>@error</div>
                            }
                        </div>
                    </div>
                }

                <form method="post" asp-action="Register" id="registerForm" novalidate>
                    @Html.AntiForgeryToken()

                    <div class="form-row">
                        <div class="form-group">
                            <label asp-for="FirstName">First Name <span class="required">*</span></label>
                            <div class="input-wrap">
                                <i class="fas fa-user input-icon"></i>
                                <input asp-for="FirstName" id="regFirstName" placeholder="First name" required
                                       autocomplete="given-name"
                                       oninput="validateName('regFirstName','firstNameError','First name')" />
                            </div>
                            <div class="field-error" id="firstNameError"></div>
                            <span asp-validation-for="FirstName" class="field-error"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="LastName">Last Name <span class="required">*</span></label>
                            <div class="input-wrap">
                                <i class="fas fa-user input-icon"></i>
                                <input asp-for="LastName" id="regLastName" placeholder="Last name" required
                                       autocomplete="family-name"
                                       oninput="validateName('regLastName','lastNameError','Last name')" />
                            </div>
                            <div class="field-error" id="lastNameError"></div>
                            <span asp-validation-for="LastName" class="field-error"></span>
                        </div>
                    </div>

                    <div class="form-group">
                        <label asp-for="SAIDNumber">SA ID Number <span class="required">*</span></label>
                        <div class="input-wrap">
                            <i class="fas fa-id-card input-icon"></i>
                            <input asp-for="SAIDNumber" id="saIdInput"
                                   placeholder="13 digits (e.g. 8001015009087)"
                                   pattern="[0-9]{13}" maxlength="13" inputmode="numeric"
                                   title="SA ID must be exactly 13 digits"
                                   required autocomplete="off"
                                   oninput="this.value=this.value.replace(/\D/g,''); validateID();" />
                        </div>
                        <div class="field-error" id="idError"></div>
                        <span asp-validation-for="SAIDNumber" class="field-error"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Email">Email Address <span class="required">*</span></label>
                        <div class="input-wrap">
                            <i class="fas fa-envelope input-icon"></i>
                            <input asp-for="Email" id="regEmail" type="email" placeholder="you@email.com"
                                   required autocomplete="email"
                                   oninput="validateEmail()" />
                        </div>
                        <div class="field-error" id="emailError"></div>
                        <span asp-validation-for="Email" class="field-error"></span>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label asp-for="Cellphone">Cellphone <span class="required">*</span></label>
                            <div class="input-wrap">
                                <i class="fas fa-phone input-icon"></i>
                                <input asp-for="Cellphone" id="regPhone" placeholder="0821234567"
                                       maxlength="15" inputmode="tel" required autocomplete="tel"
                                       oninput="validatePhone()" />
                            </div>
                            <div class="field-error" id="phoneError"></div>
                            <span asp-validation-for="Cellphone" class="field-error"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="DateOfBirth">Date of Birth <span class="required">*</span></label>
                            <div class="input-wrap">
                                <i class="fas fa-calendar input-icon"></i>
                                <input type="date" name="DateOfBirth" id="dobInput" required
                                       max="@DateTime.Now.ToString("yyyy-MM-dd")"
                                       min="1900-01-01"
                                       onchange="validateDOB(false)" />
                            </div>
                            <span class="dob-badge" id="dobBadge">
                                <i class="fas fa-magic"></i> Auto-filled from your SA ID
                            </span>
                            <div class="field-error" id="dobError"></div>
                            <span asp-validation-for="DateOfBirth" class="field-error"></span>
                        </div>
                    </div>

                    <div class="form-group">
                        <label asp-for="HomeAddress">Home Address</label>
                        <div class="input-wrap">
                            <i class="fas fa-map-marker-alt input-icon"></i>
                            <input asp-for="HomeAddress" placeholder="123 Street, City" autocomplete="street-address" />
                        </div>
                        <span asp-validation-for="HomeAddress" class="field-error"></span>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label asp-for="Password">Password <span class="required">*</span></label>
                            <div class="input-wrap password-wrap">
                                <i class="fas fa-lock input-icon"></i>
                                <input asp-for="Password" type="password" id="passwordInput"
                                       placeholder="Create a password" required
                                       minlength="8" autocomplete="new-password"
                                       oninput="validatePassword()" />
                                <button type="button" class="password-toggle" id="togglePassword"
                                        aria-label="Show password">
                                    <i class="fas fa-eye"></i>
                                </button>
                            </div>
                            <div class="password-hints" id="pwdHints">
                                <div data-req="length"><i class="fas fa-circle"></i> At least 8 characters</div>
                                <div data-req="upper"><i class="fas fa-circle"></i> One uppercase letter</div>
                                <div data-req="lower"><i class="fas fa-circle"></i> One lowercase letter</div>
                                <div data-req="number"><i class="fas fa-circle"></i> One number</div>
                                <div data-req="special"><i class="fas fa-circle"></i> One special character</div>
                            </div>
                            <div class="field-error" id="passwordError"></div>
                            <span asp-validation-for="Password" class="field-error"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="ConfirmPassword">Confirm Password <span class="required">*</span></label>
                            <div class="input-wrap password-wrap">
                                <i class="fas fa-lock input-icon"></i>
                                <input asp-for="ConfirmPassword" type="password" id="confirmPasswordInput"
                                       placeholder="Confirm password" required
                                       minlength="8" autocomplete="new-password"
                                       oninput="validateConfirm()" />
                                <button type="button" class="password-toggle" id="toggleConfirmPassword"
                                        aria-label="Show password">
                                    <i class="fas fa-eye"></i>
                                </button>
                            </div>
                            <div class="field-error" id="confirmError"></div>
                            <span asp-validation-for="ConfirmPassword" class="field-error"></span>
                        </div>
                    </div>

                    <button type="submit" class="btn-register" id="registerBtn">
                        <i class="fas fa-user-plus"></i> Create Account
                    </button>
                </form>

                <div class="form-footer">
                    Already have an account? <a href="@Url.Action("Login", "Account")">Login here</a>
                </div>
            </div>

        </div>
    </div>

    <script>
        (function () {
            'use strict';

            // ═══════════════════════════════════════════════════════════
            // PASSWORD SHOW/HIDE
            // ═══════════════════════════════════════════════════════════
            function setupToggle(toggleId, inputId) {
                var btn = document.getElementById(toggleId);
                var inp = document.getElementById(inputId);
                if (!btn || !inp) return;
                btn.addEventListener('click', function () {
                    var isPwd = inp.type === 'password';
                    inp.type = isPwd ? 'text' : 'password';
                    var icon = btn.querySelector('i');
                    icon.classList.toggle('fa-eye', !isPwd);
                    icon.classList.toggle('fa-eye-slash', isPwd);
                    btn.setAttribute('aria-label', isPwd ? 'Hide password' : 'Show password');
                });
            }
            setupToggle('togglePassword', 'passwordInput');
            setupToggle('toggleConfirmPassword', 'confirmPasswordInput');

            // ═══════════════════════════════════════════════════════════
            // HELPERS
            // ═══════════════════════════════════════════════════════════
            function setErr(el, errId, msg) {
                el.classList.add('error');
                var box = document.getElementById(errId);
                if (box) { box.textContent = msg; box.classList.add('show'); }
            }

            function clearErr(el, errId) {
                el.classList.remove('error');
                var box = document.getElementById(errId);
                if (box) { box.textContent = ''; box.classList.remove('show'); }
            }

            function parseLocalDate(v) {
                if (!v) return null;
                var m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(v);
                if (!m) return null;
                var dt = new Date(+m[1], +m[2] - 1, +m[3]);
                if (dt.getFullYear() !== +m[1] || dt.getMonth() !== +m[2] - 1 || dt.getDate() !== +m[3]) return null;
                return dt;
            }

            function formatYMD(dt) {
                return dt.getFullYear() + '-' +
                    String(dt.getMonth() + 1).padStart(2, '0') + '-' +
                    String(dt.getDate()).padStart(2, '0');
            }

            // ═══════════════════════════════════════════════════════════
            // SA ID → decode the embedded date
            // ═══════════════════════════════════════════════════════════
            function decodeSaIdDate(id13) {
                var yy = parseInt(id13.substr(0, 2), 10);
                var mm = parseInt(id13.substr(2, 2), 10);
                var dd = parseInt(id13.substr(4, 2), 10);

                if (mm < 1 || mm > 12) {
                    return { ok: false, reason: 'SA ID has an invalid month (' + mm + ') in position 3-4' };
                }
                if (dd < 1 || dd > 31) {
                    return { ok: false, reason: 'SA ID has an invalid day (' + dd + ') in position 5-6' };
                }

                var year = (yy >= 0 && yy <= 24) ? 2000 + yy : 1900 + yy;
                var dt = new Date(year, mm - 1, dd);

                if (dt.getFullYear() !== year || dt.getMonth() !== mm - 1 || dt.getDate() !== dd) {
                    return {
                        ok: false,
                        reason: 'SA ID has an impossible date (' +
                            yy + '-' + String(mm).padStart(2, '0') + '-' + String(dd).padStart(2, '0') + ')'
                    };
                }

                var today = new Date(); today.setHours(0, 0, 0, 0);
                if (dt > today) {
                    return { ok: false, reason: 'SA ID encodes a date in the future' };
                }

                return { ok: true, date: dt, dob: formatYMD(dt) };
            }

            // ═══════════════════════════════════════════════════════════
            // NAME
            // ═══════════════════════════════════════════════════════════
            function validateName(inputId, errId, label) {
                var el = document.getElementById(inputId);
                var v = (el.value || '').trim();
                if (v.length === 0) { setErr(el, errId, label + ' is required'); return false; }
                if (v.length < 2)   { setErr(el, errId, label + ' must be at least 2 characters'); return false; }
                clearErr(el, errId);
                return true;
            }

            // ═══════════════════════════════════════════════════════════
            // SA ID — live validation + DOB auto-fill
            // ═══════════════════════════════════════════════════════════
            function validateID() {
                var el = document.getElementById('saIdInput');
                if (!el) return false;
                var v = (el.value || '').replace(/\D/g, '');
                el.value = v;

                if (v.length === 0) { clearErr(el, 'idError'); return false; }
                if (v.length < 13)  { clearErr(el, 'idError'); return false; }
                if (v.length > 13)  { el.value = v = v.substr(0, 13); }

                var decoded = decodeSaIdDate(v);
                if (!decoded.ok) {
                    setErr(el, 'idError', decoded.reason);
                    return false;
                }

                clearErr(el, 'idError');

                // ─── Auto-fill DOB ───
                var dobEl = document.getElementById('dobInput');
                var badge = document.getElementById('dobBadge');
                if (!dobEl) return true;

                if (!dobEl.dataset.userEdited || dobEl.dataset.userEdited === '0') {
                    dobEl.value = decoded.dob;
                    dobEl.classList.add('auto-filled');
                    if (badge) badge.classList.add('visible');
                    dobEl.dataset.userEdited = '0';
                    clearErr(dobEl, 'dobError');
                }

                return true;
            }

            // ═══════════════════════════════════════════════════════════
            // DOB
            // ═══════════════════════════════════════════════════════════
            function validateDOB(fromAutoFill) {
                var el = document.getElementById('dobInput');
                if (!el) return false;

                if (!fromAutoFill) {
                    el.dataset.userEdited = '1';
                    el.classList.remove('auto-filled');
                    var badge = document.getElementById('dobBadge');
                    if (badge) badge.classList.remove('visible');
                }

                if (!el.value) { setErr(el, 'dobError', 'Please select date of birth'); return false; }

                var dt = parseLocalDate(el.value);
                if (!dt) { setErr(el, 'dobError', 'Please enter a valid date'); return false; }

                var today = new Date(); today.setHours(0, 0, 0, 0);
                if (dt > today) { setErr(el, 'dobError', 'Date of birth cannot be in the future'); return false; }

                var idEl = document.getElementById('saIdInput');
                var id = idEl ? (idEl.value || '').replace(/\D/g, '') : '';
                if (id.length === 13) {
                    var decoded = decodeSaIdDate(id);
                    if (decoded.ok && el.value !== decoded.dob) {
                        setErr(el, 'dobError', 'Date of birth does not match the SA ID (' + decoded.dob + ')');
                        return false;
                    }
                }

                clearErr(el, 'dobError');
                return true;
            }

            // ═══════════════════════════════════════════════════════════
            // PHONE
            // ═══════════════════════════════════════════════════════════
            function validatePhone() {
                var el = document.getElementById('regPhone');
                if (!el) return false;
                var v = (el.value || '').replace(/[\s\-]/g, '');

                if (!v) { setErr(el, 'phoneError', 'Cellphone is required'); return false; }
                if (!/^(0[1-9][0-9]{8}|\+27[1-9][0-9]{8})$/.test(v)) {
                    setErr(el, 'phoneError', 'Enter a valid SA number (e.g. 0821234567)');
                    return false;
                }
                clearErr(el, 'phoneError');
                return true;
            }

            // ═══════════════════════════════════════════════════════════
            // EMAIL
            // ═══════════════════════════════════════════════════════════
            function validateEmail() {
                var el = document.getElementById('regEmail');
                if (!el) return false;
                var v = (el.value || '').trim();

                if (!v) { setErr(el, 'emailError', 'Email is required'); return false; }
                if (!/^[^\s@@]+@@[^\s@@]+\.[^\s@@]{2,}$/.test(v)) {
                    setErr(el, 'emailError', 'Enter a valid email address');
                    return false;
                }
                clearErr(el, 'emailError');
                return true;
            }

            // ═══════════════════════════════════════════════════════════
            // PASSWORD
            // ═══════════════════════════════════════════════════════════
            function validatePassword() {
                var el = document.getElementById('passwordInput');
                if (!el) return false;
                var v = el.value;

                var hints = document.querySelectorAll('#pwdHints > div');
                var tests = {
                    length:  v.length >= 8,
                    upper:   /[A-Z]/.test(v),
                    lower:   /[a-z]/.test(v),
                    number:  /[0-9]/.test(v),
                    special: /[^A-Za-z0-9]/.test(v)
                };
                var allMet = true;
                hints.forEach(function (hint) {
                    var key = hint.getAttribute('data-req');
                    var met = tests[key];
                    hint.classList.toggle('met', met);
                    var icon = hint.querySelector('i');
                    if (icon) icon.className = met ? 'fas fa-check-circle' : 'fas fa-circle';
                    if (!met) allMet = false;
                });

                if (!v) {
                    setErr(el, 'passwordError', 'Password is required');
                    return false;
                }
                if (!allMet) {
                    setErr(el, 'passwordError', 'Password must meet all requirements above');
                    return false;
                }
                clearErr(el, 'passwordError');

                var confirmEl = document.getElementById('confirmPasswordInput');
                if (confirmEl && confirmEl.value) {
                    validateConfirm();
                }
                return true;
            }

            // ═══════════════════════════════════════════════════════════
            // CONFIRM PASSWORD
            // ═══════════════════════════════════════════════════════════
            function validateConfirm() {
                var el = document.getElementById('confirmPasswordInput');
                if (!el) return false;
                var pwdEl = document.getElementById('passwordInput');
                var pwd = pwdEl ? pwdEl.value : '';

                if (!el.value) { setErr(el, 'confirmError', 'Please confirm your password'); return false; }
                if (el.value !== pwd) { setErr(el, 'confirmError', 'Passwords do not match'); return false; }
                clearErr(el, 'confirmError');
                return true;
            }

            // ═══════════════════════════════════════════════════════════
            // EXPOSE VALIDATORS TO GLOBAL SCOPE
            // (required because HTML has inline oninput/onchange handlers)
            // ═══════════════════════════════════════════════════════════
            window.validateName     = validateName;
            window.validateID       = validateID;
            window.validateDOB      = validateDOB;
            window.validatePhone    = validatePhone;
            window.validateEmail    = validateEmail;
            window.validatePassword = validatePassword;
            window.validateConfirm  = validateConfirm;

            // ═══════════════════════════════════════════════════════════
            // WIRE UP FORM SUBMIT
            // ═══════════════════════════════════════════════════════════
            var form = document.getElementById('registerForm');
            if (!form) return;

            // Strip "0001-01-01" default if Razor injected it
            var dobInit = document.getElementById('dobInput');
            if (dobInit && dobInit.value && dobInit.value.startsWith('0001')) {
                dobInit.value = '';
            }

            form.addEventListener('submit', function (e) {
                var ok = true;
                ok = validateName('regFirstName', 'firstNameError', 'First name') && ok;
                ok = validateName('regLastName', 'lastNameError', 'Last name') && ok;
                ok = validateID() && ok;
                ok = validateDOB(true) && ok;
                ok = validatePhone() && ok;
                ok = validateEmail() && ok;
                ok = validatePassword() && ok;
                ok = validateConfirm() && ok;

                if (!ok) {
                    e.preventDefault();
                    var firstErr = form.querySelector('input.error');
                    if (firstErr) {
                        firstErr.scrollIntoView({ behavior: 'smooth', block: 'center' });
                        firstErr.focus();
                    }
                    return;
                }

                var btn = document.getElementById('registerBtn');
                btn.disabled = true;
                btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Creating account...';
            });

            // Prefill check on load
            if (document.getElementById('saIdInput').value) validateID();
        })();
    </script>

</body>
</html>