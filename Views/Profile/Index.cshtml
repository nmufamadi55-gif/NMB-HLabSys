<style>
    .profile-container {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
        gap: 1.5rem;
    }

    .profile-card {
        background: white;
        border-radius: 20px;
        border: 1px solid #E2E8F0;
        overflow: hidden;
    }

    .profile-card-header {
        background: linear-gradient(135deg, #F8FAFE, #FFFFFF);
        padding: 1rem 1.5rem;
        border-bottom: 1px solid #E2E8F0;
    }

        .profile-card-header h3 {
            margin: 0;
            color: #032C7D;
            font-size: 1.1rem;
        }

    .profile-card-body {
        padding: 1.5rem;
    }

    .form-group {
        margin-bottom: 1.2rem;
    }

        .form-group label {
            font-size: 0.8rem;
            font-weight: 600;
            display: block;
            margin-bottom: 0.3rem;
            color: #032C7D;
        }

    .form-control {
        width: 100%;
        padding: 0.6rem 0.8rem;
        border: 1px solid #E2E8F0;
        border-radius: 12px;
        font-size: 0.85rem;
        transition: all 0.2s;
    }

        .form-control:focus {
            outline: none;
            border-color: #0841C9;
            box-shadow: 0 0 0 3px rgba(8,65,201,0.1);
        }

    .btn-primary {
        background: #0841C9;
        color: white;
        border: none;
        padding: 0.5rem 1.2rem;
        border-radius: 30px;
        cursor: pointer;
        font-size: 0.8rem;
        transition: all 0.2s;
    }

        .btn-primary:hover {
            background: #032C7D;
        }

    .btn-outline {
        background: transparent;
        border: 1px solid #E2E8F0;
        padding: 0.5rem 1.2rem;
        border-radius: 30px;
        cursor: pointer;
        font-size: 0.8rem;
    }

    .alert-success {
        background: #D1FAE5;
        color: #065F46;
        padding: 0.8rem 1rem;
        border-radius: 12px;
        margin-bottom: 1rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .alert-error {
        background: #FEE2E2;
        color: #991B1B;
        padding: 0.8rem 1rem;
        border-radius: 12px;
        margin-bottom: 1rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .password-requirements {
        font-size: 0.7rem;
        color: #5A6E7A;
        margin-top: 0.3rem;
    }

    .row-2col {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
    }

    .switch {
        position: relative;
        display: inline-block;
        width: 50px;
        height: 24px;
    }

        .switch input {
            opacity: 0;
            width: 0;
            height: 0;
        }

    .slider {
        position: absolute;
        cursor: pointer;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: #ccc;
        transition: .4s;
        border-radius: 24px;
    }

        .slider:before {
            position: absolute;
            content: "";
            height: 18px;
            width: 18px;
            left: 3px;
            bottom: 3px;
            background-color: white;
            transition: .4s;
            border-radius: 50%;
        }

    input:checked + .slider {
        background-color: #0841C9;
    }

        input:checked + .slider:before {
            transform: translateX(26px);
        }

    .margin-top-0 {
        margin-top: 0;
    }

    @@media (max-width: 768px) {
        .profile-container {
            grid-template-columns: 1fr;
        }

        .row-2col {
            grid-template-columns: 1fr;
        }
    }
</style>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert-success">
        <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert-error">
        <i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]
    </div>
}

<div class="profile-container">
    <!-- Personal Information Card -->
    <div class="profile-card">
        <div class="profile-card-header">
            <h3><i class="fas fa-user-circle"></i> Personal Information</h3>
        </div>
        <div class="profile-card-body">
            <form method="post" action="@Url.Action("UpdateProfile", "Profile")">
                <div class="row-2col">
                    <div class="form-group">
                        <label>First Name</label>
                        <input type="text" name="name" class="form-control" value="@(ViewBag.UserName?.Split(' ')[0] ?? "")" placeholder="First name">
                    </div>
                    <div class="form-group">
                        <label>Last Name</label>
                        <input type="text" name="surname" class="form-control" value="@(ViewBag.UserName?.Split(' ').Length > 1 ? ViewBag.UserName.Split(' ')[1] : "")" placeholder="Last name">
                    </div>
                </div>
                <div class="form-group">
                    <label>Email Address (Username)</label>
                    <input type="email" name="email" class="form-control" value="@ViewBag.UserEmail" placeholder="email@example.com">
                    <small style="font-size:0.65rem; color:#5A6E7A;">This is your login username</small>
                </div>
                <div class="form-group">
                    <label>Phone Number</label>
                    <input type="tel" name="phone" class="form-control" placeholder="082 123 4567">
                </div>
                <div class="form-group">
                    <button type="submit" class="btn-primary"><i class="fas fa-save"></i> Save Changes</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Change Password Card -->
    <div class="profile-card">
        <div class="profile-card-header">
            <h3><i class="fas fa-lock"></i> Change Password</h3>
        </div>
        <div class="profile-card-body">
            <form method="post" action="@Url.Action("ChangePassword", "Profile")">
                <div class="form-group">
                    <label>Current Password</label>
                    <input type="password" name="currentPassword" class="form-control" placeholder="Enter current password" required>
                </div>
                <div class="form-group">
                    <label>New Password</label>
                    <input type="password" name="newPassword" id="newPassword" class="form-control" placeholder="Enter new password" required>
                    <div class="password-requirements" id="passwordRequirements">
                        <i class="fas fa-circle" style="font-size:0.5rem;" id="reqLength"></i> At least 8 characters<br>
                        <i class="fas fa-circle" style="font-size:0.5rem;" id="reqUpper"></i> One uppercase letter<br>
                        <i class="fas fa-circle" style="font-size:0.5rem;" id="reqNumber"></i> One number<br>
                        <i class="fas fa-circle" style="font-size:0.5rem;" id="reqSpecial"></i> One special character (!@@#$%^&*)
                    </div>
                </div>
                <div class="form-group">
                    <label>Confirm New Password</label>
                    <input type="password" name="confirmPassword" id="confirmPassword" class="form-control" placeholder="Confirm new password" required>
                    <div id="matchMessage" class="password-requirements"></div>
                </div>
                <div class="form-group">
                    <button type="submit" class="btn-primary" id="changePasswordBtn"><i class="fas fa-key"></i> Update Password</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="profile-card margin-top-0">
    <div class="profile-card-header">
        <h3><i class="fas fa-shield-alt"></i> Account Security</h3>
    </div>
    <div class="profile-card-body">
        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
            <div>
                <strong>Two-Factor Authentication</strong><br>
                <small style="color:#5A6E7A;">Add an extra layer of security to your account</small>
            </div>
            <label class="switch">
                <input type="checkbox" id="twoFactorToggle" onclick="toggleTwoFactor()">
                <span class="slider"></span>
            </label>
        </div>
        <hr style="margin: 1rem 0; border-color: #E2E8F0;">
        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
            <div>
                <strong>Recent Login Activity</strong><br>
                <small style="color:#5A6E7A;">Last login: Today at 09:45 AM from Gqeberha, SA</small>
            </div>
            <button class="btn-outline" onclick="alert('View all login history')">View History</button>
        </div>
    </div>
</div>

<script type="text/javascript">
    function checkPasswordStrength() {
        var password = document.getElementById('newPassword').value;

        var lengthOk = password.length >= 8;
        var upperOk = /[A-Z]/.test(password);
        var numberOk = /[0-9]/.test(password);
        var specialOk = /[!@@#$%^&*(),.?":{}|<>]/.test(password);

        document.getElementById('reqLength').style.color = lengthOk ? '#10B981' : '#5A6E7A';
        document.getElementById('reqUpper').style.color = upperOk ? '#10B981' : '#5A6E7A';
        document.getElementById('reqNumber').style.color = numberOk ? '#10B981' : '#5A6E7A';
        document.getElementById('reqSpecial').style.color = specialOk ? '#10B981' : '#5A6E7A';

        if (lengthOk) {
            document.getElementById('reqLength').className = 'fas fa-check-circle';
        } else {
            document.getElementById('reqLength').className = 'fas fa-circle';
        }
        if (upperOk) {
            document.getElementById('reqUpper').className = 'fas fa-check-circle';
        } else {
            document.getElementById('reqUpper').className = 'fas fa-circle';
        }
        if (numberOk) {
            document.getElementById('reqNumber').className = 'fas fa-check-circle';
        } else {
            document.getElementById('reqNumber').className = 'fas fa-circle';
        }
        if (specialOk) {
            document.getElementById('reqSpecial').className = 'fas fa-check-circle';
        } else {
            document.getElementById('reqSpecial').className = 'fas fa-circle';
        }

        return lengthOk && upperOk && numberOk && specialOk;
    }

    function checkPasswordMatch() {
        var password = document.getElementById('newPassword').value;
        var confirm = document.getElementById('confirmPassword').value;
        var matchMsg = document.getElementById('matchMessage');

        if (confirm.length > 0) {
            if (password === confirm) {
                matchMsg.innerHTML = '<i class="fas fa-check-circle" style="color:#10B981;"></i> Passwords match';
                matchMsg.style.color = '#10B981';
            } else {
                matchMsg.innerHTML = '<i class="fas fa-exclamation-circle" style="color:#DC2626;"></i> Passwords do not match';
                matchMsg.style.color = '#DC2626';
            }
        } else {
            matchMsg.innerHTML = '';
        }
    }

    function toggleTwoFactor() {
        var isChecked = document.getElementById('twoFactorToggle').checked;
        if (isChecked) {
            alert('Two-Factor Authentication would be configured here.\n\nYou would receive a verification code via SMS or authenticator app.');
        } else {
            alert('Two-Factor Authentication disabled.');
        }
    }

    // Attach event listeners
    document.getElementById('newPassword').oninput = function() {
        checkPasswordStrength();
        checkPasswordMatch();
    };
    document.getElementById('confirmPassword').oninput = function() {
        checkPasswordMatch();
    };
</script>