@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "My Profile";
    ViewData["RoleSubtitle"] = @ViewBag.UserRole + " Portal";
    ViewData["UserGreeting"] = @ViewBag.UserGreeting;
    ViewData["UserInitials"] = @ViewBag.UserInitials;
    ViewData["UserName"] = @ViewBag.UserName;
}

