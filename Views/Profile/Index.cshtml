@{
    var role = Context.Session.GetString("UserRole");
    var sessionName = Context.Session.GetString("UserName") ?? "";
    var sessionEmail = Context.Session.GetString("UserEmail") ?? "";
    
    // Split name for the form fields if ViewBag isn't available
    var nameParts = sessionName.Split(' ', 2);
    var firstName = ViewBag.Name ?? (nameParts.Length > 0 ? nameParts[0] : "");
    var lastName = ViewBag.Surname ?? (nameParts.Length > 1 ? nameParts[1] : "");
    var email = ViewBag.Email ?? sessionEmail;
    
    // Dynamically assign layout based on role
    Layout = role == "Manager" ? "~/Views/Shared/_ManagerLayout.cshtml" : "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "My Profile";

    if (role != "Manager")
    {
        ViewData["RoleSubtitle"] = role + " Portal";
        ViewData["UserGreeting"] = $"Welcome back, {sessionName}";
        ViewData["UserInitials"] = ViewBag.UserInitials ?? "U";
        ViewData["UserName"] = sessionName;
    }
}

