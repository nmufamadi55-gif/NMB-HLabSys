<style>
    .profile-container {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
        gap: 1.5rem;
    }

    .profile-card {
        background: white;
        border-radius: 20px;
        border: 1px solid #E2E8F0;
        overflow: hidden;
    }

    .profile-card-header {
        background: linear-gradient(135deg, #F8FAFE, #FFFFFF);
        padding: 1rem 1.5rem;
        border-bottom: 1px solid #E2E8F0;
    }

        .profile-card-header h3 {
            margin: 0;
            color: #032C7D;
            font-size: 1.1rem;
        }

    .profile-card-body {
        padding: 1.5rem;
    }

    .form-group {
        margin-bottom: 1.2rem;
    }

        .form-group label {
            font-size: 0.8rem;
            font-weight: 600;
            display: block;
            margin-bottom: 0.3rem;
            color: #032C7D;
        }

    .form-control {
        width: 100%;
        padding: 0.6rem 0.8rem;
        border: 1px solid #E2E8F0;
        border-radius: 12px;
        font-size: 0.85rem;
        transition: all 0.2s;
    }

        .form-control:focus {
            outline: none;
            border-color: #0841C9;
            box-shadow: 0 0 0 3px rgba(8,65,201,0.1);
        }

        .form-control.error {
            border-color: #DC2626;
            background: #FEF2F2;
        }

    /* Error Message Styling */
    .error-msg {
        display: none;
        color: #DC2626;
        font-size: 0.72rem;
        margin-top: 0.3rem;
    }
    .error-msg.show {
        display: block;
    }

    /* Password Eye Icon Styling */
    .password-wrapper { position: relative; }
    .password-toggle {
        position: absolute;
        right: 12px;
        top: 50%;
        transform: translateY(-50%);
        cursor: pointer;
        color: #94A3B8;
        background: none;
        border: none;
        padding: 0;
    }
    .password-toggle:hover { color: #0841C9; }

    .btn-primary {
        background: #0841C9;
        color: white;
        border: none;
        padding: 0.5rem 1.2rem;
        border-radius: 30px;
        cursor: pointer;
        font-size: 0.8rem;
        transition: all 0.2s;
    }

        .btn-primary:hover {
            background: #032C7D;
        }

    .btn-outline {
        background: transparent;
        border: 1px solid #E2E8F0;
        padding: 0.5rem 1.2rem;
        border-radius: 30px;
        cursor: pointer;
        font-size: 0.8rem;
    }

    .alert-success {
        background: #D1FAE5;
        color: #065F46;
        padding: 0.8rem 1rem;
        border-radius: 12px;
        margin-bottom: 1rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .alert-error {
        background: #FEE2E2;
        color: #991B1B;
        padding: 0.8rem 1rem;
        border-radius: 12px;
        margin-bottom: 1rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .password-requirements {
        font-size: 0.7rem;
        color: #5A6E7A;
        margin-top: 0.3rem;
        line-height: 1.6;
    }

    .row-2col {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
    }

    .switch {
        position: relative;
        display: inline-block;
        width: 50px;
        height: 24px;
    }

        .switch input {
            opacity: 0;
            width: 0;
            height: 0;
        }

    .slider {
        position: absolute;
        cursor: pointer;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: #ccc;
        transition: .4s;
        border-radius: 24px;
    }

        .slider:before {
            position: absolute;
            content: "";
            height: 18px;
            width: 18px;
            left: 3px;
            bottom: 3px;
            background-color: white;
            transition: .4s;
            border-radius: 50%;
        }

    input:checked + .slider {
        background-color: #0841C9;
    }

        input:checked + .slider:before {
            transform: translateX(26px);
        }

    .margin-top-0 {
        margin-top: 0;
    }

    @@media (max-width: 768px) {
        .profile-container {
            grid-template-columns: 1fr;
        }

        .row-2col {
            grid-template-columns: 1fr;
        }
    }
</style>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert-success">
        <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert-error">
        <i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]
    </div>
}

<div class="profile-container">
    <!-- Personal Information Card -->
    <div class="profile-card">
        <div class="profile-card-header">
            <h3><i class="fas fa-user-circle"></i> Personal Information</h3>
        </div>
        <div class="profile-card-body">
            <form method="post" action="@Url.Action("UpdateProfile", "Profile")" id="updateProfileForm">
                @Html.AntiForgeryToken()
                <div class="row-2col">
                    <div class="form-group">
                        <label>First Name</label>
                        <input type="text" name="name" id="profName" class="form-control" value="@firstName" placeholder="First name" required>
                        <span class="error-msg" id="nameError">First name must be at least 2 characters.</span>
                    </div>
                    <div class="form-group">
                        <label>Last Name</label>
                        <input type="text" name="surname" id="profSurname" class="form-control" value="@lastName" placeholder="Last name" required>
                        <span class="error-msg" id="surnameError">Last name must be at least 2 characters.</span>
                    </div>
                </div>
                <div class="form-group">
                    <label>Email Address (Username)</label>
                    <input type="email" name="email" class="form-control" value="@email" placeholder="email@example.com" required readonly style="background:#F8FAFE; cursor:not-allowed;">
                    <small style="font-size:0.65rem; color:#5A6E7A;">This is your login username and cannot be changed here.</small>
                </div>
<div class="form-group">
    <label>Phone Number</label>
    <!-- Added maxlength="10" and oninput to strip non-digits -->
    <input type="tel" name="phone" id="profPhone" class="form-control" value="@ViewBag.ContactNumber" 
           placeholder="0821234567" maxlength="10" inputmode="numeric"
           oninput="this.value = this.value.replace(/\D/g, '')">
    <span class="error-msg" id="phoneError">Please enter a valid 10-digit SA phone number (e.g. 0821234567).</span>
</div>
                <div class="form-group">
                    <button type="submit" class="btn-primary"><i class="fas fa-save"></i> Save Changes</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Change Password Card -->
    <div class="profile-card">
        <div class="profile-card-header">
            <h3><i class="fas fa-lock"></i> Change Password</h3>
        </div>
        <div class="profile-card-body">
            <form method="post" action="@Url.Action("ChangePassword", "Profile")" id="changePasswordForm">
                @Html.AntiForgeryToken()
                
                <div class="form-group">
                    <label>Current Password</label>
                    <div class="password-wrapper">
                        <input type="password" name="currentPassword" id="currentPassword" class="form-control" placeholder="Enter current password" required>
                        <button type="button" class="password-toggle" onclick="togglePassword('currentPassword', 'eye1')"><i class="fas fa-eye" id="eye1"></i></button>
                    </div>
                </div>
                
                <div class="form-group">
                    <label>New Password</label>
                    <div class="password-wrapper">
                        <input type="password" name="newPassword" id="newPassword" class="form-control" placeholder="Enter new password" required>
                        <button type="button" class="password-toggle" onclick="togglePassword('newPassword', 'eye2')"><i class="fas fa-eye" id="eye2"></i></button>
                    </div>
                    <div class="password-requirements" id="passwordRequirements">
                        <i class="fas fa-circle" style="font-size:0.5rem;" id="reqLength"></i> At least 8 characters<br>
                        <i class="fas fa-circle" style="font-size:0.5rem;" id="reqUpper"></i> One uppercase letter<br>
                        <i class="fas fa-circle" style="font-size:0.5rem;" id="reqNumber"></i> One number<br>
                        <i class="fas fa-circle" style="font-size:0.5rem;" id="reqSpecial"></i> One special character (!@@#$%^&*)
                    </div>
                </div>
                
                <div class="form-group">
                    <label>Confirm New Password</label>
                    <div class="password-wrapper">
                        <input type="password" name="confirmPassword" id="confirmPassword" class="form-control" placeholder="Confirm new password" required>
                        <button type="button" class="password-toggle" onclick="togglePassword('confirmPassword', 'eye3')"><i class="fas fa-eye" id="eye3"></i></button>
                    </div>
                    <div id="matchMessage" class="password-requirements"></div>
                </div>
                
                <div class="form-group">
                    <button type="submit" class="btn-primary" id="changePasswordBtn"><i class="fas fa-key"></i> Update Password</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="profile-card margin-top-0" style="margin-top: 1.5rem;">
    <div class="profile-card-header">
        <h3><i class="fas fa-shield-alt"></i> Account Security</h3>
    </div>
    <div class="profile-card-body">
        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
            <div>
                <strong>Two-Factor Authentication</strong><br>
                <small style="color:#5A6E7A;">Add an extra layer of security to your account</small>
            </div>
            <label class="switch">
                <input type="checkbox" id="twoFactorToggle" onclick="toggleTwoFactor()">
                <span class="slider"></span>
            </label>
        </div>
        <hr style="margin: 1rem 0; border-color: #E2E8F0;">
        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
            <div>
                <strong>Recent Login Activity</strong><br>
                <small style="color:#5A6E7A;">Last login: Today from your current device</small>
            </div>
            <button type="button" class="btn-outline" onclick="alert('View all login history')">View History</button>
        </div>
    </div>
</div>

<script type="text/javascript">
    // ─── PASSWORD EYE TOGGLE ───
    function togglePassword(inputId, iconId) {
        var input = document.getElementById(inputId);
        var icon = document.getElementById(iconId);
        
        if (input.type === "password") {
            input.type = "text";
            icon.classList.remove("fa-eye");
            icon.classList.add("fa-eye-slash");
        } else {
            input.type = "password";
            icon.classList.remove("fa-eye-slash");
            icon.classList.add("fa-eye");
        }
    }

    // ─── PASSWORD STRENGTH CHECKER ───
    function checkPasswordStrength() {
        var password = document.getElementById('newPassword').value;

        var lengthOk = password.length >= 8;
        var upperOk = /[A-Z]/.test(password);
        var numberOk = /[0-9]/.test(password);
        var specialOk = /[!@@#$%^&*(),.?":{}|<>]/.test(password);

        document.getElementById('reqLength').style.color = lengthOk ? '#10B981' : '#5A6E7A';
        document.getElementById('reqUpper').style.color = upperOk ? '#10B981' : '#5A6E7A';
        document.getElementById('reqNumber').style.color = numberOk ? '#10B981' : '#5A6E7A';
        document.getElementById('reqSpecial').style.color = specialOk ? '#10B981' : '#5A6E7A';

        document.getElementById('reqLength').className = lengthOk ? 'fas fa-check-circle' : 'fas fa-circle';
        document.getElementById('reqUpper').className = upperOk ? 'fas fa-check-circle' : 'fas fa-circle';
        document.getElementById('reqNumber').className = numberOk ? 'fas fa-check-circle' : 'fas fa-circle';
        document.getElementById('reqSpecial').className = specialOk ? 'fas fa-check-circle' : 'fas fa-circle';

        return lengthOk && upperOk && numberOk && specialOk;
    }

    // ─── PASSWORD MATCH CHECKER ───
    function checkPasswordMatch() {
        var password = document.getElementById('newPassword').value;
        var confirm = document.getElementById('confirmPassword').value;
        var matchMsg = document.getElementById('matchMessage');

        if (confirm.length > 0) {
            if (password === confirm) {
                matchMsg.innerHTML = '<i class="fas fa-check-circle" style="color:#10B981;"></i> Passwords match';
                matchMsg.style.color = '#10B981';
                return true;
            } else {
                matchMsg.innerHTML = '<i class="fas fa-exclamation-circle" style="color:#DC2626;"></i> Passwords do not match';
                matchMsg.style.color = '#DC2626';
                return false;
            }
        } else {
            matchMsg.innerHTML = '';
            return false;
        }
    }

    // ─── UPDATE PROFILE FORM VALIDATION ───
    document.getElementById('updateProfileForm').addEventListener('submit', function(e) {
        var isValid = true;
        
        var name = document.getElementById('profName');
        var surname = document.getElementById('profSurname');
        var phone = document.getElementById('profPhone');

        // Reset errors
        name.classList.remove('error');
        surname.classList.remove('error');
        phone.classList.remove('error');
        document.getElementById('nameError').classList.remove('show');
        document.getElementById('surnameError').classList.remove('show');
        document.getElementById('phoneError').classList.remove('show');

        // Validate Name
        if (name.value.trim().length < 2) {
            name.classList.add('error');
            document.getElementById('nameError').classList.add('show');
            isValid = false;
        }

        // Validate Surname
        if (surname.value.trim().length < 2) {
            surname.classList.add('error');
            document.getElementById('surnameError').classList.add('show');
            isValid = false;
        }

        // Validate Phone (Optional, but if filled must be valid)
        // Validate Phone (Optional, but if filled must be exactly 10 digits)
        if (phone.value.trim() !== '') {
            // This regex strictly requires exactly 10 digits, starting with 0
            var phoneRe = /^0\d{9}$/; 
            
            if (!phoneRe.test(phone.value)) {
                phone.classList.add('error');
                document.getElementById('phoneError').classList.add('show');
                isValid = false;
            }
        }

        if (!isValid) {
            e.preventDefault(); // Block form submission
            return;
        }

        var btn = this.querySelector('button[type="submit"]');
        btn.disabled = true;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Saving...';
    });

    // ─── CHANGE PASSWORD FORM VALIDATION ───
    document.getElementById('changePasswordForm').addEventListener('submit', function(e) {
        var isStrengthValid = checkPasswordStrength();
        var isMatchValid = checkPasswordMatch();

        if (!isStrengthValid) {
            e.preventDefault();
            alert('Please ensure your new password meets all requirements (8+ chars, uppercase, number, special character).');
            return;
        }

        if (!isMatchValid) {
            e.preventDefault();
            alert('Passwords do not match. Please re-enter the confirmation password.');
            return;
        }

        var btn = this.querySelector('button[type="submit"]');
        btn.disabled = true;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Updating...';
    });

    // ─── EVENT LISTENERS FOR REAL-TIME FEEDBACK ───
    document.getElementById('newPassword').addEventListener('input', function() {
        checkPasswordStrength();
        checkPasswordMatch();
    });
    
    document.getElementById('confirmPassword').addEventListener('input', function() {
        checkPasswordMatch();
    });

    function toggleTwoFactor() {
        var isChecked = document.getElementById('twoFactorToggle').checked;
        if (isChecked) {
            alert('Two-Factor Authentication would be configured here.\n\nYou would receive a verification code via SMS or authenticator app.');
        } else {
            alert('Two-Factor Authentication disabled.');
        }
    }
</script>