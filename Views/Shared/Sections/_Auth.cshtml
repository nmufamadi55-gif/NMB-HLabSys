            gap: 0.3rem;
            align-items: flex-start;
        }

        .role-grid {
            gap: 0.25rem;
        }

        .hero-role-btn {
            font-size: 0.55rem;
            padding: 0.2rem 0.5rem;
        }

            .hero-role-btn i {
                font-size: 0.6rem;
            }

        .allergy-hint {
            font-size: 0.7rem;
        }

        .allergy-input-row {
            flex-direction: column;
            align-items: stretch;
        }

