</style>

<script>
    (function() {
        // ── TOAST SYSTEM ──
        var container = document.getElementById('authToastContainer');

        function showToast(title, message, type) {
            if (!container) return;
            var toast = document.createElement('div');
            toast.className = 'toast-item';
            var iconClass = type === 'success' ? 'success' : 'error';
            var iconHtml = type === 'success' ? '<i class="fas fa-check-circle"></i>' : '<i class="fas fa-exclamation-circle"></i>';
            toast.innerHTML = `
                <div class="toast-icon ${iconClass}">${iconHtml}</div>
                <div class="toast-content">
                    <div class="toast-title">${title}</div>
                    <div class="toast-message">${message}</div>
                </div>
                <button class="toast-close" onclick="closeToast(this)">&times;</button>
            `;
            container.appendChild(toast);

            // Auto-remove after 5 seconds
            setTimeout(function() {
                closeToast(toast.querySelector('.toast-close'));
            }, 5000);
        }

        window.closeToast = function(btn) {
            var toast = btn ? btn.closest('.toast-item') : null;
            if (!toast) return;
            toast.classList.add('hiding');
            setTimeout(function() {
                if (toast.parentNode) toast.parentNode.removeChild(toast);
            }, 400);
        };

        // ── Password Toggle ──
        window.togglePasswordVisibility = function(inputId, buttonElement) {
            var input = document.getElementById(inputId);
            if (!input) return;
            var icon = buttonElement.querySelector('i');
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.remove('fa-eye');
                icon.classList.add('fa-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.remove('fa-eye-slash');
                icon.classList.add('fa-eye');
            }
        };

        // ── Allergy Management ──
        var allergyToggle = document.getElementById('allergyToggle');
        var allergyInputArea = document.getElementById('allergyInputArea');
        var allergyInput = document.getElementById('allergyInput');
        var allergyContainer = document.getElementById('allergyContainer');

        if (allergyToggle) {
            allergyToggle.addEventListener('click', function() {
                var isVisible = allergyInputArea.style.display === 'block';
                allergyInputArea.style.display = isVisible ? 'none' : 'block';
                if (!isVisible) allergyInput.focus();
            });
        }

        window.addAllergyItem = function() {
            var value = allergyInput.value.trim();
            if (value === '') {
                allergyInput.focus();
                allergyInput.style.borderColor = '#EF4444';
                setTimeout(function() { allergyInput.style.borderColor = ''; }, 1500);
                return;
            }
            var tag = document.createElement('span');
            tag.className = 'allergy-tag';
            tag.innerHTML = value + ' <button type="button" class="remove-allergy" onclick="removeAllergy(this)">&times;</button>';
            allergyContainer.appendChild(tag);
            allergyInput.value = '';
            allergyInput.focus();
        };

        window.removeAllergy = function(button) {
            var tag = button.parentElement;
            tag.style.transform = 'scale(0)';
            tag.style.opacity = '0';
            setTimeout(function() { tag.remove(); }, 300);
        };

        if (allergyInput) {
            allergyInput.addEventListener('keydown', function(e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    window.addAllergyItem();
                }
            });
        }

        // ─── MODAL HELPERS (for forgot password only) ───
        window.showModal = function(id) {
            var modal = document.getElementById(id);
            if (modal) modal.classList.add('show');
        };

        window.closeModal = function(id) {
            var modal = document.getElementById(id);
            if (modal) modal.classList.remove('show');
        };

        // ─── Forgot Password ───
        var forgotPasswordLink = document.getElementById('forgotPasswordLink');
        var forgotForm = document.getElementById('forgotPasswordForm');

        if (forgotPasswordLink) {
            forgotPasswordLink.addEventListener('click', function(e) {
                e.preventDefault();
                window.showModal('forgotPasswordModal');
            });
        }

        window.handleForgotPassword = function(e) {
            e.preventDefault();
            var email = document.getElementById('forgotEmail').value.trim();
            if (!email) {
                showToast('Error', 'Please enter your email address.', 'error');
                return;
            }
            window.closeModal('forgotPasswordModal');
            forgotForm.reset();
            showToast('Success', 'Password reset link sent to your email.', 'success');
        };

        // ── Register Handler (UPDATED) ────────────────────────
        window.handleRegister = function(e) {
            e.preventDefault();
            var name = document.getElementById('regName').value.trim();
            var surname = document.getElementById('regSurname').value.trim();
            var email = document.getElementById('regEmail').value.trim();
            var phone = document.getElementById('regPhone').value.trim();

            // Validate required fields
            if (!name || !surname || !email) {
                showToast('Error', 'Please fill in all required fields.', 'error');
                return;
            }

            // Simple email format check (escaped @@ for Razor)
            if (!email.includes('@@') || !email.includes('.')) {
                showToast('Error', 'Please enter a valid email address.', 'error');
                return;
            }

            // (Optional) Collect allergies for display
            var allergyTags = allergyContainer.querySelectorAll('.allergy-tag');
            var allergies = Array.from(allergyTags).map(function(tag) {
                return tag.textContent.replace('×', '').trim();
            });

            // Simulate successful registration
            showToast(
                'Registration Successful!',
                `Welcome, ${name}! A password has been sent to <strong>${email}</strong>. Please check your inbox.`,
                'success'
            );

            // Reset the form
            document.getElementById('registerForm').reset();
            allergyContainer.innerHTML = '';
            allergyInputArea.style.display = 'none';
        };

        // ── Login ──
        window.handleAuthLogin = function() {
            var email = document.getElementById('authLoginEmail').value.trim();
            var password = document.getElementById('authLoginPassword').value;
            var errorDiv = document.getElementById('authLoginError');
            var errorText = document.getElementById('authLoginErrorText');

            if (typeof mockUsers !== 'undefined') {
                var user = mockUsers.find(function(u) { return u.email.toLowerCase() === email.toLowerCase(); });
                if (user) {
                    sessionStorage.setItem('userEmail', user.email);
                    sessionStorage.setItem('userRole', user.role);
                    sessionStorage.setItem('userName', user.name);
                    var roleMap = {
                        Doctor: '@Url.Action("Dashboard", "Doctor")',
                        Technician: '@Url.Action("Dashboard", "Technician")',
                        Manager: '@Url.Action("Dashboard", "Manager")',
                        Patient: '@Url.Action("Dashboard", "Patient")',
                        Admin: '@Url.Action("Dashboard", "Admin")'
                    };
                    window.location.href = roleMap[user.role] || '@Url.Action("Dashboard", "Doctor")';
                } else {
                    errorDiv.style.display = 'flex';
                    errorText.textContent = 'Incorrect details, please try again.';
                    errorDiv.style.animation = 'none';
                    setTimeout(function() { errorDiv.style.animation = 'shake 0.4s ease'; }, 10);
                }
            } else {
                errorDiv.style.display = 'flex';
                errorText.textContent = 'Mock users not found.';
            }
        };

        // ── Auth Slider ──
        var authState = 'login';
        var slider = document.getElementById('authSlider');
        var sliderTitle = document.getElementById('sliderTitle');
        var sliderDesc = document.getElementById('sliderDesc');
        var sliderBtnText = document.getElementById('sliderBtnText');

        window.toggleAuth = function() {
            slider.classList.add('updating');
            setTimeout(function() {
                if (authState === 'login') {
                    authState = 'register';
                    slider.classList.remove('cover-right');
                    slider.classList.add('cover-left');
                    sliderTitle.textContent = 'Welcome Back, Champion!';
                    sliderDesc.textContent = 'Your journey to better patient outcomes starts here. Let\'s make a difference!';
                    sliderBtnText.textContent = 'SIGN IN';
                    document.getElementById('loginHalf').classList.remove('active-mobile');
                    document.getElementById('registerHalf').classList.add('active-mobile');
                } else {
                    authState = 'login';
                    slider.classList.remove('cover-left');
                    slider.classList.add('cover-right');
                    sliderTitle.textContent = 'Hello, Future Healer!';
                    sliderDesc.textContent = 'Join our community and start making a difference in haematology diagnostics today!';
                    sliderBtnText.textContent = 'SIGN UP';
                    document.getElementById('registerHalf').classList.remove('active-mobile');
                    document.getElementById('loginHalf').classList.add('active-mobile');
                }
                setTimeout(function() { slider.classList.remove('updating'); }, 300);
            }, 300);
        };

        // ── Close modals on overlay & escape ──
        document.querySelectorAll('.modal-overlay').forEach(function(overlay) {
            overlay.addEventListener('click', function(e) {
                if (e.target === this) {
                    window.closeModal(this.id);
                }
            });
        });
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                document.querySelectorAll('.modal-overlay.show').forEach(function(modal) {
                    window.closeModal(modal.id);
                });
            }
        });

        // ── Initialize mobile view ──
        document.addEventListener('DOMContentLoaded', function() {
            document.getElementById('loginHalf').classList.add('active-mobile');
            var s = document.getElementById('authSlider');
            if (s) { s.classList.add('cover-right'); s.classList.remove('cover-left'); }
            authState = 'login';
        });
    })();
</script>