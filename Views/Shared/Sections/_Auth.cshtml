        color: #94A3B8;
        transition: color 0.3s ease;
        line-height: 1;
    }

        .modal-close-btn:hover {
            color: var(--text-dark);
        }

    /* ─── TOAST STYLES ─── */
    .toast-container {
        position: fixed;
        top: 1.5rem;
        right: 1.5rem;
        z-index: 99999;
        display: flex;
        flex-direction: column;
        gap: 0.8rem;
        max-width: 380px;
        width: 100%;
        pointer-events: none;
    }

    .toast-item {
        background: #fff;
        border-radius: var(--radius-element);
        padding: 1rem 1.2rem;
        box-shadow: 0 12px 40px rgba(0,0,0,0.15);
        display: flex;
        align-items: flex-start;
        gap: 0.8rem;
        border-left: 4px solid var(--primary-bright);
        animation: slideInRight 0.4s cubic-bezier(0.34,1.56,0.64,1) both;
        pointer-events: auto;
        transition: transform 0.3s ease, opacity 0.3s ease;
    }

        .toast-item.hiding {
            transform: translateX(30px);
            opacity: 0;
        }

        .toast-item .toast-icon {
            font-size: 1.4rem;
            margin-top: 0.1rem;
            flex-shrink: 0;
        }

            .toast-item .toast-icon.success {
                color: #10B981;
            }

            .toast-item .toast-icon.error {
                color: #EF4444;
            }

        .toast-item .toast-content {
            flex: 1;
            display: flex;
            flex-direction: column;
            gap: 0.1rem;
        }

        .toast-item .toast-title {
            font-weight: 600;
            font-size: 0.9rem;
            color: var(--text-dark);
        }

        .toast-item .toast-message {
            font-size: 0.85rem;
            color: var(--text-muted);
            line-height: 1.4;
        }

        .toast-item .toast-close {
            background: none;
            border: none;
            font-size: 1.2rem;
            cursor: pointer;
            color: #94A3B8;
            padding: 0 0.2rem;
            transition: color 0.2s;
            pointer-events: auto;
        }

            .toast-item .toast-close:hover {
                color: var(--text-dark);
            }

    @@keyframes slideInRight {
        0% {
            transform: translateX(40px);
            opacity: 0;
        }

        100% {
            transform: translateX(0);
            opacity: 1;
        }
    }

    /* ─── RESPONSIVE ─── */
    @@media (max-width: 1024px) {
        .auth-container {
            flex-direction: column;
            min-height: auto;
            border-radius: var(--radius-card);
        }

        .auth-half {
            padding: 2rem 1.8rem;
        }

        .auth-slider {
            position: relative;
            width: 100% !important;
            border-radius: var(--radius-card) !important;
            transform: none !important;
            padding: 2.5rem 2rem;
            left: auto;
            right: auto;
            top: auto;
            bottom: auto;
        }

            .auth-slider.cover-right, .auth-slider.cover-left {
                transform: none !important;
                border-radius: var(--radius-card) !important;
            }

        .auth-container {
            display: block;
        }

        .auth-half {
            display: none;
        }

            .auth-half.active-mobile {
                display: flex;
            }

        .auth-slider {
            display: flex;
            width: 100% !important;
            position: relative !important;
            border-radius: var(--radius-card) !important;
            transform: none !important;
        }

        .slider-logo {
            width: 56px;
            height: 56px;
            font-size: 1.8rem;
        }

        .auth-slider h3 {
