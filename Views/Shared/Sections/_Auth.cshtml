        color: #fff;
        border: none;
        border-radius: 40px;
        font-weight: 700;
        font-size: 0.95rem;
        cursor: pointer;
        transition: all 0.3s cubic-bezier(0.25,0.46,0.45,0.94);
        font-family: 'Inter', sans-serif;
        box-shadow: 0 4px 16px rgba(8,65,201,0.25);
    }

        .modal-submit-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 28px rgba(8,65,201,0.35);
