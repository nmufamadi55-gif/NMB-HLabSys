            height: 56px;
            font-size: 2.8rem;
        }

        .modal-box h3 {
            font-size: 1.2rem;
        }

        .modal-box p {
            font-size: 0.85rem;
        }

        .modal-btn {
            font-size: 0.85rem;
            padding: 0.6rem 1.5rem;
        }
