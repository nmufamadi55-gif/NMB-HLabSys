<section id="auth">
    <div class="container">
        <!-- Auth Section Headings -->
        <div class="section-header fade-in">
            <span class="tag"><i class="fas fa-lock"></i> Secure Access</span>
            <h2>Get Started <span class="highlight">Today</span></h2>
            <p>Login to your account or register to start managing haematology tests seamlessly.</p>
        </div>

        <div class="auth-container" id="authContainer">
            <!-- Login half -->
            <div class="auth-half login-half" id="loginHalf">
                <h2>Welcome Back!</h2>
                <p class="sub">Enter your personal details to use all of site features</p>
                <div id="authLoginError" class="auth-error">
                    <i class="fas fa-exclamation-circle"></i>
                    <span id="authLoginErrorText">Incorrect details, please try again.</span>
                </div>
                <div class="form-group floating-group">
                    <input type="email" id="authLoginEmail" value="doctor@nmblab.com" required />
                    <label for="authLoginEmail">Email Address <span class="required-star">*</span></label>
                </div>
                <div class="form-group floating-group password-group">
                    <input type="password" id="authLoginPassword" value="password123" required />
                    <label for="authLoginPassword">Password <span class="required-star">*</span></label>
                    <button type="button" class="password-toggle-btn" onclick="togglePasswordVisibility('authLoginPassword', this)">
                        <i class="fas fa-eye"></i>
                    </button>
                </div>
                <div class="auth-options">
                    <label style="display:flex; align-items:center; gap:0.3rem; cursor:pointer;">
                        <input type="checkbox" checked /> Remember me
                    </label>
                    <a href="#" id="forgotPasswordLink">Forget Your Password?</a>
                </div>
                <button class="btn-auth btn-login-action" onclick="handleAuthLogin()">
                    <i class="fas fa-sign-in-alt"></i> <span>LOG IN</span>
                </button>

                <!-- Role buttons under the card -->
                <div class="hero-role-buttons">
                    <span class="role-label">Quick Demo Access</span>
                    <div class="role-grid">
                        <a href="@Url.Action("Dashboard", "Doctor")" class="hero-role-btn doctor"><i class="fas fa-user-md"></i> Doctor</a>
                        <a href="@Url.Action("Dashboard", "Technician")" class="hero-role-btn technician"><i class="fas fa-flask"></i> Technician</a>
                        <a href="@Url.Action("Dashboard", "Manager")" class="hero-role-btn manager"><i class="fas fa-chart-line"></i> Manager</a>
                        <a href="@Url.Action("Dashboard", "Patient")" class="hero-role-btn patient"><i class="fas fa-user-injured"></i> Patient</a>
                        <a href="@Url.Action("Dashboard", "Admin")" class="hero-role-btn admin"><i class="fas fa-cogs"></i> Admin</a>
                    </div>
                </div>
            </div>

            <!-- Register half (UPDATED) -->
            <div class="auth-half register-half" id="registerHalf">
                <h2>Create Account</h2>
                <p class="sub">Register with your personal details to use all of site features</p>
                <form id="registerForm" onsubmit="handleRegister(event)">
                    <div class="form-row">
                        <div class="form-group floating-group">
                            <input type="text" id="regName" required />
                            <label for="regName">Name <span class="required-star">*</span></label>
                        </div>
                        <div class="form-group floating-group">
                            <input type="text" id="regSurname" required />
                            <label for="regSurname">Surname <span class="required-star">*</span></label>
                        </div>
                    </div>
                    <div class="form-group floating-group">
                        <input type="email" id="regEmail" required />
                        <label for="regEmail">Email Address <span class="required-star">*</span></label>
                    </div>
                    <div class="form-group floating-group">
                        <input type="tel" id="regPhone" />
                        <label for="regPhone">Phone Number</label>
                    </div>

                    <!-- Password fields removed – password will be sent via email -->
                    <div class="auth-note" style="margin: 0.5rem 0 1.2rem 0; padding: 0.8rem 1rem; background: #F0F7FF; border-radius: var(--radius-element); border-left: 4px solid var(--primary-bright); font-size: 0.85rem; color: var(--text-dark);">
                        <i class="fas fa-info-circle" style="color: var(--primary-bright); margin-right: 0.5rem;"></i>
                        <strong>Password will be sent to your email</strong> after registration. Check your inbox (and spam folder) for login details.
                    </div>

                    <!-- Allergy Section -->
                    <div class="allergy-section">
                        <div class="allergy-hint" id="allergyToggle">
                            <i class="fas fa-plus-circle"></i> Do you have any allergies? Click here to add them
                        </div>
                        <div class="allergy-input-area" id="allergyInputArea" style="display:none;">
                            <div class="allergy-input-row">
                                <input type="text" id="allergyInput" placeholder="Type allergy name..." class="allergy-text-input" />
                                <button type="button" class="allergy-add-btn" onclick="addAllergyItem()">+ Add</button>
                            </div>
                        </div>
                        <div id="allergyContainer"></div>
                    </div>

                    <button type="submit" class="btn-auth btn-register-action">
                        <i class="fas fa-user-plus"></i> <span>SIGN UP</span>
                    </button>
                </form>
            </div>

            <!-- Sliding Panel -->
            <div class="auth-slider cover-right" id="authSlider">
                <div class="slider-inner">
                    <div class="slider-logo"><i class="fas fa-microscope"></i></div>
                    <h3 id="sliderTitle">Hello, Future Healer!</h3>
                    <p id="sliderDesc">Join our community and start making a difference in haematology diagnostics today!</p>
                    <button class="btn-slider" id="sliderBtn" onclick="toggleAuth()">
                        <span id="sliderBtnText">SIGN UP</span>
                        <i class="fas fa-arrow-right"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- ─── FORGOT PASSWORD MODAL ─── -->
    <div class="modal-overlay" id="forgotPasswordModal">
        <div class="modal-box modal-box-small">
            <div class="modal-icon"><i class="fas fa-envelope"></i></div>
            <h3>Reset Password</h3>
            <p>Enter your email address and we'll send you a link to reset your password.</p>
            <form id="forgotPasswordForm" onsubmit="handleForgotPassword(event)">
                <div class="modal-form-group floating-group">
                    <input type="email" id="forgotEmail" required />
                    <label for="forgotEmail">Email Address <span class="required-star">*</span></label>
                </div>
                <button type="submit" class="modal-submit-btn">Send Reset Link</button>
            </form>
            <button class="modal-close-btn" onclick="closeModal('forgotPasswordModal')">&times;</button>
        </div>
    </div>

    <!-- ─── TOAST CONTAINER ─── -->
    <div class="toast-container" id="authToastContainer"></div>
</section>

<style>
    /* ─── AUTH ─── */
    #auth {
        background: var(--bg-soft);
        position: relative;
        overflow: hidden;
    }

        #auth::before {
            content: '';
            position: absolute;
            inset: 0;
            background-image: radial-gradient(circle at 20% 30%, rgba(8,65,201,0.03) 0%, transparent 50%), radial-gradient(circle at 80% 70%, rgba(29,151,241,0.03) 0%, transparent 50%);
            pointer-events: none;
        }

    .auth-container {
        max-width: 1050px;
        margin: 0 auto;
        background: #ffffff;
        border-radius: var(--radius-card);
        box-shadow: 0 20px 60px rgba(0,0,0,0.08);
        overflow: hidden;
        position: relative;
        min-height: 560px;
        display: flex;
        border: 1px solid rgba(255,255,255,0.2);
    }

    .auth-half {
        flex: 1;
        padding: 3rem 2.8rem;
        display: flex;
        flex-direction: column;
        justify-content: center;
        transition: var(--transition);
        position: relative;
        z-index: 1;
    }

        .auth-half.login-half {
            background: #ffffff;
        }

        .auth-half.register-half {
            background: #ffffff;
        }

        .auth-half h2 {
            font-size: 1.6rem;
            font-weight: 700;
            color: var(--primary-dark);
            margin-bottom: 0.2rem;
            letter-spacing: -0.02em;
        }

        .auth-half .sub {
            color: var(--text-muted);
            font-size: 0.9rem;
            margin-bottom: 1.8rem;
            line-height: 1.5;
        }

    .required-star {
        color: #EF4444;
        margin-left: 2px;
        font-weight: 700;
    }

    /* ─── FLOATING LABELS ─── */
    .floating-group {
        position: relative;
        margin-bottom: 1.4rem;
    }

        .floating-group input {
            width: 100%;
            padding: 1rem 1rem 0.5rem 1rem;
            border: 1.5px solid #E8EDF5;
            border-radius: var(--radius-element);
            font-size: 0.95rem;
            font-family: 'Inter', sans-serif;
            transition: all 0.3s ease;
            background: #F8FAFE;
            color: var(--text-dark);
            outline: none;
            min-height: 52px;
        }

            .floating-group input:focus {
                border-color: var(--primary-bright);
                background: #fff;
                box-shadow: 0 0 0 4px rgba(8,65,201,0.06);
            }

            .floating-group input:hover {
                border-color: #94A3B8;
                background: #fcfcfd;
            }

            .floating-group input::placeholder {
                color: transparent;
            }

        .floating-group label {
            position: absolute;
            left: 1rem;
            top: 50%;
            transform: translateY(-50%);
            font-size: 0.85rem;
            color: var(--text-muted);
            pointer-events: none;
            transition: all 0.25s ease;
            background: transparent;
            padding: 0 4px;
            font-weight: 500;
            line-height: 1;
        }

        .floating-group input:focus ~ label,
        .floating-group input:not(:placeholder-shown) ~ label {
            top: -0.5rem;
            left: 0.8rem;
            font-size: 0.7rem;
            color: var(--primary-bright);
            background: #fff;
            padding: 0 6px;
            font-weight: 600;
            border-radius: 4px;
            transform: translateY(0);
        }

        .floating-group input:not(:focus):not(:placeholder-shown) ~ label {
            color: var(--text-muted);
        }

        .floating-group .password-toggle-btn {
            position: absolute;
            right: 12px;
            top: 50%;
            transform: translateY(-50%);
            background: transparent;
            border: none;
            cursor: pointer;
            color: var(--text-muted);
            font-size: 1rem;
            padding: 4px;
            transition: color 0.2s;
            z-index: 2;
        }

            .floating-group .password-toggle-btn:hover {
                color: var(--primary-bright);
            }

    .auth-half .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
    }

    /* ─── AUTH OPTIONS ─── */
    .auth-half .auth-options {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin: 0.2rem 0 1.2rem;
        font-size: 0.8rem;
    }

        .auth-half .auth-options label {
            color: var(--text-muted);
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 0.3rem;
        }

            .auth-half .auth-options label input[type="checkbox"] {
                accent-color: var(--primary-bright);
                width: 16px;
                height: 16px;
                cursor: pointer;
            }

        .auth-half .auth-options a {
            color: var(--primary-bright);
            text-decoration: none;
            font-weight: 500;
            transition: color 0.3s ease;
            cursor: pointer;
        }

            .auth-half .auth-options a:hover {
                color: var(--primary-light);
                text-decoration: underline;
            }

    /* ─── BUTTONS ─── */
    .btn-auth {
        width: 100%;
        padding: 0.85rem;
        border-radius: 40px;
        font-weight: 700;
        font-size: 0.95rem;
        border: none;
        cursor: pointer;
        transition: all 0.35s cubic-bezier(0.25,0.46,0.45,0.94);
        font-family: 'Inter', sans-serif;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.6rem;
        position: relative;
        overflow: hidden;
        letter-spacing: 0.02em;
    }

        .btn-auth i, .btn-auth span {
            position: relative;
            z-index: 2;
            color: #fff;
        }

    .btn-login-action {
        background: linear-gradient(135deg, var(--primary-bright), var(--primary-light));
        box-shadow: 0 4px 20px rgba(8,65,201,0.3);
    }

        .btn-login-action::before {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(135deg, var(--primary-light), var(--primary-bright));
            opacity: 0;
            transition: opacity 0.4s ease;
            border-radius: 40px;
        }

        .btn-login-action:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 36px rgba(8,65,201,0.45);
        }

            .btn-login-action:hover::before {
                opacity: 1;
            }

    .btn-register-action {
        background: linear-gradient(135deg, var(--primary-deep), var(--primary-bright));
        box-shadow: 0 4px 20px rgba(8,65,201,0.2);
    }

        .btn-register-action::before {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(135deg, var(--primary-bright), var(--primary-light));
            opacity: 0;
            transition: opacity 0.4s ease;
            border-radius: 40px;
        }

        .btn-register-action:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 36px rgba(8,65,201,0.35);
        }

            .btn-register-action:hover::before {
                opacity: 1;
            }

    /* ─── ERROR MESSAGE ─── */
    .auth-error {
        background: #FEE2E2;
        color: #991B1B;
        padding: 0.6rem 1rem;
        border-radius: var(--radius-element);
        font-size: 0.8rem;
        margin-bottom: 1rem;
        display: none;
        align-items: center;
        gap: 0.5rem;
        border: 1px solid #FECACA;
    }

    /* ─── ALLERGY SECTION ─── */
    .allergy-section {
        margin: 0.5rem 0 0.8rem 0;
        width: 100%;
    }

    .allergy-hint {
        font-size: 0.8rem;
        color: var(--text-muted);
        cursor: pointer;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        padding: 0.3rem 0.5rem;
        border-radius: 8px;
        border: 1px dashed transparent;
    }

        .allergy-hint i {
            color: var(--primary-bright);
            transition: transform 0.3s ease;
            font-size: 0.9rem;
        }

        .allergy-hint:hover {
            color: var(--primary-bright);
            border-color: rgba(8,65,201,0.15);
            background: rgba(8,65,201,0.03);
        }

            .allergy-hint:hover i {
                transform: rotate(90deg);
            }

    .allergy-input-area {
        margin-top: 0.5rem;
        padding: 0.8rem;
        background: var(--bg-soft);
        border-radius: var(--radius-element);
        border: 1px solid #E8EDF5;
    }

    .allergy-input-row {
        display: flex;
        gap: 0.5rem;
        align-items: center;
    }

        .allergy-input-row .allergy-text-input {
            flex: 1;
            padding: 0.6rem 0.8rem;
            border: 1.5px solid #E8EDF5;
            border-radius: var(--radius-element);
            font-size: 0.85rem;
            font-family: 'Inter', sans-serif;
            background: #fff;
            color: var(--text-dark);
            outline: none;
            transition: border 0.3s ease;
        }

            .allergy-input-row .allergy-text-input:focus {
                border-color: var(--primary-bright);
                box-shadow: 0 0 0 3px rgba(8,65,201,0.06);
            }

    .allergy-add-btn {
        padding: 0.6rem 1.2rem;
        background: var(--primary-bright);
        color: #fff;
        border: none;
        border-radius: var(--radius-element);
        font-weight: 600;
        font-size: 0.8rem;
        cursor: pointer;
        transition: background 0.3s ease, transform 0.2s ease;
        white-space: nowrap;
    }

        .allergy-add-btn:hover {
            background: var(--primary-light);
            transform: scale(1.02);
        }

    #allergyContainer {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-top: 0.5rem;
    }

    .allergy-tag {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        background: rgba(239,68,68,0.08);
        color: #DC2626;
        padding: 0.25rem 0.7rem;
        border-radius: 40px;
        font-size: 0.75rem;
        font-weight: 500;
        border: 1px solid rgba(239,68,68,0.1);
        animation: tagPop 0.3s cubic-bezier(0.34,1.56,0.64,1) both;
    }

    @@keyframes tagPop {
        0% {
            transform: scale(0);
            opacity: 0;
        }

        100% {
            transform: scale(1);
            opacity: 1;
        }
    }

    .allergy-tag .remove-allergy {
        background: none;
        border: none;
        cursor: pointer;
        color: #DC2626;
        font-size: 0.7rem;
        padding: 0 2px;
        opacity: 0.6;
        transition: opacity 0.3s ease, transform 0.3s ease;
    }

        .allergy-tag .remove-allergy:hover {
            opacity: 1;
            transform: scale(1.2);
        }

    /* ─── ROLE BUTTONS ─── */
    .hero-role-buttons {
        margin-top: 1.5rem;
        padding-top: 1.2rem;
        border-top: 1px solid #E8EDF5;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.6rem;
    }

    .role-label {
        font-size: 0.65rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--text-muted);
        font-weight: 600;
    }

    .role-grid {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.4rem;
    }

    .hero-role-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        background: rgba(2,13,47,0.05);
        border: 1px solid rgba(2,13,47,0.06);
        padding: 0.3rem 0.8rem;
        border-radius: 40px;
        font-size: 0.65rem;
        font-weight: 600;
        color: var(--primary-dark);
        cursor: pointer;
        transition: all 0.3s cubic-bezier(0.25,0.46,0.45,0.94);
        text-decoration: none;
        font-family: 'Inter', sans-serif;
    }

        .hero-role-btn i {
            font-size: 0.7rem;
            opacity: 0.7;
        }

        .hero-role-btn:hover {
            transform: translateY(-2px);
            color: #fff;
            border-color: transparent;
        }

        .hero-role-btn.doctor:hover {
            background: #2563EB;
            box-shadow: 0 4px 16px rgba(37,99,235,0.25);
        }

        .hero-role-btn.technician:hover {
            background: #7C3AED;
            box-shadow: 0 4px 16px rgba(124,58,237,0.25);
        }

        .hero-role-btn.manager:hover {
            background: #059669;
            box-shadow: 0 4px 16px rgba(5,150,105,0.25);
        }

        .hero-role-btn.patient:hover {
            background: #D97706;
            box-shadow: 0 4px 16px rgba(217,119,6,0.25);
        }

        .hero-role-btn.admin:hover {
            background: #DC2626;
            box-shadow: 0 4px 16px rgba(220,38,38,0.25);
        }

    /* ─── SLIDING PANEL ─── */
    .auth-slider {
        position: absolute;
        top: 0;
        bottom: 0;
        width: 50%;
        background: linear-gradient(145deg, var(--primary-dark), var(--primary-deep));
        color: #fff;
        padding: 3rem 2.5rem;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        text-align: center;
        transition: transform 0.6s cubic-bezier(0.65,0,0.35,1), border-radius 0.6s cubic-bezier(0.65,0,0.35,1);
        z-index: 10;
        box-shadow: 0 8px 40px rgba(0,0,0,0.25);
        left: 0;
        border-radius: 70px 0 0 70px;
        transform: translateX(100%);
        overflow: hidden;
    }

        .auth-slider::before {
            content: '';
            position: absolute;
            inset: 0;
            background: radial-gradient(circle at 30% 50%, rgba(29,151,241,0.06), transparent 50%), radial-gradient(circle at 70% 50%, rgba(8,65,201,0.04), transparent 50%);
            pointer-events: none;
        }

        .auth-slider .slider-inner {
            position: relative;
            z-index: 1;
            transition: opacity 0.4s ease;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .auth-slider.updating .slider-inner {
            opacity: 0;
        }

        .auth-slider.cover-right {
            transform: translateX(100%);
            border-radius: 70px 0 0 70px;
        }

        .auth-slider.cover-left {
            transform: translateX(0);
            border-radius: 0 70px 70px 0;
        }

    .slider-logo {
        width: 72px;
        height: 72px;
        background: rgba(255,255,255,0.06);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.2rem;
        color: var(--primary-light);
        margin-bottom: 1rem;
        border: 1px solid rgba(255,255,255,0.08);
        transition: all 0.4s ease;
    }

    .auth-slider:hover .slider-logo {
        transform: scale(1.05);
        background: rgba(255,255,255,0.1);
        box-shadow: 0 0 40px rgba(29,151,241,0.05);
    }

    .auth-slider h3 {
        font-size: 1.8rem;
        font-weight: 800;
        margin-bottom: 0.5rem;
        letter-spacing: -0.02em;
        line-height: 1.2;
    }

    .auth-slider p {
        opacity: 0.85;
        font-size: 0.95rem;
        max-width: 300px;
        margin: 0 auto 1.5rem;
        line-height: 1.6;
    }

    .auth-slider .btn-slider {
        background: rgba(255,255,255,0.08);
        backdrop-filter: blur(4px);
        border: 1px solid rgba(255,255,255,0.15);
        color: #fff;
        padding: 0.7rem 2rem;
        border-radius: 40px;
        font-weight: 600;
        font-size: 0.95rem;
        cursor: pointer;
        transition: all 0.35s cubic-bezier(0.25,0.46,0.45,0.94);
        font-family: 'Inter', sans-serif;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

        .auth-slider .btn-slider:hover {
            background: rgba(255,255,255,0.15);
            transform: translateY(-3px);
            border-color: rgba(255,255,255,0.25);
            box-shadow: 0 8px 28px rgba(0,0,0,0.2);
        }

        .auth-slider .btn-slider i {
            transition: transform 0.3s ease;
        }

        .auth-slider .btn-slider:hover i {
            transform: translateX(4px);
        }

    /* ─── MODAL OVERLAY (only for forgot password) ─── */
    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.5);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 10000;
        padding: 1.5rem;
    }

        .modal-overlay.show {
            display: flex;
        }

    .modal-box {
        background: #fff;
        border-radius: var(--radius-card);
        padding: 2.5rem 2rem;
        text-align: center;
        max-width: 440px;
        width: 100%;
        box-shadow: 0 25px 70px rgba(0,0,0,0.2);
        animation: modalPop 0.5s cubic-bezier(0.34,1.56,0.64,1);
        position: relative;
    }

        .modal-box.modal-box-small {
            max-width: 400px;
            padding: 2rem 1.5rem;
        }

    @@keyframes modalPop {
        0% {
            transform: scale(0.8);
            opacity: 0;
        }

        100% {
            transform: scale(1);
            opacity: 1;
        }
    }

    .modal-icon {
        font-size: 3.5rem;
        color: #10B981;
        margin-bottom: 0.8rem;
        background: rgba(16,185,129,0.1);
        width: 72px;
