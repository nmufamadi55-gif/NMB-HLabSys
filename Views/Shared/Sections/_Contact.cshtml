<section id="contact">
    <div class="container">
        <div class="section-header fade-in">
            <span class="tag"><i class="fas fa-envelope"></i> Contact Us</span>
            <h2>Get In <span class="highlight">Touch</span></h2>
            <p>Have questions or need support? Reach out to our team — we're here to help.</p>
        </div>
        <div class="contact-grid">
            <!-- Contact Info Card -->
            <div class="contact-info contact-card fade-in">
                <h3>Let's Connect</h3>
                <p>
                    Whether you're a healthcare provider, a patient, or a partner,
                    we'd love to hear from you. Our team is ready to assist.
                </p>
                <div class="contact-detail">
                    <div class="cd-icon"><i class="fas fa-map-marker-alt"></i></div>
                    <div class="cd-text">
                        <div class="cd-label">Address</div>
                        <div class="cd-value">123 Haematology Lane, Gqeberha, 6001</div>
                    </div>
                </div>
                <div class="contact-detail">
                    <div class="cd-icon"><i class="fas fa-phone"></i></div>
                    <div class="cd-text">
                        <div class="cd-label">Phone</div>
                        <div class="cd-value">+27 41 123 4567</div>
                    </div>
                </div>
                <div class="contact-detail">
                    <div class="cd-icon"><i class="fas fa-envelope"></i></div>
                    <div class="cd-text">
                        <div class="cd-label">Email</div>
                        <div class="cd-value">info@nmblab.co.za</div>
                    </div>
                </div>
                <div class="contact-detail">
                    <div class="cd-icon"><i class="fas fa-clock"></i></div>
                    <div class="cd-text">
                        <div class="cd-label">Working Hours</div>
                        <div class="cd-value">Mon–Fri: 7:00 AM – 6:00 PM</div>
                    </div>
                </div>

                <!-- Social icons in contact card -->
                <div class="contact-social">
                    <a href="#" class="cs-fb" aria-label="Facebook"><i class="fab fa-facebook-f"></i></a>
                    <a href="#" class="cs-tw" aria-label="Twitter"><i class="fab fa-twitter"></i></a>
                    <a href="#" class="cs-li" aria-label="LinkedIn"><i class="fab fa-linkedin-in"></i></a>
                    <a href="#" class="cs-ig" aria-label="Instagram"><i class="fab fa-instagram"></i></a>
                    <a href="#" class="cs-wa" aria-label="WhatsApp"><i class="fab fa-whatsapp"></i></a>
                    <a href="#" class="cs-yt" aria-label="YouTube"><i class="fab fa-youtube"></i></a>
                    <a href="#" class="cs-tt" aria-label="TikTok"><i class="fab fa-tiktok"></i></a>
                </div>
            </div>

            <!-- Contact Form Card -->
            <div class="contact-form contact-card fade-in">
                <form id="contactForm" novalidate>
                    <div class="form-row">
                        <div class="form-group floating-group">
                            <input type="text" id="name" required />
                            <label for="name">Full Name <span class="required-star">*</span></label>
                            <span class="error-msg">Please enter your name</span>
                        </div>
                        <div class="form-group floating-group">
                            <input type="email" id="email" required />
                            <label for="email">Email Address <span class="required-star">*</span></label>
                            <span class="error-msg">Please enter a valid email</span>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group floating-group">
                            <input type="tel" id="phone" />
                            <label for="phone">Phone Number</label>
                            <span class="error-msg">Please enter a valid phone number</span>
                        </div>
                        <div class="form-group floating-group">
                            <select id="subject" required>
                                <option value="" disabled selected></option>
                                <option>General Inquiry</option>
                                <option>Technical Support</option>
                                <option>Partnership</option>
                                <option>Feedback</option>
                            </select>
                            <label for="subject">Subject <span class="required-star">*</span></label>
                            <span class="error-msg">Please select a subject</span>
                        </div>
                    </div>
                    <div class="form-group floating-group">
                        <textarea id="message" required></textarea>
                        <label for="message">Message <span class="required-star">*</span></label>
                        <span class="error-msg">Please enter your message</span>
                    </div>
                    <button type="submit" class="btn-primary premium-btn" id="sendBtn">
                        <i class="fas fa-paper-plane"></i> <span>Send Message</span>
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Success Modal -->
    <div class="modal-overlay" id="successModal">
        <div class="modal-box">
            <div class="modal-icon"><i class="fas fa-check-circle"></i></div>
            <h3>Message Sent!</h3>
            <p>Thank you for reaching out. We'll respond within 24 hours.</p>
            <button class="modal-btn" id="modalOkBtn">OK</button>
            <p class="modal-timer" id="modalTimer">Closing in 5s...</p>
        </div>
    </div>
</section>

<style>
