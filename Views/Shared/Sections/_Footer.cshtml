<script>
    document.addEventListener('DOMContentLoaded', function() {
        // ─── NEWSLETTER FORM ───
        const newsletterForm = document.getElementById('newsletterForm');
        const newsletterModal = document.getElementById('newsletterModal');
        const newsletterModalOkBtn = document.getElementById('newsletterModalOkBtn');
        const newsletterModalTimer = document.getElementById('newsletterModalTimer');
        let newsletterCountdownInterval = null;

        newsletterForm.addEventListener('submit', function(e) {
            e.preventDefault();

            const emailInput = document.getElementById('newsletterEmail');
            const email = emailInput.value.trim();

            // Simple validation
            if (!email) {
                alert('Please enter your email address.');
                return;
            }

            // Simulate subscription
            const btn = this.querySelector('button[type="submit"]');
            const originalIcon = btn.innerHTML;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
            btn.disabled = true;

            setTimeout(() => {
                // Show modal
                showNewsletterModal();
                btn.innerHTML = originalIcon;
                btn.disabled = false;
                emailInput.value = ''; // Reset form
            }, 1000);
        });

        function showNewsletterModal() {
            newsletterModal.classList.add('show');
            let countdown = 5;
            newsletterModalTimer.textContent = `Closing in ${countdown}s...`;

            if (newsletterCountdownInterval) {
                clearInterval(newsletterCountdownInterval);
            }

            newsletterCountdownInterval = setInterval(() => {
                countdown--;
                if (countdown <= 0) {
                    clearInterval(newsletterCountdownInterval);
                    newsletterCountdownInterval = null;
                    closeNewsletterModal();
                } else {
                    newsletterModalTimer.textContent = `Closing in ${countdown}s...`;
                }
            }, 1000);
        }

        function closeNewsletterModal() {
            newsletterModal.classList.remove('show');
            if (newsletterCountdownInterval) {
                clearInterval(newsletterCountdownInterval);
                newsletterCountdownInterval = null;
            }
            newsletterModalTimer.textContent = 'Closing in 5s...';
        }

        // Close modal on OK button click (immediate)
        newsletterModalOkBtn.addEventListener('click', function(e) {
            e.stopPropagation();
            closeNewsletterModal();
        });

        // Close modal when clicking outside
        newsletterModal.addEventListener('click', function(e) {
            if (e.target === this) {
                closeNewsletterModal();
            }
        });

        // Close modal on Escape key
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape' && newsletterModal.classList.contains('show')) {
                closeNewsletterModal();
            }
        });
    });
</script>