<script>
    (function() {
        // ── STAR RATING ──
        var selectedRating = 5;
        var stars = document.querySelectorAll('#starRating i');

        window.setRating = function(val) {
            selectedRating = val;
            document.getElementById('testimonialRating').value = val;
            stars.forEach(function(star) {
                var value = parseInt(star.dataset.value);
                if (value <= val) {
                    star.classList.add('active');
                } else {
                    star.classList.remove('active');
                }
            });
        };

        // Initialize with 5 stars
        setRating(5);

        // ── MODAL ──
        window.openTestimonialModal = function() {
            document.getElementById('testimonialModal').classList.add('show');
        };

        window.closeTestimonialModal = function() {
            document.getElementById('testimonialModal').classList.remove('show');
        };

        // ── TOAST ──
        function showToast(title, message) {
            var container = document.getElementById('testimonialToastContainer');
            var toast = document.createElement('div');
            toast.className = 'toast-item';
            toast.innerHTML = `
                <div class="toast-icon"><i class="fas fa-check-circle"></i></div>
                <div class="toast-content">
                    <div class="toast-title">${title}</div>
                    <div class="toast-message">${message}</div>
                </div>
                <button class="toast-close" onclick="this.closest('.toast-item').remove()">&times;</button>
            `;
            container.appendChild(toast);
            setTimeout(function() {
                if (toast.parentNode) toast.remove();
            }, 5000);
        }

        // ── SUBMIT TESTIMONIAL ──
        window.submitTestimonial = function(e) {
            e.preventDefault();

            var name = document.getElementById('testimonialName').value.trim();
            var role = document.getElementById('testimonialRole').value.trim();
            var text = document.getElementById('testimonialText').value.trim();
            var rating = parseInt(document.getElementById('testimonialRating').value);

            if (!name || !role || !text) {
                alert('Please fill in all required fields.');
                return;
            }

            // Generate initials
            var initials = name.split(' ').map(function(word) { return word.charAt(0); }).join('').toUpperCase().slice(0, 2);

            // Build stars HTML
            var starsHtml = '';
            for (var i = 0; i < 5; i++) {
                if (i < rating) {
                    starsHtml += '<i class="fas fa-star"></i>';
                } else {
                    starsHtml += '<i class="far fa-star"></i>';
                }
            }

            // Build new testimonial card
            var newCard = document.createElement('div');
            newCard.className = 'testimonial-card';
            newCard.style.animation = 'fadeIn 0.5s ease';
            newCard.innerHTML = `
                <div class="stars">${starsHtml}</div>
                <blockquote>"${text}"</blockquote>
                <div class="author">
                    <div class="avatar">${initials}</div>
                    <div class="info">
                        <div class="name">${name}</div>
                        <div class="role">${role}</div>
                    </div>
                </div>
            `;

            // Get the track
            var track = document.getElementById('testimonialTrack');
            var cards = track.querySelectorAll('.testimonial-card');
            var totalCards = cards.length;

            // Insert new card before the duplicate set (which starts at index totalCards/2)
            var insertIndex = Math.floor(totalCards / 2);
            var referenceNode = cards[insertIndex];
            track.insertBefore(newCard, referenceNode);

            // Clone the new card for the duplicate set
            var cloneCard = newCard.cloneNode(true);
            var duplicateStart = insertIndex + 1 + Math.floor(insertIndex / 2); // rough estimate, but we'll just append to the end of the duplicate section
            // Actually, we need to insert it in the second half. Let's just add it at the end of the track.
            // Since the animation uses translateX(-50%), adding it at the end of the track will work seamlessly.
            // Let's add the clone right after the last original card.
            var totalAfterInsert = track.querySelectorAll('.testimonial-card').length;
            var half = Math.floor(totalAfterInsert / 2);
            // Insert clone at the end of the track, or specifically after the duplicate section starts.
            // We'll just append it to the track. The track will have 2 sets. Let's keep it simple: add clone at the end.
            // But to maintain the exact 50% split, we need to duplicate the new one.
            // Find the last card of the first set (which is the original duplicated ones)
            // Actually, just clone and append to the end of the track. The overflow and animation will handle it.
            var cloneToAppend = newCard.cloneNode(true);
            track.appendChild(cloneToAppend);

            // Close modal and reset form
            closeTestimonialModal();
            document.getElementById('testimonialForm').reset();
            setRating(5);

            // Show success toast
            showToast('Thank You!', 'Your testimonial has been added successfully.');
        };

        // ── Close modal on overlay click & Escape ──
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                var modal = document.getElementById('testimonialModal');
                if (modal.classList.contains('show')) {
                    closeTestimonialModal();
                }
            }
        });

        document.getElementById('testimonialModal').addEventListener('click', function(e) {
            if (e.target === this) {
                closeTestimonialModal();
            }
        });

        // ── Fade-in animation for new cards ──
        var style = document.createElement('style');
        style.textContent = `
            @@keyframes fadeIn {
                0% { opacity: 0; transform: scale(0.95); }
                100% { opacity: 1; transform: scale(1); }
            }
        `;
        document.head.appendChild(style);
    })();
</script>