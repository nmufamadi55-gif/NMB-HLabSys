<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NMB-HLabSys</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
    <style>
        /* ─── RESET & VARIABLES ─── */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --primary-dark: #020D2F;
            --primary-deep: #032C7D;
            --primary-bright: #0841C9;
            --primary-light: #1D97F1;
            --primary-soft: #C4C7F2;
            --bg-soft: #F0F4F8;
            --card-white: #FFFFFF;
            --text-dark: #0B1A2E;
            --text-muted: #5A6E7A;
            --shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.06);
            --shadow-md: 0 8px 30px rgba(0, 0, 0, 0.12);
            --shadow-lg: 0 20px 60px rgba(0, 0, 0, 0.18);
            --radius-card: 28px;
            --radius-element: 14px;
            --transition: 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94);
        }

        /* ─── GLOBAL SCROLLBAR STYLES ─── */
        /* WebKit browsers (Chrome, Safari, Edge) */
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }

        ::-webkit-scrollbar-track {
            background: #EDF2F7;
            border-radius: 8px;
        }

        ::-webkit-scrollbar-thumb {
            background: var(--primary-bright);
            border-radius: 8px;
            border: 1px solid rgba(255, 255, 255, 0.3);
        }

            ::-webkit-scrollbar-thumb:hover {
                background: var(--primary-light);
            }

        /* Firefox */
        * {
            scrollbar-width: thin;
            scrollbar-color: var(--primary-bright) #EDF2F7;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: #FFFFFF;
            color: var(--text-dark);
            overflow-x: hidden;
        }

        .container {
            max-width: 1280px;
            margin: 0 auto;
            padding: 0 2rem;
        }

        /* ─── NAVIGATION ─── */
        .landing-nav {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 1000;
            background: rgba(2, 13, 47, 0.92);
            backdrop-filter: blur(18px) saturate(1.2);
            border-bottom: 1px solid rgba(255, 255, 255, 0.06);
            transition: var(--transition);
        }

            .landing-nav.scrolled {
                background: rgba(2, 13, 47, 0.97);
                box-shadow: 0 4px 30px rgba(0, 0, 0, 0.4);
            }

        .nav-container {
            max-width: 1280px;
            margin: 0 auto;
            padding: 0.75rem 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 0.6rem;
            text-decoration: none;
        }

        .logo-icon {
            width: 40px;
            height: 40px;
            background: linear-gradient(135deg, var(--primary-bright), var(--primary-light));
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 1.2rem;
            box-shadow: 0 4px 16px rgba(8, 65, 201, 0.35);
        }

        .logo h1 {
            font-size: 1.2rem;
            font-weight: 700;
            background: linear-gradient(135deg, #FFFFFF 40%, var(--primary-soft));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            letter-spacing: -0.02em;
        }

        .logo span {
            font-weight: 400;
            font-size: 0.65rem;
            color: rgba(255, 255, 255, 0.4);
            -webkit-text-fill-color: rgba(255, 255, 255, 0.4);
            margin-left: 0.2rem;
        }

        .nav-links {
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

            .nav-links a {
                color: rgba(255, 255, 255, 0.7);
                text-decoration: none;
                font-size: 0.82rem;
                font-weight: 500;
                transition: var(--transition);
                position: relative;
                padding: 0.5rem 0.8rem;
                border-radius: 8px;
                letter-spacing: 0.01em;
            }

                .nav-links a::after {
                    content: '';
                    position: absolute;
                    bottom: 2px;
                    left: 50%;
                    width: 0;
                    height: 2px;
                    background: var(--primary-light);
                    border-radius: 4px;
                    transition: all 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94);
                    transform: translateX(-50%);
                }

                .nav-links a:hover {
                    color: #fff;
                    background: rgba(255, 255, 255, 0.06);
                }

                    .nav-links a:hover::after {
                        width: 60%;
                    }

                .nav-links a.active {
                    color: #fff;
                    background: rgba(255, 255, 255, 0.08);
                }

                    .nav-links a.active::after {
                        width: 60%;
                    }

        .nav-login {
            background: transparent !important;
            color: rgba(255, 255, 255, 0.9) !important;
            padding: 0.5rem 1.4rem !important;
            border: 1.5px solid rgba(255, 255, 255, 0.3);
            border-radius: 10px !important;
            font-weight: 600 !important;
            font-size: 0.78rem !important;
            transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94) !important;
            position: relative;
            overflow: hidden;
            letter-spacing: 0.02em;
        }

            .nav-login:hover {
                border-color: rgba(255, 255, 255, 0.8) !important;
                transform: translateY(-2px) scale(1.02);
                box-shadow: 0 8px 32px rgba(255, 255, 255, 0.08), inset 0 1px 0 rgba(255, 255, 255, 0.1);
                color: #fff !important;
                background: rgba(255, 255, 255, 0.05) !important;
            }

            .nav-login::after {
                display: none !important;
            }

        .nav-register {
            background: linear-gradient(135deg, var(--primary-bright), var(--primary-light)) !important;
            color: #fff !important;
            padding: 0.65rem 2rem !important;
            border-radius: 12px !important;
            font-weight: 700 !important;
            font-size: 0.82rem !important;
            box-shadow: 0 4px 20px rgba(8, 65, 201, 0.35);
            transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94) !important;
            position: relative;
            overflow: hidden;
            letter-spacing: 0.03em;
            border: none;
            text-transform: uppercase;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            z-index: 1;
        }

            .nav-register::before {
                content: '';
                position: absolute;
                inset: 0;
                background: linear-gradient(135deg, var(--primary-light), var(--primary-bright));
                opacity: 0;
                transition: opacity 0.5s ease;
                border-radius: 12px;
                z-index: -1;
            }

            .nav-register:hover {
                transform: translateY(-3px) scale(1.04);
                box-shadow: 0 12px 40px rgba(8, 65, 201, 0.5);
                color: #fff !important;
            }

                .nav-register:hover::before {
                    opacity: 1;
                }

            .nav-register::after {
                display: none !important;
            }

        .nav-hamburger {
            display: none;
            flex-direction: column;
            gap: 4px;
            background: none;
            border: none;
            cursor: pointer;
            padding: 4px;
        }

            .nav-hamburger span {
                display: block;
                width: 24px;
                height: 2px;
                background: #fff;
                border-radius: 4px;
                transition: var(--transition);
            }

        .mobile-nav {
            display: none;
            background: rgba(2, 13, 47, 0.98);
            padding: 1rem 2rem 2rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.06);
        }

            .mobile-nav.open {
                display: block;
            }

            .mobile-nav a {
                display: block;
                color: rgba(255, 255, 255, 0.8);
                text-decoration: none;
                padding: 0.6rem 0;
                font-size: 0.95rem;
                border-bottom: 1px solid rgba(255, 255, 255, 0.05);
            }

                .mobile-nav a:hover {
                    color: #fff;
                }

        .auth-buttons {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            margin-left: 0.5rem;
        }

        /* ─── RESPONSIVE ─── */
        @@media (max-width: 868px) {
            .nav-links a:not(.nav-login):not(.nav-register) {
                display: none;
            }

            .auth-buttons {
                margin-left: 0;
                gap: 0.4rem;
            }

            .nav-hamburger {
                display: flex !important;
            }
        }

        @@media (max-width: 480px) {
            .nav-login {
                padding: 0.3rem 0.8rem !important;
                font-size: 0.65rem !important;
            }

            .nav-register {
                padding: 0.4rem 1rem !important;
                font-size: 0.68rem !important;
            }
        }

        /* ─── SECTION COMMON ─── */
        section {
            padding: 5rem 0;
        }

        .section-header {
            text-align: center;
            max-width: 700px;
            margin: 0 auto 3.5rem;
        }

            .section-header .tag {
                display: inline-block;
                background: rgba(8, 65, 201, 0.08);
                color: var(--primary-bright);
                padding: 0.3rem 1.2rem;
                border-radius: 40px;
                font-size: 0.7rem;
                font-weight: 600;
                letter-spacing: 0.04em;
                text-transform: uppercase;
                margin-bottom: 0.8rem;
            }

            .section-header h2 {
                font-size: 2.5rem;
                font-weight: 800;
                color: var(--primary-dark);
                letter-spacing: -0.02em;
                line-height: 1.2;
            }

                .section-header h2 .highlight {
                    background: linear-gradient(135deg, var(--primary-bright), var(--primary-light));
                    -webkit-background-clip: text;
                    -webkit-text-fill-color: transparent;
                    background-clip: text;
                }

            .section-header p {
                color: var(--text-muted);
                font-size: 1.05rem;
                margin-top: 0.8rem;
                line-height: 1.6;
            }

        /* ─── LEGAL PAGE SPECIFIC ─── */
        .legal-page {
            padding: 8rem 0 4rem;
            background: var(--bg-soft);
            min-height: 80vh;
        }

        .legal-header {
            text-align: center;
            margin-bottom: 2.5rem;
        }

            .legal-header h1 {
                font-size: 2.8rem;
                font-weight: 800;
                color: var(--primary-dark);
                letter-spacing: -0.02em;
            }

        .last-updated {
            color: var(--text-muted);
            font-size: 0.9rem;
            margin-top: 0.3rem;
        }

        .legal-body {
            max-width: 820px;
            margin: 0 auto;
            background: #fff;
            padding: 2.5rem 3rem;
            border-radius: var(--radius-card);
            box-shadow: var(--shadow-md);
            border: 1px solid #E8EDF5;
        }

            .legal-body h2 {
                font-size: 1.4rem;
                font-weight: 700;
                color: var(--primary-dark);
                margin-top: 1.8rem;
                margin-bottom: 0.8rem;
                padding-bottom: 0.3rem;
                border-bottom: 1px solid #E8EDF5;
            }

            .legal-body p {
                color: var(--text-muted);
                line-height: 1.8;
                margin-bottom: 1rem;
            }

            .legal-body ul {
                margin: 0.5rem 0 1.2rem 1.5rem;
            }

                .legal-body ul li {
                    color: var(--text-muted);
                    line-height: 1.7;
                    margin-bottom: 0.4rem;
                }

            .legal-body a {
                color: var(--primary-bright);
                text-decoration: none;
                font-weight: 500;
            }

                .legal-body a:hover {
                    text-decoration: underline;
                }

        /* ─── MODAL STYLES (for newsletter success) ─── */
        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.5);
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 10000;
            padding: 1.5rem;
        }

            .modal-overlay.show {
                display: flex;
            }

        .modal-box {
            background: #fff;
            border-radius: var(--radius-card);
            padding: 2.5rem 2rem;
            text-align: center;
            max-width: 440px;
            width: 100%;
            box-shadow: 0 25px 70px rgba(0, 0, 0, 0.2);
            animation: modalPop 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
            position: relative;
        }

            .modal-box.modal-box-small {
                max-width: 400px;
                padding: 2rem 1.5rem;
            }

        @@keyframes modalPop {
            0% {
                transform: scale(0.8);
                opacity: 0;
            }

            100% {
                transform: scale(1);
                opacity: 1;
            }
        }

        .modal-icon {
            font-size: 3.5rem;
            color: #10B981;
            margin-bottom: 0.8rem;
            background: rgba(16, 185, 129, 0.1);
            width: 72px;
            height: 72px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-left: auto;
            margin-right: auto;
        }

        .modal-box h3 {
            font-size: 1.4rem;
            font-weight: 700;
            color: var(--text-dark);
            margin-bottom: 0.5rem;
        }

        .modal-box p {
            font-size: 0.95rem;
            color: var(--text-muted);
            line-height: 1.6;
            margin-bottom: 1.2rem;
        }

        .modal-btn {
            background: linear-gradient(135deg, var(--primary-bright), var(--primary-light));
            color: #fff;
            border: none;
            padding: 0.7rem 2rem;
            border-radius: 40px;
            font-weight: 600;
            font-size: 0.95rem;
            cursor: pointer;
            transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
            box-shadow: 0 4px 16px rgba(8, 65, 201, 0.3);
            font-family: 'Inter', sans-serif;
            margin-bottom: 0.5rem;
        }

            .modal-btn:hover {
                transform: scale(1.05);
                box-shadow: 0 8px 28px rgba(8, 65, 201, 0.4);
            }

        .modal-timer {
            font-size: 0.8rem;
            color: #94A3B8;
            margin-top: 0.3rem;
            font-weight: 400;
            letter-spacing: 0.02em;
        }

        .modal-close-btn {
            position: absolute;
            top: 12px;
            right: 16px;
            background: none;
            border: none;
            font-size: 1.8rem;
            cursor: pointer;
            color: #94A3B8;
            transition: color 0.3s ease;
            line-height: 1;
        }

            .modal-close-btn:hover {
                color: var(--text-dark);
            }

        /* ─── RESPONSIVE ─── */
        @@media (max-width: 1024px) {
            .section-header h2 {
                font-size: 2.2rem;
            }

            .legal-body {
                padding: 2rem;
            }
        }

        @@media (max-width: 868px) {
            .section-header h2 {
                font-size: 2rem;
            }

            .container {
                padding: 0 1rem;
            }

            .legal-header h1 {
                font-size: 2.2rem;
            }

            .legal-body {
                padding: 1.8rem;
            }
        }

        @@media (max-width: 480px) {
            .section-header h2 {
                font-size: 1.6rem;
            }

            .legal-header h1 {
                font-size: 1.8rem;
            }

            .legal-body {
                padding: 1.2rem;
            }

                .legal-body h2 {
                    font-size: 1.2rem;
                }
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <!-- ─── NAVIGATION ─── -->
    <nav class="landing-nav" id="mainNav">
        <div class="nav-container">
            <a href="@Url.Action("Index", "Home")" class="logo">
                <div class="logo-icon"><i class="fas fa-microscope"></i></div>
                <h1>NMB-HLabSys <span>v2.0</span></h1>
            </a>
            <div class="nav-links">
                <a href="@Url.Action("Index", "Home")#about" data-section="about">About</a>
                <a href="@Url.Action("Index", "Home")#services" data-section="services">Services</a>
                <a href="@Url.Action("Index", "Home")#features" data-section="features">Why Us</a>
                <a href="@Url.Action("Index", "Home")#contact" data-section="contact">Contact</a>
                <div class="auth-buttons">
                    <a href="@Url.Action("Index", "Home")#auth" class="nav-login">Login</a>
                    <a href="@Url.Action("Index", "Home")#auth" class="nav-register">Register</a>
                </div>
            </div>
            <button class="nav-hamburger" id="hamburger" aria-label="Toggle menu">
                <span></span><span></span><span></span>
            </button>
        </div>
        <div class="mobile-nav" id="mobileNav">
            <a href="@Url.Action("Index", "Home")#about">About</a>
            <a href="@Url.Action("Index", "Home")#services">Services</a>
            <a href="@Url.Action("Index", "Home")#features">Why Us</a>
            <a href="@Url.Action("Index", "Home")#contact">Contact</a>
            <div class="mobile-auth-buttons" style="display:flex; gap:0.8rem; margin-top:0.5rem; padding-top:0.5rem; border-top:1px solid rgba(255,255,255,0.08);">
                <a href="@Url.Action("Index", "Home")#auth" class="mobile-login" style="flex:1; text-align:center; padding:0.7rem 1rem; border-radius:10px; font-weight:600; font-size:0.85rem; background:transparent; color:rgba(255,255,255,0.9); border:1.5px solid rgba(255,255,255,0.25); text-decoration:none;">Login</a>
                <a href="@Url.Action("Index", "Home")#auth" class="mobile-register" style="flex:1; text-align:center; padding:0.7rem 1rem; border-radius:10px; font-weight:600; font-size:0.85rem; background:linear-gradient(135deg,var(--primary-bright),var(--primary-light)); color:#fff; box-shadow:0 4px 16px rgba(8,65,201,0.3); text-decoration:none;">Register</a>
            </div>
        </div>
    </nav>

    <!-- ─── MAIN CONTENT ─── -->
    <main>
        @RenderBody()
    </main>

    <!-- ─── FOOTER ─── -->
    <partial name="Sections/_Footer" />

    <!-- ─── JAVASCRIPT ─── -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        // ── Nav scroll effect ──
        window.addEventListener('scroll', function() {
            const nav = document.getElementById('mainNav');
            if (nav) {
                if (window.scrollY > 20) nav.classList.add('scrolled');
                else nav.classList.remove('scrolled');
            }
        });

        // ── Mobile hamburger ──
        document.getElementById('hamburger')?.addEventListener('click', function() {
            document.getElementById('mobileNav')?.classList.toggle('open');
        });
        document.querySelectorAll('#mobileNav a').forEach(link => {
            link.addEventListener('click', () => document.getElementById('mobileNav')?.classList.remove('open'));
        });

        // ── Nav highlight on scroll (if we are on the home page) ──
        const sections = document.querySelectorAll('section[id]');
        const navLinks = document.querySelectorAll('.nav-links a[data-section]');
        if (sections.length > 0 && navLinks.length > 0) {
            function updateNav() {
                let current = '';
                sections.forEach(section => {
                    const rect = section.getBoundingClientRect();
                    if (rect.top <= 120) { current = section.getAttribute('id'); }
                });
                navLinks.forEach(link => {
                    link.classList.remove('active');
                    if (link.getAttribute('data-section') === current) { link.classList.add('active'); }
                });
            }
            window.addEventListener('scroll', updateNav);
            window.addEventListener('load', updateNav);
        }

        // ── Ensure newsletter modal is hidden on load ──
        document.addEventListener('DOMContentLoaded', function() {
            var newsletterModal = document.getElementById('newsletterModal');
            if (newsletterModal) {
                newsletterModal.classList.remove('show');
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>