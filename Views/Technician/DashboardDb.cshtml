@model NMB_HLabSys.ViewModels.TechnicianDashboardViewModel
@{ Layout="~/Views/Shared/_Layout.cshtml"; ViewData["Title"]="Technician Dashboard"; ViewData["RoleSubtitle"]="Technician Portal"; ViewData["UserGreeting"]=$"{Model.Technician.Name} ({Model.Technician.EmployeeNumber})"; ViewData["UserInitials"]="LT"; }
@section Styles { <link rel="stylesheet" href="~/css/technician.css" /> }
@section SidebarMenu { @await Html.PartialAsync("_TechnicianSidebar", "Dashboard") }
<section class="tech-shell">
  <div class="page-toolbar"><div><div class="tech-eyebrow">Laboratory operations</div><h2>Welcome back, @Model.Technician.Name</h2><p>A live view of your workload, quality checks, and turnaround priorities.</p></div><div class="tech-toolbar"><button class="tech-command" data-brief-open><i class="fas fa-sparkles"></i> Shift brief</button><button class="tech-command" data-command-open><i class="fas fa-search"></i> Quick access <kbd>Ctrl K</kbd></button><button class="tech-theme-toggle" data-tech-theme title="Toggle colour theme"><i class="fas fa-moon"></i></button></div></div>
  <div class="tech-hero"><div class="tech-hero-grid"><div class="tech-hero-copy"><div class="tech-eyebrow" style="color:#d6f9ff">Technician workspace</div><h1>Work clearly. Deliver on time.</h1><p>Live workload signals help you prioritise urgent tests, protect turnaround times, and maintain quality at every step.</p><div class="tech-hero-chips"><span><i class="fas fa-bolt"></i> @Model.Urgent priority</span><span><i class="fas fa-hourglass-half"></i> @Model.NearingDue due soon</span></div></div><div class="tech-time tech-hero-mini"><i class="fas fa-flask"></i><strong>@Model.Technician.EmployeeNumber</strong><span id="techClock"></span></div></div></div>
  <partial name="_TechnicianFeedback" />
  <div class="tech-focus-grid">
    <section class="card-modern tech-start-card"><div class="tech-start-card-top"><span class="tech-mini-label"><i class="fas fa-compass"></i> Start here</span><span class="tech-live-dot">Live queue</span></div><h3>Choose your next safe step.</h3><p>Move from sample receipt to result verification with clear, role-approved actions.</p><div class="tech-next-actions"><a asp-action="ReceiveSamples"><span class="tech-next-icon receive"><i class="fas fa-box-open"></i></span><span><strong>Receive samples</strong><small>Confirm sample identity and receipt</small></span><i class="fas fa-arrow-right"></i></a><a asp-action="PerformTests"><span class="tech-next-icon perform"><i class="fas fa-vial"></i></span><span><strong>Perform tests</strong><small>@Model.WaitingToBeSelected ready to be selected</small></span><i class="fas fa-arrow-right"></i></a><a asp-action="Verification"><span class="tech-next-icon verify"><i class="fas fa-check-double"></i></span><span><strong>Verify results</strong><small>@Model.AwaitingVerification awaiting review</small></span><i class="fas fa-arrow-right"></i></a></div></section>
  </div>
  <div class="tech-workload-section"><div class="tech-section-heading"><span>Workflow</span><small>Choose a state to open its live records</small></div><div class="tech-kpis tech-kpis-workload"><a class="tech-kpi" href="@Url.Action("PerformTests",new { })" title="Show tests waiting to be selected"><i class="fas fa-hand-pointer"></i><div><strong>@Model.WaitingToBeSelected</strong><span>Waiting to be selected</span><em>Open workbench <i class="fas fa-arrow-right"></i></em></div></a><a class="tech-kpi" href="@Url.Action("PerformTests",new { })" title="Show tests selected by you"><i class="fas fa-vial"></i><div><strong>@Model.InProgress</strong><span>Tests selected by you</span><em>Open workbench <i class="fas fa-arrow-right"></i></em></div></a><a class="tech-kpi" asp-action="Verification" title="Show independently verifiable results"><i class="fas fa-user-shield"></i><div><strong>@Model.AwaitingVerification</strong><span>Waiting to be verified</span><em>Open verification <i class="fas fa-arrow-right"></i></em></div></a><a class="tech-kpi" asp-action="PerformTests" title="Show returned tests"><i class="fas fa-undo"></i><div><strong>@Model.WaitingToBeReviewed</strong><span>Waiting to be reviewed</span><em>Open workbench <i class="fas fa-arrow-right"></i></em></div></a></div></div><div class="tech-workload-section"><div class="tech-section-heading"><span>Turnaround priority</span><small>Live record filters</small></div><div class="tech-kpis tech-kpis-priority"><a class="tech-kpi" href="@Url.Action("Dashboard",new { Urgency="priority" })" title="Show urgent and STAT tests"><i class="fas fa-bolt"></i><div><strong>@Model.Urgent</strong><span>Urgent / STAT</span><em>View records <i class="fas fa-arrow-right"></i></em></div></a><a class="tech-kpi" href="@Url.Action("Dashboard",new { Due="overdue" })" title="Show overdue tests"><i class="fas fa-exclamation-circle"></i><div><strong>@Model.Overdue</strong><span>Overdue turnaround</span><em>View records <i class="fas fa-arrow-right"></i></em></div></a><a class="tech-kpi" href="@Url.Action("Dashboard",new { Due="nearing" })" title="Show tests due within one hour"><i class="fas fa-hourglass-half"></i><div><strong>@Model.NearingDue</strong><span>Due within 60 min</span><em>View records <i class="fas fa-arrow-right"></i></em></div></a></div></div>
  @{ var categoryMax=Math.Max(1,Model.CategoryChart.Any()?Model.CategoryChart.Max(x=>x.Value):1); var workloadMax=Math.Max(1,Model.WorkloadChart.Any()?Model.WorkloadChart.Max(x=>x.Value):1); }
  <div class="tech-chart-grid"><div class="card-modern tech-chart-card"><div class="card-header-flex"><div><h3><i class="fas fa-chart-column"></i> Tests by category</h3><p>Click a bar to filter live records by category.</p></div><span class="tech-live-dot">Live</span></div><div class="tech-bar-chart">@foreach(var item in Model.CategoryChart){var height=Math.Max(8,(int)Math.Round(item.Value*100.0/categoryMax));<a class="tech-bar" href="@Url.Action("Dashboard",new { Category=item.Category })" title="Show @item.Value test(s) in @item.Label"><span class="tech-bar-value">@item.Value</span><span class="tech-bar-fill" style="height:@height%"></span><span class="tech-bar-label">@item.Label</span></a>}@if(!Model.CategoryChart.Any()){<div class="tech-chart-empty">No assigned test categories yet.</div>}</div></div><div class="card-modern tech-chart-card"><div class="card-header-flex"><div><h3><i class="fas fa-chart-pie"></i> Workload state</h3><p>Current progress across your authorised workload.</p></div><span class="tech-live-dot">Live</span></div><div class="tech-bar-chart tech-workload-chart">@foreach(var item in Model.WorkloadChart){var height=Math.Max(8,(int)Math.Round(item.Value*100.0/workloadMax));var target=item.Status=="Completed"?Url.Action("Verification"):item.Status=="Submitted"||item.Status=="In Progress"||item.Status=="To Be Reviewed"?Url.Action("PerformTests"):Url.Action("Dashboard",new { Due=item.Due });<a class="tech-bar" href="@target" title="Show @item.Label records"><span class="tech-bar-value">@item.Value</span><span class="tech-bar-fill" style="height:@height%"></span><span class="tech-bar-label">@item.Label</span></a>}</div></div></div>
  <div class="tech-dashboard-grid">
    <div class="card-modern tech-filter-card"><div class="card-header-flex"><div><h3><i class="fas fa-filter"></i> Workload filters</h3><p>Filter the live queue without changing any records.</p></div><a class="btn-outline-lab" asp-action="Dashboard">Clear</a></div><form method="get" class="tech-filter-form"><div><label>Progress status</label><select name="Status" class="lab-input"><option value="">All statuses</option>@foreach(var item in new[]{"Submitted","In Progress","Completed","To Be Reviewed","Verified"}){<option value="@item" selected="@(Model.Filter.Status==item)">@item</option>}</select></div><div><label>Urgency</label><select name="Urgency" class="lab-input"><option value="">All urgency levels</option><option value="priority" selected="@(Model.Filter.Urgency=="priority")">Urgent / STAT</option>@foreach(var item in new[]{"routine","urgent","stat"}){<option value="@item" selected="@(Model.Filter.Urgency==item)">@item.ToUpperInvariant()</option>}</select></div><div><label>Category</label><select name="Category" class="lab-input"><option value="">All categories</option>@foreach(var category in Model.Categories){<option value="@category" selected="@(Model.Filter.Category==category)">@category</option>}</select></div><div><label>Due time</label><select name="Due" class="lab-input"><option value="">All due times</option><option value="nearing" selected="@(Model.Filter.Due=="nearing")">Due within 60 min</option><option value="today" selected="@(Model.Filter.Due=="today")">Due today</option><option value="overdue" selected="@(Model.Filter.Due=="overdue")">Overdue</option></select></div><div><label>Request number</label><input class="lab-input" name="RequestNumber" value="@Model.Filter.RequestNumber" placeholder="e.g. TR-1001" /></div><button class="btn-sm-lab" type="submit"><i class="fas fa-search"></i> Apply filters</button></form></div>
    <div class="card-modern tech-report-card"><div class="card-header-flex"><div><h3><i class="fas fa-file-pdf"></i> Completed tests report</h3><p>Download your completed tests, grouped by category.</p></div></div><form asp-action="CompletedTestsReport" method="get" class="tech-report-form"><div><label>From</label><input class="lab-input" type="date" name="StartDate" value="@DateTime.Today.AddDays(-30).ToString("yyyy-MM-dd")" required /></div><div><label>To</label><input class="lab-input" type="date" name="EndDate" value="@DateTime.Today.ToString("yyyy-MM-dd")" required /></div><button class="btn-sm-lab" type="submit"><i class="fas fa-download"></i> Download PDF</button></form><small><i class="fas fa-shield-alt"></i> Includes completion time, urgency and turnaround status.</small></div>
  </div>
  <div class="card-modern table-container"><div class="card-header-flex"><div><h3><i class="fas fa-list-check"></i> Work queue</h3><p>@Model.WorkItems.Count live item(s) match the selected filters.</p></div><div class="tech-table-tools"><input class="lab-input tech-table-search" data-tech-search="#techWorkQueue" placeholder="Search visible queue" /><a class="btn-outline-lab" asp-action="PerformTests">Open testing</a></div></div><table id="techWorkQueue"><thead><tr><th>Request</th><th>Patient</th><th>Test / category</th><th>Urgency</th><th>Status</th><th>Due</th><th></th></tr></thead><tbody>@foreach(var x in Model.WorkItems){<tr><td><strong>@x.RequestNumber</strong></td><td>@x.Patient</td><td><strong>@x.TestName</strong><br/><small>@x.Category</small></td><td><span class="tech-status @(x.Urgency.ToLower())">@x.Urgency</span></td><td><span class="tech-status @(x.IsOverdue?"overdue":x.Status.ToLower().Replace(" ",""))">@x.Status</span></td><td>@(x.DueAt?.ToString("dd MMM, HH:mm")??"Not started")</td><td><a class="btn-sm-lab" asp-action="PerformTests">Open</a></td></tr>}@if(!Model.WorkItems.Any()){<tr><td colspan="7" class="tech-empty"><i class="fas fa-clipboard-check"></i>No workload records match these filters.</td></tr>}</tbody></table></div>
</section>
<div id="techCommand" class="tech-modal" data-command-close><div class="tech-command-box" onclick="event.stopPropagation()"><input placeholder="Jump to a Technician page..." autofocus/><a class="tech-command-item" asp-action="Dashboard"><i class="fas fa-chart-line"></i> Dashboard</a><a class="tech-command-item" asp-action="ReceiveSamples"><i class="fas fa-box-open"></i> Receive samples</a><a class="tech-command-item" asp-action="PerformTests"><i class="fas fa-vial"></i> Perform tests</a><a class="tech-command-item" asp-action="Verification"><i class="fas fa-check-double"></i> Verification queue</a></div></div>
<div id="techBrief" class="tech-modal" data-brief-close><div class="tech-brief-box" onclick="event.stopPropagation()"><button class="tech-modal-close" type="button" data-brief-close aria-label="Close shift brief"><i class="fas fa-xmark"></i></button><span class="tech-mini-label"><i class="fas fa-sparkles"></i> Your live shift brief</span><h3>Focus on what moves care forward.</h3><div class="tech-brief-metrics"><a asp-action="PerformTests"><strong>@Model.WaitingToBeSelected</strong><span>waiting to start</span></a><a asp-action="Verification"><strong>@Model.AwaitingVerification</strong><span>need verification</span></a><a asp-action="Dashboard" asp-route-Due="overdue"><strong>@Model.Overdue</strong><span>overdue tests</span></a></div><p><i class="fas fa-circle-info"></i> Figures reflect your current authorised workload.</p><a class="btn-sm-lab" asp-action="PerformTests">Open my workbench <i class="fas fa-arrow-right"></i></a></div></div>
@section Scripts { <script src="~/js/technician-ui.js"></script><script>setInterval(()=>{const e=document.getElementById('techClock');if(e)e.textContent=new Date().toLocaleString()},1000)</script> }


