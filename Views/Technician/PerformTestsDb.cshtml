@model NMB_HLabSys.ViewModels.PerformTestsViewModel
@{ Layout="~/Views/Shared/_Layout.cshtml"; ViewData["Title"]="Perform Tests"; ViewData["RoleSubtitle"]="Technician Portal"; ViewData["UserGreeting"]=$"{Model.Technician.Name} ({Model.Technician.EmployeeNumber})"; ViewData["UserInitials"]="LT"; }
@section Styles { <link rel="stylesheet" href="~/css/technician.css" /> }
@section SidebarMenu { @await Html.PartialAsync("_TechnicianSidebar", "PerformTests") }
<section class="tech-shell"><div class="page-toolbar"><div><div class="tech-eyebrow">Testing bench</div><h2>Authorised tests</h2><p>Only test types assigned by the Laboratory Manager are listed. Starting a test records the time and deducts its configured consumables.</p></div><button class="tech-theme-toggle" data-tech-theme><i class="fas fa-moon"></i></button></div>@if(TempData["ErrorMessage"] is string error){<div class="alert alert-danger">@error</div>} @if(TempData["SuccessMessage"] is string success){<div class="alert alert-success">@success</div>}
<div class="card-modern table-container"><table><thead><tr><th>Request</th><th>Patient</th><th>Test</th><th>Urgency</th><th>Timing</th><th>Status</th><th>Action</th></tr></thead><tbody>@foreach(var x in Model.Tests){<tr><td><strong>@x.RequestNumber</strong></td><td>@x.Patient</td><td><strong>@x.TestName</strong><br/><small>@x.Category</small></td><td><span class="tech-status @(x.Urgency.ToLower())">@x.Urgency</span></td><td>@if(x.DueAt.HasValue){<span class="@(x.IsOverdue?"abnormal-text":"")">@x.DueAt.Value.ToString("dd MMM HH:mm")</span>}else{<span>Starts when selected</span>}</td><td><span class="tech-status @(x.IsOverdue?"overdue":x.Status.ToLower().Replace(" ",""))">@x.Status</span></td><td>@if(x.Status=="Submitted"||x.Status=="To Be Reviewed"){<form asp-action="SelectTest" method="post"><input type="hidden" name="requestTestId" value="@x.RequestTestId"/><button class="btn-sm-lab">Start test</button></form>}else{<span>Started @x.StartedAt?.ToString("g")</span>}</td></tr>@if(x.Status=="In Progress"||x.Status=="To Be Reviewed"){<tr class="tech-work-detail"><td colspan="7"><div class="tech-detail-grid"><div class="tech-patient-context"><h4><i class="fas fa-notes-medical"></i> Patient context</h4><p><strong>Clinical notes:</strong> @(string.IsNullOrWhiteSpace(x.ClinicalNotes)?"No clinical notes supplied.":x.ClinicalNotes)</p><p><strong>Conditions:</strong> @(string.IsNullOrWhiteSpace(x.Conditions)?"None recorded":x.Conditions)</p><p><strong>Allergies:</strong> @(string.IsNullOrWhiteSpace(x.Allergies)?"None recorded":x.Allergies)</p><p><strong>Medications:</strong> @(string.IsNullOrWhiteSpace(x.Medications)?"None recorded":x.Medications)</p>@if(!string.IsNullOrWhiteSpace(x.ReviewNotes)){<p class="tech-review-note"><strong>Return note:</strong> @x.ReviewNotes</p>}</div><form asp-action="CaptureResult" method="post" class="compact-form"><input type="hidden" name="RequestTestId" value="@x.RequestTestId"/><label>Result value <input class="lab-input" name="ResultValue" required /></label><label>Numeric value <input class="lab-input" type="number" step="0.0001" name="NumericValue" /></label><label>Notes <input class="lab-input" name="Notes" /></label><button class="btn-sm-lab" type="submit"><i class="fas fa-save"></i> Save completed result</button></form></div></td></tr>}}@if(!Model.Tests.Any()){<tr><td colspan="7" class="tech-empty"><i class="fas fa-vial"></i>No available authorised tests.</td></tr>}</tbody></table></div></section>
@section Scripts { <script src="~/js/technician-ui.js"></script> }


