@model NMB_HLabSys.ViewModels.TechnicianProfileViewModel
@{ Layout="~/Views/Shared/_Layout.cshtml"; ViewData["Title"]="My Profile"; ViewData["RoleSubtitle"]="Technician Portal"; ViewData["UserGreeting"]=$"{Model.Name} {Model.Surname}"; ViewData["UserInitials"]="LT"; }
@section Styles { <link rel="stylesheet" href="~/css/technician.css" /> }
@section SidebarMenu { @await Html.PartialAsync("_TechnicianSidebar", "Profile") }
<section class="tech-shell"><div class="page-toolbar"><div><div class="tech-eyebrow">Account settings</div><h2>My profile</h2><p>Keep your contact information and professional details current.</p></div><button class="tech-theme-toggle" data-tech-theme><i class="fas fa-moon"></i></button></div>@if(TempData["ErrorMessage"] is string error){<div class="alert alert-danger">@error</div>} @if(TempData["SuccessMessage"] is string success){<div class="alert alert-success">@success</div>}<div class="card-modern tech-profile-card"><div class="tech-profile-badge"><i class="fas fa-user-gear"></i><div><strong>@Model.Name @Model.Surname</strong><span>@Model.EmployeeNumber</span></div></div><form asp-action="Profile" method="post" class="tech-profile-form"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div><label asp-for="Name">First name</label><input asp-for="Name" class="lab-input"/><span asp-validation-for="Name" class="text-danger"></span></div><div><label asp-for="Surname">Surname</label><input asp-for="Surname" class="lab-input"/><span asp-validation-for="Surname" class="text-danger"></span></div><div><label asp-for="Email">Email address</label><input asp-for="Email" class="lab-input"/><span asp-validation-for="Email" class="text-danger"></span></div><div><label asp-for="ContactNumber">Contact number</label><input asp-for="ContactNumber" class="lab-input"/><span asp-validation-for="ContactNumber" class="text-danger"></span></div><div><label>Employee number</label><input class="lab-input" value="@Model.EmployeeNumber" disabled /></div><div><label asp-for="YearsOfExperience">Years of experience</label><input asp-for="YearsOfExperience" type="number" min="0" max="70" class="lab-input"/><span asp-validation-for="YearsOfExperience" class="text-danger"></span></div><div class="tech-profile-wide"><label asp-for="Specialization">Specialization</label><input asp-for="Specialization" class="lab-input"/></div><div class="tech-profile-wide"><label asp-for="Qualification">Qualification</label><input asp-for="Qualification" class="lab-input"/></div><div class="tech-profile-wide"><button class="btn-sm-lab" type="submit"><i class="fas fa-save"></i> Save profile changes</button></div></form></div></section>
@section Scripts { <script src="~/js/technician-ui.js"></script><partial name="_ValidationScriptsPartial" /> }


