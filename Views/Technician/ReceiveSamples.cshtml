@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Receive Samples";
    ViewData["RoleSubtitle"] = "Technician Portal";
    ViewData["UserGreeting"] = $"Lab Tech {ViewBag.TechName} (EMP:{ViewBag.EmployeeNumber})";
    ViewData["UserInitials"] = "MP";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
}

@section SidebarMenu {
        <li><a href="@Url.Action("Dashboard", "Technician")" class="@(currentAction == "Dashboard" ? "active" : "")"><i class="fas fa-chart-line"></i> <span>Workload</span></a></li>
        <li><a href="@Url.Action("ReceiveSamples", "Technician")" class="@(currentAction == "ReceiveSamples" ? "active" : "")"><i class="fas fa-box-open"></i> <span>Receive Samples</span></a></li>
        <li><a href="@Url.Action("PerformTests", "Technician")" class="@(currentAction == "PerformTests" ? "active" : "")"><i class="fas fa-vial"></i> <span>Perform Tests</span></a></li>
        <li><a href="@Url.Action("Verification", "Technician")" class="@(currentAction == "Verification" ? "active" : "")"><i class="fas fa-check-double"></i> <span>Verification</span></a></li>
        <li><a href="@Url.Action("Reports", "Technician")" class="@(currentAction == "Reports" ? "active" : "")"><i class="fas fa-file-pdf"></i> <span>Reports</span></a></li>
        <li><a href="@Url.Action("Index", "Profile")"><i class="fas fa-user-circle"></i> <span>My Profile</span></a></li>
}

<div class="stat-cards">
    <div class="stat-item"><div class="stat-icon-lg"><i class="fas fa-boxes"></i></div><div><h3 id="pendingCount">4</h3><p>Pending Receipts</p></div></div>
    <div class="stat-item"><div class="stat-icon-lg"><i class="fas fa-clipboard-check"></i></div><div><h3 id="receivedCount">23</h3><p>Received Today</p></div></div>
    <div class="stat-item"><div class="stat-icon-lg"><i class="fas fa-triangle-exclamation"></i></div><div><h3>2</h3><p>Overdue Samples</p></div></div>
</div>

<div class="card-modern">
    <div class="card-header-flex">
        <h3><i class="fas fa-barcode"></i> Receive Patient Test Requests and Samples</h3>
        <button class="btn-sm-lab" onclick="focusBarcode()"><i class="fas fa-barcode"></i> Scan Barcode</button>
    </div>
    <div class="grid-2col compact-form">
        <div><label>Request number</label><input id="requestInput" class="lab-input" placeholder="REQ-000"></div>
        <div><label>Sample barcode number</label><input id="barcodeInput" class="lab-input" placeholder="Scan or enter barcode"></div>
        <div><label>Sample type</label><select id="sampleTypeInput" class="lab-select"><option>Whole Blood (EDTA Tube)</option><option>Plasma (Citrate Tube)</option><option>Bone Marrow Aspirate</option><option>Serum</option></select></div>
        <div><label>Technician receiving sample</label><input class="lab-input" value="@ViewBag.TechName (@ViewBag.EmployeeNumber)" readonly></div>
        <div><label>Date/time received</label><input id="receivedAtInput" class="lab-input" value="Captured when marked received" readonly></div>
        <div><label>Resulting request status</label><input class="lab-input" value="Samples Received" readonly></div>
    </div>
    <div class="table-container">
        <table id="sampleTable">
            <thead><tr><th>Barcode</th><th>Request #</th><th>Patient</th><th>Sample Type</th><th>Collected</th><th>Date/Time Received</th><th>Status</th><th>Action</th></tr></thead>
            <tbody>
                <tr data-status="awaiting"><td><span class="mono">BAR-47832</span></td><td>REQ-004</td><td>Thabo Mbeki</td><td>Whole Blood (EDTA Tube)</td><td>2026-05-19 09:30</td><td class="received-at">-</td><td><span class="badge badge-progress">Awaiting</span></td><td><button class="btn-sm-lab" onclick="receiveSample(this, 'BAR-47832', 'REQ-004')"><i class="fas fa-check"></i> Mark Received</button></td></tr>
                <tr data-status="awaiting"><td><span class="mono">BAR-47833</span></td><td>REQ-005</td><td>Lerato Dlamini</td><td>Plasma (Citrate Tube)</td><td>2026-05-19 10:15</td><td class="received-at">-</td><td><span class="badge badge-progress">Awaiting</span></td><td><button class="btn-sm-lab" onclick="receiveSample(this, 'BAR-47833', 'REQ-005')"><i class="fas fa-check"></i> Mark Received</button></td></tr>
                <tr data-status="awaiting"><td><span class="mono">BAR-47834</span></td><td>REQ-006</td><td>John Smith</td><td>Bone Marrow Aspirate</td><td>2026-05-18 14:20</td><td class="received-at">-</td><td><span class="badge badge-stat">Urgent</span></td><td><button class="btn-sm-lab" onclick="receiveSample(this, 'BAR-47834', 'REQ-006')"><i class="fas fa-check"></i> Mark Received</button></td></tr>
                <tr data-status="awaiting"><td><span class="mono">BAR-47835</span></td><td>REQ-007</td><td>Maria Santos</td><td>Whole Blood (EDTA Tube)</td><td>2026-05-19 08:45</td><td class="received-at">-</td><td><span class="badge badge-progress">Awaiting</span></td><td><button class="btn-sm-lab" onclick="receiveSample(this, 'BAR-47835', 'REQ-007')"><i class="fas fa-check"></i> Mark Received</button></td></tr>
            </tbody>
        </table>
    </div>
</div>

<div class="card-modern">
    <h3><i class="fas fa-receipt"></i> Receipt Audit Trail</h3>
    <table id="receiptLog">
        <thead><tr><th>Request #</th><th>Barcode</th><th>Technician</th><th>Received At</th><th>Request Status</th></tr></thead>
        <tbody>
            <tr><td>REQ-003</td><td>BAR-47828</td><td>Tech Peters</td><td>2026-05-19 08:10</td><td><span class="badge badge-completed">Samples Received</span></td></tr>
            <tr><td>REQ-002</td><td>BAR-47829</td><td>Tech Smith</td><td>2026-05-19 07:55</td><td><span class="badge badge-completed">Samples Received</span></td></tr>
        </tbody>
    </table>
</div>

<div class="alert-info-soft"><strong><i class="fas fa-circle-info"></i> Quality Check Reminder:</strong> Verify request number, technician, barcode, sample type, and date/time received before accepting. Accepted requests move to Samples Received.</div>

@section Scripts {
    <script>
    function focusBarcode() { document.getElementById('barcodeInput').focus(); }
    function receiveSample(button, barcode, requestNo) {
        const row = button.closest('tr');
        const timestamp = new Date().toLocaleString();
        document.getElementById('requestInput').value = requestNo;
        document.getElementById('barcodeInput').value = barcode;
        document.getElementById('sampleTypeInput').value = row.cells[3].textContent;
        document.getElementById('receivedAtInput').value = timestamp;
        row.dataset.status = 'received';
        row.querySelector('.received-at').textContent = timestamp;
        row.cells[6].innerHTML = '<span class="badge badge-completed">Samples Received</span>';
        button.innerHTML = '<i class="fas fa-check-circle"></i> Received';
        button.disabled = true;
        button.classList.add('disabled-btn');
        const log = document.getElementById('receiptLog').querySelector('tbody');
        log.insertAdjacentHTML('afterbegin', `<tr><td>${requestNo}</td><td>${barcode}</td><td>@ViewBag.TechName</td><td>${timestamp}</td><td><span class="badge badge-completed">Samples Received</span></td></tr>`);
        document.getElementById('pendingCount').textContent = document.querySelectorAll('#sampleTable tr[data-status="awaiting"]').length;
        document.getElementById('receivedCount').textContent = Number(document.getElementById('receivedCount').textContent) + 1;
    }
    </script>
}
