@model NMB_HLabSys.ViewModels.ReceiveSamplesViewModel
@{ Layout="~/Views/Shared/_Layout.cshtml"; ViewData["Title"]="Receive Samples"; ViewData["RoleSubtitle"]="Technician Portal"; ViewData["UserGreeting"]=$"{Model.Technician.Name} ({Model.Technician.EmployeeNumber})"; ViewData["UserInitials"]="LT"; }
@section Styles { <link rel="stylesheet" href="~/css/technician.css" /> }
@section SidebarMenu { @await Html.PartialAsync("_TechnicianSidebar", "ReceiveSamples") }
<section class="tech-shell"><div class="page-toolbar"><div><div class="tech-eyebrow">Sample reception</div><h2>Pending samples</h2><p>Confirm request, barcode, and sample type before receiving.</p></div><button class="tech-theme-toggle" data-tech-theme><i class="fas fa-moon"></i></button></div><partial name="_TechnicianFeedback" />
<div class="card-modern table-container"><table><thead><tr><th>Request</th><th>Patient</th><th>Barcode</th><th>Sample type</th><th>Requested</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var x in Model.Samples){<tr><td><strong>@x.RequestNumber</strong></td><td>@x.Patient</td><td>@x.Barcode</td><td>@x.SampleType</td><td>@x.RequestedAt.ToString("dd MMM yyyy HH:mm")</td><td><span class="tech-status">@x.Status</span></td><td><form asp-action="ReceiveSample" method="post"><input type="hidden" name="sampleId" value="@x.SampleId"/><button class="btn-sm-lab" type="submit">Receive sample</button></form></td></tr>}@if(!Model.Samples.Any()){<tr><td colspan="7" class="tech-empty"><i class="fas fa-box-open"></i>No pending samples.</td></tr>}</tbody></table></div></section>
@section Scripts { <script src="~/js/technician-ui.js"></script> }


