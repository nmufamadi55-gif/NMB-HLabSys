@{ Layout="~/Views/Shared/_Layout.cshtml"; ViewData["Title"]="Technician Reports"; ViewData["RoleSubtitle"]="Technician Portal"; ViewData["UserGreeting"]="Technician reports"; ViewData["UserInitials"]="LT"; }
@section Styles { <link rel="stylesheet" href="~/css/technician.css" /> }
@section SidebarMenu { @await Html.PartialAsync("_TechnicianSidebar", "Reports") }
<section class="tech-shell"><div class="page-toolbar"><div><div class="tech-eyebrow">Reporting centre</div><h2>Completed tests report</h2><p>Generate a professional PDF summary of your completed tests, grouped by category.</p></div><button class="tech-theme-toggle" data-tech-theme><i class="fas fa-moon"></i></button></div><partial name="_TechnicianFeedback" /><div class="tech-hero tech-hero-compact"><div><div class="tech-eyebrow" style="color:#bfeaff">Ready when you are</div><h3>Choose a date range for your completed work.</h3><p>The report includes urgency, completion time, turnaround status, abnormal-result indicators, category grouping, and page numbering.</p></div><div class="tech-time"><i class="fas fa-file-pdf"></i><br/><span>PDF report</span></div></div><div class="card-modern tech-report-card"><form asp-action="CompletedTestsReport" method="get" class="tech-report-form"><div><label>From date</label><input class="lab-input" type="date" name="StartDate" value="@DateTime.Today.AddDays(-30).ToString("yyyy-MM-dd")" required /></div><div><label>To date</label><input class="lab-input" type="date" name="EndDate" value="@DateTime.Today.ToString("yyyy-MM-dd")" required /></div><button class="btn-sm-lab" type="submit"><i class="fas fa-download"></i> Download report</button></form><small><i class="fas fa-shield-alt"></i> Reports contain only the Technician's completed tests and should be handled as confidential clinical information.</small></div></section>
@section Scripts { <script src="~/js/technician-ui.js"></script> }
