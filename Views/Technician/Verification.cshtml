@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Test Verification";
    ViewData["RoleSubtitle"] = "Technician Portal";
    ViewData["UserGreeting"] = $"🔬 {@ViewBag.TechName} (EMP:{@ViewBag.EmployeeNumber})";
    ViewData["UserInitials"] = "MP";
}

@section SidebarMenu {
    <li><a href="@Url.Action("Dashboard", "Technician")">📊 Workload</a></li>
    <li><a href="@Url.Action("ReceiveSamples", "Technician")">📦 Receive Samples</a></li>
    <li><a href="@Url.Action("PerformTests", "Technician")">⚙️ Perform Tests</a></li>
    <li><a href="@Url.Action("Verification", "Technician")" class="active">✅ Verification</a></li>
}

<div class="stat-cards">
    <div class="stat-item"><div class="stat-icon-lg">✅</div><div><h3>6</h3><p>Awaiting Verification</p></div></div>
    <div class="stat-item"><div class="stat-icon-lg">🔄</div><div><h3>2</h3><p>Returned for Review</p></div></div>
    <div class="stat-item"><div class="stat-icon-lg">📊</div><div><h3>34</h3><p>Verified Today</p></div></div>
</div>

<div class="card-modern">
    <div class="card-header-flex">
        <h3>✅ Tests Awaiting Your Verification</h3>
        <div class="user-tag" style="background:#F1F5F9; padding:0.3rem 1rem; border-radius:40px;">
            <span>🔐 Two-Step Validation Required</span>
        </div>
    </div>
    <div class="table-container">
        <table>
            <thead>
                <tr><th>Test Name</th><th>Request #</th><th>Patient</th><th>Performed By</th><th>Result Value</th><th>Normal Range</th><th>Status</th><th>Action</th></tr>
            </thead>
            <tbody>
                <tr>
                    <td>Full Blood Count - Hb</td>
                    <td>REQ-001</td>
                    <td>Thabo Mbeki</td>
                    <td>Tech Peters</td>
                    <td><strong class="abnormal-row" style="color:#E26D5C;">7.2 g/dL</strong></td>
                    <td>12-16 g/dL</td>
                    <td><span class="badge badge-progress">Pending</span></td>
                    <td><button class="btn-sm-lab" onclick="openVerificationModal('FBC', 'REQ-001', '7.2', '12-16', 'Thabo Mbeki', true)">🔍 Verify</button></td>
                </tr>
                <tr>
                    <td>Coagulation - PT/INR</td>
                    <td>REQ-002</td>
                    <td>Lerato Dlamini</td>
                    <td>Tech Smith</td>
                    <td>12.5 seconds</td>
                    <td>11-13.5 seconds</td>
                    <td><span class="badge badge-progress">Pending</span></td>
                    <td><button class="btn-sm-lab" onclick="openVerificationModal('PT/INR', 'REQ-002', '12.5', '11-13.5', 'Lerato Dlamini', false)">🔍 Verify</button></td>
                </tr>
                <tr>
                    <td>Platelet Count</td>
                    <td>REQ-003</td>
                    <td>John Smith</td>
                    <td>Tech Peters</td>
                    <td><strong class="abnormal-row" style="color:#E26D5C;">45 k/µL</strong></td>
                    <td>150-450 k/µL</td>
                    <td><span class="badge badge-progress">Pending</span></td>
                    <td><button class="btn-sm-lab" onclick="openVerificationModal('Platelets', 'REQ-003', '45', '150-450', 'John Smith', true)">🔍 Verify</button></td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<div class="card-modern">
    <div class="card-header-flex">
        <h3>🔄 Tests Returned for Review</h3>
        <button class="btn-outline-lab" onclick="showDemoAlert('View all returned tests')">View All</button>
    </div>
    <table>
        <thead>
            <tr><th>Test</th><th>Request</th><th>Original Result</th><th>Verifier Notes</th><th>Action</th></tr>
        </thead>
        <tbody>
            <tr>
                <td>Differential Count</td>
                <td>REQ-005</td>
                <td>Neutrophils 85%</td>
                <td>"Please review: Reference range 40-70%"</td>
                <td><button class="btn-outline-lab" onclick="showDemoAlert('Review and correct results')">Review & Correct</button></td>
            </tr>
        </tbody>
    </table>
</div>

<!-- Verification Modal (Hidden) -->
<div id="verificationModal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5); z-index:2000; align-items:center; justify-content:center;">
    <div style="background:white; max-width:500px; width:90%; border-radius:24px; padding:1.8rem;">
        <h3 id="modalTitle">Verify Test Result</h3>
        <div id="modalBody"></div>
        <div style="margin-top:1.5rem; display:flex; gap:1rem; justify-content:flex-end;">
            <button class="btn-outline-lab" onclick="closeVerificationModal()">Cancel</button>
            <button class="btn-sm-lab" style="background:#2C8C6E;" onclick="verifyApprove()">✓ Approve & Verify</button>
            <button class="btn-sm-lab" style="background:#E26D5C;" onclick="verifyReturn()">↺ Return for Review</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentVerifyData = {};

        function openVerificationModal(testName, requestNo, result, normalRange, patient, isAbnormal) {
            currentVerifyData = { testName, requestNo, result, normalRange, patient, isAbnormal };
            document.getElementById('modalTitle').innerText = `Verify ${testName} - ${requestNo}`;
            document.getElementById('modalBody').innerHTML = `
                <div class="alert alert-info" style="background:#F4F7FC; padding:1rem; border-radius:12px; margin-bottom:1rem;">
                    <strong>Patient:</strong> ${patient}<br>
                    <strong>Result:</strong> <span style="color:${isAbnormal ? '#E26D5C' : '#2C8C6E'}; font-weight:bold;">${result}</span><br>
                    <strong>Normal Range:</strong> ${normalRange}<br>
                    <strong>Performed by:</strong> Another Technician
                </div>
                <div class="form-group">
                    <label><strong>Verification Notes</strong></label>
                    <textarea id="verifyNotes" rows="2" style="width:100%; padding:10px; border-radius:12px; border:1px solid #E2E8F0;" placeholder="Add any comments..."></textarea>
                </div>
                <p style="font-size:0.75rem; color:#5A6E7A;">⚠️ You cannot verify your own results. Two-step validation required.</p>
            `;
            document.getElementById('verificationModal').style.display = 'flex';
        }

        function closeVerificationModal() {
            document.getElementById('verificationModal').style.display = 'none';
        }

        function verifyApprove() {
            const notes = document.getElementById('verifyNotes')?.value || '';
            showDemoAlert(`✓ Test ${currentVerifyData.testName} VERIFIED. Doctor will be notified via email with PDF attachment.`);
            closeVerificationModal();
        }

        function verifyReturn() {
            const notes = document.getElementById('verifyNotes')?.value || '';
            if (!notes) {
                alert('Please provide a reason for returning this test for review.');
                return;
            }
            showDemoAlert(`↺ Test returned to technician. Status: "To Be Reviewed". Reason: "${notes}"`);
            closeVerificationModal();
        }

        function showDemoAlert(msg) { alert('🔔 ' + msg); }
    </script>
}