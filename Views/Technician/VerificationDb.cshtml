@model NMB_HLabSys.ViewModels.VerificationQueueViewModel
@{ Layout="~/Views/Shared/_Layout.cshtml"; ViewData["Title"]="Result Verification"; ViewData["RoleSubtitle"]="Technician Portal"; ViewData["UserGreeting"]=$"{Model.Technician.Name} ({Model.Technician.EmployeeNumber})"; ViewData["UserInitials"]="LT"; }
@section Styles { <link rel="stylesheet" href="~/css/technician.css" /> }
@section SidebarMenu { @await Html.PartialAsync("_TechnicianSidebar", "Verification") }
<section class="tech-shell">
  <div class="page-toolbar"><div><div class="tech-eyebrow">Quality assurance</div><h2>Independent verification</h2><p>Review a colleague's completed result before it is released. Returned results require a clear audit note.</p></div><button class="tech-theme-toggle" data-tech-theme title="Toggle colour theme"><i class="fas fa-moon"></i></button></div>
  <partial name="_TechnicianFeedback" />
  <div class="tech-hero tech-hero-compact"><div><div class="tech-eyebrow" style="color:#bfeaff">Verification safeguard</div><h3>Every released result has a second set of eyes.</h3><p>You cannot approve a result you performed. This protects quality and preserves a clear review history.</p></div><div class="tech-time"><i class="fas fa-check-double"></i> @Model.Results.Count()<br/><span>Ready to review</span></div></div>
  <div class="card-modern table-container"><div class="card-header-flex"><div><h3><i class="fas fa-user-shield"></i> Review queue</h3><p>Only results awaiting an independent review are shown.</p></div><input class="lab-input tech-table-search" data-tech-search="#techVerificationQueue" placeholder="Search request or test" /></div><table id="techVerificationQueue"><thead><tr><th>Request</th><th>Test</th><th>Result</th><th>Performed by</th><th>Action</th></tr></thead><tbody>@foreach(var x in Model.Results){<tr><td><strong>@x.RequestNumber</strong></td><td>@x.TestName</td><td class="@(x.IsAbnormal?"abnormal-text":"")">@x.ResultValue</td><td>@x.PerformedBy</td><td class="tech-actions"><form asp-action="VerifyResult" method="post"><input type="hidden" name="ResultId" value="@x.ResultId"/><button class="btn-sm-lab">Verify</button></form><form asp-action="ReturnForReview" method="post"><input type="hidden" name="ResultId" value="@x.ResultId"/><input class="lab-input" name="ReviewNotes" required placeholder="Reason for return"/><button class="btn-outline-lab">Return</button></form></td></tr>}@if(!Model.Results.Any()){<tr><td colspan="5" class="tech-empty"><i class="fas fa-clipboard-check"></i>No independently-verifiable results are available.</td></tr>}</tbody></table></div>
</section>
@section Scripts { <script src="~/js/technician-ui.js"></script> }


